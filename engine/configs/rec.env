# rec.env: the production switch set of Volta sPLIt (2026-11-03). Source it before engine/configs/run_serve.sh.
# Every VLLM_V41_* lever defaults off in the engine; with a switch off, its code path is the old one.
# run_serve.sh adds #1277's own serving set: DOWN_ROWS=1 SESSION_PREFIX=1 PACKED_KV=1 INDEX_TILE_MB=32.
# HOT_REFILL (1Cat issue #1341 port) is on by default in the engine.

# Token path and drafts
export VLLM_V41_INDEX_REDUCE=1        # indexer top-k reduce through the custom all-reduce IPC bank (ours)
export VLLM_V41_DMV_X=1               # double-buffered Volta dense mat-vec dmv13_x (ours)
export VLLM_V41_COUPLED_DRAFTS=1      # coupled (keyed Gumbel) sampled drafts (TensorFold #25, via DGX sPLIce)
export VLLM_V41_COUPLED_DRAFT_TEMP=1.0
export VLLM_V41_MARKOV_SHARD=1        # draft head on vocabulary shards (ours)
export VLLM_V41_COUPLED_SHARD=1       # coupled draft head from vocabulary shards in a captured graph
export VLLM_V41_COUPLED_LOCAL=1       # coupled verification on rank-local vocabulary shards

# Kernels and host path
export VLLM_V41_PLAN_FUSE=1           # expert plan inside the q8 quantize launch
export VLLM_V41_PP_KEEP_BATCH=1       # keep the request in the batch across PP2's empty steps (1Cat #1263 port)
export VLLM_V41_EXPERT_FAST=1         # fast routed-expert kernels, down and gate/up (ours)
export VLLM_V41_FUSE_ATTN_PREP=1      # fused decode attention prologue (ours)
export VLLM_V41_FUSE_ATTN_POST=1      # fused decode attention epilogue (ours)
export VLLM_V41_EXPERT_DIET=3         # expert-kernel instruction diet, gate/up and down (ours; needs patch 0050's v41k)
export VLLM_V41_ROUTE_FAST=1          # router floor (DGX sPLIce port); inconclusive A/B, kept as upstream-backed
export VLLM_V41_ROUTE_WARPS=4
