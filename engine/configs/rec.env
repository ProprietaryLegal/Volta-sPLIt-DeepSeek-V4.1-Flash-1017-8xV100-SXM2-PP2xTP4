# rec.env: the production switch set of Volta sPLIt (the 2026-11-05 checkpoint's 30 keys and two adopted 2026-11-11: 32 keys). Source it before engine/configs/run_serve.sh.
# Every VLLM_V41_* lever defaults off in the engine; with a switch off, its code path is the old one.
# run_serve.sh adds #1277's own serving set: DOWN_ROWS=1 SESSION_PREFIX=1 PACKED_KV=1 INDEX_TILE_MB=32.
# HOT_REFILL (1Cat issue #1341 port) is on by default in the engine.

# Token path and drafts
export VLLM_V41_INDEX_REDUCE=1        # indexer top-k reduce through the custom all-reduce IPC bank (ours)
export VLLM_V41_DMV_X=1               # double-buffered Volta dense mat-vec dmv13_x (ours)
export VLLM_V41_COUPLED_DRAFTS=1      # coupled (keyed Gumbel) sampled drafts (TensorFold #25)
export VLLM_V41_COUPLED_DRAFT_TEMP=1.0
export VLLM_V41_MARKOV_SHARD=1        # draft head on vocabulary shards (ours)
export VLLM_V41_COUPLED_SHARD=1       # coupled draft head from vocabulary shards in a captured graph
export VLLM_V41_COUPLED_LOCAL=1       # coupled verification on rank-local vocabulary shards

# Kernels and host path
export VLLM_V41_PLAN_FUSE=1           # expert plan inside the q8 quantize launch
export VLLM_V41_PP_KEEP_BATCH=1       # keep the request in the batch across PP2's empty steps (1Cat #1263 port)
export VLLM_V41_EXPERT_FAST=1         # fast routed-expert kernels, down and gate/up (ours)
export VLLM_V41_FUSE_ATTN_PREP=1      # fused decode attention prologue (ours)
export VLLM_V41_FUSE_ATTN_POST=1      # fused decode attention epilogue (ours)
export VLLM_V41_EXPERT_DIET=3         # expert-kernel instruction diet, gate/up and down (ours; needs patch 0050's v41k)
export VLLM_V41_ROUTE_FAST=1          # router floor (our Sparks research code); inconclusive A/B, kept as upstream-backed
export VLLM_V41_ROUTE_WARPS=4

# Long context (adopted 2026-11-03)
export VLLM_V41_PREFILL_SKIP_ROWS=3072    # prefill skip: early chunks skip unreachable stage-2 window layers (ours; needs patch 0051)
export VLLM_V41_KV_HOT_POSITIONS=524288   # packed-KV GPU hot ring, 524,288 positions (#1277 default 32768)
export VLLM_V41_INDEX_TILED=1             # tiled decode index scorer (ours; adopted 2026-11-04; needs patch 0052 and v41idx.so)
export VLLM_V41_INDEX_TILED_LIB="${ENGINE_HOME}/src-pp2/benchmarks/deepseek_v41/v41idx/build/v41idx.so"   # no fallback: a missing library fails the boot
export VLLM_V41_INDEX_FUSE=ilp4           # fused prefill index scorer, summation order ilp4 (ours; adopted 2026-11-04; needs patch 0053 and v41pidx.so)
export VLLM_V41_INDEX_FUSE_LIB="${ENGINE_HOME}/src-pp2/benchmarks/deepseek_v41/v41pidx/build/v41pidx.so"

# Drafter (adopted 2026-11-04)
export VLLM_V41_DRAFT_MP_SHARD=1          # drafter main_proj as a TP-sharded GEMV (ours; needs patch 0054). VLLM_V41_DRAFT_GEMV2 stays off

# Model runner (adopted 2026-11-04)
export VLLM_USE_V2_MODEL_RUNNER=1         # vLLM Model Runner V2 with our DeepSeek-V4.1 port (needs patch 0055); synchronous scheduling, as before

# All-reduce (adopted 2026-11-04, test D44R5)
export VLLM_SM70_MOE_ADD_ALLREDUCE=1      # shared + routed MoE outputs added inside the TP all-reduce (1Cat engine switch, off by default)
export VLLM_V41_SUM2_PUSH_ANY=1           # admit V4.1's 61,440-byte MoE-sum message to the push path (ours; needs patch 0056 and a rebuilt _C)
export VLLM_SM70_TP4_PUSH_ALLREDUCE_SMALL_MESSAGES=1   # custom all-reduce admission by aligned message size (1Cat engine switch), set explicitly

# Pipeline hand-off (adopted 2026-11-05, lever G)
export NCCL_P2P_LEVEL=NVL                 # NCCL peer-to-peer only inside an NVLink board; the cross-board PP hand-off takes NCCL's host path (env only, no patch)

# Prefill experts (adopted 2026-11-05, test D51)
export VLLM_V41_PREFILL_IQ_GEMM=1         # SM70 prefill IQ GEMM for routed experts (ours; needs patch 0057 and v41prefmoe.so next to gguf_prefill_iq.py)
export VLLM_V41_PREFILL_IQ_TILES=5,4,4,4,4,4   # frozen tile choice per codec and role (from the D51 micro-benchmark)
export VLLM_V41_PREFILL_IQ_GRID=0         # grid sized from the work, not the fixed 160

# After the checkpoint (adopted 2026-11-11)
export VLLM_V41_SYSTEM_IN_PLACE=1         # Messages endpoint: a system message sent in the middle of a chat stays in place, so the cached prefix still matches (ours; needs patch 0058)
export VLLM_V41_TOPK_SEG=1024             # decode index top-k in segments of 1,024 scores instead of 8,192; same selection (ours; needs patch 0059)
