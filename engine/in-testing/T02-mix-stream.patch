+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""sm_70 compile check for VLLM_V41_MIX_STREAM (CPU only, no GPU).
+
+Compiles the side-stream mix kernels and the prod kernels whose MIX work they
+take over, with ``triton.compile(..., target=GPUTarget("cuda", 70, 32))``, and
+checks:
+
+* every FP32 add-reduction of ``_mix_parts`` (groups 8/4/2/1) has an operand
+  layout and axis that ``_transition_parts3`` (MIX=True, same rows per group)
+  uses, and every add-reduction of ``_mix_finish`` one that
+  ``_transition_finish3`` (MIX=True) uses: the in-thread / warp-shuffle /
+  cross-warp summation trees are the same;
+* the same multiset of add-reductions: _mix_parts has parts3's MIX sums
+  (squares + one per fn row) and _mix_finish finish3's MIX sums;
+* ``_mix_finish``'s Sinkhorn sums are the 4-lane butterflies finish3 uses
+  (shfl xor 2, 1 over a row, 8, 4 over a column);
+* no FP32 contraction in parts3, finish3, _mix_parts or _mix_finish: no fma
+  and every f32 mul/add is .rn (enable_fp_fusion=False), so the residual
+  update n that finish3 stores is computed exactly as parts3 computes it
+  (both call _v3_new_residual on the same inputs), and _mix_parts reads
+  those FP32 bits back;
+* ptxas (Triton's bundled CUDA 12.x one) reports no spills for the default
+  groups (8) and _mix_finish; other groupings only warn.
+
+Prints one JSON report; exit 1 on any failure, 2 if this Triton cannot target
+sm_70.
+
+    CUDA_VISIBLE_DEVICES= python benchmarks/deepseek_v41/mix_stream_sm70_check.py
+"""
+
+import importlib.util
+import json
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+_spec = importlib.util.spec_from_file_location(
+    "small_fuse_sm70_check", _HERE / "small_fuse_sm70_check.py"
+)
+SF = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(SF)
+
+
+def _adds(ttgir):
+    return Counter({k: v for k, v in SF.reductions(ttgir).items() if k[0] == "addf"})
+
+
+def _contractible(ptx):
+    """FMAs, and f32 mul/add without .rn (ptxas may contract those)."""
+    return {
+        "fma": len(re.findall(r"\bfma\.\S*f32", ptx)),
+        "plain_mul_add": len(re.findall(r"\b(?:mul|add)\.f32\b", ptx)),
+    }
+
+
+def _shuffles(ptx):
+    return " ".join(re.findall(r"shfl\.sync\.bfly\.b32\s+\S+,\s*\S+,\s*(\d+),", ptx))
+
+
+def main():
+    fused = SF.load_modules()[0]
+    p32, p16 = "*fp32", "*fp16"
+    shape = dict(H=fused.H, COLS=fused.COLS, CHUNKS=fused.CHUNKS)
+    eps = dict(NORM_EPS=1e-20, HC_EPS=1e-6, ITERS=20)
+    parts_t = dict(
+        residual=p32, y=p16, post=p32, comb=p32, fn=p32, cpre=p32,
+        cbuf=p32, dots=p32, squares=p32, csquares=p32,
+    )  # fmt: skip
+    finish_t = dict(
+        residual=p32, y=p16, post_in=p32, comb_in=p32, dots=p32, squares=p32,
+        csquares=p32, cbuf=p32, norm=p32, out=p16, scale=p32, base=p32,
+        pre=p32, post=p32, comb=p32,
+    )  # fmt: skip
+    mparts_t = dict(residual=p32, fn=p32, dots=p32, squares=p32)
+    mfinish_t = dict(
+        dots=p32, squares=p32, scale=p32, base=p32, pre=p32, post=p32, comb=p32
+    )
+    report = {"triton": SF.triton.__version__}
+    ok = True
+
+    for groups in (8, 4, 2, 1):
+        rows = 24 // groups
+        old_mix = SF.compile_sm70(
+            fused._transition_parts3, parts_t, dict(shape, MIX=True, ROWS=rows)
+        )
+        old_nomix = SF.compile_sm70(
+            fused._transition_parts3, parts_t, dict(shape, MIX=False, ROWS=rows)
+        )
+        new = SF.compile_sm70(fused._mix_parts, mparts_t, dict(shape, ROWS=rows))
+        for kname, k in (("parts3", old_mix), ("mix_parts", new)):
+            c = _contractible(k["ptx"])
+            report.setdefault("contraction", {})[f"{kname} rows={rows}"] = c
+            ok &= c == {"fma": 0, "plain_mul_add": 0}
+        old_adds, new_adds = _adds(old_mix["ttgir"]), _adds(new["ttgir"])
+        # parts3's MIX sums = its MIX=True sums minus the collapse's.
+        mix_only = old_adds - _adds(old_nomix["ttgir"])
+        name = f"mix_parts groups={groups}"
+        unmatched = [str(k) for k in new_adds if k not in old_adds]
+        report[name] = {
+            "regs": new["regs"],
+            "spill_bytes": new["spill_bytes"],
+            "add_reductions": [f"{v} x {k[2]}" for k, v in sorted(new_adds.items())],
+            "parts3_mix_add_reductions": [
+                f"{v} x {k[2]}" for k, v in sorted(mix_only.items())
+            ],
+            "unmatched_add_layouts": unmatched,
+        }
+        if unmatched or new_adds != mix_only:
+            ok = False
+            report[name]["error"] = "add-reduction layouts/multiset differ"
+        if new["spill_bytes"]:  # a timing matter, not a bitwise one
+            report[name]["warning"] = "ptxas spills"
+            ok &= groups != fused._MS_GROUPS  # the default must not spill
+
+    old_f = SF.compile_sm70(
+        fused._transition_finish3, finish_t, dict(shape, MIX=True, **eps)
+    )
+    old_f0 = SF.compile_sm70(
+        fused._transition_finish3, finish_t, dict(shape, MIX=False, **eps)
+    )
+    new_f = SF.compile_sm70(
+        fused._mix_finish, mfinish_t, dict(H=fused.H, CHUNKS=fused.CHUNKS, **eps)
+    )
+    for kname, k in (
+        ("finish3", old_f),
+        ("finish3_nomix", old_f0),
+        ("mix_finish", new_f),
+    ):
+        c = _contractible(k["ptx"])
+        report.setdefault("contraction", {})[kname] = c
+        ok &= c == {"fma": 0, "plain_mul_add": 0}
+    old_adds, new_adds = _adds(old_f["ttgir"]), _adds(new_f["ttgir"])
+    mix_only = old_adds - _adds(old_f0["ttgir"])
+    unmatched = [str(k) for k in new_adds if k not in old_adds]
+    report["mix_finish"] = {
+        "regs": new_f["regs"],
+        "spill_bytes": new_f["spill_bytes"],
+        "add_reductions": [f"{v} x {k[2]}" for k, v in sorted(new_adds.items())],
+        "finish3_mix_add_reductions": [
+            f"{v} x {k[2]}" for k, v in sorted(mix_only.items())
+        ],
+        "unmatched_add_layouts": unmatched,
+        "finish3_shuffles": _shuffles(old_f["ptx"]),
+        "mix_finish_shuffles": _shuffles(new_f["ptx"]),
+    }
+    errors = []
+    if unmatched or new_adds != mix_only:
+        errors.append("add-reduction layouts/multiset differ from finish3's MIX")
+    if new_f["spill_bytes"]:
+        errors.append("spills")
+    if "2 1 8 4" not in report["mix_finish"]["mix_finish_shuffles"]:
+        errors.append("Sinkhorn sums are not xor 2,1 / 8,4")
+    if errors:
+        ok = False
+        report["mix_finish"]["error"] = "; ".join(errors)
+    report["ok"] = bool(ok)
+    print(json.dumps(report, indent=1))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    if not SF._ptxas_targets_sm70():
+        print(json.dumps({"ok": None, "skip": "Triton's ptxas cannot target sm_70"}))
+        sys.exit(2)
+    sys.exit(main())
