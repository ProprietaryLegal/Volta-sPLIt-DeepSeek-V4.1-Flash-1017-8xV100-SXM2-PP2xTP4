index 000000000..19f176930
--- /dev/null
+++ b/tests/models/test_deepseek_v41_mix_stream_knob_off.py
@@ -0,0 +1,167 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Knob-off proof for VLLM_V41_MIX_STREAM (source level, CPU).
+
+Every MIX_STREAM branch is an ``if [_]MIX_STREAM[ and ...]:`` whose test is
+False when the knob is off, so the code that runs is what remains after
+replacing each such ``if`` by its ``else`` body. This test does that on the
+AST and requires the result to equal the base commit (combo1103f b9b0bc8e4
+plus the hot-refill fix dd522db + 7e9a156, the deployed site-packages):
+
+* deepseek_v41_fused.py: hc_transition equal after pruning (one branch);
+  every other function of the base unchanged; the base's module-level
+  statements all still there, in order (new ones only added);
+* model.py: DeepseekV41Model.forward and ._forward_fused equal after pruning
+  (one and three branches); every other method and every other top-level
+  function/class unchanged; base module statements a subsequence;
+* deepseek_v41.py (hc_mixes, collapse, expand) unchanged;
+* both knobs registered in vllm/envs.py, VLLM_V41_MIX_STREAM default "0",
+  and both in the compile_factors ignore list.
+
+Needs git and the base commit (skips otherwise).
+
+    python tests/models/test_deepseek_v41_mix_stream_knob_off.py   # or pytest
+"""
+
+import ast
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+BASE = "7e9a15686"  # b9b0bc8e4 + hotrefill dd522db + 7e9a156
+KNOBS = {"_MIX_STREAM", "MIX_STREAM"}
+
+
+def _source(rel, rev=None):
+    if rev is None:
+        return (ROOT / rel).read_text()
+    try:
+        return subprocess.run(
+            ["git", "-C", str(ROOT), "show", f"{rev}:{rel}"],
+            capture_output=True,
+            text=True,
+            check=True,
+        ).stdout
+    except (OSError, subprocess.CalledProcessError):
+        pytest.skip(f"git or base commit {rev} not available")
+
+
+def _is_knob(test):
+    if isinstance(test, ast.BoolOp) and isinstance(test.op, ast.And):
+        test = test.values[0]
+    return isinstance(test, ast.Name) and test.id in KNOBS
+
+
+class _KnobsOff(ast.NodeTransformer):
+    def __init__(self):
+        self.pruned = 0
+
+    def visit_If(self, node):
+        self.generic_visit(node)
+        if _is_knob(node.test):
+            self.pruned += 1
+            return node.orelse  # [] removes the statement
+        return node
+
+
+def _defs(tree):
+    return {
+        n.name: n for n in tree.body if isinstance(n, ast.FunctionDef | ast.ClassDef)
+    }
+
+
+def _methods(cls):
+    return {
+        n.name: n
+        for n in cls.body
+        if isinstance(n, ast.FunctionDef | ast.AsyncFunctionDef)
+    }
+
+
+def _dump(node):
+    return ast.dump(node, include_attributes=False)
+
+
+def _pruned(node):
+    pruner = _KnobsOff()
+    node = pruner.visit(ast.parse(ast.unparse(node)).body[0])
+    return node, pruner.pruned
+
+
+def _module_statements(tree):
+    return [
+        _dump(n) for n in tree.body if not isinstance(n, ast.FunctionDef | ast.ClassDef)
+    ]
+
+
+def _is_subsequence(small, big):
+    it = iter(big)
+    return all(any(x == y for y in it) for x in small)
+
+
+def test_fused_module_knob_off():
+    rel = "vllm/model_executor/kernels/mhc/deepseek_v41_fused.py"
+    base, cur = ast.parse(_source(rel, BASE)), ast.parse(_source(rel))
+    base_defs, cur_defs = _defs(base), _defs(cur)
+    for name, node in base_defs.items():
+        if name == "hc_transition":
+            pruned, n = _pruned(cur_defs[name])
+            assert n == 1
+            assert _dump(pruned) == _dump(node), name
+        else:
+            assert _dump(cur_defs[name]) == _dump(node), name
+    assert set(cur_defs) - set(base_defs) == {
+        "_mix_parts",
+        "_mix_finish",
+        "_mix_side_stream",
+        "mix_join",
+        "mix_fork",
+        "mix_side_mixes",
+        "_hc_transition_side",
+    }
+    assert _is_subsequence(_module_statements(base), _module_statements(cur))
+
+
+def test_model_knob_off():
+    rel = "vllm/models/deepseek_v41/model.py"
+    base, cur = ast.parse(_source(rel, BASE)), ast.parse(_source(rel))
+    base_defs, cur_defs = _defs(base), _defs(cur)
+    assert set(cur_defs) == set(base_defs)
+    for name, node in base_defs.items():
+        if name != "DeepseekV41Model":
+            assert _dump(cur_defs[name]) == _dump(node), name
+    base_m = _methods(base_defs["DeepseekV41Model"])
+    cur_m = _methods(cur_defs["DeepseekV41Model"])
+    assert set(cur_m) == set(base_m)
+    expected = {"forward": 1, "_forward_fused": 3}
+    for name, node in base_m.items():
+        if name in expected:
+            pruned, n = _pruned(cur_m[name])
+            assert n == expected[name], name
+            assert _dump(pruned) == _dump(node), name
+        else:
+            assert _dump(cur_m[name]) == _dump(node), name
+    assert _is_subsequence(_module_statements(base), _module_statements(cur))
+
+
+def test_mhc_primitives_untouched():
+    rel = "vllm/model_executor/kernels/mhc/deepseek_v41.py"
+    assert _source(rel) == _source(rel, BASE)
+
+
+def test_knobs_registered_default_off():
+    src = _source("vllm/envs.py")
+    for name, default in (
+        ("VLLM_V41_MIX_STREAM", "0"),
+        ("VLLM_V41_MIX_STREAM_GROUPS", "8"),
+    ):
+        assert f'    {name}: str = "{default}"\n' in src
+        assert f'os.getenv("{name}", "{default}")' in src
+        assert f'        "{name}",\n' in src  # compile_factors ignore list
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main([__file__, "-q"]))
diff --git a/tests/models/test_deepseek_v41_small_fuse_knob_off.py b/tests/models/test_deepseek_v41_small_fuse_knob_off.py
