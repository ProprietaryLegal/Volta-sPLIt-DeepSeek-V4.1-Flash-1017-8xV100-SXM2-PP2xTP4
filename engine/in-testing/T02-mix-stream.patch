@@ -0,0 +1,396 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""4-GPU check for VLLM_V41_MIX_STREAM beside the real TP4 all-reduce.
+
+The side-stream mix kernels run beside the next sublayer, and on the 8-GPU host every
+decode sublayer ends in vLLM's TP all-reduce (the sm_70 ring / custom
+all-reduce kernels spin on peer flags). This check runs that path for real:
+four processes, one per GPU of a TP4 board, vLLM's distributed init and
+``graph_capture`` as the engine uses them, and per layer
+
+    transition (hc_transition, knob off = prod, knob on = side-stream mixes)
+    -> sublayer: inputs @ W1_shard -> @ W2_shard -> tensor_model_parallel_all_reduce
+       (--reduces all-reduces per sublayer; the reduced y feeds the next
+       transition, so every rank's HC chain is identical)
+
+1. Bitwise per rank: the knob-on chain equals the knob-off chain (every FP16
+   collapse, the final residual and mixes), eager and in CUDA graphs captured
+   under ``graph_capture`` (one per M = 1..6, replayed interleaved); and all
+   four ranks hold the same final residual.
+2. No hang: every replay is synchronized under a watchdog (--watchdog s);
+   a stuck replay exits non-zero with the phase it stuck in.
+3. Timing: a --layers chain per M = --time-tokens in a CUDA graph, ABBA,
+   max over ranks of the median per-replay time; saved us per transition and
+   the x--round-transitions round estimate (rank 0 prints the JSON).
+4. Which all-reduce backend ran (the communicator's collective trace).
+
+Uses the engine's installed vllm (source run-pp2/env.sh first) for the
+communicator; the kernel module deepseek_v41_fused.py is loaded from this
+script's tree. Server down; the four GPUs of ONE NVLink board. On the 8-GPU host (by
+PCI_BUS_ID) Board B is CUDA 0,1,4,5 and Board C is 2,3,6,7; 0,1,2,3 spans two
+boards. The report lists each rank's PCI bus id, masked UUID and peer access so
+a wrong set shows:
+
+    source ${ENGINE_HOME}/run-pp2/env.sh
+    cd /path/to/1cat-vllm-checkout
+    CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES=0,1,4,5 timeout 1800 \\
+      "$PY" -m torch.distributed.run --nproc-per-node 4 \\
+      benchmarks/deepseek_v41/mix_stream_tp4_check.py --json /tmp/mix_tp4.json
+"""
+
+import argparse
+import contextlib
+import faulthandler
+import importlib.util
+import json
+import os
+import statistics
+import sys
+import threading
+import types
+from pathlib import Path
+
+_BLOCKING = "--blocking" in sys.argv[1:]
+if _BLOCKING:  # before torch initializes CUDA
+    os.environ["CUDA_LAUNCH_BLOCKING"] = "1"
+
+import torch  # noqa: E402
+import torch.distributed as dist  # noqa: E402
+
+_TREE = Path(__file__).resolve().parents[2]
+_FUSED_PATH = _TREE / "vllm/model_executor/kernels/mhc/deepseek_v41_fused.py"
+_KNOB_DEFAULTS = {"VLLM_V41_MIX_STREAM": "0", "VLLM_V41_MIX_STREAM_GROUPS": "8"}
+EPS = dict(norm_eps=1e-20, hc_eps=1e-6, iters=20)
+
+
+def load_fused():
+    """deepseek_v41_fused.py from this tree against the installed vllm; knobs
+    the installed vllm.envs does not know come from the process env."""
+    import vllm.envs as real
+
+    class _Proxy(types.ModuleType):
+        def __getattr__(self, name):
+            try:
+                return getattr(real, name)
+            except AttributeError:
+                if name in _KNOB_DEFAULTS:
+                    return os.environ.get(name, _KNOB_DEFAULTS[name])
+                raise
+
+    saved = sys.modules["vllm.envs"]
+    sys.modules["vllm.envs"] = _Proxy("vllm.envs")
+    import vllm
+
+    vllm_envs = getattr(vllm, "envs", None)
+    vllm.envs = sys.modules["vllm.envs"]
+    try:
+        spec = importlib.util.spec_from_file_location("v41_mix_tp4", _FUSED_PATH)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+    finally:
+        sys.modules["vllm.envs"] = saved
+        if vllm_envs is not None:
+            vllm.envs = vllm_envs
+    if not mod._V3:
+        raise SystemExit("VLLM_V41_HC_V3 must be 1 (the deployed transition)")
+    return mod
+
+
+@contextlib.contextmanager
+def watchdog(seconds, phase):
+    done = threading.Event()
+
+    def bite():
+        if not done.wait(seconds):
+            sys.stderr.write(f"rank {os.environ.get('RANK')}: HANG in {phase}\n")
+            faulthandler.dump_traceback(all_threads=True)
+            os._exit(3)
+
+    t = threading.Thread(target=bite, daemon=True)
+    t.start()
+    rank = os.environ.get("RANK")
+    if _BLOCKING:
+        print(f"rank {rank}: begin {phase}", file=sys.stderr, flush=True)
+    try:
+        yield
+        if _BLOCKING:
+            torch.cuda.synchronize()
+            print(f"rank {rank}: end {phase}", file=sys.stderr, flush=True)
+    finally:
+        done.set()
+
+
+class Chain:
+    def __init__(self, fused, tokens, layers, reduces, seed, rank, world):
+        self.fused, self.reduces = fused, reduces
+        H = fused.H
+        g = torch.Generator(device="cuda").manual_seed(seed)  # same on all ranks
+        dev = "cuda"
+        comb = torch.softmax(torch.randn(tokens, 4, 4, device=dev, generator=g), -1)
+        for _ in range(8):
+            comb = comb / comb.sum(-1, keepdim=True)
+            comb = comb / comb.sum(-2, keepdim=True)
+        self.res0 = torch.randn(tokens, 4, H, device=dev, generator=g) * 0.7
+        self.residual = self.res0.clone()
+        self.y0 = (torch.randn(tokens, H, device=dev, generator=g) * 0.5).half()
+        self.post0 = 2.0 * torch.sigmoid(
+            torch.randn(tokens, 4, device=dev, generator=g)
+        )
+        self.comb0 = comb
+        self.pre0 = (
+            torch.sigmoid(torch.randn(tokens, 4, device=dev, generator=g)) + 1e-6
+        )
+        self.norm = 1.0 + 0.1 * torch.randn(H, device=dev, generator=g)
+        self.fns = [
+            (
+                torch.randn(24, 4 * H, device=dev, generator=g) * 0.02,
+                0.5 + torch.rand(3, device=dev, generator=g),
+                0.5 * torch.randn(24, device=dev, generator=g),
+            )
+            for _ in range(layers)
+        ]
+        # TP shards of a 5120 -> 4096 -> 5120 sublayer (rank's quarter).
+        inner = 4096 // world
+        w1 = torch.randn(H, 4096, device=dev, generator=g) / H**0.5
+        w2 = torch.randn(4096, H, device=dev, generator=g) / 4096**0.5
+        sl = slice(rank * inner, (rank + 1) * inner)
+        self.w1 = w1[:, sl].contiguous().half()
+        self.w2 = w2[sl].contiguous().half()
+        del w1, w2
+
+    def sublayer(self, inputs):
+        from vllm.distributed import tensor_model_parallel_all_reduce
+
+        y = (inputs @ self.w1) @ self.w2
+        y = tensor_model_parallel_all_reduce(y)
+        for _ in range(self.reduces - 1):
+            y = tensor_model_parallel_all_reduce(y * 0.25)
+        return y
+
+    def run(self):
+        f = self.fused
+        self.residual.copy_(self.res0)
+        y, post, comb, pre = self.y0, self.post0, self.comb0, self.pre0
+        outs = []
+        for fn, scale, base in self.fns:
+            out, (pre, post, comb) = f.hc_transition(
+                self.residual, y, post, comb, pre, self.norm, fn, scale, base, **EPS
+            )
+            outs.append(out)
+            y = self.sublayer(out)
+        f.mix_join(self.residual.device)
+        return outs + [self.residual, pre, post, comb]
+
+
+@contextlib.contextmanager
+def knob(fused, on):
+    saved = fused._MIX_STREAM
+    fused._MIX_STREAM = on
+    try:
+        yield
+    finally:
+        fused._MIX_STREAM = saved
+
+
+def _bits(x):
+    x = x.contiguous()
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _same(a, b):
+    return a.shape == b.shape and torch.equal(_bits(a), _bits(b))
+
+
+def gpu_identity(device):
+    """PCI bus id, masked UUID (first 8 hex digits only) and peer access."""
+    props = torch.cuda.get_device_properties(device)
+    bus = "%04x:%02x:%02x.0" % (
+        getattr(props, "pci_domain_id", 0),
+        getattr(props, "pci_bus_id", -1),
+        getattr(props, "pci_device_id", -1),
+    )
+    uuid = str(getattr(props, "uuid", ""))
+    masked = (uuid[:8] + "-****") if uuid else None
+    peers = [
+        j
+        for j in range(torch.cuda.device_count())
+        if j != device.index and torch.cuda.can_device_access_peer(device.index, j)
+    ]
+    return {"local": device.index, "pci": bus, "uuid": masked, "peers": peers}
+
+
+def capture(fused, chain, on, device):
+    from vllm.distributed.parallel_state import graph_capture
+
+    with knob(fused, on):
+        chain.run()
+        torch.cuda.synchronize()
+        with graph_capture(device=device) as ctx:
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph, stream=ctx.stream):
+                result = chain.run()
+    return graph, result
+
+
+def replay_us(graph, trials, wd, phase):
+    with watchdog(wd, phase):
+        graph.replay()
+        torch.cuda.synchronize()
+    times = []
+    for _ in range(trials):
+        dist.barrier()
+        with watchdog(wd, phase):
+            start = torch.cuda.Event(enable_timing=True)
+            end = torch.cuda.Event(enable_timing=True)
+            start.record()
+            for _ in range(10):
+                graph.replay()
+            end.record()
+            end.synchronize()
+        times.append(start.elapsed_time(end) * 1000.0 / 10)
+    return statistics.median(times)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--check-layers", type=int, default=8)
+    ap.add_argument("--layers", type=int, default=40)
+    ap.add_argument("--reduces", type=int, default=1)
+    ap.add_argument("--time-tokens", default="1,6")
+    ap.add_argument("--trials", type=int, default=7)
+    ap.add_argument("--round-transitions", type=int, default=76)
+    ap.add_argument("--watchdog", type=float, default=120.0)
+    ap.add_argument("--json", default=None)
+    ap.add_argument(
+        "--blocking",
+        action="store_true",
+        help="CUDA_LAUNCH_BLOCKING=1 + sync and print per phase (fault finding)",
+    )
+    args = ap.parse_args()
+
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.distributed import (
+        ensure_model_parallel_initialized,
+        init_distributed_environment,
+    )
+    from vllm.distributed.parallel_state import get_tp_group
+
+    rank, world = int(os.environ["RANK"]), int(os.environ["WORLD_SIZE"])
+    if world != 4:
+        raise SystemExit("run with --nproc-per-node 4 (one TP4 board)")
+    device = torch.device("cuda", int(os.environ["LOCAL_RANK"]))
+    torch.cuda.set_device(device)
+    with set_current_vllm_config(VllmConfig()):
+        init_distributed_environment(
+            world_size=world, rank=rank, local_rank=device.index
+        )
+        ensure_model_parallel_initialized(world, 1)
+    comm = get_tp_group().device_communicator
+    trace = getattr(comm, "_collective_trace", None)
+    if trace is not None:
+        trace.enabled = True
+    # Warm the communicators before any capture.
+    warm = torch.ones(8, 5120, device=device, dtype=torch.float16)
+    from vllm.distributed import tensor_model_parallel_all_reduce
+
+    tensor_model_parallel_all_reduce(warm)
+    torch.cuda.synchronize()
+
+    fused = load_fused()
+    fused._MS_GROUPS = int(os.environ.get("VLLM_V41_MIX_STREAM_GROUPS", "8"))
+    failures = []
+    report = {"device": torch.cuda.get_device_name(), "ranks": world}
+    ident = [None] * world
+    dist.all_gather_object(ident, dict(gpu_identity(device), rank=rank))
+    report["gpus"] = ident
+    report["cuda_visible_devices"] = os.environ.get("CUDA_VISIBLE_DEVICES")
+    if rank == 0:
+        print("visible GPUs:", json.dumps(ident), flush=True)
+
+    # 1. eager + graphs, bitwise, interleaved replays across M.
+    graphs = []
+    for tokens in range(1, 7):
+        chain = Chain(
+            fused, tokens, args.check_layers, args.reduces, 100 + tokens, rank, world
+        )
+        with watchdog(args.watchdog, f"eager M{tokens}"):
+            with knob(fused, False):
+                old = [t.clone() for t in chain.run()]
+            with knob(fused, True):
+                new = [t.clone() for t in chain.run()]
+            torch.cuda.synchronize()
+        for i, (a, b) in enumerate(zip(old, new)):
+            if not _same(a, b):
+                failures.append(f"rank{rank} eager M{tokens} #{i}")
+        with watchdog(args.watchdog, f"capture M{tokens}"):
+            graph, result = capture(fused, chain, True, device)
+        graphs.append((tokens, graph, result, old, chain))
+    for _ in range(2):
+        for tokens, graph, result, old, _chain in graphs:
+            dist.barrier()
+            with watchdog(args.watchdog, f"replay M{tokens}"):
+                graph.replay()
+                torch.cuda.synchronize()
+            for i, (a, b) in enumerate(zip(old, result)):
+                if not _same(a, b):
+                    failures.append(f"rank{rank} graph M{tokens} #{i}")
+    # Same HC chain on every rank.
+    for tokens, _graph, result, _old, _chain in graphs:
+        final = result[-4].contiguous()
+        gathered = [torch.empty_like(final) for _ in range(world)]
+        dist.all_gather(gathered, final)
+        if not all(_same(gathered[0], g) for g in gathered[1:]):
+            failures.append(f"rank{rank} M{tokens} ranks differ")
+    del graphs
+
+    # 3. timing.
+    timing = {}
+    for tokens in [int(t) for t in args.time_tokens.split(",")]:
+        chain = Chain(
+            fused, tokens, args.layers, args.reduces, 300 + tokens, rank, world
+        )
+        times = {}
+        for tag, on in (("a1", False), ("b1", True), ("b2", True), ("a2", False)):
+            graph, _ = capture(fused, chain, on, device)
+            times[tag] = replay_us(
+                graph, args.trials, args.watchdog, f"time M{tokens} {tag}"
+            )
+            del graph
+        local = torch.tensor(
+            [(times["a1"] + times["a2"]) / 2, (times["b1"] + times["b2"]) / 2],
+            device=device,
+        )
+        dist.all_reduce(local, op=dist.ReduceOp.MAX)
+        old_us, new_us = local.tolist()
+        saved = (old_us - new_us) / args.layers
+        timing[f"M={tokens}"] = {
+            "prod_chain_us": round(old_us, 2),
+            "new_chain_us": round(new_us, 2),
+            "saved_us_per_transition": round(saved, 2),
+            "round_saving_ms_est": round(saved * args.round_transitions / 1000, 3),
+        }
+        del chain
+    report["timing"] = timing
+    report["timing_note"] = (
+        f"{args.layers}-transition chain, each followed by a TP4 sublayer with "
+        f"{args.reduces} all-reduce(s); CUDA graph under graph_capture; median of "
+        f"{args.trials} x 10 replays per rank, ABBA, max over ranks"
+    )
+    report["allreduce_backends"] = trace.snapshot() if trace is not None else None
+
+    count = torch.tensor([len(failures)], device=device)
+    dist.all_reduce(count)
+    report["mismatches_all_ranks"] = int(count.item())
+    report["failures_rank0"] = failures[:20]
+    report["ok"] = int(count.item()) == 0
+    if rank == 0:
+        text = json.dumps(report, indent=1)
+        print(text)
+        if args.json:
+            Path(args.json).write_text(text)
+    dist.barrier()
+    return 0 if report["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/models/test_deepseek_v41_mix_stream.py b/tests/models/test_deepseek_v41_mix_stream.py
new file mode 100644
index 000000000..2ef8a6790
--- /dev/null
+++ b/tests/models/test_deepseek_v41_mix_stream.py
@@ -0,0 +1,365 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_MIX_STREAM against the prod transition (CPU, Triton interpreter).
+
+* ``_hc_transition_side`` (critical parts3/finish3 without mixes, then
+  ``_mix_parts`` + ``_mix_finish`` on the side stream, here run in place) must
+  give ``_hc_transition3``'s residual, FP16 collapse and (pre, post, comb) bit
+  for bit, for 1..6 tokens and fn-row groups 8/4/2/1.
+* Host logic with fake CUDA streams: a join is a no-op unless a fork is
+  pending (so no edge to a stream outside the capture), a fork waits on the
+  caller stream and launches inside the side-stream context, and
+  hc_transition joins before its kernels read post/comb/collapse_pre, takes
+  the side path only for mixes at 1..6 tokens, and stays on the old path
+  otherwise.
+
+Scope: the interpreter runs programs one after another and ``tl.sum`` as a
+numpy reduction, so this proves the wiring (n read back from the residual,
+dot/squares indexing, rows per group, finish block), not the GPU's reduction
+trees; those are compared on sm_70 TTGIR by
+benchmarks/deepseek_v41/mix_stream_sm70_check.py and on the GPU by
+benchmarks/deepseek_v41/mix_stream_check.py.
+
+    python tests/models/test_deepseek_v41_mix_stream.py   # or pytest
+"""
+
+import os
+
+os.environ["TRITON_INTERPRET"] = "1"  # before triton is imported
+
+import contextlib  # noqa: E402
+import importlib.util  # noqa: E402
+import logging  # noqa: E402
+import sys  # noqa: E402
+import types  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+import triton  # noqa: E402
+import triton.language as tl  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[2]
+_ENV = {
+    "VLLM_V41_HC_WINDOW": "2048",
+    "VLLM_V41_HC_COLS": "32",
+    "VLLM_V41_HC_PW": "4",
+    "VLLM_V41_HC_FW": "4",
+    "VLLM_V41_HC_V3": "1",
+    "VLLM_V41_HC_V3_GROUPS": "8",
+}
+
+
+class _Envs(types.ModuleType):
+    def __getattr__(self, name):
+        if name.startswith("VLLM_"):
+            return _ENV.get(name, "0")
+        raise AttributeError(name)
+
+
+def _load():
+    sys.modules.setdefault("vllm", types.ModuleType("vllm"))
+    tu = types.ModuleType("vllm.triton_utils")
+    tu.tl, tu.triton = tl, triton
+    sys.modules.setdefault("vllm.triton_utils", tu)
+    lg = types.ModuleType("vllm.logger")
+    lg.init_logger = logging.getLogger
+    sys.modules.setdefault("vllm.logger", lg)
+    if "vllm.envs" not in sys.modules:
+        envs = _Envs("vllm.envs")
+        sys.modules["vllm.envs"] = envs
+        sys.modules["vllm"].envs = envs
+    spec = importlib.util.spec_from_file_location(
+        "v41_mix_stream_mhc",
+        ROOT / "vllm/model_executor/kernels/mhc/deepseek_v41_fused.py",
+    )
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+FUSED = _load()
+H = FUSED.H
+
+
+def _inputs(tokens, seed):
+    g = torch.Generator().manual_seed(seed)
+    comb = torch.softmax(torch.randn(tokens, 4, 4, generator=g), -1)
+    for _ in range(8):
+        comb = comb / comb.sum(-1, keepdim=True)
+        comb = comb / comb.sum(-2, keepdim=True)
+    x = dict(
+        residual=torch.randn(tokens, 4, H, generator=g) * 0.7,
+        y=(torch.randn(tokens, H, generator=g) * 0.5).half(),
+        post=2.0 * torch.sigmoid(torch.randn(tokens, 4, generator=g)),
+        comb=comb,
+        collapse_pre=torch.sigmoid(torch.randn(tokens, 4, generator=g)) + 1e-6,
+        norm_weight=1.0 + 0.1 * torch.randn(H, generator=g),
+        fn=torch.randn(24, 4 * H, generator=g) * 0.02,
+        scale=0.5 + torch.rand(3, generator=g),
+        base=0.5 * torch.randn(24, generator=g),
+    )
+    if tokens > 1:
+        x["y"][1] = 0
+    if tokens > 2:
+        x["residual"][2, :, :256] *= 1e-4
+    return x
+
+
+def _run(path, x):
+    residual = x["residual"].clone()
+    out, mixes = path(
+        residual,
+        x["y"],
+        x["post"],
+        x["comb"],
+        x["collapse_pre"],
+        x["norm_weight"],
+        x["fn"],
+        x["scale"],
+        x["base"],
+        1e-20,
+        1e-6,
+        20,
+    )
+    return residual, out, mixes
+
+
+def _run_public(x):
+    # hc_transition's eps/iters are keyword-only (defaults = the model's).
+    keys = ("y", "post", "comb", "collapse_pre", "norm_weight", "fn", "scale", "base")
+    residual = x["residual"].clone()
+    return FUSED.hc_transition(residual, *(x[k] for k in keys))
+
+
+def _same(a, b):
+    a, b = a.contiguous(), b.contiguous()
+    view = {4: torch.int32, 2: torch.int16}[a.element_size()]
+    return (
+        a.shape == b.shape
+        and a.dtype == b.dtype
+        and torch.equal(a.view(view), b.view(view))
+    )
+
+
+@contextlib.contextmanager
+def _patched(**attrs):
+    saved = {k: getattr(FUSED, k) for k in attrs}
+    for k, v in attrs.items():
+        setattr(FUSED, k, v)
+    try:
+        yield
+    finally:
+        for k, v in saved.items():
+            setattr(FUSED, k, v)
+
+
+def _inline_fork(log=None):
+    def fork(device, launch):
+        if log is not None:
+            log.append("fork")
+        launch()
+
+    return fork
+
+
+@pytest.mark.parametrize("groups", [8, 4, 2, 1])
+@pytest.mark.parametrize("tokens", [1, 2, 3, 4, 5, 6])
+def test_side_matches_prod(tokens, groups):
+    x = _inputs(tokens, 1000 * tokens + groups)
+    with _patched(_V3_GROUPS=8):
+        old = _run(FUSED._hc_transition3, x)
+    with _patched(_MS_GROUPS=groups, mix_fork=_inline_fork()):
+        new = _run(FUSED._hc_transition_side, x)
+    assert _same(old[0], new[0]), "residual"
+    assert _same(old[1], new[1]), "collapse"
+    for name, a, b in zip(("pre", "post", "comb"), old[2], new[2]):
+        assert _same(a, b), name
+
+
+def _parts_dots(tokens, groups, x):
+    """prod parts3 (MIX=True) dots/squares on the old residual, and _mix_parts
+    dots/squares on the residual finish3 stored (no-MIX critical path)."""
+    C = FUSED.CHUNKS
+    res = x["residual"].clone()
+    dots_old = torch.full((tokens, C, 24), float("nan"))
+    sq_old = torch.full((tokens, C), float("nan"))
+    cbuf = torch.empty(tokens, H)
+    csq = torch.empty(tokens, C)
+    FUSED._transition_parts3[(tokens, C, groups)](
+        res, x["y"], x["post"], x["comb"], x["fn"], x["collapse_pre"], cbuf,
+        dots_old, sq_old, csq, MIX=True, H=H, COLS=FUSED.COLS, CHUNKS=C,
+        ROWS=24 // groups, num_warps=4, enable_fp_fusion=False,
+    )  # fmt: skip
+    assert torch.equal(res, x["residual"])  # parts3 leaves the residual alone
+    FUSED._hc_transition3(
+        res, x["y"], x["post"], x["comb"], x["collapse_pre"], x["norm_weight"],
+        None, None, None, 1e-20, 1e-6, 20,
+    )  # fmt: skip
+    dots_new = torch.full((tokens, C, 24), float("nan"))
+    sq_new = torch.full((tokens, C), float("nan"))
+    FUSED._mix_parts[(tokens, C, groups)](
+        res, x["fn"], dots_new, sq_new, H=H, COLS=FUSED.COLS, CHUNKS=C,
+        ROWS=24 // groups, num_warps=4, enable_fp_fusion=False,
+    )  # fmt: skip
+    return (dots_old, sq_old), (dots_new, sq_new), res
+
+
+@pytest.mark.parametrize("groups", [8, 1])
+@pytest.mark.parametrize("tokens", [1, 6])
+def test_readback_n_gives_parts3_sums(tokens, groups):
+    # The residual finish3 stores is parts3's n (same _v3_new_residual on the
+    # same inputs, FP32 store/load): the fn dots and squares built from it are
+    # parts3's, bit for bit, before any finishing.
+    x = _inputs(tokens, 40 + tokens)
+    (d0, s0), (d1, s1), res = _parts_dots(tokens, groups, x)
+    assert not torch.isnan(d1).any() and not torch.isnan(s1).any()
+    assert _same(d0, d1) and _same(s0, s1)
+    # ... and that residual is n = comb^T r + post * y, in the kernel's order.
+    r, c, p = x["residual"], x["comb"], x["post"]
+    yv = x["y"].float()
+    for o in range(4):
+        n = c[:, 0, o, None] * r[:, 0]
+        n = n + c[:, 1, o, None] * r[:, 1]
+        n = n + c[:, 2, o, None] * r[:, 2]
+        n = n + c[:, 3, o, None] * r[:, 3]
+        n = n + p[:, o, None] * yv
+        assert _same(res[:, o], n), o
+
+
+# ------------------------------------------------------- host stream logic --
+
+
+class _FakeStream:
+    def __init__(self, name, log):
+        self.name, self.log = name, log
+
+    def wait_stream(self, other):
+        self.log.append(f"{self.name}.wait({other.name})")
+
+
+class _FakeCuda:
+    def __init__(self, log):
+        self.log = log
+        self.main = _FakeStream("main", log)
+        self.current = self.main
+
+    def Stream(self, device=None):  # noqa: N802
+        self.log.append("create")
+        return _FakeStream("side", self.log)
+
+    def current_stream(self, device=None):
+        return self.current
+
+    @contextlib.contextmanager
+    def stream(self, s):
+        prev, self.current = self.current, s
+        self.log.append(f"enter({s.name})")
+        try:
+            yield
+        finally:
+            self.current = prev
+            self.log.append(f"exit({s.name})")
+
+
+class _FakeTorch(types.ModuleType):
+    def __init__(self, cuda):
+        super().__init__("torch")
+        self.cuda = cuda
+
+    def __getattr__(self, name):
+        return getattr(torch, name)
+
+
+@contextlib.contextmanager
+def _fake_cuda():
+    log = []
+    cuda = _FakeCuda(log)
+    with _patched(torch=_FakeTorch(cuda), _MS_STREAMS={}, _MS_PENDING={}):
+        yield cuda, log
+
+
+def test_join_without_fork_is_noop():
+    with _fake_cuda() as (_, log):
+        FUSED.mix_join(torch.device("cpu"))
+        assert log == []
+
+
+def test_fork_then_join_once():
+    dev = torch.device("cpu")
+    with _fake_cuda() as (cuda, log):
+        seen = []
+        FUSED.mix_fork(dev, lambda: seen.append(cuda.current.name))
+        assert seen == ["side"]
+        assert log == ["create", "side.wait(main)", "enter(side)", "exit(side)"]
+        log.clear()
+        FUSED.mix_join(dev)
+        FUSED.mix_join(dev)
+        assert log == ["main.wait(side)"]
+        FUSED.mix_fork(dev, lambda: None)  # stream reused, not recreated
+        assert "create" not in log
+
+
+def test_hc_transition_dispatch_and_join():
+    with _fake_cuda() as (_, log):
+        calls = []
+
+        def side(*args):
+            calls.append(("side", args[0].shape[0], list(log)))
+            return "side", None
+
+        def old(*args):
+            calls.append(("old", args[0].shape[0], list(log)))
+            return "old", None
+
+        with _patched(
+            _MIX_STREAM=True,
+            _hc_transition_side=side,
+            _hc_transition3=old,
+            _FUSE_TRANSITION=False,
+        ):
+            x = _inputs(3, 7)
+            FUSED._MS_STREAMS[None] = _FakeStream("side", log)
+            FUSED._MS_PENDING[None] = True  # a previous transition forked
+            assert _run_public(x)[0] == "side"
+            assert calls[-1][2] == ["main.wait(side)"]  # joined first
+            log.clear()
+            # Final norm transition (no mixes): joins, then the old kernels.
+            FUSED._MS_PENDING[None] = True
+            x_nomix = dict(x, fn=None, scale=None, base=None)
+            assert _run_public(x_nomix)[0] == "old"
+            assert calls[-1][2] == ["main.wait(side)"]
+            log.clear()
+            # Prefill-sized: no side path, no fork, nothing pending: no wait.
+            x7 = _inputs(7, 8)
+            assert _run_public(x7)[0] == "old"
+            assert calls[-1][:2] == ("old", 7) and log == []
+
+
+def test_knob_off_never_touches_streams():
+    with _fake_cuda() as (_, log):
+        calls = []
+
+        def old(*args):
+            calls.append(args[0].shape[0])
+            return "old", None
+
+        with _patched(_MIX_STREAM=False, _hc_transition3=old, _FUSE_TRANSITION=False):
+            FUSED._MS_PENDING[None] = True
+            for tokens in (1, 6):
+                assert _run_public(_inputs(tokens, 3))[0] == "old"
+        assert calls == [1, 6] and log == []
+
+
+def test_groups_must_divide_24():
+    _ENV.update(VLLM_V41_MIX_STREAM="1", VLLM_V41_MIX_STREAM_GROUPS="5")
+    try:
+        with pytest.raises(ValueError, match="divide 24"):
+            _load()
+    finally:
+        _ENV.pop("VLLM_V41_MIX_STREAM")
+        _ENV.pop("VLLM_V41_MIX_STREAM_GROUPS")
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main([__file__, "-q"]))
