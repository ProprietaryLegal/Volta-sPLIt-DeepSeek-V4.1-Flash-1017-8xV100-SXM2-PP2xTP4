+# --- VLLM_V41_MIX_STREAM: the next mixes on a side stream ---------------------
+#
+# V4.1 delays the pre-mix: the (pre, post, comb) a transition produces are first
+# read by the NEXT transition (expand with post/comb, delayed collapse with pre),
+# by the stage hand-off, or by an Engram expand. The sublayer in between reads
+# only the normalized collapse. So the critical path runs the transition with
+# MIX=False (parts3 + finish3: the same collapse and in-place residual bits as
+# with MIX=True) and a side stream, forked after finish3 has stored the new
+# residual n, runs
+#   _mix_parts:  squares and fn dots per (token, 256-column chunk), exactly
+#                parts3's MIX expressions on n read back from the residual
+#                (n is stored as FP32, so the bits are the ones parts3 had);
+#   _mix_finish: finish3's chunk-0 MIX block verbatim (sums over the 20 chunks
+#                in order, sigmoids, Sinkhorn).
+# mix_join() joins the side stream into the caller stream before any consumer.
+# Every reduction keeps parts3/finish3's shapes, order and num_warps.
+
+_MIX_STREAM = envs.VLLM_V41_MIX_STREAM == "1"
+MIX_STREAM = _MIX_STREAM  # for model.py
+_MS_GROUPS = int(envs.VLLM_V41_MIX_STREAM_GROUPS)
+_MS_TOKENS = 6  # the decode CUDA-graph sizes (M1..M6)
+if _MIX_STREAM and (_MS_GROUPS < 1 or 24 % _MS_GROUPS):
+    raise ValueError("VLLM_V41_MIX_STREAM_GROUPS must divide 24")
+_MS_STREAMS: dict = {}
+_MS_PENDING: dict = {}
+_MS_LOGGED = False
+
+
+@triton.jit
+def _mix_parts(
+    residual,
+    fn,
+    dots,
+    squares,
+    H: tl.constexpr,
+    COLS: tl.constexpr,
+    CHUNKS: tl.constexpr,
+    ROWS: tl.constexpr,
+):
+    # parts3's MIX arithmetic on the already-updated residual chunk.
+    t, chunk, grp = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    col = chunk * COLS + tl.arange(0, COLS)
+    base = residual + t * 4 * H
+    n0 = tl.load(base + 0 * H + col)
+    n1 = tl.load(base + 1 * H + col)
+    n2 = tl.load(base + 2 * H + col)
+    n3 = tl.load(base + 3 * H + col)
+    if grp == 0:
+        tl.store(
+            squares + t * CHUNKS + chunk,
+            tl.sum(n0 * n0 + n1 * n1 + n2 * n2 + n3 * n3, 0),
+        )
+    for i in tl.static_range(ROWS):
+        r = grp * ROWS + i
+        w = fn + r * 4 * H
+        d = (
+            tl.load(w + 0 * H + col) * n0
+            + tl.load(w + 1 * H + col) * n1
+            + tl.load(w + 2 * H + col) * n2
+            + tl.load(w + 3 * H + col) * n3
+        )
+        tl.store(dots + (t * CHUNKS + chunk) * 24 + r, tl.sum(d, 0))
+
+
+@triton.jit
+def _mix_finish(
+    dots,
+    squares,
+    scale,
+    base,
+    pre,
+    post,
+    comb,
+    H: tl.constexpr,
+    CHUNKS: tl.constexpr,
+    NORM_EPS: tl.constexpr,
+    HC_EPS: tl.constexpr,
+    ITERS: tl.constexpr,
+):
+    # finish3's chunk-0 MIX block, one program per token.
+    t = tl.program_id(0)
+    i = tl.arange(0, 4)
+    sq = tl.full((), 0, tl.float32)
+    for c in tl.static_range(CHUNKS):
+        sq += tl.load(squares + t * CHUNKS + c)
+    rs = tl.rsqrt(sq / (4 * H) + NORM_EPS)
+    p = tl.zeros((4,), tl.float32)
+    q = tl.zeros((4,), tl.float32)
+    location = i[:, None] * 4 + i[None, :]
+    m = tl.zeros((4, 4), tl.float32)
+    for c in tl.static_range(CHUNKS):
+        row = dots + (t * CHUNKS + c) * 24
+        p += tl.load(row + i)
+        q += tl.load(row + 4 + i)
+        m += tl.load(row + 8 + location)
+    p = p * rs * tl.load(scale) + tl.load(base + i)
+    q = q * rs * tl.load(scale + 1) + tl.load(base + 4 + i)
+    tl.store(pre + t * 4 + i, tl.sigmoid(p) + HC_EPS)
+    tl.store(post + t * 4 + i, 2.0 * tl.sigmoid(q))
+    value = m * rs * tl.load(scale + 2) + tl.load(base + 8 + location)
+    value = tl.exp(value - tl.max(value, 1)[:, None])
+    value = value / tl.sum(value, 1)[:, None] + HC_EPS
+    value = value / (tl.sum(value, 0)[None, :] + HC_EPS)
+    for _ in range(ITERS - 1):
+        value = value / (tl.sum(value, 1)[:, None] + HC_EPS)
+        value = value / (tl.sum(value, 0)[None, :] + HC_EPS)
+    tl.store(comb + t * 16 + location, value)
+
+
+def _mix_side_stream(device):
+    key = device.index
+    side = _MS_STREAMS.get(key)
+    if side is None:
+        side = torch.cuda.Stream(device=device)
+        _MS_STREAMS[key] = side
+    return side
+
+
+def mix_join(device):
+    """Join this device's pending side-stream mixes into the current stream.
+
+    No-op (no captured edge) when nothing is pending, so a join never waits
+    on a stream that is not part of the current capture."""
+    key = device.index
+    if _MS_PENDING.get(key):
+        _MS_PENDING[key] = False
+        torch.cuda.current_stream(device).wait_stream(_MS_STREAMS[key])
+
+
+def mix_fork(device, launch):
+    """Run launch() on the side stream after the current stream's work so far.
+
+    launch() allocates its own temporaries on the side stream; outputs it
+    writes must be allocated by the caller on the current stream (they are
+    read there only after mix_join)."""
+    side = _mix_side_stream(device)
+    side.wait_stream(torch.cuda.current_stream(device))
+    with torch.cuda.stream(side):
+        launch()
+    _MS_PENDING[device.index] = True
+
+
+def mix_side_mixes(residual, fn, scale, base, mixes):
+    """hc_mixes(residual, fn, scale, base) on the side stream (caller-stream
+    outputs re-recorded so the allocator keeps them until the caller's use).
+    ``mixes`` is the hc_mixes callable; returns (pre, post, comb)."""
+    device = residual.device
+    out = []
+
+    def launch():
+        out.extend(mixes(residual, fn, scale, base))
+
+    mix_fork(device, launch)
+    main = torch.cuda.current_stream(device)
+    for tensor in out:
+        tensor.record_stream(main)
+    return tuple(out)
+
+
+def _hc_transition_side(
+    residual,
+    y,
+    post,
+    comb,
+    collapse_pre,
+    norm_weight,
+    fn,
+    scale,
+    base,
+    norm_eps,
+    hc_eps,
+    iters,
+):
+    global _MS_LOGGED
+    tokens = residual.shape[0]
+    device = residual.device
+    if not _MS_LOGGED:
+        _MS_LOGGED = True
+        # Once per worker, at its first decode transition (graph capture at
+        # boot): the activation line the deploy greps for.
+        logger.info(
+            "VLLM_V41_MIX_STREAM=1: MIX on side stream (groups=%d, device %s)",
+            _MS_GROUPS,
+            device,
+        )
+    # Outputs on the caller stream; the side stream writes them.
+    pre = torch.empty(tokens, 4, dtype=torch.float32, device=device)
+    post_n = torch.empty_like(pre)
+    comb_n = torch.empty(tokens, 4, 4, dtype=torch.float32, device=device)
+    # Critical path: expand + delayed collapse, no mixes (residual stored).
+    out, _ = _hc_transition3(
+        residual,
+        y,
+        post,
+        comb,
+        collapse_pre,
+        norm_weight,
+        None,
+        None,
+        None,
+        norm_eps,
+        hc_eps,
+        iters,
+    )
+
+    def launch():
+        dots = torch.empty(tokens, CHUNKS, 24, dtype=torch.float32, device=device)
+        sq = torch.empty(tokens, CHUNKS, dtype=torch.float32, device=device)
+        _mix_parts[(tokens, CHUNKS, _MS_GROUPS)](
+            residual,
+            fn,
+            dots,
+            sq,
+            H=H,
+            COLS=COLS,
+            CHUNKS=CHUNKS,
+            ROWS=24 // _MS_GROUPS,
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+        _mix_finish[(tokens,)](
+            dots,
+            sq,
+            scale,
+            base,
+            pre,
+            post_n,
+            comb_n,
+            H=H,
+            CHUNKS=CHUNKS,
+            NORM_EPS=norm_eps,
+            HC_EPS=hc_eps,
+            ITERS=iters,
+            num_warps=4,
+            enable_fp_fusion=False,
+        )
+
+    mix_fork(device, launch)
+    return out, (pre, post_n, comb_n)
+
