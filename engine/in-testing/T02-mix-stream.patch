index 000000000..c98e27964
--- /dev/null
+++ b/benchmarks/deepseek_v41/mix_stream_check.py
@@ -0,0 +1,531 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check for VLLM_V41_MIX_STREAM (one GPU, synthetic inputs, server down).
+
+Prod = hc_transition with the knob off (_hc_transition3: parts3 + finish3 with
+the mixes, groups = VLLM_V41_HC_V3_GROUPS, 8 unless set). New = the knob on:
+parts3 + finish3 without mixes on the caller stream, _mix_parts + _mix_finish
+on the side stream, joined before the next consumer.
+
+1. Bit equality, prod vs new, every output into fresh NaN-poisoned buffers:
+   one transition for M = 1..6 and side groups 8/4/2/1 (residual, FP16
+   collapse, pre, post, comb); the reference hc_mixes on the side stream
+   (mix_side_mixes) vs on the caller stream.
+2. A chain of --check-layers transitions, each followed by a stand-in sublayer
+   that turns the collapse into the next y (so the side branch really overlaps
+   it and each join is a real edge): eager and CUDA-graph replays (twice, and
+   interleaved across M) of the new chain must equal the prod chain bit for
+   bit (every collapse, the final residual and mixes).
+3. Timing inside CUDA graphs: the same chain with --layers transitions (40 =
+   one stage's 2 x 20) for M = --time-tokens and each stand-in:
+     gemv   two FP16 GEMMs [M,5120]x[5120,2048]x[2048,5120] (~42 MB, DRAM
+            bound: the side branch competes for bandwidth),
+     small  ten tiny elementwise kernels (latency bound),
+     none   y = collapse (no slack: the side branch serializes with the join).
+   Saved per transition = (prod chain - new chain) / layers, and the round
+   estimate uses --round-transitions (76 MIX transitions per target forward:
+   37 on stage 1, 39 on stage 2). This number is a microbenchmark; the ABBA on
+   the server decides.
+
+Loads the kernel modules from this script's tree (no vllm install or build).
+Exit status 1 on any difference.
+
+    CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES=0 \\
+        python benchmarks/deepseek_v41/mix_stream_check.py --json /tmp/mix.json
+
+Fault finding: --blocking sets CUDA_LAUNCH_BLOCKING=1 (before CUDA starts),
+synchronizes after every step and prints "mix_stream_check: begin/end <step>"
+to stderr, so the last "begin" names the step that faulted. --checks picks a
+subset (single,chains,readback,prefill,topology) for slow tools such as
+compute-sanitizer.
+"""
+
+import argparse
+import contextlib
+import importlib.util
+import json
+import os
+import statistics
+import sys
+from pathlib import Path
+
+_BLOCKING = "--blocking" in sys.argv[1:]
+if _BLOCKING:  # before torch initializes CUDA
+    os.environ["CUDA_LAUNCH_BLOCKING"] = "1"
+
+import torch  # noqa: E402
+
+_HERE = Path(__file__).resolve().parent
+_spec = importlib.util.spec_from_file_location(
+    "small_fuse_check", _HERE / "small_fuse_check.py"
+)
+SF = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(SF)
+
+FUSED = SF.FUSED
+# The loader's env stub answers "0" for knobs it does not list; use the real
+# default (or the process env) for the side groups.
+FUSED._MS_GROUPS = int(os.environ.get("VLLM_V41_MIX_STREAM_GROUPS", "8"))
+H = FUSED.H
+DEV = SF.DEV
+EPS = (1e-20, 1e-6, 20)
+
+
+@contextlib.contextmanager
+def stage(label):
+    """Step marker: with --blocking, a fault surfaces inside its own step."""
+    if _BLOCKING:
+        print(f"mix_stream_check: begin {label}", file=sys.stderr, flush=True)
+    yield
+    if _BLOCKING:
+        torch.cuda.synchronize()
+        print(f"mix_stream_check: end {label}", file=sys.stderr, flush=True)
+
+
+@contextlib.contextmanager
+def knob(on, groups=None):
+    saved = FUSED._MIX_STREAM, FUSED._MS_GROUPS
+    FUSED._MIX_STREAM = on
+    if groups is not None:
+        FUSED._MS_GROUPS = groups
+    try:
+        yield
+    finally:
+        FUSED._MIX_STREAM, FUSED._MS_GROUPS = saved
+
+
+def _call(residual, x, post, comb, pre, fn, scale, base):
+    return FUSED.hc_transition(
+        residual, x["y"], post, comb, pre, x["norm_weight"], fn, scale, base
+    )
+
+
+# ------------------------------------------------------------ 1. single --
+
+
+def check_single(failures, report):
+    n = 0
+    for tokens in range(1, 7):
+        for groups in (8, 4, 2, 1):
+            x = SF.transition_inputs(tokens, True, 7000 + 10 * tokens + groups)
+            args = (x["post"], x["comb"], x["collapse_pre"])
+            fns = (x["fn"], x["scale"], x["base"])
+            with stage(f"single M{tokens} g{groups} prod"), SF.poisoned(), knob(False):
+                old_res = x["residual"].clone()
+                old_out, old_mix = _call(old_res, x, *args, *fns)
+            with (
+                stage(f"single M{tokens} g{groups} side"),
+                SF.poisoned(),
+                knob(True, groups),
+            ):
+                new_res = x["residual"].clone()
+                new_out, new_mix = _call(new_res, x, *args, *fns)
+                FUSED.mix_join(new_res.device)
+            torch.cuda.synchronize()
+            SF.compare_transition(
+                failures,
+                f"single M{tokens} g{groups}",
+                (old_res, old_out, old_mix),
+                (new_res, new_out, new_mix),
+            )
+            n += 1
+    # The reference hc_mixes (stage start, after Engram) on the side stream.
+    mixes_mod = sys.modules.get("vllm.model_executor.kernels.mhc.deepseek_v41")
+    if mixes_mod is None:
+        spec = importlib.util.spec_from_file_location(
+            "v41_mhc_ref",
+            _HERE.parents[1] / "vllm/model_executor/kernels/mhc/deepseek_v41.py",
+        )
+        mixes_mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mixes_mod)
+    for tokens in range(1, 7):
+        x = SF.transition_inputs(tokens, True, 9100 + tokens)
+        r = x["residual"]
+        with stage(f"hc_mixes side M{tokens}"):
+            old = mixes_mod.hc_mixes(r, x["fn"], x["scale"], x["base"])
+            new = FUSED.mix_side_mixes(
+                r, x["fn"], x["scale"], x["base"], mixes_mod.hc_mixes
+            )
+            FUSED.mix_join(r.device)
+        torch.cuda.synchronize()
+        for name, a, b in zip(("pre", "post", "comb"), old, new):
+            SF.compare(failures, f"hc_mixes side M{tokens} {name}", a, b)
+        n += 1
+    report["single_checks"] = n
+
+
+def check_readback(failures, report):
+    """parts3 (MIX) fn dots/squares on the old residual == _mix_parts on the
+    residual finish3 stored: n read back is the FP32 n parts3 consumed."""
+    C = FUSED.CHUNKS
+    n = 0
+    for tokens in range(1, 7):
+        for groups in (8, 4, 2, 1):
+            x = SF.transition_inputs(tokens, True, 4000 + 10 * tokens + groups)
+            res = x["residual"].clone()
+            nan = float("nan")
+            d0 = torch.full((tokens, C, 24), nan, device=DEV)
+            s0 = torch.full((tokens, C), nan, device=DEV)
+            d1, s1 = d0.clone(), s0.clone()
+            cbuf = torch.empty(tokens, H, device=DEV)
+            csq = torch.empty(tokens, C, device=DEV)
+            FUSED._transition_parts3[(tokens, C, groups)](
+                res, x["y"], x["post"], x["comb"], x["fn"], x["collapse_pre"],
+                cbuf, d0, s0, csq, MIX=True, H=H, COLS=FUSED.COLS, CHUNKS=C,
+                ROWS=24 // groups, num_warps=4, enable_fp_fusion=False,
+            )  # fmt: skip
+            FUSED._hc_transition3(
+                res, x["y"], x["post"], x["comb"], x["collapse_pre"],
+                x["norm_weight"], None, None, None, *EPS,
+            )  # fmt: skip
+            FUSED._mix_parts[(tokens, C, groups)](
+                res, x["fn"], d1, s1, H=H, COLS=FUSED.COLS, CHUNKS=C,
+                ROWS=24 // groups, num_warps=4, enable_fp_fusion=False,
+            )  # fmt: skip
+            torch.cuda.synchronize()
+            SF.compare(failures, f"readback dots M{tokens} g{groups}", d0, d1)
+            SF.compare(failures, f"readback squares M{tokens} g{groups}", s0, s1)
+            n += 1
+    report["readback_checks"] = n
+
+
+def check_prefill(failures, report, sizes):
+    """Above 6 tokens the knob changes nothing: same kernels, no fork."""
+    n = 0
+    for tokens in sizes:
+        x = SF.transition_inputs(tokens, True, 6000 + tokens)
+        args = (x["post"], x["comb"], x["collapse_pre"], x["fn"], x["scale"], x["base"])
+        with stage(f"prefill M{tokens}"):
+            with knob(False):
+                old_res = x["residual"].clone()
+                old_out, old_mix = _call(old_res, x, *args)
+            FUSED._MS_PENDING.clear()
+            with knob(True):
+                new_res = x["residual"].clone()
+                new_out, new_mix = _call(new_res, x, *args)
+        if any(FUSED._MS_PENDING.values()):
+            failures.append({"check": f"prefill M{tokens} forked a side stream"})
+        torch.cuda.synchronize()
+        SF.compare_transition(
+            failures,
+            f"prefill M{tokens}",
+            (old_res, old_out, old_mix),
+            (new_res, new_out, new_mix),
+        )
+        n += 1
+        del x, old_res, new_res, old_out, new_out
+    report["prefill_checks"] = n
+
+
+def _dot_graph(path):
+    """(node id -> label, list of edges) from a cudaGraphDebugDotPrint file."""
+    import re
+
+    text = Path(path).read_text()
+    # A node's text runs from its definition to the next one (labels may
+    # span lines); edge lines ("a" -> "b") never start a definition.
+    starts = list(re.finditer(r'^\s*"?(\w+)"?\s*\[', text, re.M))
+    labels = {}
+    for m, nxt in zip(starts, starts[1:] + [None]):
+        labels[m.group(1)] = text[m.end() : nxt.start() if nxt else len(text)]
+    edges = re.findall(r'"?(\w+)"?\s*->\s*"?(\w+)"?', text)
+    return labels, edges
+
+
+def check_topology(failures, report, layers, dump_dir):
+    """Each graph size 1..6: every _mix_parts depends on a finish3, every
+    _mix_finish (but the chain's last) feeds the next transition's parts3,
+    and no sublayer kernel waits on a mix kernel (a real fork/join)."""
+    out = {}
+    Path(dump_dir).mkdir(parents=True, exist_ok=True)
+    for tokens in range(1, 7):
+        for on in (False, True):
+            chain = Chain(tokens, layers, "gemv", 900 + tokens)
+            with stage(f"topology M{tokens} on={on}"), knob(on):
+                chain.run()
+                torch.cuda.synchronize()
+                graph = torch.cuda.CUDAGraph()
+                graph.enable_debug_mode()
+                with torch.cuda.graph(graph):
+                    chain.run()
+            path = Path(dump_dir) / f"chain_M{tokens}_{'side' if on else 'prod'}.dot"
+            graph.debug_dump(str(path))
+            del graph
+            labels, edges = _dot_graph(path)
+
+            def kind(node):
+                label = labels.get(node, "")
+                for name in (
+                    "_mix_parts",
+                    "_mix_finish",
+                    "_transition_parts3",
+                    "_transition_finish3",
+                ):
+                    if name in label:
+                        return name
+                return "other"
+
+            preds, succs = {}, {}
+            for a, b in edges:
+                succs.setdefault(a, []).append(b)
+                preds.setdefault(b, []).append(a)
+            mp = [v for v in labels if kind(v) == "_mix_parts"]
+            mf = [v for v in labels if kind(v) == "_mix_finish"]
+            fork_ok = all(
+                any(kind(u) == "_transition_finish3" for u in preds.get(v, []))
+                for v in mp
+            )
+            join = sum(
+                any(kind(w) == "_transition_parts3" for w in succs.get(v, []))
+                for v in mf
+            )
+            leaks = sum(
+                1
+                for v in mp + mf
+                for w in succs.get(v, [])
+                if kind(w) not in ("_mix_finish", "_transition_parts3")
+            )
+            row = {
+                "nodes": len(labels),
+                "mix_parts": len(mp),
+                "mix_finish": len(mf),
+                "forks_from_finish3": fork_ok,
+                "joins_into_next_parts3": join,
+                "mix_edges_into_other_kernels": leaks,
+            }
+            out[f"M={tokens} {'side' if on else 'prod'}"] = row
+            want = layers if on else 0
+            bad = len(mp) != want or len(mf) != want or leaks
+            if on:
+                bad = bad or not fork_ok or join != layers - 1
+            if bad:
+                failures.append({"check": f"topology M{tokens} on={on}", **row})
+    report["graph_topology"] = out
+
+
+# ------------------------------------------------------------- 2. chains --
+
+
+class Chain:
+    """layers transitions, each followed by a stand-in sublayer."""
+
+    def __init__(self, tokens, layers, standin, seed):
+        g = SF._gen(seed)
+        self.x = SF.transition_inputs(tokens, True, seed)
+        self.res0 = self.x["residual"].clone()
+        self.residual = self.res0.clone()
+        self.fns = [
+            (
+                torch.randn(24, 4 * H, device=DEV, generator=g) * 0.02,
+                0.5 + torch.rand(3, device=DEV, generator=g),
+                0.5 * torch.randn(24, device=DEV, generator=g),
+            )
+            for _ in range(layers)
+        ]
+        self.standin = standin
+        if standin == "gemv":
+            self.w1 = (torch.randn(H, 2048, device=DEV, generator=g) / H**0.5).half()
+            self.w2 = (torch.randn(2048, H, device=DEV, generator=g) / 2048**0.5).half()
+
+    def sublayer(self, out):
+        if self.standin == "gemv":
+            return (out @ self.w1) @ self.w2
+        if self.standin == "small":
+            y = out
+            for _ in range(10):
+                y = y * 0.999
+            return y
+        return out
+
+    def run(self):
+        """One forward: copy the residual in, then the transitions."""
+        self.residual.copy_(self.res0)
+        x = dict(self.x)
+        post, comb, pre = x["post"], x["comb"], x["collapse_pre"]
+        outs = []
+        for fn, scale, base in self.fns:
+            out, (pre, post, comb) = _call(
+                self.residual, x, post, comb, pre, fn, scale, base
+            )
+            outs.append(out)
+            x["y"] = self.sublayer(out)
+        FUSED.mix_join(self.residual.device)
+        return outs, self.residual, (pre, post, comb)
+
+
+def _flatten(result):
+    outs, residual, mixes = result
+    return list(outs) + [residual] + list(mixes)
+
+
+def check_chains(failures, report, layers):
+    n = 0
+    graphs = []
+    for tokens in range(1, 7):
+        for standin in ("gemv", "small"):
+            name = f"chain M{tokens} {standin}"
+            chain = Chain(tokens, layers, standin, 500 + tokens)
+            with stage(f"{name} eager prod"), knob(False):
+                old = [t.clone() for t in _flatten(chain.run())]
+            with stage(f"{name} eager side"), knob(True):
+                new = [t.clone() for t in _flatten(chain.run())]
+            torch.cuda.synchronize()
+            for i, (a, b) in enumerate(zip(old, new)):
+                SF.compare(failures, f"chain eager M{tokens} {standin} #{i}", a, b)
+            with stage(f"{name} capture"), knob(True):
+                chain.run()  # warm
+                torch.cuda.synchronize()
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph):
+                    result = chain.run()
+            # Keep the chain: the graph holds raw pointers to its weights and
+            # inputs (fns, res0, x, w1/w2). Dropping it let the next capture's
+            # empty_cache() return them to the driver, and the replays below
+            # read unmapped memory (D33: illegal memory access at replay).
+            graphs.append((tokens, standin, graph, result, old, chain))
+            n += 1
+    # Replay interleaved across M (shared side stream), twice each.
+    for rnd in range(2):
+        for tokens, standin, graph, result, old, _chain in graphs:
+            with stage(f"chain M{tokens} {standin} replay {rnd}"):
+                graph.replay()
+            torch.cuda.synchronize()
+            for i, (a, b) in enumerate(zip(old, _flatten(result))):
+                SF.compare(failures, f"chain graph M{tokens} {standin} #{i}", a, b)
+    report["chain_checks"] = n
+    del graphs
+
+
+# ------------------------------------------------------------- 3. timing --
+
+
+def chain_us(chain, on, trials):
+    with knob(on):
+        chain.run()
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            chain.run()
+    graph.replay()
+    torch.cuda.synchronize()
+    times = []
+    for _ in range(trials):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(10):
+            graph.replay()
+        end.record()
+        end.synchronize()
+        times.append(start.elapsed_time(end) * 1000.0 / 10)
+    del graph
+    return statistics.median(times)
+
+
+def timing(report, tokens_list, layers, trials, round_transitions):
+    out = {}
+    for standin in ("gemv", "small", "none"):
+        rows = {}
+        for tokens in tokens_list:
+            chain = Chain(tokens, layers, standin, 800 + tokens)
+            # ABBA order per M.
+            if _BLOCKING:
+                print(
+                    f"mix_stream_check: timing M{tokens} {standin}",
+                    file=sys.stderr,
+                    flush=True,
+                )
+            a1 = chain_us(chain, False, trials)
+            b1 = chain_us(chain, True, trials)
+            b2 = chain_us(chain, True, trials)
+            a2 = chain_us(chain, False, trials)
+            old, new = (a1 + a2) / 2, (b1 + b2) / 2
+            saved = (old - new) / layers
+            rows[f"M={tokens}"] = {
+                "prod_chain_us": round(old, 2),
+                "new_chain_us": round(new, 2),
+                "saved_us_per_transition": round(saved, 2),
+                "round_saving_ms_est": round(saved * round_transitions / 1000, 3),
+            }
+            del chain
+        out[standin] = rows
+    report["timing"] = out
+    report["timing_note"] = (
+        f"CUDA graph of one {layers}-transition chain (residual copy-in + "
+        "transition + stand-in sublayer per layer), median of "
+        f"{trials} x 10 replays, ABBA; round = saved x {round_transitions}"
+    )
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--device", type=int, default=0)
+    ap.add_argument("--check-layers", type=int, default=8)
+    ap.add_argument("--layers", type=int, default=40)
+    ap.add_argument("--time-tokens", default="1,6")
+    ap.add_argument("--trials", type=int, default=7)
+    ap.add_argument("--round-transitions", type=int, default=76)
+    ap.add_argument("--skip-timing", action="store_true")
+    ap.add_argument("--prefill-tokens", default="7,8,64,2048,8192")
+    ap.add_argument("--dump-dir", default="/tmp/mix_stream_graphs")
+    ap.add_argument("--json", default=None)
+    ap.add_argument(
+        "--checks",
+        default="single,chains,readback,prefill,topology",
+        help="comma list of the bitwise checks to run",
+    )
+    ap.add_argument(
+        "--blocking",
+        action="store_true",
+        help="CUDA_LAUNCH_BLOCKING=1 + sync and print after every step",
+    )
+    args = ap.parse_args()
+    checks = set(args.checks.split(","))
+    unknown = checks - {"single", "chains", "readback", "prefill", "topology"}
+    if unknown:
+        raise SystemExit(f"unknown --checks {sorted(unknown)}")
+    torch.cuda.set_device(args.device)
+    report = {
+        "device": torch.cuda.get_device_name(),
+        "capability": list(torch.cuda.get_device_capability()),
+        "torch": torch.__version__,
+        "triton": SF._loader.triton.__version__,
+        "hc_v3_groups": FUSED._V3_GROUPS,
+        "mix_stream_groups": FUSED._MS_GROUPS,
+    }
+    if not FUSED._V3:
+        raise SystemExit("VLLM_V41_HC_V3 must be 1 (the deployed transition)")
+    failures = []
+    report["checks"] = sorted(checks)
+    report["blocking"] = _BLOCKING
+    if "single" in checks:
+        check_single(failures, report)
+    if "chains" in checks:
+        check_chains(failures, report, args.check_layers)
+    if "readback" in checks:
+        check_readback(failures, report)
+    if "prefill" in checks:
+        sizes = [int(t) for t in args.prefill_tokens.split(",")]
+        check_prefill(failures, report, sizes)
+    if "topology" in checks:
+        check_topology(failures, report, args.check_layers, args.dump_dir)
+    report["mismatches"] = len(failures)
+    report["failures"] = failures[:40]
+    if not args.skip_timing:
+        timing(
+            report,
+            [int(t) for t in args.time_tokens.split(",")],
+            args.layers,
+            args.trials,
+            args.round_transitions,
+        )
+    report["ok"] = not failures
+    text = json.dumps(report, indent=1)
+    print(text)
+    if args.json:
+        Path(args.json).write_text(text)
+    return 0 if not failures else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
