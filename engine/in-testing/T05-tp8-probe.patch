diff --git a/benchmarks/deepseek_v41/tp8probe/ar_probe.py b/benchmarks/deepseek_v41/tp8probe/ar_probe.py
new file mode 100644
index 000000000..41a2fd688
--- /dev/null
+++ b/benchmarks/deepseek_v41/tp8probe/ar_probe.py
@@ -0,0 +1,436 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103 step b: all-reduce latency on the 8 board GPUs, CUDA-graph timed.
+
+Eight processes (rank r = visible device r; ranks 0-3 Board B, 4-7 Board C),
+the deployed engine's own collectives driven standalone (as vLLM's
+benchmarks/kernels/benchmark_device_communicators.py does): CustomAllreduce on
+gloo groups, PyNcclCommunicator. Groups (--group) run as separate processes so
+a hang in one (1Cat #1224: TP8 hang across two NVLink islands) loses only it:
+
+  ca    ca4        today's TP4 custom push AR inside each board, both boards
+                   at once (the PP2 baseline, comparable to PROF1103b 7-10 us)
+        ca2x       2-rank custom AR across boards, pairs (i, i+4) all at once
+        ca2x_q     the same at a quarter payload (the cross step of a
+                   reduce-scatter -> cross exchange -> all-gather scheme)
+        two_level  ca4 then ca2x in one graph = (B0+..+B3) + (C0+..+C3) on all
+                   8 ranks (an 8-way AR built from today's kernels)
+  nccl  nccl8      NCCL all-reduce over all 8
+        nccl4      NCCL inside each board (reference)
+        nccl2x     NCCL across boards, pairs (i, i+4)
+        two_level_nccl  ca4 then nccl2x
+  hier  hier8      the in-tree SM70 TP8 hierarchical push AR (env
+                   VLLM_SM70_TP8_HIERARCHICAL_CUSTOM_AR=1, _PUSH_AR=1); it
+                   admits exactly 8 KiB and 64 KiB fp16, so those two sizes
+
+Payloads: M x 5120 fp16, M = 1..6 (10,240..61,440 B; M6 = DSpark-5 verify),
+plus M12 (122,880 B = "120 KiB"); hier8 at 4,096 / 32,768 elements.
+
+Timing: per (variant, size) two graphs of N1=40 and N2=200 back-to-back
+collectives; us/op = (t(N2) - t(N1)) / (N2 - N1) per replay, which removes
+the launch and the cross-rank start skew; median and p90 over replays per
+rank, and the slowest rank is reported. Mode "spin": every collective follows
+a ~20 us spin kernel (decode-like spacing); the spin-only graph is
+subtracted. Correctness: an eager collective of (rank+1) x base is compared
+with the expected sum before timing.
+
+  python ar_probe.py --group ca --out ar-ca.json [--watchdog 400]
+"""
+
+import argparse
+import json
+import os
+import socket
+import sys
+import time
+import traceback
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C  # noqa: E402
+
+N1, N2 = 40, 200
+TRIALS = 15
+SPIN_CYCLES = 28_000  # ~20 us at 1.4 GHz
+MS = [1, 2, 3, 4, 5, 6, 12]
+SPIN_MS = [6]
+
+
+def _free_port():
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+    s.close()
+    return port
+
+
+# --------------------------------------------------------------------------
+# worker
+
+
+def worker(rank, world, group_name, port, outdir, sel, wd_seconds):
+    import faulthandler
+    from datetime import timedelta
+
+    trace = open(os.path.join(outdir, f"ar-{group_name}-rank{rank}.stacks.txt"), "w")
+    faulthandler.dump_traceback_later(max(10.0, wd_seconds - 15), exit=False, file=trace)
+    res = {"rank": rank, "status": "running", "results": {}, "notes": []}
+    path = os.path.join(outdir, f"ar-{group_name}-rank{rank}.json")
+    try:
+        import torch
+        import torch.distributed as dist
+
+        torch.cuda.set_device(rank)
+        got = str(torch.cuda.get_device_properties(rank).uuid)
+        got = got if got.startswith("GPU-") else "GPU-" + got
+        if got.lower() != sel["uuids"][rank].lower():
+            res["status"] = "precondition"
+            res["error"] = f"rank {rank} device is {C.mask(got)}"
+            C.write_json(path, res)
+            return
+        dist.init_process_group(
+            "gloo",
+            init_method=f"tcp://127.0.0.1:{port}",
+            rank=rank,
+            world_size=world,
+            timeout=timedelta(seconds=120),
+        )
+        half = world // 2
+        boards = [list(range(0, half)), list(range(half, world))]
+        pairs = [[i, i + half] for i in range(half)]
+        g_world = dist.new_group(list(range(world)), backend="gloo")
+        g_board = [dist.new_group(b, backend="gloo") for b in boards]
+        g_pair = [dist.new_group(p, backend="gloo") for p in pairs]
+        my_board = g_board[0 if rank < half else 1]
+        my_pair = g_pair[rank % half]
+        my_board_ranks = boards[0 if rank < half else 1]
+        my_pair_ranks = pairs[rank % half]
+
+        from vllm.distributed.device_communicators.custom_all_reduce import (
+            CustomAllreduce,
+        )
+        from vllm.distributed.device_communicators.pynccl import (
+            PyNcclCommunicator,
+        )
+
+        dev = torch.device(f"cuda:{rank}")
+        stream = torch.cuda.Stream(device=dev)
+
+        def barrier():
+            dist.barrier(group=g_world)
+
+        def build_comms():
+            comms = {}
+            if group_name == "ca":
+                comms["ca4"] = CustomAllreduce(group=my_board, device=dev)
+                comms["ca2x"] = CustomAllreduce(group=my_pair, device=dev)
+            elif group_name == "nccl":
+                comms["ca4"] = CustomAllreduce(group=my_board, device=dev)
+                comms["nccl8"] = PyNcclCommunicator(group=g_world, device=dev)
+                comms["nccl4"] = PyNcclCommunicator(group=my_board, device=dev)
+                comms["nccl2x"] = PyNcclCommunicator(group=my_pair, device=dev)
+            elif group_name == "hier":
+                comms["hier8"] = CustomAllreduce(group=g_world, device=dev)
+            for k, c in comms.items():
+                if isinstance(c, CustomAllreduce):
+                    res["notes"].append(
+                        f"{k}: disabled={c.disabled}"
+                        + (
+                            f" fully_connected={c.fully_connected}"
+                            f" tp8_hierarchical={getattr(c, 'tp8_hierarchical', None)}"
+                            f" tp4_push={c.sm70_tp4_push_buffer_ptrs is not None}"
+                            f" tp8_push={c.sm70_tp8_hierarchical_push_buffer_ptrs is not None}"
+                            if not c.disabled
+                            else ""
+                        )
+                    )
+                else:
+                    res["notes"].append(f"{k}: disabled={c.disabled}")
+            return comms
+
+        comms = build_comms()
+        C.write_json(path, res)
+        barrier()
+
+        def ca_fn(c):
+            def f(x):
+                y = c.custom_all_reduce(x)
+                if y is None:
+                    raise RuntimeError("custom all-reduce rejected this payload")
+                return y
+
+            return f
+
+        def nccl_fn(c):
+            return lambda x: c.all_reduce(x)
+
+        variants = {}
+        if group_name == "ca":
+            a, b = comms["ca4"], comms["ca2x"]
+            if not a.disabled:
+                variants["ca4"] = ([a], [ca_fn(a)], my_board_ranks, 1.0)
+            if not b.disabled:
+                variants["ca2x"] = ([b], [ca_fn(b)], my_pair_ranks, 1.0)
+                variants["ca2x_q"] = ([b], [ca_fn(b)], my_pair_ranks, 0.25)
+            if not a.disabled and not b.disabled:
+                variants["two_level"] = ([a, b], [ca_fn(a), ca_fn(b)], list(range(world)), 1.0)
+        elif group_name == "nccl":
+            a = comms["ca4"]
+            for k, ranks in (("nccl8", list(range(world))), ("nccl4", my_board_ranks), ("nccl2x", my_pair_ranks)):
+                if not comms[k].disabled:
+                    variants[k] = ([], [nccl_fn(comms[k])], ranks, 1.0)
+            if not a.disabled and not comms["nccl2x"].disabled:
+                variants["two_level_nccl"] = (
+                    [a],
+                    [ca_fn(a), nccl_fn(comms["nccl2x"])],
+                    list(range(world)),
+                    1.0,
+                )
+        elif group_name == "hier":
+            h = comms["hier8"]
+            if not h.disabled:
+                variants["hier8"] = ([h], [ca_fn(h)], list(range(world)), 1.0)
+        res["variants"] = list(variants)
+
+        def sizes_for(name, scale):
+            if name == "hier8":
+                return [4096, 32768] + [m * C.HIDDEN for m in MS]
+            return [int(m * C.HIDDEN * scale) for m in MS]
+
+        from contextlib import ExitStack
+
+        def chain(fns, x, spin):
+            y = x
+            for f in fns:
+                y = f(y)
+            return y
+
+        def capture(cas, fns, x, count, spin):
+            with ExitStack() as st:
+                for c in cas:
+                    st.enter_context(c.capture())
+                g = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(g, stream=stream):
+                    for _ in range(count):
+                        if spin:
+                            torch.cuda._sleep(SPIN_CYCLES)
+                        if fns:
+                            chain(fns, x, spin)
+            return g
+
+        def replay_times(g):
+            out = []
+            for _ in range(3):
+                g.replay()
+            torch.cuda.synchronize()
+            for _ in range(TRIALS):
+                barrier()
+                a = torch.cuda.Event(enable_timing=True)
+                b = torch.cuda.Event(enable_timing=True)
+                a.record(stream)
+                with torch.cuda.stream(stream):
+                    g.replay()
+                b.record(stream)
+                b.synchronize()
+                out.append(a.elapsed_time(b) * 1000.0)
+            return out
+
+        def slope(cas, fns, x, spin, base_us=None):
+            g1 = capture(cas, fns, x, N1, spin)
+            g2 = capture(cas, fns, x, N2, spin)
+            torch.cuda.synchronize()
+            barrier()
+            t1 = replay_times(g1)
+            t2 = replay_times(g2)
+            per = sorted((b2 - b1) / (N2 - N1) for b1, b2 in zip(sorted(t1), sorted(t2)))
+            st = C.stats(per)
+            st["t1_median_us"] = round(sorted(t1)[len(t1) // 2], 2)
+            st["t2_median_us"] = round(sorted(t2)[len(t2) // 2], 2)
+            del g1, g2
+            return st
+
+        spin_base = None
+        for name, (cas, fns, ranks, scale) in variants.items():
+            res["results"][name] = {}
+            for numel in sizes_for(name, scale):
+                key = str(numel * 2)  # bytes
+                entry = {"bytes": numel * 2, "elements": numel, "group_ranks": ranks}
+                gen = torch.Generator(device=dev).manual_seed(numel)
+                base = (torch.rand(numel, device=dev, generator=gen) * 0.01).half()
+                x = (base * (rank + 1)).contiguous()
+                ok_payload = True
+                for c in cas:
+                    if not c.should_custom_ar(x):
+                        ok_payload = False
+                if not ok_payload:
+                    entry["admitted"] = False
+                    res["results"][name][key] = entry
+                    barrier()
+                    continue
+                entry["admitted"] = True
+                with torch.cuda.stream(stream):
+                    for _ in range(2):
+                        y = chain(fns, x, False)
+                    torch.cuda.synchronize()
+                    want = base.float() * sum(r + 1 for r in ranks)
+                    err = (y.float() - want).abs().max().item()
+                    entry["max_abs_err"] = err
+                    entry["correct"] = bool(err <= 2e-3 * max(1.0, want.abs().max().item()) + 1e-3)
+                barrier()
+                entry["us"] = slope(cas, fns, x, False)
+                m = numel * 2 // (C.HIDDEN * 2) if scale == 1.0 else None
+                if m in SPIN_MS and name != "hier8":
+                    if spin_base is None:
+                        spin_base = slope([], [], x, True)
+                        res["results"]["spin_only"] = {"spin": {"us": spin_base}}
+                    sp = slope(cas, fns, x, True)
+                    entry["spin_us_total"] = sp
+                    entry["spin_us_net"] = round(sp["median"] - spin_base["median"], 3)
+                res["results"][name][key] = entry
+                C.write_json(path, res)
+                barrier()
+        res["status"] = "ok"
+        C.write_json(path, res)
+        barrier()
+        faulthandler.cancel_dump_traceback_later()
+        for c in comms.values():
+            try:
+                if isinstance(c, CustomAllreduce):
+                    c.close()
+            except Exception:
+                pass
+        dist.destroy_process_group()
+    except Exception:
+        res["status"] = "crash"
+        res["error"] = traceback.format_exc()[-4000:]
+        C.write_json(path, res)
+        os._exit(C.EXIT_CRASH)
+
+
+# --------------------------------------------------------------------------
+# parent
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--group", choices=("ca", "nccl", "hier"), required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--watchdog", type=float, default=400)
+    args = ap.parse_args()
+    outdir = os.path.dirname(os.path.abspath(args.out))
+    report = {"step": f"ar-{args.group}", "start": C.now(), "status": "running"}
+    sel_json = os.environ.get("TP8PROBE_SELECTION")
+    try:
+        sel = json.loads(sel_json) if sel_json else C.resolve()
+    except SystemExit as e:
+        report.update(status="precondition", error=str(e))
+        C.write_json(args.out, report)
+        return C.EXIT_PRE
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != sel["cuda_visible_devices"]:
+        report.update(status="precondition", error="CUDA_VISIBLE_DEVICES differs from the selection")
+        C.write_json(args.out, report)
+        return C.EXIT_PRE
+    report["layout"] = C.public_layout(sel)
+    os.environ.setdefault("VLLM_SKIP_P2P_CHECK", "1")
+    os.environ["VLLM_ALLREDUCE_USE_SYMM_MEM"] = "0"
+    os.environ.setdefault("NCCL_DEBUG", "WARN")
+    if args.group == "hier":
+        os.environ["VLLM_SM70_TP8_HIERARCHICAL_CUSTOM_AR"] = "1"
+        os.environ["VLLM_SM70_TP8_HIERARCHICAL_PUSH_AR"] = "1"
+    report["env"] = {
+        k: os.environ[k]
+        for k in sorted(os.environ)
+        if k.startswith(("VLLM_SM70_", "VLLM_SKIP_P2P", "NCCL_", "VLLM_ALLREDUCE"))
+    }
+    import multiprocessing as mp
+
+    ctx = mp.get_context("spawn")
+    world = 8
+    port = _free_port()
+    procs = []
+    for r in range(world):
+        p = ctx.Process(
+            target=worker,
+            args=(r, world, args.group, port, outdir, sel, args.watchdog),
+            daemon=False,
+        )
+        p.start()
+        procs.append(p)
+    deadline = time.time() + args.watchdog
+    for p in procs:
+        p.join(timeout=max(0.0, deadline - time.time()))
+    hung = [i for i, p in enumerate(procs) if p.is_alive()]
+    if hung:
+        C.log(f"ar-{args.group}: watchdog, ranks still running {hung}; terminating")
+        for p in procs:
+            if p.is_alive():
+                p.terminate()
+        for p in procs:
+            p.join(timeout=10)
+        for p in procs:
+            if p.is_alive():
+                p.kill()
+    ranks = []
+    for r in range(world):
+        path = os.path.join(outdir, f"ar-{args.group}-rank{r}.json")
+        try:
+            ranks.append(json.load(open(path)))
+        except Exception:
+            ranks.append({"rank": r, "status": "missing"})
+    report["rank_status"] = [x.get("status") for x in ranks]
+    report["exitcodes"] = [p.exitcode for p in procs]
+    report["notes_rank0"] = ranks[0].get("notes", [])
+    report["notes_rank4"] = ranks[4].get("notes", []) if len(ranks) > 4 else []
+    errors = {r: x["error"] for r, x in enumerate(ranks) if x.get("error")}
+    if errors:
+        report["errors"] = errors
+    # merge: slowest rank's median per (variant, size)
+    merged = {}
+    correct = True
+    for x in ranks:
+        for name, sizes in x.get("results", {}).items():
+            for key, e in sizes.items():
+                m = merged.setdefault(name, {}).setdefault(key, {"per_rank_median": {}, "per_rank_p90": {}})
+                for f in ("bytes", "elements", "admitted"):
+                    if f in e:
+                        m[f] = e[f]
+                if "us" in e:
+                    st = e["us"]
+                    m["per_rank_median"][x["rank"]] = st.get("median")
+                    m["per_rank_p90"][x["rank"]] = st.get("p90")
+                if "spin_us_net" in e:
+                    m.setdefault("spin_net_per_rank", {})[x["rank"]] = e["spin_us_net"]
+                if "correct" in e:
+                    m.setdefault("correct_per_rank", {})[x["rank"]] = e["correct"]
+                    correct = correct and e["correct"]
+    for name, sizes in merged.items():
+        for key, m in sizes.items():
+            meds = [v for v in m["per_rank_median"].values() if v is not None]
+            p90s = [v for v in m["per_rank_p90"].values() if v is not None]
+            if meds:
+                m["us_median_slowest_rank"] = max(meds)
+                m["us_p90_slowest_rank"] = max(p90s) if p90s else None
+            if m.get("spin_net_per_rank"):
+                m["spin_net_us_slowest_rank"] = max(m["spin_net_per_rank"].values())
+    report["results"] = merged
+    report["all_correct"] = correct
+    report["end"] = C.now()
+    if hung:
+        report["status"] = "hang"
+        report["hung_ranks"] = hung
+        C.write_json(args.out, report)
+        return C.EXIT_HANG
+    if any(s == "precondition" for s in report["rank_status"]):
+        report["status"] = "precondition"
+        C.write_json(args.out, report)
+        return C.EXIT_PRE
+    if any(s != "ok" for s in report["rank_status"]):
+        report["status"] = "crash"
+        C.write_json(args.out, report)
+        return C.EXIT_CRASH
+    report["status"] = "ok"
+    C.write_json(args.out, report)
+    return C.EXIT_OK if correct else C.EXIT_CHECK
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/benchmarks/deepseek_v41/tp8probe/common.py b/benchmarks/deepseek_v41/tp8probe/common.py
