+#!/usr/bin/env bash
+# TP8PROBE1103: the whole GPU window in one command (server DOWN, the 8-GPU host).
+#
+#   bash benchmarks/deepseek_v41/tp8probe/window.sh [OUT_DIR]
+#
+# Steps (each under run_step.py with a hard timeout; a hang = exit 3, the
+# window continues with the next step):
+#   preflight  refuse (exit 2) if :18042 or :8000 is listening or any process
+#              other than nvidia-persistenced holds one of the 8 board GPUs
+#   p2p        P2P matrix, copy-engine latency/bandwidth, concurrency  180 s
+#   kernels    TP8 vs TP4 half-width kernels on one GPU                480 s
+#   ar-ca      custom AR: ca4, ca2x, ca2x_q, two_level                 300 s
+#   ar-hier    in-tree SM70 TP8 hierarchical push AR                   180 s
+#   ar-nccl    NCCL 8 / 4 / 2x, two_level_nccl (last: #1224 hang risk) 240 s
+#   model      tp8_model.py on the JSONs -> model.json, GO / NO-GO      30 s
+# Worst case 1410 s (23.5 min) plus preflight; expected 8-12 min.
+# Uses the deployed engine read-only (venv python, src-pp2, v41k.so); writes
+# only OUT_DIR (default /path/to/out).
+# Exit: 0 all steps ok, 1 some step failed a check / crashed, 2 preflight,
+# 3 some step hung (watchdog).
+set -u
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ENGINE=${ENGINE_HOME}
+PY="$ENGINE/.venv-pp2/bin/python"
+TS="$(date -u +%Y%m%dT%H%M%SZ)"
+OUT="${1:-/path/to/out"
+mkdir -p "$OUT/cache" || exit 2
+cd "$OUT" || exit 2
+
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+export PYTHONPATH="$ENGINE/.venv-pp2/lib/python3.12/site-packages:$ENGINE/src-pp2"
+export XDG_CACHE_HOME="$OUT/cache" XDG_CONFIG_HOME="$OUT/cache/config"
+export TRITON_CACHE_DIR="$OUT/cache/triton" FLASHINFER_WORKSPACE_BASE="$OUT/cache"
+export VLLM_NO_USAGE_STATS=1 OMP_NUM_THREADS=1 PYTHONUNBUFFERED=1
+export VLLM_V41K_LIB="$ENGINE/src-pp2/benchmarks/deepseek_v41/v41k/build/v41k.so"
+unset VLLM_SM70_TP8_HIERARCHICAL_CUSTOM_AR VLLM_SM70_TP8_HIERARCHICAL_PUSH_AR
+
+# --- preflight -------------------------------------------------------------
+"$PY" - "$HERE" "$OUT" <<'EOF'
+import json, os, sys
+sys.path.insert(0, sys.argv[1])
+import common as C
+
+out = sys.argv[2]
+pre = {"step": "preflight", "time": C.now()}
+
+def listening(port):
+    for path in ("/proc/net/tcp", "/proc/net/tcp6"):
+        try:
+            rows = open(path).read().splitlines()[1:]
+        except OSError:
+            continue
+        for row in rows:
+            f = row.split()
+            if f[3] == "0A" and int(f[1].rsplit(":", 1)[1], 16) == port:
+                return True
+    return False
+
+try:
+    sel = C.resolve("deployed")
+except SystemExit as e:
+    pre["error"] = str(e)
+    C.write_json(os.path.join(out, "preflight.json"), pre)
+    sys.exit(2)
+pre["layout"] = C.public_layout(sel)
+pre["listening"] = {p: listening(p) for p in (18042, 8000)}
+holders = [h for h in C.gpu_holders(sel["minor"]) if not h["comm"].startswith("nvidia-persist")]
+pre["gpu_holders"] = holders
+bad = [f"port {p} listening" for p, v in pre["listening"].items() if v]
+if holders and os.environ.get("TP8PROBE_ALLOW_HOLDERS") != "1":
+    bad.append(f"GPU holders {[(h['pid'], h['comm']) for h in holders]}")
+pre["refused"] = bad
+C.write_json(os.path.join(out, "preflight.json"), pre)
+if bad:
+    print("preflight: REFUSED: " + "; ".join(bad), file=sys.stderr)
+    sys.exit(2)
+fd = os.open(os.path.join(out, ".selection"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+with os.fdopen(fd, "w") as fh:
+    json.dump(sel, fh)
+print("preflight: ok, " + " ".join(f"{l['rank']}:{l['board']}{l['pci_bus_id_index']}" for l in pre["layout"]))
+EOF
+[ $? -eq 0 ] || { echo "window: preflight refused, see $OUT/preflight.json" >&2; exit 2; }
+SEL="$OUT/.selection"
+export TP8PROBE_SELECTION="$(cat "$SEL")"
+export CUDA_VISIBLE_DEVICES="$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1]))["cuda_visible_devices"])' "$SEL")"
+rm -f "$SEL"   # full UUIDs live only in this process's environment
+
+step() {  # name timeout cmd...
+  local name=$1 t=$2; shift 2
+  "$PY" "$HERE/run_step.py" --name "$name" --timeout "$t" --dir "$OUT" -- "$@"
+}
+T_START=$(date +%s)
+step p2p 180 "$PY" "$HERE/p2p_probe.py" --out "$OUT/p2p.json" --watchdog 160
+step kernels 480 "$PY" "$HERE/kernel_scale.py" --out "$OUT/kernels.json" --watchdog 450
+step ar-ca 300 "$PY" "$HERE/ar_probe.py" --group ca --out "$OUT/ar-ca.json" --watchdog 270
+step ar-hier 180 "$PY" "$HERE/ar_probe.py" --group hier --out "$OUT/ar-hier.json" --watchdog 150
+step ar-nccl 240 "$PY" "$HERE/ar_probe.py" --group nccl --out "$OUT/ar-nccl.json" --watchdog 210
+step model 30 "$PY" "$HERE/tp8_model.py" --dir "$OUT" --out "$OUT/model.json"
+echo "window: $(( $(date +%s) - T_START )) s"
+
+"$PY" - "$OUT" <<'EOF'
+import glob, json, os, sys
+out = sys.argv[1]
+codes = {}
+for p in sorted(glob.glob(os.path.join(out, "*.status.json"))):
+    s = json.load(open(p))
+    codes[s["name"]] = s["exit"]
+print("exit codes:", codes)
+try:
+    v = json.load(open(os.path.join(out, "model.json")))["verdict"]
+    print("verdict:", json.dumps(v))
+except Exception as e:
+    print("verdict: unavailable", e)
+probe = [c for n, c in codes.items() if n != "model"]
+sys.exit(3 if 3 in probe else (1 if any(probe) else 0))
+EOF
+RC=$?
+ls -la "$OUT"
+exit $RC
