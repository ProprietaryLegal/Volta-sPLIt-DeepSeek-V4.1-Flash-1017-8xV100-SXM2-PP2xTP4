index 000000000..48f0df4bb
--- /dev/null
+++ b/benchmarks/deepseek_v41/tp8probe/kernel_scale.py
@@ -0,0 +1,351 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103 step c: half-width kernel scaling on one GPU (TP4 vs TP8 shapes).
+
+One GPU (visible device 0 = Board B's first GPU), the deployed v41k.so
+(--lib / VLLM_V41K_LIB, read-only), synthetic weights, CUDA-graph timing with
+cold weights (rotating copies larger than the 6 MB L2), M = 1..6.
+
+dense    v41k.dmv13_x per role at the deployed TP4 per-rank shapes and at the
+         TP8 per-rank shapes (q_b N 8192->4096, wo_a 2->1 O groups, wo_b K
+         2048->1024, shared 576->288 rows, head 32320->16160, engram
+         6400->3200; qkv is replicated and stays). (warps, split) from
+         dense_tm.default_config at VLLM_V41_DMV_CTAS=80, as deployed.
+experts  gate_up_fast (after q8_plan) and down_rows_fast, gtypes 29/16/17, on
+         eight layers with disjoint expert slices (cold), three route mixes:
+           k6   6 routes per row, today's TP4 rank work;
+           k3   3 live routes per row (3 dropped): half the experts, i.e. the
+                bytes and CTAs of a TP8 rank (288-row gate/up, 640-row down)
+                and of a balanced expert-parallel board;
+           ep2  routes whose expert lives on the other board (a random half
+                of the 384) dropped: EP2 x TP4 with its natural imbalance.
+         The v41k expert kernels hard-code 576 gate/up rows and 1280 down rows
+         per rank, so a true TP8 carrier cannot run without a rebuild; k3 is
+         the proxy (same bytes, same CTA count).
+attn     the per-token attention bmm pair at 16 heads (TP4) vs 8 (TP8):
+         [M,h,512] x [M,512,640] -> softmax -> [M,h,640] x [M,640,512], fp16.
+
+  python kernel_scale.py --out kernels.json [--lib v41k.so] [--watchdog 500]
+"""
+
+import argparse
+import math
+import os
+import statistics
+import sys
+import traceback
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.dirname(HERE))  # benchmarks/deepseek_v41
+import common as C  # noqa: E402
+
+Q5K, Q8 = 1, 4
+# role -> (format, K, segment widths, x offsets, config widths); per rank.
+DENSE = {
+    "tp4": {
+        "qkv": (Q8, 5120, [1280, 512], None, None),
+        "q_b": (Q5K, 1280, [8192], None, None),
+        "wo_a": (Q5K, 4096, [1024, 1024], [0, 4096], [1024]),
+        "wo_b": (Q5K, 2048, [5120], None, None),
+        "shared": (Q5K, 5120, [576, 576], None, None),
+        "engram": (Q5K, 6144, [6400], None, None),
+        "head": (Q5K, 5120, [32320], None, None),
+    },
+    "tp8": {
+        "qkv": (Q8, 5120, [1280, 512], None, None),
+        "q_b": (Q5K, 1280, [4096], None, None),
+        "wo_a": (Q5K, 4096, [1024], [0], [1024]),
+        "wo_b": (Q5K, 1024, [5120], None, None),
+        "shared": (Q5K, 5120, [288, 288], None, None),
+        "engram": (Q5K, 6144, [3200], None, None),
+        "head": (Q5K, 5120, [16160], None, None),
+    },
+}
+# PROF1103b production medians (us/call, stage 1) for the TP4 sanity column.
+PROD_US = {"qkv": 26.2, "q_b": 21.1, "wo_a": 19.1, "wo_b": 18.1, "shared": 12.3,
+           "engram": 48.6, "head": 167.1}  # fmt: skip
+
+
+def default_config(k, widths, target=80):
+    """dense_tm.default_config (VLLM_V41_DMV_CTAS=80): (warps, split)."""
+    tiles = sum((w + 31) // 32 for w in widths)
+    groups = (k // 32 + 3) // 4
+    split = max(1, min(8, round(target / tiles), groups // 4))
+    split = max(c for c in (1, 2, 3, 4, 6, 8) if c <= split)
+    return (8, split) if split > 1 else (4, 1)
+
+
+def time_graph(torch, fn, reps, iters=15):
+    """us per call: median over iters of one graph of `reps` calls."""
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for r in range(min(reps, 4)):
+            fn(r)
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for r in range(reps):
+            fn(r)
+    graph.replay()
+    torch.cuda.synchronize()
+    times = []
+    for _ in range(iters):
+        a = torch.cuda.Event(enable_timing=True)
+        b = torch.cuda.Event(enable_timing=True)
+        a.record()
+        graph.replay()
+        b.record()
+        b.synchronize()
+        times.append(a.elapsed_time(b) * 1000.0 / reps)
+    del graph
+    return {"median": round(statistics.median(times), 3), "min": round(min(times), 3)}
+
+
+def dense_part(torch, args, gen, report):
+    def planes(fmt, n, k):
+        tiles, groups = n // 32, k // 128
+        cw = 2 if fmt == Q8 else 1
+
+        def rb(count):
+            return torch.randint(0, 256, (count,), dtype=torch.uint8, device="cuda", generator=gen)
+
+        codes = rb(tiles * groups * 2048 * cw)
+        high = rb(tiles * groups * 512) if fmt == Q5K else torch.empty(0, dtype=torch.uint8, device="cuda")
+        words = tiles * groups * 128
+        u = torch.rand(words, 2, device="cuda", generator=gen)
+        st = torch.stack([0.002 + 0.018 * u[:, 0], -0.1 * u[:, 1] if fmt == Q5K else 0 * u[:, 1]], 1)
+        return codes, high, st.half().view(torch.uint8).flatten()
+
+    out = {}
+    for tp, roles in DENSE.items():
+        out[tp] = {}
+        for role, (fmt, k, widths, x_off, cfg) in roles.items():
+            x_off = list(x_off) if x_off else [0] * len(widths)
+            warps, split = default_config(k, cfg or widths)
+            tiles = sum(w // 32 for w in widths)
+            one = [planes(fmt, w, k) for w in widths]
+            nbytes = sum(t.numel() for p in one for t in p)
+            count = max(1, math.ceil(args.l2_mb * 2**20 / nbytes))
+            copies = [one] + [[planes(fmt, w, k) for w in widths] for _ in range(count - 1)]
+            copies = [tuple(list(t) for t in zip(*c)) for c in copies]
+            reps = len(copies) * max(1, math.ceil(48 / len(copies)))
+            row = {"bytes": nbytes, "warps": warps, "split": split, "tiles": tiles,
+                   "copies": len(copies), "us": {}, "best_us": {},
+                   "best_cfg": {}}  # fmt: skip
+            xcols = max(o + k for o in x_off)
+            # alternative (warps, split) a TP8 build could pick; split stays
+            # inside default_config's limit groups // 4.
+            limit = ((k // 32 + 3) // 4) // 4
+            cfgs = [(warps, split)] + [
+                c for c in ((4, 1), (8, 2), (8, 4)) if c != (warps, split) and c[1] <= max(1, limit)
+            ]
+            for m in args.m:
+                x = torch.randn(m, xcols, device="cuda", generator=gen).half()
+                outs = [torch.empty(m, w, dtype=torch.half, device="cuda") for w in widths]
+                ws = torch.zeros(tiles * 8 * 256, device="cuda")
+                cnt = torch.zeros(tiles, dtype=torch.int32, device="cuda")
+                times = {}
+                for cw, cs in cfgs:
+
+                    def fn(i, x=x, outs=outs, ws=ws, cnt=cnt, cw=cw, cs=cs):
+                        codes, high, scale = copies[i % len(copies)]
+                        torch.ops.v41k.dmv13_x(x, codes, high, scale, outs, x_off, fmt,
+                                               k, cs, cw, 1, ws, cnt, 0)  # fmt: skip
+
+                    times[f"w{cw}s{cs}"] = time_graph(torch, fn, reps)["median"]
+                row["us"][str(m)] = times[f"w{warps}s{split}"]
+                best = min(times, key=times.get)
+                row["best_us"][str(m)], row["best_cfg"][str(m)] = times[best], best
+            out[tp][role] = row
+            del copies, one
+            torch.cuda.empty_cache()
+            C.log(f"dense {tp} {role}: M6 {row['us'].get(str(max(args.m)))} us")
+    ratios = {}
+    for role in DENSE["tp4"]:
+        ratios[role] = {
+            m: round(out["tp8"][role]["us"][m] / out["tp4"][role]["us"][m], 3)
+            for m in out["tp4"][role]["us"]
+        }
+    best_ratios = {
+        role: {
+            m: round(out["tp8"][role]["best_us"][m] / out["tp4"][role]["us"][m], 3)
+            for m in out["tp4"][role]["us"]
+        }
+        for role in DENSE["tp4"]
+    }
+    report["dense"] = out
+    report["dense_ratio_tp8_over_tp4"] = ratios
+    report["dense_ratio_tp8best_over_tp4deployed"] = best_ratios
+    report["dense_prod_us_tp4_prof1103b"] = PROD_US
+
+
+def expert_part(torch, args, gen, report):
+    import expert_fast_check as E
+
+    dev = torch.device("cuda")
+    E_N, TOPK = E.E, E.TOP_K
+    board_of = torch.randperm(E_N, device=dev, generator=gen) < (E_N // 2)  # True = this board
+
+    def ids_for(m, slice_, mix):
+        ids = E._ids(m, 0, gen, dev, pool_experts=slice_).view(m, TOPK).clone()
+        if mix == "k3":
+            ids[:, 3:] = -1
+        elif mix == "ep2":
+            keep = board_of[ids.long()]
+            rows = []
+            for r in range(m):
+                live = ids[r][keep[r]]
+                pad = torch.full((TOPK - live.numel(),), -1, dtype=ids.dtype, device=dev)
+                rows.append(torch.cat([live, pad]))
+            ids = torch.stack(rows)
+        return ids.flatten().contiguous()
+
+    out = {}
+    for gtype in args.gtypes:
+        bb = E.BLOCK_BYTES[gtype]
+        gate = E._weights(gtype, E.GU_ROWS, E.GU_BLOCKS, gen, dev)
+        up = E._weights(gtype, E.GU_ROWS, E.GU_BLOCKS, gen, dev)
+        down = E._weights(gtype, E.ROWS_LOCAL, E.DN_BLOCKS, gen, dev)
+        obook = torch.ops.v41k.table(gtype, dev)
+        fbook = torch.ops.v41k.fast_table(gtype, dev)
+        res = {"gate_up": {}, "down": {}}
+        for mix in ("k6", "k3", "ep2"):
+            res["gate_up"][mix], res["down"][mix] = {}, {}
+            for m in args.m:
+                slices = torch.randperm(E_N, device=dev, generator=gen).view(E.LAYERS, -1)
+                gu, dn = [], []
+                for layer in range(E.LAYERS):
+                    ids = ids_for(m, slices[layer], mix)
+                    gu.append(E.GuCase(m, gtype, gate, up, obook, fbook, ids, 0.01, True, gen))
+                    x = torch.randn(m, E.N, device=dev, generator=gen).half()
+                    plan = E._plan(m, ids, x, gen, dev)
+                    gathered = E._gathered(m, ids, gen, dev)
+                    dn.append(E.Case(m, gtype, down, None, fbook, plan, gathered, layer % 4))
+                nu = sum(E._nu(c.plan0) for c in gu) / E.LAYERS
+                t_gu = E._graph_us([lambda c=c: c.new() for c in gu], args.reps)
+                t_dn = E._graph_us([lambda c=c: c.new(8) for c in dn], args.reps)
+                res["gate_up"][mix][str(m)] = {
+                    "us": round(t_gu, 3),
+                    "experts": round(nu, 2),
+                    "MB": round(nu * E.GU_ROWS * 2 * E.GU_BLOCKS * bb / 1e6, 3),
+                }
+                res["down"][mix][str(m)] = {
+                    "us": round(t_dn, 3),
+                    "experts": round(nu, 2),
+                    "MB": round(nu * E.ROWS_LOCAL * E.DN_BLOCKS * bb / 1e6, 3),
+                }
+                del gu, dn
+            C.log(f"experts gtype {gtype} {mix}: M6 gate_up {res['gate_up'][mix].get('6')} down {res['down'][mix].get('6')}")
+        ratios = {}
+        for role in ("gate_up", "down"):
+            ratios[role] = {
+                mix: {m: round(res[role][mix][m]["us"] / res[role]["k6"][m]["us"], 3) for m in res[role]["k6"]}
+                for mix in ("k3", "ep2")
+            }
+        res["ratio_over_k6"] = ratios
+        out[str(gtype)] = res
+        del gate, up, down
+        torch.cuda.empty_cache()
+    report["experts"] = out
+
+
+def attention_part(torch, args, gen, report):
+    out = {}
+    keys = 640
+    copies = 8
+    for heads in (16, 8):
+        out[str(heads)] = {}
+        for m in args.m:
+            q = torch.randn(m, heads, 512, device="cuda", generator=gen).half()
+            ks = [torch.randn(m, 512, keys, device="cuda", generator=gen).half() * 0.05 for _ in range(copies)]
+            vs = [torch.randn(m, keys, 512, device="cuda", generator=gen).half() for _ in range(copies)]
+
+            def fn(i, q=q, ks=ks, vs=vs):
+                s = torch.bmm(q, ks[i % copies])
+                p = torch.softmax(s.float(), -1).half()
+                return torch.bmm(p, vs[i % copies])
+
+            out[str(heads)][str(m)] = time_graph(torch, fn, 48)["median"]
+    out["ratio_8_over_16"] = {m: round(out["8"][m] / out["16"][m], 3) for m in out["16"]}
+    report["attention"] = out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--lib", default=os.environ.get("VLLM_V41K_LIB", ""))
+    ap.add_argument("--watchdog", type=float, default=500)
+    ap.add_argument("--m", default="1,2,3,4,5,6")
+    ap.add_argument("--gtypes", default="29,16,17")
+    ap.add_argument("--parts", default="dense,experts,attention")
+    ap.add_argument("--l2-mb", type=float, default=48.0)
+    ap.add_argument("--reps", type=int, default=96)
+    ap.add_argument("--seed", type=int, default=0)
+    args = ap.parse_args()
+    args.m = [int(v) for v in args.m.split(",") if v]
+    args.gtypes = [int(v) for v in args.gtypes.split(",") if v]
+    report = {"step": "kernels", "start": C.now(), "status": "running"}
+
+    def partial(reason):
+        report["status"] = "hang"
+        report["hang_reason"] = reason
+        C.write_json(args.out, report)
+
+    wd = C.Watchdog(args.watchdog, args.out + ".stacks.txt", partial)
+    try:
+        import json
+
+        import torch
+
+        sel_json = os.environ.get("TP8PROBE_SELECTION")
+        sel = json.loads(sel_json) if sel_json else C.resolve()
+        torch.cuda.init()
+        bad = C.check_visible_uuids(sel["uuids"])
+        if bad:
+            report.update(status="precondition", error=bad)
+            C.write_json(args.out, report)
+            return C.EXIT_PRE
+        torch.cuda.set_device(0)
+        report["gpu"] = C.public_layout(sel)[0]
+        if not args.lib or not os.path.exists(args.lib):
+            report.update(status="precondition", error=f"v41k library not found: {args.lib!r}")
+            C.write_json(args.out, report)
+            return C.EXIT_PRE
+        torch.ops.load_library(args.lib)
+        need = ("dmv13_x", "q8_plan", "table", "fast_table", "gate_up_fast", "down_rows_fast")
+        missing = [op for op in need if not hasattr(torch.ops.v41k, op)]
+        if missing:
+            report.update(status="precondition", error=f"v41k lacks {missing}")
+            C.write_json(args.out, report)
+            return C.EXIT_PRE
+        report["lib"] = args.lib
+        gen = torch.Generator(device="cuda").manual_seed(args.seed)
+        parts = args.parts.split(",")
+        if "dense" in parts:
+            dense_part(torch, args, gen, report)
+            C.write_json(args.out, report)
+        if "experts" in parts:
+            expert_part(torch, args, gen, report)
+            C.write_json(args.out, report)
+        if "attention" in parts:
+            attention_part(torch, args, gen, report)
+        report["status"] = "ok"
+        report["end"] = C.now()
+        wd.cancel()
+        C.write_json(args.out, report)
+        return C.EXIT_OK
+    except SystemExit as e:
+        report.update(status="precondition", error=str(e))
+        C.write_json(args.out, report)
+        return C.EXIT_PRE
+    except Exception:
+        report.update(status="crash", error=traceback.format_exc()[-4000:])
+        C.write_json(args.out, report)
+        return C.EXIT_CRASH
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/benchmarks/deepseek_v41/tp8probe/p2p_probe.py b/benchmarks/deepseek_v41/tp8probe/p2p_probe.py
new file mode 100644
index 000000000..9e435cb16
--- /dev/null
+++ b/benchmarks/deepseek_v41/tp8probe/p2p_probe.py
@@ -0,0 +1,272 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103 step a: P2P matrix, latency and bandwidth over the 8 board GPUs.
+
+One process, all 8 GPUs (Board B ranks 0-3, Board C ranks 4-7, see common.py).
+  1. cudaDeviceCanAccessPeer for all 56 ordered pairs; peer access enabled
+     where allowed (copies between other pairs are staged by the driver and
+     flagged).
+  2. Copy-engine P2P (cudaMemcpyPeerAsync) per ordered pair and size:
+     single-copy latency (median of 15, stream pre-blocked by a spin kernel so
+     the CPU issue rate is not measured) and pipelined us/copy (20 back to back).
+     Sizes: 256 B, 15/30/60/120 KiB (M6 decode payload /4, /2, x1, x2), 1 MiB,
+     16 MiB (bandwidth).
+  3. Concurrency: all cross-board pairs at once (i <-> i+4, one and both
+     directions), the rot2 pairing, two GPUs behind one PCIe switch, and an
+     in-board NVLink reference, at 15/60 KiB and 1 MiB.
+  4. Correctness: a 60 KiB pattern copied across every pair is compared.
+
+The copy engine is not what the custom all-reduce kernels use (they store
+over P2P from SMs); ar_probe.py measures those. This step answers "is P2P
+there across boards, and what do latency and bandwidth look like".
+
+  python p2p_probe.py --out p2p.json [--watchdog 200]
+"""
+
+import argparse
+import ctypes
+import os
+import sys
+import traceback
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C  # noqa: E402
+
+SIZES = [256, 15360, 30720, 61440, 122880, 1 << 20, 16 << 20]
+CONC_SIZES = [15360, 61440, 1 << 20]
+SLEEP_CYCLES = 3_000_000  # ~2 ms spin at 1.4-1.5 GHz, longer than the CPU issue
+
+
+def _cudart():
+    for line in open("/proc/self/maps"):
+        if "libcudart" in line:
+            path = line.split()[-1]
+            lib = ctypes.CDLL(path)
+            lib.cudaMemcpyPeerAsync.argtypes = [
+                ctypes.c_void_p,
+                ctypes.c_int,
+                ctypes.c_void_p,
+                ctypes.c_int,
+                ctypes.c_size_t,
+                ctypes.c_void_p,
+            ]
+            lib.cudaDeviceEnablePeerAccess.argtypes = [ctypes.c_int, ctypes.c_uint]
+            lib.cudaSetDevice.argtypes = [ctypes.c_int]
+            return lib, path
+    raise RuntimeError("libcudart is not loaded in this process")
+
+
+def _switch_of(bus: str) -> str:
+    """PCIe switch upstream port above a GPU (two bridges up), from sysfs."""
+    try:
+        real = os.path.realpath(f"/sys/bus/pci/devices/{bus}")
+        parts = real.split("/")
+        return parts[-3]
+    except OSError:
+        return "?"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--watchdog", type=float, default=200)
+    ap.add_argument("--reps", type=int, default=15)
+    args = ap.parse_args()
+    sel_json = os.environ.get("TP8PROBE_SELECTION")
+    report = {"step": "p2p", "start": C.now(), "status": "running"}
+
+    def partial(reason):
+        report["status"] = "hang"
+        report["hang_reason"] = reason
+        C.write_json(args.out, report)
+
+    wd = C.Watchdog(args.watchdog, args.out + ".stacks.txt", partial)
+    try:
+        import json
+
+        sel = json.loads(sel_json) if sel_json else C.resolve()
+        report["layout"] = C.public_layout(sel)
+        switches = [_switch_of(b) for b in sel["bus"]]
+        for r, s in enumerate(switches):
+            report["layout"][r]["pcie_switch_port"] = s
+        import torch
+
+        torch.cuda.init()
+        bad = C.check_visible_uuids(sel["uuids"])
+        if bad:
+            report["status"] = "precondition"
+            report["error"] = bad
+            C.write_json(args.out, report)
+            return C.EXIT_PRE
+        n = torch.cuda.device_count()
+        lib, libpath = _cudart()
+        report["cudart"] = os.path.basename(libpath)
+
+        # 1. capability matrix + enable peer access
+        can = [[False] * n for _ in range(n)]
+        enabled = [[False] * n for _ in range(n)]
+        for i in range(n):
+            for j in range(n):
+                if i == j:
+                    continue
+                can[i][j] = bool(torch.cuda.can_device_access_peer(i, j))
+                if can[i][j]:
+                    lib.cudaSetDevice(i)
+                    rc = lib.cudaDeviceEnablePeerAccess(j, 0)
+                    enabled[i][j] = rc in (0, 704)  # 704: already enabled
+        lib.cudaGetLastError()
+        report["can_access_peer"] = can
+        report["peer_access_enabled"] = enabled
+        cross = [(i, j) for i in range(n) for j in range(n) if sel["board"][i] != sel["board"][j]]
+        report["cross_board_pairs_with_p2p"] = sum(can[i][j] for i, j in cross)
+        report["cross_board_pairs_total"] = len(cross)
+        C.log(f"p2p: cross-board can_access {report['cross_board_pairs_with_p2p']}/{len(cross)}")
+
+        streams = [torch.cuda.Stream(device=i) for i in range(n)]
+        maxb = max(SIZES)
+        send = [torch.empty(maxb, dtype=torch.uint8, device=i) for i in range(n)]
+        recv = [torch.empty(maxb, dtype=torch.uint8, device=i) for i in range(n)]
+        for i in range(n):
+            g = torch.Generator(device=i).manual_seed(1000 + i)
+            send[i].copy_(torch.randint(0, 256, (maxb,), dtype=torch.uint8, device=i, generator=g))
+        torch.cuda.synchronize()
+
+        def enqueue(src, dst, size, count, s):
+            for _ in range(count):
+                rc = lib.cudaMemcpyPeerAsync(
+                    ctypes.c_void_p(recv[dst].data_ptr()),
+                    dst,
+                    ctypes.c_void_p(send[src].data_ptr()),
+                    src,
+                    size,
+                    ctypes.c_void_p(s.cuda_stream),
+                )
+                if rc != 0:
+                    raise RuntimeError(f"cudaMemcpyPeerAsync {src}->{dst} rc={rc}")
+
+        def timed(flows, size, count):
+            """flows [(src, dst)]: us per copy for each flow (own stream)."""
+            ev = []
+            for src, dst in flows:
+                s = streams[src]
+                with torch.cuda.device(src), torch.cuda.stream(s):
+                    torch.cuda._sleep(SLEEP_CYCLES)
+                    a = torch.cuda.Event(enable_timing=True)
+                    b = torch.cuda.Event(enable_timing=True)
+                    a.record(s)
+                ev.append((a, b, s, src, dst))
+            for a, b, s, src, dst in ev:
+                with torch.cuda.device(src):
+                    enqueue(src, dst, size, count, s)
+                    b.record(s)
+            out = []
+            for a, b, s, src, dst in ev:
+                b.synchronize()
+                out.append(a.elapsed_time(b) * 1000.0 / count)
+            return out
+
+        # 4. correctness first (cheap, catches broken P2P before timing)
+        corr = {}
+        size = 61440
+        for i in range(n):
+            for j in range(n):
+                if i == j:
+                    continue
+                recv[j][:size].zero_()
+                torch.cuda.synchronize()
+                timed([(i, j)], size, 1)
+                ok = torch.equal(recv[j][:size].cpu(), send[i][:size].cpu())
+                corr[f"{i}->{j}"] = ok
+        report["copy_correct_all"] = all(corr.values())
+        report["copy_correct_failures"] = [k for k, v in corr.items() if not v]
+
+        # 2. per pair latency / pipelined
+        pairs = {}
+        for i in range(n):
+            for j in range(n):
+                if i == j:
+                    continue
+                row = {"cross_board": sel["board"][i] != sel["board"][j], "p2p": can[i][j]}
+                for size in SIZES:
+                    count = 5 if size >= (16 << 20) else 20
+                    single = [timed([(i, j)], size, 1)[0] for _ in range(args.reps)]
+                    piped = [timed([(i, j)], size, count)[0] for _ in range(3)]
+                    st = C.stats(single)
+                    pp = min(piped)
+                    row[str(size)] = {
+                        "single_us": st,
+                        "pipelined_us": round(pp, 3),
+                        "GBps_pipelined": round(size / pp / 1e3, 3),
+                    }
+                pairs[f"{i}->{j}"] = row
+            C.log(f"p2p: pairs from rank {i} done")
+        report["pairs"] = pairs
+
+        def summarize(keys, size):
+            vals = [pairs[k][str(size)]["single_us"]["median"] for k in keys]
+            bws = [pairs[k][str(size)]["GBps_pipelined"] for k in keys]
+            return {"single_us": C.stats(vals), "GBps": C.stats(bws)}
+
+        inb = [f"{i}->{j}" for i in range(n) for j in range(n) if i != j and sel["board"][i] == sel["board"][j]]
+        crs = [f"{i}->{j}" for i, j in cross]
+        report["summary"] = {
+            str(s): {"in_board": summarize(inb, s), "cross_board": summarize(crs, s)}
+            for s in SIZES
+        }
+
+        # 3. concurrency
+        half = n // 2
+        dep = [(i, i + half) for i in range(half)]
+        rot = [(i, half + (i + 2) % half) for i in range(half)]
+        by_switch = {}
+        for r, s in enumerate(switches):
+            by_switch.setdefault(s, []).append(r)
+        shared = next((v for v in by_switch.values() if len(v) >= 2), None)
+        scen = {
+            "pairs_deployed_uni_B2C": dep,
+            "pairs_deployed_bi": dep + [(b, a) for a, b in dep],
+            "pairs_rot2_bi": rot + [(b, a) for a, b in rot],
+            "board_nvlink_ring": [(i, (i + 1) % half) for i in range(half)]
+            + [(half + i, half + (i + 1) % half) for i in range(half)],
+        }
+        if shared:
+            a, b = shared[:2]
+            pa = next(j for j in range(n) if sel["board"][j] != sel["board"][a])
+            pb = next(j for j in range(n) if sel["board"][j] != sel["board"][a] and j != pa)
+            scen["one_switch_two_senders"] = [(a, pa), (b, pb)]
+            scen["one_switch_one_sender"] = [(a, pa)]
+        conc = {}
+        for name, flows in scen.items():
+            conc[name] = {"flows": flows}
+            for size in CONC_SIZES:
+                count = 20
+                runs = [timed(flows, size, count) for _ in range(3)]
+                worst = [max(r) for r in runs]
+                best_run = runs[worst.index(min(worst))]
+                conc[name][str(size)] = {
+                    "us_per_copy_each": [round(v, 3) for v in best_run],
+                    "us_per_copy_max": round(max(best_run), 3),
+                    "aggregate_GBps": round(len(flows) * size / max(best_run) / 1e3, 3),
+                }
+        report["concurrency"] = conc
+        report["status"] = "ok"
+        report["end"] = C.now()
+        wd.cancel()
+        C.write_json(args.out, report)
+        if not report["copy_correct_all"]:
+            return C.EXIT_CHECK
+        return C.EXIT_OK
+    except SystemExit as e:
+        report["status"] = "precondition"
+        report["error"] = str(e)
+        C.write_json(args.out, report)
+        return C.EXIT_PRE
+    except Exception:
+        report["status"] = "crash"
+        report["error"] = traceback.format_exc()[-4000:]
+        C.write_json(args.out, report)
+        return C.EXIT_CRASH
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/benchmarks/deepseek_v41/tp8probe/run_step.py b/benchmarks/deepseek_v41/tp8probe/run_step.py
new file mode 100644
index 000000000..4067ec19f
--- /dev/null
+++ b/benchmarks/deepseek_v41/tp8probe/run_step.py
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103: run one probe step under a hard timeout.
+
+  python run_step.py --name p2p --timeout 240 --dir OUT -- python p2p_probe.py ...
+
+The step runs in its own session (process group); output goes to
+OUT/<name>.log. On timeout the group gets SIGTERM, then SIGKILL after 15 s,
+and the step's exit code is recorded as 3 (hang). Writes OUT/<name>.status.json
+{name, cmd, exit, seconds, timed_out} and exits with the step's code. Only
+processes this wrapper started are signalled.
+"""
+
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+
+EXIT_HANG = 3
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--timeout", type=float, required=True)
+    ap.add_argument("--dir", required=True)
+    ap.add_argument("cmd", nargs=argparse.REMAINDER)
+    args = ap.parse_args()
+    cmd = args.cmd[1:] if args.cmd and args.cmd[0] == "--" else args.cmd
+    if not cmd:
+        sys.exit("run_step: no command")
+    log = open(os.path.join(args.dir, f"{args.name}.log"), "w")
+    t0 = time.time()
+    proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+    timed_out = False
+    try:
+        code = proc.wait(timeout=args.timeout)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(proc.pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+        try:
+            proc.wait(timeout=15)
+        except subprocess.TimeoutExpired:
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+            proc.wait(timeout=15)
+        code = EXIT_HANG
+    secs = round(time.time() - t0, 1)
+    status = {"name": args.name, "cmd": cmd, "exit": code, "seconds": secs, "timed_out": timed_out}
+    path = os.path.join(args.dir, f"{args.name}.status.json")
+    with open(path + ".tmp", "w") as fh:
+        json.dump(status, fh, indent=1)
+    os.replace(path + ".tmp", path)
+    print(f"step {args.name}: exit {code} in {secs} s{' (TIMEOUT)' if timed_out else ''}", flush=True)
+    return code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
