+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103: per-round decode model, TP8 designs vs today's PP2 x TP4.
+
+CPU only. Without --dir it prints the ESTIMATED table; with --dir it reads the
+window's p2p.json, ar-*.json and kernels.json, replaces every estimate it can
+with a MEASURED value (each input is labelled), and applies the go/no-go rule.
+
+Baseline (MEASURED): round T0 = 27.1 ms on the deployed PP2 x TP4 stack. Each
+decode round runs the 40 layers once (20 on Board B, then 20 on Board C), so a
+TP8 design runs the same 40 layers on all 8 GPUs and its round is
+
+  round = T0 - 40 * layer_saving - nonlayer_saving + n8 * (AR8 - AR4)
+
+layer_saving    per-layer kernel time a TP8 rank no longer spends (dense
+                halvable roles, routed experts, attention), from PROF1103b
+                stage-1 layer components and the TP8/TP4 time ratios f;
+nonlayer_saving PP hand-off (removed), lm head, Engram, drafter, index;
+n8              collectives per round that become 8-wide (ARs, and in design
+                A the expert all-gather peer_gather);
+AR8 - AR4       extra latency of one 8-way collective over today's in-board
+                4-way custom AR at the M6 decode payload (61,440 B).
+
+Designs
+  A  full TP8: attention heads, dense, experts (288/640 rows per rank)
+  B  TP8 attention + dense, experts EP2 x TP4 (each board owns half the
+     experts at today's TP4 kernels; peer_gather stays in-board)
+  C  attention/dense replicated per board at TP4, experts EP2 x TP4 (only the
+     MoE AR is 8-wide)
+
+  python tp8_model.py [--dir WINDOW_OUT] [--out model.json] [--target 22.0]
+"""
+
+import argparse
+import glob
+import json
+import os
+import sys
+
+T0 = 27.1  # MEASURED ms/round today (S8-D + PLAN_FUSE + PP_KEEP_BATCH + EXPERT_FAST + FUSE_ATTN)
+LAYERS = 40
+M6_BYTES = "61440"
+# PROF1103b stage-1 layer, us (MEASURED): halvable dense roles and the rest.
+DENSE_US = {"q_b": 20.4, "wo_a": 18.4, "wo_b": 17.3, "shared": 12.9, "shared_down": 17.4}
+ATTN_US = 44.3  # gather 10.9 + gemms 13.5 + 15.6 + softmax 4.3
+EXPERT_US = 156.0  # ESTIMATED: gate_up + down per layer after EXPERT_FAST
+EXPERT_SPLIT = {"gate_up": 0.565, "down": 0.435}  # PROF1103b 99.6 : 76.9
+HEAD_US, ENGRAM_US, ENGRAM_LAYERS = 167.1, 48.6, 2  # MEASURED prod medians
+HANDOFF_MS = 0.40  # ESTIMATED PP send/recv + its skew left after overlap
+DRAFTER_SAVE_MS = 0.41  # ESTIMATED: ~12 % of the 3.4 ms drafter GPU time
+INDEX_SAVE_MS = 0.06  # ESTIMATED
+C_REPLICATION_MS = 0.15  # ESTIMATED: C replicates head / drafter per board
+ASYNC_CREDIT_MS = 1.0  # ESTIMATED, unmeasured: async scheduling at PP1
+N8 = {"A": 106 + 40, "B": 106, "C": 40}  # 85 push AR + 8 fp32 + 8 index + 5 gather; +40 peer_gather
+AR4_EST = 8.75
+
+ESTIMATES = {
+    "f_dense": {"q_b": 0.67, "wo_a": 0.67, "wo_b": 0.67, "shared": 0.67, "shared_down": 0.67},
+    "f_expert_tp8": 0.53,
+    "f_expert_ep2": 0.60,
+    "f_attn": 0.85,
+    "f_head": 0.52,
+    "f_engram": 0.55,
+}
+
+
+def _load(path):
+    try:
+        return json.load(open(path))
+    except Exception:
+        return None
+
+
+def measured_inputs(d):
+    """MEASURED overrides from a window directory; (inputs, sources, gate)."""
+    inp, src, gate = {}, {}, {"notes": []}
+    p2p = _load(os.path.join(d, "p2p.json"))
+    if p2p:
+        gate["p2p_status"] = p2p.get("status")
+        gate["cross_board_p2p"] = f"{p2p.get('cross_board_pairs_with_p2p')}/{p2p.get('cross_board_pairs_total')}"
+        gate["p2p_ok"] = (
+            p2p.get("status") == "ok"
+            and p2p.get("copy_correct_all") is True
+            and p2p.get("cross_board_pairs_with_p2p") == p2p.get("cross_board_pairs_total")
+        )
+        summ = p2p.get("summary", {}).get(M6_BYTES, {})
+        if summ:
+            inp["p2p_cross_single_us_60k"] = summ["cross_board"]["single_us"].get("median")
+            inp["p2p_inboard_single_us_60k"] = summ["in_board"]["single_us"].get("median")
+    else:
+        gate["p2p_ok"] = False
+        gate["notes"].append("p2p.json missing")
+
+    def ar(group, name, key):
+        r = _load(os.path.join(d, f"ar-{group}.json"))
+        if not r:
+            return None, f"ar-{group}.json missing"
+        e = r.get("results", {}).get(name, {}).get(key)
+        if not e:
+            return None, f"{name}@{key} absent (status {r.get('status')})"
+        if e.get("admitted") is False:
+            return None, f"{name}@{key} not admitted"
+        ok = all(e.get("correct_per_rank", {}).values()) if e.get("correct_per_rank") else False
+        if not ok:
+            return None, f"{name}@{key} incorrect or unchecked"
+        return e.get("us_median_slowest_rank"), "ok"
+
+    statuses = {}
+    for g in ("ca", "nccl", "hier"):
+        r = _load(os.path.join(d, f"ar-{g}.json"))
+        statuses[g] = r.get("status") if r else "missing"
+    gate["ar_status"] = statuses
+    ar4, why = ar("ca", "ca4", M6_BYTES)
+    if ar4 is not None:
+        inp["AR4"], src["AR4"] = ar4, "MEASURED ca4 @ 61,440 B"
+    else:
+        gate["notes"].append(f"AR4: {why}")
+    cands = {}
+    for label, (g, n, k) in {
+        "nccl8": ("nccl", "nccl8", M6_BYTES),
+        "two_level_ca4+ca2x": ("ca", "two_level", M6_BYTES),
+        "two_level_ca4+nccl2x": ("nccl", "two_level_nccl", M6_BYTES),
+        "hier8@64KiB (upper bound for 60 KiB)": ("hier", "hier8", "65536"),
+    }.items():
+        v, why = ar(g, n, k)
+        if v is not None:
+            cands[label] = {"us": v, "kind": "MEASURED", "steps": [f"ar-{g}"]}
+        else:
+            cands[label] = {"us": None, "why": why}
+    q, why_q = ar("ca", "ca2x_q", "15360")
+    if ar4 is not None and q is not None:
+        # reduce-scatter in board + quarter cross exchange + all-gather in board:
+        # in-board RS + AG move what one in-board AR moves.
+        cands["rs_cross_ag (ca4 + ca2x_q)"] = {
+            "us": round(ar4 + q, 3),
+            "kind": "COMPOSED from MEASURED",
+            "steps": ["ar-ca"],
+        }
+    inp["AR8_candidates"] = cands
+    usable = {k: v["us"] for k, v in cands.items() if v.get("us") is not None}
+    if usable:
+        best = min(usable, key=usable.get)
+        inp["AR8"], src["AR8"] = usable[best], f"{cands[best]['kind']} {best}"
+        gate["ar8_built_from_existing_kernel"] = cands[best]["kind"] == "MEASURED"
+        gate["ar8_steps"] = cands[best]["steps"]
+
+    k = _load(os.path.join(d, "kernels.json"))
+    if k and k.get("dense_ratio_tp8best_over_tp4deployed"):
+        r = k["dense_ratio_tp8best_over_tp4deployed"]
+        fd = {role: r[role]["6"] for role in ("q_b", "wo_a", "wo_b", "shared") if role in r}
+        if "shared" in fd:
+            fd["shared_down"] = fd["shared"]
+        inp["f_dense"], src["f_dense"] = fd, "MEASURED dmv13_x M6 (shared_down uses shared's ratio)"
+        if "head" in r:
+            inp["f_head"], src["f_head"] = r["head"]["6"], "MEASURED"
+        if "engram" in r:
+            inp["f_engram"], src["f_engram"] = r["engram"]["6"], "MEASURED"
+    if k and k.get("experts"):
+
+        def mix_ratio(mix):
+            vals = []
+            for res in k["experts"].values():
+                rr = res.get("ratio_over_k6", {})
+                if "gate_up" in rr and "down" in rr:
+                    vals.append(
+                        EXPERT_SPLIT["gate_up"] * rr["gate_up"][mix]["6"]
+                        + EXPERT_SPLIT["down"] * rr["down"][mix]["6"]
+                    )
+            return round(sum(vals) / len(vals), 3) if vals else None
+
+        for key, mix in (("f_expert_tp8", "k3"), ("f_expert_ep2", "ep2")):
+            v = mix_ratio(mix)
+            if v is not None:
+                inp[key], src[key] = v, f"MEASURED proxy ({mix}/k6, M6, mean of gtypes)"
+    if k and k.get("attention", {}).get("ratio_8_over_16"):
+        inp["f_attn"], src["f_attn"] = k["attention"]["ratio_8_over_16"]["6"], "MEASURED bmm proxy"
+    for name in ("p2p", "ar-ca", "ar-nccl", "ar-hier", "kernels"):
+        st = _load(os.path.join(d, f"{name}.status.json"))
+        if st and st.get("exit") == 3:
+            gate["notes"].append(f"{name}: watchdog / hang (exit 3)")
+    gate["hang_steps"] = [
+        os.path.basename(p).replace(".status.json", "")
+        for p in glob.glob(os.path.join(d, "*.status.json"))
+        if (_load(p) or {}).get("exit") == 3
+    ]
+    return inp, src, gate
+
+
+def evaluate(inp, target):
+    f = {**ESTIMATES, **{k: v for k, v in inp.items() if k in ESTIMATES}}
+    fd = {**ESTIMATES["f_dense"], **f["f_dense"]}
+    dense_save = sum(DENSE_US[r] * (1 - fd[r]) for r in DENSE_US)
+    attn_save = ATTN_US * (1 - f["f_attn"])
+    exp_tp8 = EXPERT_US * (1 - f["f_expert_tp8"])
+    exp_ep2 = EXPERT_US * (1 - f["f_expert_ep2"])
+    head_save = HEAD_US * (1 - f["f_head"]) / 1000
+    eng_save = ENGRAM_LAYERS * ENGRAM_US * (1 - f["f_engram"]) / 1000
+    nonlayer_ab = HANDOFF_MS + head_save + eng_save + DRAFTER_SAVE_MS + INDEX_SAVE_MS
+    layer = {"A": dense_save + attn_save + exp_tp8, "B": dense_save + attn_save + exp_ep2, "C": exp_ep2}
+    nonlayer = {"A": nonlayer_ab, "B": nonlayer_ab, "C": HANDOFF_MS - C_REPLICATION_MS}
+    ar4 = inp.get("AR4", AR4_EST)
+    ar8 = inp.get("AR8")
+    out = {}
+    for d in ("A", "B", "C"):
+        base = T0 - LAYERS * layer[d] / 1000 - nonlayer[d]
+        n = N8[d]
+        row = {
+            "layer_saving_us": round(layer[d], 1),
+            "layer_saving_ms_x40": round(LAYERS * layer[d] / 1000, 2),
+            "nonlayer_saving_ms": round(nonlayer[d], 2),
+            "base_ms_if_AR8_eq_AR4": round(base, 2),
+            "n8_collectives": n,
+            "breakeven_dAR_us_for_target": round((target - base) / n * 1000, 2),
+            "breakeven_dAR_us_for_target_with_async": round((target + ASYNC_CREDIT_MS - base) / n * 1000, 2),
+            "breakeven_dAR_us_for_parity": round((T0 - base) / n * 1000, 2),
+            "breakeven_AR8_us_for_target": round(ar4 + (target - base) / n * 1000, 2),
+            "breakeven_AR8_us_for_parity": round(ar4 + (T0 - base) / n * 1000, 2),
+        }
+        if ar8 is not None:
+            r = base + n * (ar8 - ar4) / 1000
+            row["round_ms"] = round(r, 2)
+            row["round_ms_with_async_credit"] = round(r - ASYNC_CREDIT_MS, 2)
+        out[d] = row
+    return {
+        "f": {**{k: f[k] for k in ESTIMATES if k != "f_dense"}, "f_dense": fd},
+        "AR4_us": ar4,
+        "AR8_us": ar8,
+        "designs": out,
+        "savings_detail_us": {
+            "dense": round(dense_save, 1),
+            "attn": round(attn_save, 1),
+            "experts_tp8": round(exp_tp8, 1),
+            "experts_ep2": round(exp_ep2, 1),
+        },
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dir", default="")
+    ap.add_argument("--out", default="")
+    ap.add_argument("--target", type=float, default=22.0)
+    args = ap.parse_args()
+    report = {"T0_ms": T0, "target_ms": args.target, "estimates": ESTIMATES}
+    est = evaluate({"AR4": AR4_EST}, args.target)
+    best_case = evaluate(
+        {
+            "f_dense": dict.fromkeys(DENSE_US, 0.5),
+            "f_expert_tp8": 0.5,
+            "f_expert_ep2": 0.5,
+            "f_attn": 0.5,
+            "f_head": 0.5,
+            "f_engram": 0.5,
+            "AR4": AR4_EST,
+        },
+        args.target,
+    )
+    report["estimated"] = est
+    report["estimated_best_case_all_f_0.5"] = best_case
+    verdict = {"decision": "NO WINDOW DATA", "kind": "ESTIMATED"}
+    if args.dir:
+        inp, src, gate = measured_inputs(args.dir)
+        meas = evaluate(inp, args.target)
+        report.update(measured_inputs=inp, sources=src, gate=gate, measured=meas)
+        reasons = []
+        if not gate.get("p2p_ok"):
+            reasons.append("cross-board P2P not complete/correct")
+        # A hang blocks GO when it is in a step TP8 cannot avoid: P2P, the
+        # kernels, NCCL at world 8 (vLLM needs it for init / gathers), or the
+        # step that supplied the chosen AR8. Other hangs are reported only.
+        must = {"p2p", "kernels", "ar-nccl", *gate.get("ar8_steps", [])}
+        blocking = [s for s in gate.get("hang_steps", []) if s in must]
+        if blocking:
+            reasons.append(f"hang in {blocking}")
+        if meas["AR8_us"] is None:
+            reasons.append("no correct 8-way AR measured")
+        missing = [k for k in ("f_dense", "f_expert_tp8", "f_expert_ep2", "f_attn", "AR4") if k not in inp]
+        if missing:
+            reasons.append(f"unmeasured inputs {missing}")
+        best = None
+        if meas["AR8_us"] is not None:
+            best = min(("A", "B"), key=lambda d: meas["designs"][d]["round_ms"])
+            if meas["designs"][best]["round_ms"] > args.target:
+                reasons.append(
+                    f"best modeled round {meas['designs'][best]['round_ms']} ms (design {best}) > {args.target}"
+                )
+        verdict = {
+            "decision": "GO" if not reasons else "NO-GO",
+            "best_design": best,
+            "best_round_ms": meas["designs"][best]["round_ms"] if best else None,
+            "best_round_ms_with_async_credit": meas["designs"][best]["round_ms_with_async_credit"] if best else None,
+            "reasons": reasons,
+            "kind": "MODELED from MEASURED inputs (sources listed)",
+        }
+    report["verdict"] = verdict
+    text = json.dumps(report, indent=1)
+    if args.out:
+        tmp = args.out + ".tmp"
+        with open(tmp, "w") as fh:
+            fh.write(text)
+        os.replace(tmp, args.out)
+    print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
