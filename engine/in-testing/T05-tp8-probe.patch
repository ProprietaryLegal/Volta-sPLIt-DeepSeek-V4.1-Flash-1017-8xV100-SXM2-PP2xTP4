@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP8PROBE1103 shared helpers: GPU selection by UUID, watchdog, JSON, stats.
+
+GPU selection never runs nvidia-smi: UUID -> PCI bus id comes from
+/proc/driver/nvidia/gpus/*/information, and CUDA_DEVICE_ORDER=PCI_BUS_ID
+indices are the sorted bus ids. The board lists come from ds41.env
+(DS41_GPUS_A = Board B, DS41_GPUS_C = Board C), in that file's order, the same
+order serve-pp2.sh passes to the deployed PP2 server. Every step re-checks the
+UUID of each visible device after CUDA init and exits 2 on a mismatch.
+UUIDs are printed masked (first 4 hex digits only).
+
+Exit codes for every probe step:
+  0 ok, 1 measured but a correctness check failed, 2 precondition failed,
+  3 hang / watchdog, 4 crash.
+"""
+
+from __future__ import annotations
+
+import faulthandler
+import glob
+import json
+import os
+import re
+import statistics
+import sys
+import threading
+import time
+
+DS41_ENV = "/path/to/gpus.env"
+EXIT_OK, EXIT_CHECK, EXIT_PRE, EXIT_HANG, EXIT_CRASH = 0, 1, 2, 3, 4
+
+# Decode payloads: hidden 5120 fp16 x M rows (M = 1 + DSpark 5 drafts at most).
+HIDDEN = 5120
+
+
+def mask(uuid: str) -> str:
+    m = re.match(r"(GPU-[0-9a-fA-F]{4})", uuid or "")
+    return (m.group(1) + "...") if m else "GPU-????"
+
+
+def board_uuids(path: str = DS41_ENV) -> tuple[list[str], list[str]]:
+    """(Board B uuids, Board C uuids) from ds41.env, file order."""
+    text = open(path).read()
+    out = {}
+    for key in ("DS41_GPUS_A", "DS41_GPUS_C"):
+        m = re.search(rf'^export {key}="([^"]*)"', text, re.M)
+        if not m:
+            raise SystemExit(f"{key} not found in {path}")
+        out[key] = m.group(1).split()
+    b, c = out["DS41_GPUS_A"], out["DS41_GPUS_C"]
+    if len(b) != 4 or len(c) != 4 or len(set(b + c)) != 8:
+        raise SystemExit("ds41.env must list 4 + 4 distinct GPU UUIDs")
+    return b, c
+
+
+def proc_gpus() -> list[dict]:
+    """[{bus, uuid, minor}] for every GPU the driver lists, sorted by bus id."""
+    gpus = []
+    for info in glob.glob("/proc/driver/nvidia/gpus/*/information"):
+        fields = {}
+        for line in open(info):
+            k, _, v = line.partition(":")
+            fields[k.strip()] = v.strip()
+        gpus.append(
+            {
+                "bus": fields.get("Bus Location", "").lower(),
+                "uuid": fields.get("GPU UUID", ""),
+                "minor": int(fields.get("Device Minor", "-1")),
+            }
+        )
+    return sorted(gpus, key=lambda g: g["bus"])
+
+
+def resolve(order: str = "deployed") -> dict:
+    """The 8 probe GPUs as PCI_BUS_ID indices.
+
+    order "deployed": Board B in ds41.env order, then Board C (serve-pp2.sh).
+    Rank r of every probe = visible device r; ranks 0-3 Board B, 4-7 Board C.
+    order "rot2": Board C rotated by two (other cross-board pairing for i<->i+4).
+    order may also be an explicit comma list of 8 PCI_BUS_ID indices.
+    """
+    b, c = board_uuids()
+    gpus = proc_gpus()
+    index = {g["uuid"]: i for i, g in enumerate(gpus)}
+    missing = [mask(u) for u in b + c if u not in index]
+    if missing:
+        raise SystemExit(f"GPUs from ds41.env not present: {missing}")
+    bi = [index[u] for u in b]
+    ci = [index[u] for u in c]
+    if order == "deployed":
+        ids = bi + ci
+    elif order == "rot2":
+        ids = bi + ci[2:] + ci[:2]
+    else:
+        ids = [int(v) for v in order.split(",")]
+        if sorted(ids) != sorted(bi + ci):
+            raise SystemExit("--order must be a permutation of the 8 board GPUs")
+    by_idx = {i: g for i, g in enumerate(gpus)}
+    board = {i: ("B" if i in bi else "C") for i in bi + ci}
+    return {
+        "cuda_visible_devices": ",".join(str(i) for i in ids),
+        "indices": ids,
+        "uuids": [by_idx[i]["uuid"] for i in ids],
+        "bus": [by_idx[i]["bus"] for i in ids],
+        "minor": [by_idx[i]["minor"] for i in ids],
+        "board": [board[i] for i in ids],
+        "masked": [mask(by_idx[i]["uuid"]) for i in ids],
+    }
+
+
+def public_layout(sel: dict) -> list[dict]:
+    """Layout for JSON output: no full UUIDs."""
+    return [
+        {
+            "rank": r,
+            "pci_bus_id_index": sel["indices"][r],
+            "bus": sel["bus"][r],
+            "board": sel["board"][r],
+            "uuid": sel["masked"][r],
+        }
+        for r in range(len(sel["indices"]))
+    ]
+
+
+def check_visible_uuids(expected: list[str]) -> str | None:
+    """After CUDA init: visible device r must have expected[r]. None if ok."""
+    import torch
+
+    n = torch.cuda.device_count()
+    if n != len(expected):
+        return f"{n} visible devices, expected {len(expected)}"
+    for r, want in enumerate(expected):
+        got = str(torch.cuda.get_device_properties(r).uuid)
+        got = got if got.startswith("GPU-") else "GPU-" + got
+        if got.lower() != want.lower():
+            return f"visible device {r} is {mask(got)}, expected {mask(want)}"
+    return None
+
+
+def gpu_holders(minors: list[int]) -> list[dict]:
+    """Processes (other than this one) holding /dev/nvidia<minor> open."""
+    targets = {f"/dev/nvidia{m}" for m in minors}
+    me = os.getpid()
+    found = []
+    for fd_dir in glob.glob("/proc/[0-9]*/fd"):
+        pid = int(fd_dir.split("/")[2])
+        if pid == me:
+            continue
+        try:
+            links = {os.readlink(os.path.join(fd_dir, f)) for f in os.listdir(fd_dir)}
+        except OSError:
+            continue
+        hit = sorted(links & targets)
+        if hit:
+            try:
+                comm = open(f"/proc/{pid}/comm").read().strip()
+            except OSError:
+                comm = "?"
+            found.append({"pid": pid, "comm": comm, "devices": hit})
+    return found
+
+
+def stats(values: list[float]) -> dict:
+    v = sorted(values)
+    if not v:
+        return {}
+    p90 = v[min(len(v) - 1, int(round(0.9 * (len(v) - 1))))]
+    return {
+        "median": round(statistics.median(v), 3),
+        "p90": round(p90, 3),
+        "min": round(v[0], 3),
+        "max": round(v[-1], 3),
+        "n": len(v),
+    }
+
+
+class Watchdog:
+    """Dump all stacks to `trace_path` and os._exit(EXIT_HANG) after seconds.
+
+    `on_fire(reason)` (optional) runs first, e.g. to write a partial JSON.
+    """
+
+    def __init__(self, seconds: float, trace_path: str, on_fire=None):
+        self.seconds, self.on_fire = seconds, on_fire
+        self.trace = open(trace_path, "w")
+        faulthandler.dump_traceback_later(seconds, exit=False, file=self.trace)
+        self.timer = threading.Timer(seconds + 2.0, self._fire)
+        self.timer.daemon = True
+        self.timer.start()
+
+    def _fire(self):
+        try:
+            if self.on_fire:
+                self.on_fire(f"watchdog {self.seconds:.0f} s")
+        finally:
+            try:
+                self.trace.flush()
+            except Exception:
+                pass
+            os._exit(EXIT_HANG)
+
+    def cancel(self):
+        self.timer.cancel()
+        faulthandler.cancel_dump_traceback_later()
+
+
+def write_json(path: str, obj) -> None:
+    tmp = path + ".tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f, indent=1, default=str)
+    os.replace(tmp, path)
+
+
+def now() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def log(msg: str) -> None:
+    print(f"{now()} {msg}", flush=True, file=sys.stderr)
diff --git a/benchmarks/deepseek_v41/tp8probe/kernel_scale.py b/benchmarks/deepseek_v41/tp8probe/kernel_scale.py
