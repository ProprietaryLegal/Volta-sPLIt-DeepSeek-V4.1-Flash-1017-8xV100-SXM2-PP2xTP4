+def _input_batch():
+    return InputBatch(
+        max_num_reqs=4,
+        max_model_len=MAX_MODEL_LEN,
+        max_num_batched_tokens=MAX_MODEL_LEN,
+        device=torch.device("cpu"),
+        pin_memory=False,
+        vocab_size=50272,
+        block_sizes=[BLOCK_SIZE],
+        kernel_block_sizes=[BLOCK_SIZE],
+        num_spec_tokens=NUM_DRAFTS,
+    )
+
+
+def _runner(is_last_rank, num_slots, monkeypatch):
+    monkeypatch.setattr(multi_runner, "get_pp_group", lambda: _pp(is_last_rank))
+    runner = object.__new__(GPUModelRunner)
+    runner.pp_keep_batch = False
+    runner._pp_keep_batch_kept_logged = False
+    runner.device = torch.device("cpu")
+    runner.input_batch = _input_batch()
+    runner.requests = {}
+    runner.num_prompt_logprobs = {}
+    runner.encoder_cache = {}
+    runner.late_interaction_runner = Mock()
+    runner._dynamic_draft_vocab_prefill_bootstrap = Mock()
+    runner.dynamic_draft_vocab_prefill_topk = 0
+    runner.speculative_config = SimpleNamespace(
+        method="dspark", use_ngram_gpu=lambda: False
+    )
+    runner.scheduler_config = SimpleNamespace(max_num_seqs=num_slots)
+    runner.use_async_spec_decode = False
+    runner.sync_spec_decode_accept_counts = False
+    runner.use_async_scheduling = False
+    runner.is_pooling_model = False
+    runner.uses_mrope = False
+    runner.uses_xdrope_dim = 0
+    runner.kv_cache_config = SimpleNamespace(kv_cache_groups=[])
+    runner.model = FakeModel()
+    runner.v41_multi_seq = V41MultiSeqRunner(runner, "test")
+    adds = []
+    real_add = runner.input_batch.add_request
+
+    def counting_add(request, **kwargs):
+        adds.append((request.req_id, kwargs.get("v41_multi_seq_row") is not None))
+        return real_add(request, **kwargs)
+
+    runner.input_batch.add_request = counting_add
+    runner.adds = adds
+    return runner
+
+
+def _row(runner, req_id):
+    batch = runner.input_batch
+    idx = batch.req_id_to_index[req_id]
+    num_tokens = int(batch.num_tokens_no_spec[idx])
+    return {
+        "tokens": batch.token_ids_cpu[idx, :num_tokens].tolist(),
+        "is_token": bool(batch.is_token_ids[idx, :num_tokens].all()),
+        "num_computed": int(batch.num_computed_tokens_cpu[idx]),
+        "spec": list(batch.spec_token_ids[idx]),
+    }
+
+
+def _last_rank_bookkeeping(runner, req_id, sampled):
+    """What _bookkeeping_sync does with the sampled tokens of a step."""
+    batch = runner.input_batch
+    idx = batch.req_id_to_index[req_id]
+    start = int(batch.num_tokens_no_spec[idx])
+    end = start + len(sampled)
+    batch.token_ids_cpu[idx, start:end] = sampled
+    batch.is_token_ids[idx, start:end] = True
+    batch.num_tokens_no_spec[idx] = end
+    runner.requests[req_id].output_token_ids.extend(sampled)
+
+
+def _output(req_id, sampled):
+    return ModelRunnerOutput(
+        req_ids=[req_id],
+        req_id_to_index={req_id: 0},
+        sampled_token_ids=[sampled],
+        logprobs=None,
+        prompt_logprobs_dict={},
+        pooler_output=[],
+    )
+
+
+def _simulate(monkeypatch, num_requests, accepted, max_tokens=60):
+    """The PP=2 batch queue (depth two) with a first-stage and a last-stage
+    runner. Each scheduled step's sampled tokens are fixed when it is
+    scheduled (the last stage samples them in that step); the scheduler
+    applies them when the step leaves the queue, then the step's drafts."""
+    scheduler = create_scheduler(
+        pipeline_parallel_size=2,
+        max_num_seqs=num_requests,
+        num_speculative_tokens=NUM_DRAFTS,
+        block_size=BLOCK_SIZE,
+        max_model_len=MAX_MODEL_LEN,
+    )
+    assert scheduler.v41_multi_seq is not None
+    first = _runner(False, num_requests, monkeypatch)
+    last = _runner(True, num_requests, monkeypatch)
+    requests = create_requests(
+        num_requests=num_requests,
+        num_tokens=37,
+        max_tokens=max_tokens,
+        block_size=BLOCK_SIZE,
+    )
+    by_id = {r.request_id: r for r in requests}
+    for request in requests:
+        scheduler.add_request(request)
+
+    queue = deque()
+    checks = 0
+    token = 1000
+    step_index = 0
+    for _ in range(2000):
+        if not scheduler.has_requests() and not queue:
+            break
+        if len(queue) < 2 and scheduler.has_requests():
+            scheduled = scheduler.schedule()
+            sampled = {}
+            monkeypatch.setattr(gpu_model_runner, "get_pp_group", lambda: _pp(False))
+            first._update_states(scheduled)
+            monkeypatch.setattr(gpu_model_runner, "get_pp_group", lambda: _pp(True))
+            last._update_states(scheduled)
+            for req_id, num in scheduled.num_scheduled_tokens.items():
+                request = by_id[req_id]
+                drafts = list(scheduled.scheduled_spec_decode_tokens.get(req_id, []))
+                # The first stage holds exactly the history it feeds the
+                # model, then this step's drafts.
+                cached = scheduled.scheduled_cached_reqs
+                if req_id in cached.req_ids:
+                    i = cached.req_ids.index(req_id)
+                    computed = cached.num_computed_tokens[i]
+                    expected = computed + len(cached.new_token_ids[i])
+                else:
+                    (new,) = [
+                        r for r in scheduled.scheduled_new_reqs if r.req_id == req_id
+                    ]
+                    computed = new.num_computed_tokens
+                    expected = request.num_prompt_tokens
+                row = _row(first, req_id)
+                assert row["tokens"] == request.all_token_ids[:expected]
+                assert row["is_token"]
+                assert row["spec"] == drafts
+                # The last stage holds the prompt and every sampled token.
+                last_row = _row(last, req_id)
+                assert last_row["tokens"] == list(request.all_token_ids)
+                assert last_row["spec"] == drafts
+                for runner, state in ((first, row), (last, last_row)):
+                    # Positions: the runner feeds num_computed + arange(num)
+                    # from the row's num_computed, so it must be the
+                    # scheduler's, after any park and re-add.
+                    assert state["num_computed"] == computed
+                    assert runner.requests[req_id].num_computed_tokens == computed
+                    # The step runs in the request's own slot.
+                    assert runner.model.binds[-1][0] == scheduled.v41_slots[req_id]
+                checks += 1
+                n = min(len(drafts), accepted[step_index % len(accepted)])
+                step_index += 1
+                sampled[req_id] = drafts[:n] + [token]
+                token += 10
+                _last_rank_bookkeeping(last, req_id, sampled[req_id])
+            queue.appendleft((scheduled, sampled))
+            if scheduled.total_num_scheduled_tokens and len(queue) < 2:
+                continue
+        if not queue:
+            continue
+        oldest, sampled = queue.pop()
+        for req_id, tokens in sampled.items():
+            scheduler.update_from_output(oldest, _output(req_id, tokens))
+            scheduler.update_draft_token_ids(
+                DraftTokenIds([req_id], [[tokens[-1] + k + 1 for k in range(3)]])
+            )
+        if not sampled:
+            scheduler.update_from_output(
+                oldest,
+                ModelRunnerOutput(
+                    req_ids=[],
+                    req_id_to_index={},
+                    sampled_token_ids=[],
+                    logprobs=None,
+                    prompt_logprobs_dict={},
+                    pooler_output=[],
+                ),
+            )
+    else:
+        raise AssertionError("did not drain")
+    return requests, first, last, checks
+
+
+ACCEPTED = [0, 3, 1, 2, 3, 0, 2, 3, 1]
+
+
+@pytest.mark.parametrize("num_requests", [2, 3])
+def test_interleaved_rows_parked_and_exact(v41, monkeypatch, num_requests):
+    requests, first, last, checks = _simulate(monkeypatch, num_requests, ACCEPTED)
+    assert checks > 20
+    for request in requests:
+        assert request.num_output_tokens >= 60
+    for runner in (first, last):
+        # Every re-add after the first one is a parked-row copy.
+        by_req = {}
+        for req_id, parked in runner.adds:
+            by_req.setdefault(req_id, []).append(parked)
+        for flags in by_req.values():
+            assert flags[0] is False
+            assert all(flags[1:]) and len(flags) > 5
+        # Finished requests leave no parked row behind.
+        assert runner.v41_multi_seq.parks == {}
+        binds = runner.model.binds
+        slots = {slot for slot, _ in binds}
+        assert slots <= set(range(num_requests))
+        # A fresh request starts a sequence in its slot exactly once.
+        assert sum(1 for _, fresh in binds if fresh) == num_requests
+
+
+def test_bind_follows_the_step(v41, monkeypatch):
+    first = _runner(False, 2, monkeypatch)
+    scheduler = create_scheduler(
+        pipeline_parallel_size=2, max_num_seqs=2, block_size=BLOCK_SIZE
+    )
+    monkeypatch.setattr(gpu_model_runner, "get_pp_group", lambda: _pp(False))
+    for request in create_requests(num_requests=2, num_tokens=20):
+        scheduler.add_request(request)
+    step_a = scheduler.schedule()
+    first._update_states(step_a)
+    step_b = scheduler.schedule()
+    first._update_states(step_b)
+    assert first.model.binds == [(0, True), (1, True)]
+    assert set(step_a.v41_slots.items()) == {("0", 0)}
+    assert set(step_b.v41_slots.items()) == {("1", 1)}
