+# -- the parked-row copy -----------------------------------------------------
+def _state(prompt, output):
+    return CachedRequestState(
+        req_id="r",
+        prompt_token_ids=list(prompt),
+        mm_features=[],
+        sampling_params=None,
+        generator=None,
+        block_ids=([],),
+        num_computed_tokens=0,
+        output_token_ids=list(output),
+    )
+
+
+def _copy(request, parked):
+    tokens = np.full((2, 64), -7, dtype=np.int32)
+    is_token = np.zeros((2, 64), dtype=bool)
+    copy_parked_row(tokens, is_token, 1, request, parked)
+    return tokens, is_token
+
+
+@pytest.mark.parametrize(
+    ("prompt", "parked_len", "output"),
+    [
+        (range(10, 30), 23, [5, 6, 7]),  # nothing new since the park
+        (range(10, 30), 21, [5, 6, 7, 8, 9]),  # tokens appended since
+        (range(10, 30), 25, [5, 6]),  # output tail trimmed since
+        (range(10, 30), 12, []),  # parked mid-prefill
+        (range(10, 30), 12, [5]),  # parked mid-prefill, then sampled
+        (range(10, 30), 0, [5]),  # empty row
+    ],
+)
+def test_copy_parked_row_matches_lists(prompt, parked_len, output):
+    request = _state(prompt, output)
+    full = list(prompt) + list(output)
+    parked_tokens = np.array((full + [99] * 10)[:parked_len], dtype=np.int32)
+    if parked_len > len(full):
+        parked_tokens[len(full) :] = 99
+    tokens, is_token = _copy(request, ParkedRow(parked_tokens, []))
+    assert tokens[1, : len(full)].tolist() == full
+    assert is_token[1, : len(full)].all()
+    assert not is_token[1, len(full) :].any()
+    assert (tokens[0] == -7).all()
+
+
+def test_copy_parked_row_detects_a_stale_row():
+    request = _state(range(10, 30), [5, 6, 7])
+    parked = np.array(list(range(10, 30)) + [5, 66], dtype=np.int32)
+    with pytest.raises(RuntimeError, match="disagrees"):
+        _copy(request, ParkedRow(parked, []))
+
+
+def test_add_request_with_parked_row_equals_default():
+    batch_default, batch_parked = _input_batch(), _input_batch()
+    prompt = list(range(100, 137))
+    request = _state(prompt, [1, 2, 3, 4])
+    request.sampling_params = SamplingParams(temperature=0.0)
+    batch_default.add_request(request)
+    parked = ParkedRow(np.array(prompt + [1, 2], dtype=np.int32), [9])
+    batch_parked.add_request(request, v41_multi_seq_row=parked)
+    for name in ("token_ids_cpu", "is_token_ids", "num_tokens_no_spec"):
+        assert np.array_equal(
+            getattr(batch_default, name), getattr(batch_parked, name)
+        ), name
+    assert batch_default.req_id_to_index == batch_parked.req_id_to_index
+
