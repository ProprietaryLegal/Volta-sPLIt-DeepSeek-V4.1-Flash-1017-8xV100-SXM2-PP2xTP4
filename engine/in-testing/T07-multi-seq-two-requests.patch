+def test_capture_slot_graphs(monkeypatch):
+    monkeypatch.setattr(multi_runner.torch.accelerator, "synchronize", lambda: None)
+    helper, runner = _helper(num_slots=3, monkeypatch=monkeypatch)
+    model = FakeModel()
+    runner.get_model = lambda: model
+    descs = [
+        BatchDescriptor(num_tokens=n, num_reqs=1, uniform=False) for n in (6, 3, 1)
+    ]
+    runner.cudagraph_dispatcher = SimpleNamespace(
+        get_capture_descs=lambda: [(CUDAGraphMode.FULL, descs)]
+    )
+    calls = []
+
+    def capture(desc, cudagraph_runtime_mode, batch_descriptor_override):
+        calls.append((model.binds[-1][0], desc, batch_descriptor_override))
+
+    runner._warmup_and_capture = capture
+    helper.capture_slot_graphs()
+    assert [(slot, d.num_tokens, d.graph_variant) for slot, d, _ in calls] == [
+        (1, 6, -1001),
+        (1, 3, -1001),
+        (1, 1, -1001),
+        (2, 6, -1002),
+        (2, 3, -1002),
+        (2, 1, -1002),
+    ]
+    assert all(d is o for _, d, o in calls)
+    assert model.binds[-1] == (0, True)
+    assert helper.captured_variants == [-1001, -1002]
+
+    descs.append(
+        BatchDescriptor(num_tokens=6, num_reqs=1, attention_context_bucket=8192)
+    )
+    with pytest.raises(ValueError, match="context-specialized"):
+        helper.capture_slot_graphs()
+
