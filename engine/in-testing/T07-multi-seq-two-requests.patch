+def test_policy_lru_among_runnable():
+    multi = V41SchedulerMultiSeq(3, 128, False)
+    a, b, c = _req("a"), _req("b"), _req("c")
+    multi.last_step.update({"a": 5, "b": 3, "c": 4})
+    multi.begin_step([a, b, c], False, False, 6)
+    assert multi.turn == "b"
+    assert multi.skip_running(a) and not multi.skip_running(b)
+    assert multi.skip_waiting(0)
+    # b in flight (no work left): c is next.
+    multi.begin_step([a, _req("b", computed=11), c], False, False, 7)
+    assert multi.turn == "c"
+    # not eligible yet
+    multi.begin_step([_req("a", eligible=9)], False, False, 8)
+    assert multi.turn is None
