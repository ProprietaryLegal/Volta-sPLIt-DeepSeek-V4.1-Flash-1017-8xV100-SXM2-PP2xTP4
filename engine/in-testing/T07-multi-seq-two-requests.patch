+def test_session_hit_only_in_the_freed_slot_of_that_session(v41, monkeypatch):
+    from vllm.v1.core import kv_cache_manager
+
+    monkeypatch.setattr(kv_cache_manager, "_V41_SESSION_PREFIX", True)
+    scheduler = create_scheduler(
+        pipeline_parallel_size=2,
+        max_num_seqs=2,
+        enable_prefix_caching=True,
+        block_size=16,
+    )
+    first = _request("a", [11] * 40, max_tokens=10)
+    other = _request("c", [22] * 40, max_tokens=30)
+    scheduler.add_request(first)
+    scheduler.add_request(other)
+    engine = Engine(scheduler)
+    while first.status != RequestStatus.FINISHED_LENGTH_CAPPED:
+        engine.step()
+    multi = scheduler.v41_multi_seq
+    assert multi.slots.records[0] is not None  # a's slot keeps its session
+    assert multi.slots.owner[1] == "c"
+
+    # The next turn of a's conversation, and a request that shares c's prompt
+    # while c still runs (its slot holds another live sequence).
+    follow_up = _request("b", list(first.all_token_ids) + [33] * 6, max_tokens=4)
+    same_as_running = _request("d", [22] * 40 + [44] * 3, max_tokens=4)
+    scheduler.add_request(follow_up)
+    engine.run()
+    new = {
+        r.req_id: (r.num_computed_tokens, step.v41_slots[r.req_id])
+        for step in engine.steps
+        for r in step.scheduled_new_reqs
+    }
+    hit, slot = new["b"]
+    assert hit == 48 and slot == 0
+    assert new["c"][1] == 1
+
+    scheduler2 = create_scheduler(
+        pipeline_parallel_size=2,
+        max_num_seqs=2,
+        enable_prefix_caching=True,
+        block_size=16,
+    )
+    other2 = _request("c", [22] * 40, max_tokens=30)
+    scheduler2.add_request(other2)
+    engine2 = Engine(scheduler2)
+    for _ in range(6):
+        engine2.step()
+    assert other2.status == RequestStatus.RUNNING
+    table = scheduler2.v41_multi_seq.slots
+    asked = []
+    real_hit = table.session_hit
+
+    def recording_hit(request, hit):
+        result = real_hit(request, hit)
+        asked.append((request.request_id, hit, result))
+        return result
+
+    monkeypatch.setattr(table, "session_hit", recording_hit)
+    scheduler2.add_request(same_as_running)
+    engine2.run()
+    # The block pool had c's prompt blocks; the slot table refused them.
+    assert ("d", 32, False) in asked
+    new2 = {
+        r.req_id: r.num_computed_tokens
+        for step in engine2.steps
+        for r in step.scheduled_new_reqs
+    }
+    # The cached blocks exist, but no free slot holds that sequence.
+    assert new2["d"] == 0
