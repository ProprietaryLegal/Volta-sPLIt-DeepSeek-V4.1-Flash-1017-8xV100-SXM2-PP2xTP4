+def test_hot_refill_uses_the_bound_slot(native):
+    """1Cat #1341: refill_hot after a session hit rewrites the bound slot's hot
+    ring from that slot's own host arena and leaves every other slot alone."""
+    store = _store(40960)
+    table = V41Slots(Model(store), 2, GROUP)
+    for slot in (0, 1):
+        table.bind(slot)
+        for source in SOURCES:
+            host = store.host[source]
+            rows = torch.arange(host.shape[0]).unsqueeze(1) * (slot + 1)
+            host.copy_((rows + torch.arange(C_ROW)) % 251)
+            store.hot[source].fill_(0xEE)
+    table.bind(1)
+    cached = 40000  # past the hot ring of both sources
+    assert store.refill_hot(cached) > 0
+    for source, ratio in SOURCES.items():
+        size, hi = store.hot_rows[source], cached // ratio - 1
+        rows = torch.arange(max(0, hi - size + 1), hi + 1)
+        assert torch.equal(store.hot[source][rows % size], store.host[source][rows])
+    table.bind(0)
+    for source in SOURCES:
+        assert bool((store.hot[source] == 0xEE).all()), source
+
