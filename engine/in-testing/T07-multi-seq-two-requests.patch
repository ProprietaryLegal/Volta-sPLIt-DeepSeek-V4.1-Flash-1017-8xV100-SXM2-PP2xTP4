index 000000000..ccb6f105a
--- /dev/null
+++ b/tests/models/sim_deepseek_v41_hot_refill.py
@@ -0,0 +1,47 @@
+"""CPU simulation of V41PackedKV.refill_hot (1Cat #1341 port): extracts the method from kv_store.py by AST."""
+import ast, sys, types, torch
+src = open(sys.argv[1]).read()
+fn = next(n for n in ast.walk(ast.parse(src)) if isinstance(n, ast.FunctionDef) and n.name == "refill_hot")
+ns = {}; exec(compile(ast.Module([fn], []), "refill_hot", "exec"), ns); refill = ns["refill_hot"]
+C = 3
+def run(sources, hot_positions, prompt, answer, drafts=4, cached=None):
+    st = types.SimpleNamespace(sources=sources, hot_rows={s: max(1, hot_positions // r) for s, r in sources.items()})
+    total = prompt + answer + drafts + 1024
+    st.host = {s: torch.zeros(total // r + 1, C, dtype=torch.int32) for s, r in sources.items()}
+    st.hot = {s: torch.zeros(st.hot_rows[s], C, dtype=torch.int32) for s in sources}
+    def write(s, row, tag):
+        v = torch.tensor([row, tag, 7], dtype=torch.int32)
+        st.hot[s][row % st.hot_rows[s]] = v; st.host[s][row] = v
+    # previous request: prompt + answer + rejected drafts, tag 1 (host also written; rank 0 writes every row)
+    for s, r in sources.items():
+        for row in range((prompt + answer + drafts) // r): write(s, row, 1)
+    cached = prompt if cached is None else cached
+    # the old request's rows past the hit differ in content from what the new request will write: mark them stale
+    for s, r in sources.items():
+        for row in range(cached // r, (prompt + answer + drafts) // r):
+            st.hot[s][row % st.hot_rows[s]][1] = 99
+    n = refill(st, cached)
+    bad = 0
+    for s, r in sources.items():
+        hi = cached // r - 1; rows = st.hot_rows[s]
+        for c in range(max(0, hi - rows + 1), hi + 1):
+            if not torch.equal(st.hot[s][c % rows], st.host[s][c]): bad += 1
+    return n, bad
+srcs = {2: 4, 8: 128, 14: 4, 20: 4}
+fails = 0
+for prompt, answer, hp in [(40000, 64, 32768), (39560, 64, 32768), (250000, 64, 32768), (500000, 64, 32768),
+                           (37000, 1, 32768), (100, 64, 64), (2000, 300, 1024)]:
+    n, bad = run(srcs, hp, prompt, answer)
+    print(f"prompt {prompt} answer {answer} hot_positions {hp}: copied {n} rows, mismatched slots {bad}")
+    fails += bad != 0
+# guard: ring cannot wrap yet -> nothing copied, and nothing needed
+n, bad = run({2: 4}, 32768, 20000, 64)
+print(f"below ring (20000 tokens): copied {n}, mismatched {bad}"); fails += (n != 0) + (bad != 0)
+# without the refill the wrapped case must show stale slots (proves the check can fail)
+st_bad = None
+def norefill(st, cached): return 0
+ns["refill_hot"] = norefill
+saved = refill; refill = norefill
+_, bad = run(srcs, 32768, 40000, 64); refill = saved
+print(f"control without refill at 40000: mismatched {bad} (must be > 0)"); fails += bad == 0
+print("FAIL" if fails else "PASS"); sys.exit(1 if fails else 0)
diff --git a/tests/models/test_deepseek_v41_multi_seq_knob_off.py b/tests/models/test_deepseek_v41_multi_seq_knob_off.py
new file mode 100644
index 000000000..05f4c6a99
--- /dev/null
+++ b/tests/models/test_deepseek_v41_multi_seq_knob_off.py
@@ -0,0 +1,392 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_MULTI_SEQ off: the code that runs is the base's, by AST.
+
+Every changed file under vllm/ is parsed at the base commit and in the work
+tree. The work tree is then evaluated with the knob off:
+
+- an ``if`` / conditional expression whose test is a knob test keeps only the
+  branch the knob-off value selects. Knob tests: ``multi_seq_requested()``, a
+  name or attribute ``v41_multi_seq*`` (None, False or 0 with the knob off),
+  ``<that> is None`` / ``is not None``, ``not <that>``, and ``<that> and ...``;
+- assignments to ``v41_multi_seq*`` names, ``v41_multi_seq*`` parameters and
+  keyword arguments, imports of the knob's own modules, and definitions named
+  ``v41_*`` / ``_v41_*`` / ``V41_*`` that the base does not have are dropped;
+- ``TYPE_CHECKING`` is dropped from ``typing`` imports on both sides, and an
+  ``if TYPE_CHECKING:`` block left empty is dropped;
+- vllm/envs.py: the ``VLLM_V41_MULTI_SEQ`` entries are dropped.
+
+The result must equal the base's AST exactly. The knob's own modules are
+imported with the knob off only for their definitions: their module level
+holds nothing that runs (checked below).
+"""
+
+import ast
+import re
+import subprocess
+from pathlib import Path
+
+import pytest
+
+# b9b0bc8 + 1Cat #1341 (v41pkg/hotrefill1103: dd522db, 7e9a156), the code
+# deployed on the 8-GPU host; this branch carries both commits unchanged.
+BASE = "7e9a1568655d"
+ROOT = Path(__file__).resolve().parents[2]
+ENV = "VLLM_V41_MULTI_SEQ"
+PREFIX = "v41_multi_seq"
+KNOB_MODULES = {
+    "vllm.v1.core.sched.v41_multi_seq",
+    "vllm.v1.worker.v41_multi_seq_runner",
+}
+NEW_FILES = {
+    "vllm/v1/core/sched/v41_multi_seq.py",
+    "vllm/v1/worker/v41_multi_seq_runner.py",
+    "vllm/models/deepseek_v41/slots.py",
+}
+CHANGED_FILES = {
+    "vllm/envs.py",
+    "vllm/models/deepseek_v41/kv_store.py",
+    "vllm/models/deepseek_v41/model.py",
+    "vllm/v1/core/kv_cache_manager.py",
+    "vllm/v1/core/sched/output.py",
+    "vllm/v1/core/sched/scheduler.py",
+    "vllm/v1/cudagraph_dispatcher.py",
+    "vllm/v1/engine/core.py",
+    "vllm/v1/outputs.py",
+    "vllm/v1/worker/gpu_input_batch.py",
+    "vllm/v1/worker/gpu_model_runner.py",
+}
+# Existing tests whose runner stubs gained the class default v41_multi_seq.
+CHANGED_TESTS = {"tests/models/test_deepseek_v41_runner_state.py"}
+# The small-fuse proof skips the two model.py classes this knob changed.
+SMALL_FUSE_PROOF = "tests/models/test_deepseek_v41_small_fuse_knob_off.py"
+NEW_NAME = re.compile(r"^_?v41_", re.IGNORECASE)
+
+
+def _git(*args):
+    return subprocess.run(
+        ["git", "-C", str(ROOT), *args], check=True, capture_output=True, text=True
+    ).stdout
+
+
+@pytest.fixture(scope="module")
+def base_available():
+    try:
+        _git("cat-file", "-e", f"{BASE}^{{commit}}")
+    except (OSError, subprocess.CalledProcessError):
+        pytest.skip(f"base commit {BASE} is not in this checkout")
+
+
+def _is_knob_ref(node):
+    if isinstance(node, ast.Name):
+        return node.id.startswith(PREFIX)
+    if isinstance(node, ast.Attribute):
+        return node.attr.startswith(PREFIX)
+    return False
+
+
+def _knob_value(test):
+    """The test's value with the knob off, or None for any other test."""
+    if _is_knob_ref(test):
+        return False
+    if (
+        isinstance(test, ast.Call)
+        and isinstance(test.func, ast.Name)
+        and test.func.id == "multi_seq_requested"
+        and not test.args
+    ):
+        return False
+    if isinstance(test, ast.UnaryOp) and isinstance(test.op, ast.Not):
+        value = _knob_value(test.operand)
+        return None if value is None else not value
+    if (
+        isinstance(test, ast.Compare)
+        and len(test.ops) == 1
+        and _is_knob_ref(test.left)
+        and isinstance(test.comparators[0], ast.Constant)
+        and test.comparators[0].value is None
+    ):
+        if isinstance(test.ops[0], ast.IsNot):
+            return False
+        if isinstance(test.ops[0], ast.Is):
+            return True
+    if (
+        isinstance(test, ast.BoolOp)
+        and isinstance(test.op, ast.And)
+        and _knob_value(test.values[0]) is False
+    ):
+        return False
+    return None
+
+
+def _defined_name(node):
+    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+        return node.name
+    if isinstance(node, ast.Assign) and len(node.targets) == 1:
+        target = node.targets[0]
+        if isinstance(target, ast.Name):
+            return target.id
+    if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
+        return node.target.id
+    return None
+
+
+def _scope_names(tree):
+    """{scope: names defined at that scope} for the module and its classes."""
+    names = {"": {_defined_name(n) for n in tree.body} - {None}}
+
+    def walk(body, scope):
+        for node in body:
+            if isinstance(node, ast.ClassDef):
+                inner = f"{scope}.{node.name}"
+                names[inner] = {_defined_name(n) for n in node.body} - {None}
+                walk(node.body, inner)
+
+    walk(tree.body, "")
+    return names
+
+
+class KnobOff(ast.NodeTransformer):
+    def __init__(self, base_names):
+        self.base_names = base_names
+        self.scope = [""]
+
+    # -- definitions -----------------------------------------------------
+    def _drop_new(self, body):
+        scope = self.scope[-1]
+        known = self.base_names.get(scope, set())
+        kept = []
+        for node in body:
+            name = _defined_name(node)
+            if name is not None and NEW_NAME.match(name) and name not in known:
+                continue
+            kept.append(node)
+        return kept
+
+    def visit_Module(self, node):
+        node.body = self._drop_new(node.body)
+        self.generic_visit(node)
+        return node
+
+    def visit_ClassDef(self, node):
+        self.scope.append(f"{self.scope[-1]}.{node.name}")
+        node.body = self._drop_new(node.body)
+        self.generic_visit(node)
+        self.scope.pop()
+        return node
+
+    def visit_FunctionDef(self, node):
+        args = node.args
+        positional = args.posonlyargs + args.args
+        defaults = [None] * (len(positional) - len(args.defaults)) + args.defaults
+        keep = [i for i, a in enumerate(positional) if not a.arg.startswith(PREFIX)]
+        kept_args = [positional[i] for i in keep]
+        kept_defaults = [defaults[i] for i in keep]
+        num_posonly = len([a for a in args.posonlyargs if a in kept_args])
+        args.posonlyargs = kept_args[:num_posonly]
+        args.args = kept_args[num_posonly:]
+        args.defaults = [d for d in kept_defaults if d is not None]
+        kw = [
+            (a, d)
+            for a, d in zip(args.kwonlyargs, args.kw_defaults)
+            if not a.arg.startswith(PREFIX)
+        ]
+        args.kwonlyargs = [a for a, _ in kw]
+        args.kw_defaults = [d for _, d in kw]
+        self.generic_visit(node)
+        return node
+
+    visit_AsyncFunctionDef = visit_FunctionDef
+
+    # -- statements ------------------------------------------------------
+    def visit_If(self, node):
+        self.generic_visit(node)
+        value = _knob_value(node.test)
+        if value is False:
+            return node.orelse or None
+        if value is True:
+            return node.body
+        if (
+            isinstance(node.test, ast.Name)
+            and node.test.id == "TYPE_CHECKING"
+            and not node.body
+        ):
+            return node.orelse or None
+        if not node.body:
+            node.body = [ast.Pass()]
+        return node
+
+    def visit_Assign(self, node):
+        if any(_is_knob_ref(t) for t in node.targets):
+            return None
+        if any(
+            isinstance(t, ast.Tuple) and any(_is_knob_ref(e) for e in t.elts)
+            for t in node.targets
+        ):
+            raise AssertionError(f"tuple knob assignment: {ast.unparse(node)}")
+        self.generic_visit(node)
+        return node
+
+    def visit_AnnAssign(self, node):
+        if _is_knob_ref(node.target):
+            return None
+        if isinstance(node.target, ast.Name) and node.target.id == ENV:
+            return None
+        self.generic_visit(node)
+        return node
+
+    def visit_ImportFrom(self, node):
+        if node.module in KNOB_MODULES:
+            return None
+        if node.level == 1 and node.module == "slots":
+            return None
+        if node.module == "typing":
+            node.names = [a for a in node.names if a.name != "TYPE_CHECKING"]
+            if not node.names:
+                return None
+        return node
+
+    # -- expressions -----------------------------------------------------
+    def visit_IfExp(self, node):
+        self.generic_visit(node)
+        value = _knob_value(node.test)
+        if value is False:
+            return node.orelse
+        if value is True:
+            return node.body
+        return node
+
+    def visit_Call(self, node):
+        node.keywords = [
+            k for k in node.keywords if not (k.arg or "").startswith(PREFIX)
+        ]
+        self.generic_visit(node)
+        return node
+
+    def visit_Dict(self, node):
+        pairs = [
+            (k, v)
+            for k, v in zip(node.keys, node.values)
+            if not (isinstance(k, ast.Constant) and k.value == ENV)
+        ]
+        node.keys = [k for k, _ in pairs]
+        node.values = [v for _, v in pairs]
+        self.generic_visit(node)
+        return node
+
+    def _drop_env_items(self, node):
+        node.elts = [
+            e for e in node.elts if not (isinstance(e, ast.Constant) and e.value == ENV)
+        ]
+        self.generic_visit(node)
+        return node
+
+    visit_List = visit_Set = visit_Tuple = _drop_env_items
+
+
+def _normalized(source, base_names):
+    tree = KnobOff(base_names).visit(ast.parse(source))
+    ast.fix_missing_locations(tree)
+    return ast.dump(tree)
+
+
+def _changed_files():
+    status = _git("diff", "--name-status", BASE, "--", "vllm")
+    changed = set()
+    for line in status.splitlines():
+        kind, path = line.split("\t")[0], line.split("\t")[-1]
+        changed.add((kind[0], path))
+    untracked = _git("ls-files", "--others", "--exclude-standard", "--", "vllm")
+    for path in untracked.split():
+        changed.add(("A", path))
+    return changed
+
+
+def test_changed_files_are_the_expected_ones(base_available):
+    changed = _changed_files()
+    modified = {p for k, p in changed if k == "M"}
+    added = {p for k, p in changed if k == "A"}
+    assert not {p for k, p in changed if k not in "MA"}
+    assert modified == CHANGED_FILES
+    assert added == NEW_FILES
+    tests = _git("diff", "--name-only", "--diff-filter=M", BASE, "--", "tests")
+    assert set(tests.split()) == CHANGED_TESTS | {SMALL_FUSE_PROOF}
+
+
+@pytest.mark.parametrize("path", sorted(CHANGED_FILES | CHANGED_TESTS))
+def test_knob_off_ast_is_the_base(base_available, path):
+    base = _git("show", f"{BASE}:{path}")
+    head = (ROOT / path).read_text()
+    base_names = _scope_names(ast.parse(base))
+    assert _normalized(head, base_names) == _normalized(base, base_names), path
+
+
+@pytest.mark.parametrize("path", sorted(NEW_FILES))
+def test_new_module_level_runs_nothing(path):
+    """Only imports, definitions and constant assignments at module level."""
+    tree = ast.parse((ROOT / path).read_text())
+    allowed = (
+        ast.Import,
+        ast.ImportFrom,
+        ast.FunctionDef,
+        ast.ClassDef,
+    )
+    for node in tree.body:
+        if isinstance(node, allowed):
+            continue
+        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant):
+            continue  # docstring
+        if (
+            isinstance(node, ast.If)
+            and isinstance(node.test, ast.Name)
+            and node.test.id == "TYPE_CHECKING"
+        ):
+            continue
+        if isinstance(node, (ast.Assign, ast.AnnAssign)):
+            value = node.value
+            if isinstance(value, (ast.Constant, ast.Tuple)) or (
+                isinstance(value, ast.UnaryOp)
+                and isinstance(value.operand, ast.Constant)
+            ):
+                continue
+            if (
+                isinstance(value, ast.Call)
+                and isinstance(value.func, ast.Name)
+                and value.func.id == "init_logger"
+            ):
+                continue
+        raise AssertionError(f"{path}: module-level statement {ast.unparse(node)}")
+
+
+def test_env_default_is_off(monkeypatch):
+    import vllm.envs as envs
+
+    monkeypatch.delenv(ENV, raising=False)
+    assert envs.environment_variables[ENV]() == "0"
+    source = (ROOT / "vllm/envs.py").read_text()
+    assert f'os.getenv("{ENV}", "0")' in source
+
+
+def test_normalizer_catches_a_reachable_change(base_available):
+    """The proof is not vacuous: an unguarded edit is reported."""
+    path = "vllm/v1/core/sched/scheduler.py"
+    base = _git("show", f"{BASE}:{path}")
+    head = (ROOT / path).read_text()
+    names = _scope_names(ast.parse(base))
+    tampered = head.replace(
+        "self.prev_step_scheduled_req_ids.clear()\n"
+        "            self.prev_step_scheduled_req_ids"
+        ".update(num_scheduled_tokens.keys())",
+        "self.prev_step_scheduled_req_ids.clear()",
+        1,
+    )
+    assert tampered != head
+    assert _normalized(tampered, names) != _normalized(base, names)
+    # A knob test with the wrong polarity is not a guard.
+    tampered = head.replace(
+        "if self.v41_multi_seq is not None:\n            self._v41_begin_step()",
+        "if self.v41_multi_seq is None:\n            self._v41_begin_step()",
+        1,
+    )
+    assert tampered != head
+    assert _normalized(tampered, names) != _normalized(base, names)
