+def test_waiting_request_takes_the_freed_slot(v41):
+    scheduler = create_scheduler(pipeline_parallel_size=2, max_num_seqs=2)
+    request_a, request_b, request_c = create_requests(
+        num_requests=3, num_tokens=20, max_tokens=4
+    )
+    request_b.max_tokens = 20
+    scheduler.add_request(request_a)
+    scheduler.add_request(request_b)
+    scheduler.add_request(request_c)
+    engine = Engine(scheduler)
+    engine.run()
+
+    admitted = {}
+    for step in engine.steps:
+        assert len(scheduler.running) <= 2
+        for new_req in step.scheduled_new_reqs:
+            admitted[new_req.req_id] = step.v41_slots[new_req.req_id]
+    # C waits for a slot, then reuses the one A freed (slot 0).
+    assert admitted == {"0": 0, "1": 1, "2": 0}
+    c_admit = next(
+        i
+        for i, s in enumerate(engine.steps)
+        if any(r.req_id == "2" for r in s.scheduled_new_reqs)
+    )
+    a_finish = next(i for i, s in enumerate(engine.steps) if "0" in s.finished_req_ids)
+    assert c_admit >= a_finish
+    assert request_c.num_output_tokens == 4
