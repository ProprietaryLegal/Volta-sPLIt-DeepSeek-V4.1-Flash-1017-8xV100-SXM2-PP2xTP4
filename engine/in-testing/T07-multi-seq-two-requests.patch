+def test_policy_waiting_turns_and_backoff():
+    multi = V41SchedulerMultiSeq(2, 128, False)
+    a = _req("a")
+    multi.begin_step([a], True, True, 1)
+    assert multi.turn == "a"  # the previous turn was not a running one
+    admitted = SimpleNamespace(request_id="a", num_computed_tokens=0)
+    assert multi.end_step(["a"], [admitted], 1) == {"a": 0}
+    multi.begin_step([a], True, True, 2)
+    assert multi.turn == v41_multi_seq._WAITING
+    assert multi.skip_running(a) and not multi.skip_waiting(0)
+    assert multi.skip_waiting(1)  # one request per step
+    # The waiting turn admitted nothing (e.g. no KV room): back off once.
+    multi.end_step([], [], 2)
+    multi.begin_step([a], True, True, 3)
+    assert multi.turn == "a"
+    multi.end_step(["a"], [], 3)
+    multi.begin_step([a], True, True, 4)
+    assert multi.turn == v41_multi_seq._WAITING
+    # Nothing runnable: the waiting queue gets the turn.
+    multi.begin_step([_req("a", computed=11)], True, True, 5)
+    assert multi.turn == v41_multi_seq._WAITING
+    # Cannot admit: running only.
+    multi.begin_step([a], True, False, 6)
+    assert multi.turn == "a"
+
