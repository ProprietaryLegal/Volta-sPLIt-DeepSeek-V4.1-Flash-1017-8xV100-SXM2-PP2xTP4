+def test_two_requests_alternate_between_stages(v41):
+    scheduler = create_scheduler(pipeline_parallel_size=2, max_num_seqs=2)
+    assert scheduler.v41_multi_seq is not None
+    request_a, request_b = create_requests(num_requests=2, num_tokens=20, max_tokens=9)
+    scheduler.add_request(request_a)
+    scheduler.add_request(request_b)
