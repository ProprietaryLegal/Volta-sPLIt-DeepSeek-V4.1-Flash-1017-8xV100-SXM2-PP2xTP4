+def test_park_skips_preempted_and_resumed(v41, monkeypatch):
+    monkeypatch.setattr(gpu_model_runner, "get_pp_group", lambda: _pp(True))
+    runner = _runner(True, 3, monkeypatch)
+    scheduler = create_scheduler(
+        pipeline_parallel_size=2, max_num_seqs=3, block_size=BLOCK_SIZE
+    )
+    for request in create_requests(num_requests=1, num_tokens=20):
+        scheduler.add_request(request)
+    runner._update_states(scheduler.schedule())
+    empty = scheduler.schedule()
+    assert not empty.num_scheduled_tokens
+    runner._update_states(dataclasses.replace(empty, preempted_req_ids={"0"}))
+    assert runner.v41_multi_seq.parks == {}
+    assert "0" not in runner.input_batch.req_id_to_index
