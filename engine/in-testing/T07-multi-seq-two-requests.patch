diff --git a/tests/models/test_deepseek_v41_slots.py b/tests/models/test_deepseek_v41_slots.py
new file mode 100644
index 000000000..73b2f48d1
--- /dev/null
+++ b/tests/models/test_deepseek_v41_slots.py
@@ -0,0 +1,381 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_MULTI_SEQ: the model's per-slot state (deepseek_v41/slots.py).
+
+CPU only. The module tree is a stand-in with the real state classes' buffer
+names (checked against their sources below); the packed KV store is the real
+``V41PackedKV`` with a one-rank group and a host-memory shim for the CUDA
+registration, so ``v41_add_slot`` itself runs.
+"""
+
+import ast
+import inspect
+import textwrap
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.model_executor.kernels.deepseek_v41_compression import V41C2State
+from vllm.model_executor.layers import deepseek_v41_engram
+from vllm.model_executor.layers.quantization import gguf_expert_cache
+from vllm.models.deepseek_v41 import kv_store, slots
+from vllm.models.deepseek_v41 import model as v41_model
+from vllm.models.deepseek_v41.kv_pack import C_ROW, I_ROW
+from vllm.models.deepseek_v41.pp_commit import StageCommit
+from vllm.models.deepseek_v41.slots import V41Slots
+
+GROUP = SimpleNamespace(
+    rank_in_group=0, world_size=1, broadcast_object=lambda obj, src: obj
+)
+SOURCES = {0: 4, 3: 128}
+
+
+class Native:
+    def __init__(self):
+        self.registered = []
+
+    def host_register(self, pointer, size):
+        self.registered.append((pointer, size))
+
+    def mapped_view(self, host, device_index):
+        return host
+
+
+@pytest.fixture
+def native(monkeypatch):
+    shim = Native()
+    monkeypatch.setattr(gguf_expert_cache, "_native", lambda: shim)
+    return shim
+
+
+def _store(max_len=256):
+    return kv_store.V41PackedKV(SOURCES, max_len, torch.device("cpu"), GROUP)
+
+
+def _buffers(module, values):
+    for name, value in values.items():
+        module.register_buffer(name, value, persistent=False)
+    return module
+
+
+class Ring(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(4))  # shared
+        self.register_buffer("window_ring", torch.zeros(8, 4), persistent=False)
+
+
+def _c2():
+    state = V41C2State.__new__(V41C2State)
+    nn.Module.__init__(state)
+    return _buffers(
+        state,
+        {
+            "norm_weight": torch.ones(512),  # shared
+            "partial": torch.zeros(2, 512),
+            "candidates": torch.zeros(7, 2, 512),
+            "metadata": torch.zeros(3, dtype=torch.int64),
+            "position": torch.zeros(1, dtype=torch.int64),
+        },
+    )
+
+
+def _hash():
+    state = deepseek_v41_engram.V41EngramHashState.__new__(
+        deepseek_v41_engram.V41EngramHashState
+    )
+    nn.Module.__init__(state)
+    return _buffers(
+        state,
+        {
+            "token_map": torch.arange(16),  # shared
+            "history": torch.tensor([-1, -1, -1, 0]),
+            "candidates": torch.zeros(5, 3, dtype=torch.int64),
+            "metadata": torch.zeros(3, dtype=torch.int64),
+        },
+    )
+
+
+class Model(nn.Module):
+    """The attributes V41Slots reads, laid out like DeepseekV41Model."""
+
+    v41_slots = None
+    v41_init_slots = v41_model.DeepseekV41Model.v41_init_slots
+    v41_bind_slot = v41_model.DeepseekV41Model.v41_bind_slot
+
+    def __init__(self, store, first_stage=True, pipelined=True):
+        super().__init__()
+        self.rings = nn.ModuleList([Ring(), Ring()])
+        self.compressors = nn.ModuleList([_c2(), _c2(), _c2()])
+        self.hash_state = _hash() if first_stage else None
+        _buffers(
+            self,
+            {
+                "pending_length": torch.zeros(1, dtype=torch.int64),
+                "pending_position": torch.zeros(1, dtype=torch.int64),
+                "pending_prefill": torch.ones(1, dtype=torch.bool),
+                "stage_commit_count": torch.zeros(1, dtype=torch.int64),  # shared
+            },
+        )
+        self.stage_commit = StageCommit() if first_stage and pipelined else None
+        self.start_layer = 0
+        shared = SimpleNamespace(store=store)
+        self.layers = [SimpleNamespace(attn=SimpleNamespace(shared=shared))]
+
+
+def _per_slot(model):
+    """Every per-slot object, read the way the model's code reads it."""
+    store = model.layers[0].attn.shared.store
+    out = {}
+    for i, ring in enumerate(model.rings):
+        out[f"ring{i}"] = ring.window_ring
+    for i, state in enumerate(model.compressors):
+        for name in slots._C2_FIELDS:
+            out[f"c2{i}.{name}"] = getattr(state, name)
+    if model.hash_state is not None:
+        for name in slots._HASH_FIELDS:
+            out[f"hash.{name}"] = getattr(model.hash_state, name)
+    for name in slots._PENDING_FIELDS:
+        out[name] = getattr(model, name)
+    if model.stage_commit is not None:
+        out["stage_commit"] = model.stage_commit
+    if store is not None:
+        out["arena"] = store.arena
+        out["host_cpu"] = store.host_cpu
+        out["mapped"] = store.mapped
+        for table in ("host", "hot", "index"):
+            for source, tensor in getattr(store, table).items():
+                out[f"{table}{source}"] = tensor
+    return out
+
+
+def _shared(model):
+    store = model.layers[0].attn.shared.store
+    out = {
+        "ring.weight": model.rings[0].weight,
+        "norm_weight": model.compressors[0].norm_weight,
+        "stage_commit_count": model.stage_commit_count,
+    }
+    if model.hash_state is not None:
+        out["token_map"] = model.hash_state.token_map
+    if store is not None:
+        out["staging"] = store.staging
+        out["selected"] = store.selected
+        out["native"] = store.native
+    return out
+
+
+def _fill(state, value):
+    for key, item in state.items():
+        if isinstance(item, torch.Tensor):
+            item.fill_(value if item.dtype != torch.bool else bool(value % 2))
+        elif isinstance(item, StageCommit):
+            item.after_forward(["r"], [5], [3])  # arm a decode forward
+
+
+def test_slots_hold_independent_state(native):
+    model = Model(_store())
+    first = _per_slot(model)
+    initial = {k: v.clone() for k, v in first.items() if isinstance(v, torch.Tensor)}
+    shared = _shared(model)
+    table = V41Slots(model, 3, GROUP)
+    assert table.current == 0 and table.store_slots == 3
+    assert all(_per_slot(model)[k] is v for k, v in first.items())
+
+    seen = [first]
+    for slot in (1, 2):
+        table.bind(slot)
+        state = _per_slot(model)
+        assert state.keys() == first.keys()
+        for key, value in state.items():
+            for other in seen:
+                assert value is not other[key], key
+                if isinstance(value, torch.Tensor) and value.numel():
+                    assert value.data_ptr() != other[key].data_ptr(), key
+            if key in initial:
+                # A new slot starts from the constructors' values.
+                assert torch.equal(value, initial[key]), key
+        assert isinstance(state["stage_commit"], StageCommit)
+        assert not state["stage_commit"].armed
+        assert all(_shared(model)[k] is v for k, v in shared.items())
+        seen.append(state)
+
+    # Writes through the bound slot stay in it.
+    for slot in range(3):
+        table.bind(slot)
+        _fill(_per_slot(model), 10 + slot)
+    for slot in (2, 0, 1, 1, 0):
+        table.bind(slot)
+        assert table.current == slot
+        for key, value in _per_slot(model).items():
+            if isinstance(value, torch.Tensor):
+                if value.dtype == torch.bool:
+                    expected = bool((10 + slot) % 2)
+                    assert bool(value.all()) == expected, (slot, key)
+                else:
+                    assert bool((value == 10 + slot).all()), (slot, key)
+            elif isinstance(value, StageCommit):
+                assert value.armed
+            else:
+                assert value is seen[slot][key], (slot, key)
+    assert all(_shared(model)[k] is v for k, v in shared.items())
+
+
+def test_store_slot_rows(native):
+    store = _store()
+    model = Model(store)
+    assert native.registered == [(store.host_cpu.data_ptr(), store.host_cpu.numel())]
+    table = V41Slots(model, 2, GROUP)
+    assert len(native.registered) == 2
+    table.bind(1)
+    pointer, size = native.registered[1]
+    assert (pointer, size) == (store.host_cpu.data_ptr(), store.host_cpu.numel())
+    assert set(store.host) == set(store.hot) == set(store.index) == set(SOURCES)
+    for source in SOURCES:
+        rows = store.rows[source]
+        assert store.host[source].shape == (rows, C_ROW)
+        assert store.hot[source].shape == (store.hot_rows[source], C_ROW)
+        assert store.index[source].shape == (rows, I_ROW)
+        # The slot's host rows are views of its own arena, at the source's offset.
+        start = store.host_cpu.data_ptr() + store.offsets[source]
+        assert store.host[source].data_ptr() == start
+    store.host[3][-1].fill_(9)
+    table.bind(0)
+    assert not bool(store.host_cpu.any())
+    table.bind(1)
+    assert int(store.host_cpu.sum()) == 9 * C_ROW
+
