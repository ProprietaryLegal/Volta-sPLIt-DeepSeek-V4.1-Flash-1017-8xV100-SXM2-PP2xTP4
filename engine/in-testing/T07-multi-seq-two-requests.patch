+# -- slots and their session records ---------------------------------------
+def _sreq(req_id, tokens, computed=0):
+    return SimpleNamespace(
+        request_id=req_id, all_token_ids=list(tokens), num_computed_tokens=computed
+    )
+
+
+def test_slot_assign_and_release():
+    table = V41SlotTable(3, 128, record_sessions=False)
+    a, b = _sreq("a", range(10)), _sreq("b", range(10))
+    assert table.assign(a) == 0
+    assert table.assign(b) == 1
+    with pytest.raises(RuntimeError, match="already owns"):
+        table.assign(a)
+    table.release(a)
+    assert table.free_slots() == [0, 2]
+    assert table.records == [None, None, None]
+    # A fresh request prefers a slot without a record: here the lowest.
+    assert table.assign(_sreq("c", range(5))) == 0
+    table.assign(_sreq("d", range(5)))
+    with pytest.raises(RuntimeError, match="no free slot"):
+        table.assign(_sreq("e", range(5)))
+    table.release(_sreq("zz", []))  # unknown request: no-op
+
+
+def test_slot_sessions():
+    table = V41SlotTable(2, 128, record_sessions=True)
+    first = _sreq("a", range(300))
+    assert table.assign(first) == 0
+    first.num_computed_tokens = 300
+    table.release(first)
+    assert table.records[0] == (list(range(300)), 300)
+
+    follow_up = _sreq("b", list(range(300)) + [7, 8])
+    assert not table.session_hit(follow_up, 255)  # odd
+    assert not table.session_hit(follow_up, 160)  # outside the rings' reach
+    assert table.session_hit(follow_up, 288)
+    other = _sreq("c", [5] * 302)
+    assert not table.session_hit(other, 288)  # different tokens
+    # A fresh request avoids the slot that holds a session.
+    fresh = _sreq("d", range(4))
+    assert table.assign(fresh) == 1
+    follow_up.num_computed_tokens = 288
+    assert table.assign(follow_up) == 0
+    # The session's slot is taken now: a hit cannot be admitted anywhere.
+    late = _sreq("e", list(range(300)), computed=0)
+    assert not table.session_hit(late, 288)
+
+
+def test_slot_hit_needs_its_own_free_slot():
+    table = V41SlotTable(2, 128, record_sessions=True)
+    req = _sreq("a", range(40), computed=32)
+    with pytest.raises(RuntimeError, match="without a free slot"):
+        table.assign(req)
+
