+"""VLLM_V41_MULTI_SEQ, scheduler side and the shared decision.
+
+The real scheduler runs through the PP=2 synchronous batch-queue cadence
+(``EngineCore.step_with_batch_queue`` with two steps in flight). With the knob
+on, every step schedules one request, two running requests alternate between
+the two pipeline stages, three or four take turns least-recently-scheduled
+first, every running request owns a slot, and no request's history is resent.
+With the knob off (or for a model other than V4.1) the default path runs.
+"""
+
+from collections import deque
+from types import SimpleNamespace
