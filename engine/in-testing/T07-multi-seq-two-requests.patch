+class Engine:
+    """EngineCore.step_with_batch_queue with a queue of two (PP=2), sync.
+
+    Schedule while the queue has room; a step with tokens returns early while
+    the queue is not full (its result is not ready yet); otherwise the oldest
+    step's output is applied, then its drafts (as the knob's runner returns
+    them with the output). ``accept(step, req_id, drafts)`` says how many of a
+    step's drafts are accepted.
+    """
+
+    def __init__(self, scheduler, num_drafts=0, accept=None, on_schedule=None):
+        self.scheduler = scheduler
+        self.queue = deque()
+        self.steps = []
+        self.applied = []
+        self.num_drafts = num_drafts
+        self.accept = accept or (lambda step, req_id, drafts: 0)
+        self.on_schedule = on_schedule
+        self.token = 1000
+
+    def step(self):
+        if len(self.queue) < 2 and self.scheduler.has_requests():
+            scheduled = self.scheduler.schedule()
+            self.steps.append(scheduled)
+            if self.on_schedule is not None:
+                self.on_schedule(scheduled)
+            self.queue.appendleft(scheduled)
+            if scheduled.total_num_scheduled_tokens and len(self.queue) < 2:
+                return
+        if not self.queue:
+            return
+        oldest = self.queue.pop()
+        sampled = {}
+        for req_id in oldest.num_scheduled_tokens:
+            drafts = list(oldest.scheduled_spec_decode_tokens.get(req_id, []))
+            num_accepted = self.accept(len(self.applied), req_id, drafts)
+            sampled[req_id] = drafts[:num_accepted] + [self.token]
+            self.token += 10
+        self.scheduler.update_from_output(oldest, _output(oldest, sampled))
+        self.applied.append(oldest)
+        if self.num_drafts and oldest.num_scheduled_tokens:
+            req_ids = list(oldest.num_scheduled_tokens)
+            self.scheduler.update_draft_token_ids(
+                DraftTokenIds(
+                    req_ids,
+                    [
+                        [self.token + 1 + k for k in range(self.num_drafts)]
+                        for _ in req_ids
+                    ],
+                )
+            )
+
+    def run(self, max_steps=400):
+        for _ in range(max_steps):
+            if not self.scheduler.has_requests() and not self.queue:
+                return
+            self.step()
+        raise AssertionError("the engine did not drain")
+
+
+def _scheduled_ids(steps):
+    return [list(s.num_scheduled_tokens) for s in steps]
