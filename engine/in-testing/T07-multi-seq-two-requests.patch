+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_MULTI_SEQ, V1 runner side.
+
+The real scheduler (knob on, PP=2, three drafts per decode step) drives the
+real ``GPUModelRunner._update_states`` of a first-stage and a last-stage
+runner on CPU ``InputBatch`` objects through the batch-queue cadence. Two or
+three requests interleave, so every request leaves the persistent batch on
+the steps of the others: its row is parked and re-added by memcpy, the first
+stage rebuilds its accepted drafts from the parked drafts (the scheduler no
+longer resends the history), and the model is bound to the step's slot. The
+runners are built without ``__init__`` (no GPU, no process group).
+"""
+
+import dataclasses
+from collections import deque
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+import torch
+
+import vllm.v1.worker.gpu_model_runner as gpu_model_runner
+import vllm.v1.worker.v41_multi_seq_runner as multi_runner
+from tests.v1.core.utils import create_requests, create_scheduler
+from vllm.config import CUDAGraphMode
+from vllm.forward_context import BatchDescriptor
+from vllm.sampling_params import SamplingParams
+from vllm.v1.core.sched import v41_multi_seq
+from vllm.v1.outputs import DraftTokenIds, ModelRunnerOutput
+from vllm.v1.worker.gpu_input_batch import CachedRequestState, InputBatch
+from vllm.v1.worker.gpu_model_runner import GPUModelRunner
+from vllm.v1.worker.v41_multi_seq_runner import (
+    ParkedRow,
+    V41MultiSeqRunner,
+    copy_parked_row,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+KNOB = "VLLM_V41_MULTI_SEQ"
+BLOCK_SIZE = 16
+MAX_MODEL_LEN = 512
+NUM_DRAFTS = 3
+
+
+@pytest.fixture(autouse=True)
+def two_devices(monkeypatch):
+    monkeypatch.setattr("vllm.config.parallel.current_platform.device_count", lambda: 2)
+
