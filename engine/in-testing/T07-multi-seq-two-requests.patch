+def test_slot_variant():
+    assert slot_variant(0) == 0
+    assert [slot_variant(k) for k in (1, 2, 3)] == [
+        SLOT_VARIANT_BASE - 1,
+        SLOT_VARIANT_BASE - 2,
+        SLOT_VARIANT_BASE - 3,
+    ]
+    # Never the long-context variant (-1) or a drafter variant (>= 0).
+    assert all(slot_variant(k) < -1 for k in (1, 2, 3))
+    for bad in (-1, 4):
+        with pytest.raises(ValueError):
+            slot_variant(bad)
