+def test_attach_drafts(monkeypatch, last, spec, attached):
+    helper, runner = _helper(last=last, spec=spec, monkeypatch=monkeypatch)
+    drafts = DraftTokenIds(["a"], [[1, 2]])
+    runner.take_draft_token_ids = lambda: drafts
+    output = SimpleNamespace(v41_multi_seq_drafts=None)
+    helper.attach_drafts(output)
+    assert (output.v41_multi_seq_drafts is drafts) is attached
+    if attached:
+        # No drafts this step: an empty set, so the engine takes nothing.
+        runner.take_draft_token_ids = lambda: None
+        helper.attach_drafts(output)
+        assert output.v41_multi_seq_drafts == DraftTokenIds([], [])
