+class FakeModel:
+    """Records what the runner asks of the V4.1 model."""
+
+    def __init__(self):
+        self.binds = []
+        self.restores = []
+
+    def v41_bind_slot(self, slot, new_sequence=False):
+        self.binds.append((slot, new_sequence))
+
+    def restore_prefix(self, cached, token_ids):
+        self.restores.append((cached, list(token_ids)))
