--- /dev/null
+++ b/vllm/v1/worker/v41_multi_seq_runner.py
@@ -0,0 +1,279 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_MULTI_SEQ: the V1 GPU model runner's side.
+
+The scheduler runs one request per step and names its slot
+(``SchedulerOutput.v41_slots``, vllm/v1/core/sched/v41_multi_seq.py). Here:
+
+- ``begin_update``: bind the model's per-request state to that slot before
+  anything in the step touches it (``restore_prefix``, the forward, the
+  first stage's commit protocol);
+- ``park`` / ``take_row`` / ``prepend_parked_drafts``: a running request that is not
+  scheduled in a step leaves the persistent batch, as on the default path,
+  but its token row and last drafts are kept. The scheduler does not resend
+  its history (the held record), so on re-add the row is a memcpy instead of
+  a list conversion of the whole context, and a non-last pipeline stage still
+  knows the drafts its accepted count refers to;
+- ``slot_descriptor`` / ``capture_slot_graphs``: one FULL CUDA graph set per
+  slot (graphs bake the slot's buffer addresses), slot k > 0 keyed by
+  ``slot_variant(k)``, which also gives it its own graph memory pool;
+- ``attach_drafts``: with a batch queue (PP), the step's drafts travel with
+  its output, because another request's step is always in flight when this
+  one is applied (vllm/v1/engine/core.py).
+
+Everything is plain Python bookkeeping on the host; nothing here adds device
+work to a step except the slot's own graphs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from typing import TYPE_CHECKING, Any
+
+import numpy as np
+import torch
+
+from vllm.config import CUDAGraphMode
+from vllm.distributed.parallel_state import get_pp_group, get_tp_group
+from vllm.logger import init_logger
+from vllm.v1.core.sched.v41_multi_seq import KNOB, slot_variant
+from vllm.v1.outputs import DraftTokenIds
+
+if TYPE_CHECKING:
+    from vllm.forward_context import BatchDescriptor
+    from vllm.v1.core.sched.output import SchedulerOutput
+    from vllm.v1.outputs import ModelRunnerOutput
+    from vllm.v1.worker.gpu_input_batch import CachedRequestState
+
+logger = init_logger(__name__)
+
+
+@dataclass
+class ParkedRow:
+    """A running request's persistent-batch row while it is not scheduled."""
+
+    tokens: np.ndarray  # token_ids_cpu[row, :num_tokens] (a copy)
+    spec: list[int]  # the drafts scheduled in its last step
+
+
+def copy_parked_row(
+    token_ids_cpu: np.ndarray,
+    is_token_ids: np.ndarray,
+    req_index: int,
+    request: CachedRequestState,
+    parked: ParkedRow,
+) -> None:
+    """InputBatch.add_request's token copy, from a parked row.
+
+    Tokens only ever append to a parked request (the scheduler's sampled
+    tokens on a non-last stage, this rank's own samples on the last), or its
+    output tail is trimmed; the row's prefix up to the current length is
+    therefore still exact. The tail since the park comes from the lists.
+    """
+    num_tokens = request.num_tokens
+    keep = min(len(parked.tokens), num_tokens)
+    if keep and int(parked.tokens[keep - 1]) != request.get_token_id(keep - 1):
+        raise RuntimeError(
+            f"{KNOB}: the parked token row of request {request.req_id} "
+            f"disagrees with its token lists at position {keep - 1}"
+        )
+    row = token_ids_cpu[req_index]
+    row[:keep] = parked.tokens[:keep]
+    if keep < num_tokens:
+        num_prompt = len(request.prompt_token_ids or ())
+        if keep < num_prompt:
+            assert request.prompt_token_ids is not None
+            row[keep:num_prompt] = request.prompt_token_ids[keep:]
+            keep = num_prompt
+        row[keep:num_tokens] = request.output_token_ids[keep - num_prompt :]
+    is_token_ids[req_index, :num_tokens] = True
+
+
+class V41MultiSeqRunner:
+    def __init__(self, runner: Any, reason: str):
+        self.runner = runner
+        self.num_slots = runner.scheduler_config.max_num_seqs
+        problems = []
+        if runner.dynamic_draft_vocab_prefill_topk:
+            problems.append(
+                "the dynamic draft-vocabulary prefill bootstrap (GPU LRU rows)"
+            )
+        if problems:
+            raise ValueError(
+                f"{KNOB}=1 does not support: {'; '.join(problems)}. Unset {KNOB}."
+            )
+        pp = get_pp_group()
+        self.pp_rank, self.pp_size = pp.rank_in_group, pp.world_size
+        self.drafts_with_output = (
+            pp.world_size > 1
+            and pp.is_last_rank
+            and runner.speculative_config is not None
+        )
+        self.parks: dict[str, ParkedRow] = {}
+        # This step's slot; None for a step without a request.
+        self.slot: int | None = None
+        self.captured_variants: list[int] = []
+        self.reason = reason
+
+    def log_activation(self, capture_sizes: Any) -> None:
+        if get_tp_group().rank_in_group != 0:
+            return
+        logger.info(
+            "%s=1 active (runner, pp rank %d of %d): max_num_seqs=%d, %s; "
+            "kernel routes: one request per step, so the single-request M<=6 "
+            "kernels and their numerics (graph sizes %s, one batch row); "
+            "per-slot FULL CUDA graphs (slot 0 the default variant, slot k "
+            "variant %s); drafts %s.",
+            KNOB,
+            self.pp_rank,
+            self.pp_size,
+            self.num_slots,
+            self.reason,
+            capture_sizes,
+            "-1000-k",
+            "returned with each step's output"
+            if self.drafts_with_output
+            else "taken by the engine as on the default path",
+        )
+
+    # -- per step --------------------------------------------------------
+    def begin_update(self, scheduler_output: SchedulerOutput) -> None:
+        """Top of _update_states: forget finished requests, bind the slot."""
+        slots = scheduler_output.v41_slots
+        if slots is None:
+            raise RuntimeError(
+                f"{KNOB}=1 in the worker but the scheduler sent no slots; the "
+                "engine and the workers must share the setting"
+            )
+        for req_id in scheduler_output.finished_req_ids:
+            self.parks.pop(req_id, None)
+        for new_req in scheduler_output.scheduled_new_reqs:
+            self.parks.pop(new_req.req_id, None)
+        resumed = scheduler_output.scheduled_cached_reqs.resumed_req_ids
+        for req_id in resumed:
+            self.parks.pop(req_id, None)
+        if len(slots) > 1:
+            raise RuntimeError(
+                f"{KNOB}: {len(slots)} requests in one step; V4.1 runs one"
+            )
+        if not slots:
+            self.slot = None
+            return
+        ((req_id, slot),) = slots.items()
+        # A request that starts at position 0 (new, or resumed without a
+        # prefix hit) starts a new sequence in its slot; restore_prefix
+        # resets a prefix-hit start.
+        fresh = any(
+            new_req.req_id == req_id and new_req.num_computed_tokens == 0
+            for new_req in scheduler_output.scheduled_new_reqs
+        )
+        if not fresh and req_id in resumed:
+            cached = scheduler_output.scheduled_cached_reqs
+            fresh = cached.num_computed_tokens[cached.req_ids.index(req_id)] == 0
+        self.runner.get_model().v41_bind_slot(slot, new_sequence=fresh)
+        self.slot = slot
+
+    def park(self, req_id: str, scheduler_output: SchedulerOutput) -> None:
+        """Before a running request that is not scheduled leaves the batch."""
+        if req_id in (scheduler_output.preempted_req_ids or ()) or (
+            req_id in scheduler_output.scheduled_cached_reqs.resumed_req_ids
+        ):
+            self.parks.pop(req_id, None)
+            return
+        batch = self.runner.input_batch
+        index = batch.req_id_to_index[req_id]
+        num_tokens = int(batch.num_tokens_no_spec[index])
+        self.parks[req_id] = ParkedRow(
+            batch.token_ids_cpu[index, :num_tokens].copy(),
+            list(batch.spec_token_ids[index]),
+        )
+
+    def is_parked(self, req_id: str) -> bool:
+        return req_id in self.parks
+
+    def prepend_parked_drafts(
+        self,
+        req_id: str,
+        req_state: CachedRequestState,
+        num_computed_tokens: int,
+        sent_token_ids: list[int],
+    ) -> list[int]:
+        """A non-last PP rank re-adds a parked request: the tokens accepted
+        in its last step are its parked drafts. (The default path,
+        GPUModelRunner._pp_prepend_accepted_drafts, has no row to read them
+        from, and the scheduler sends no history for a held request.)"""
+        num_accepted = num_computed_tokens - req_state.num_tokens
+        if num_accepted <= 0:
+            return sent_token_ids
+        spec = self.parks[req_id].spec
+        if num_accepted > len(spec):
+            raise RuntimeError(
+                f"{KNOB}: {num_accepted} accepted draft token(s) of request "
+                f"{req_id} but {len(spec)} parked; the scheduler and the "
+                "runner disagree about its last step"
+            )
+        return spec[:num_accepted] + list(sent_token_ids)
+
+    def take_row(self, request: CachedRequestState) -> ParkedRow | None:
+        return self.parks.pop(request.req_id, None)
+
+    def restore_resumed(self, num_computed_tokens: int, token_ids: list[int]):
+        """A preempted request resumed at a prefix hit in its own slot."""
+        restore = getattr(self.runner.get_model(), "restore_prefix", None)
+        if restore is not None:
+            restore(num_computed_tokens, token_ids)
+
+    def slot_descriptor(
+        self, mode: CUDAGraphMode, batch_desc: BatchDescriptor
+    ) -> BatchDescriptor:
+        if mode == CUDAGraphMode.NONE or not self.slot:
+            return batch_desc
+        return replace(batch_desc, graph_variant=slot_variant(self.slot))
+
+    def attach_drafts(self, output: ModelRunnerOutput) -> None:
+        if self.drafts_with_output:
+            drafts = self.runner.take_draft_token_ids()
+            output.v41_multi_seq_drafts = (
+                drafts if drafts is not None else DraftTokenIds([], [])
+            )
+
+    # -- start-up --------------------------------------------------------
+    def capture_slot_graphs(self) -> None:
+        """After the default capture: the same graphs for every other slot."""
+        if self.num_slots == 1:
+            return
+        runner = self.runner
+        plan = list(runner.cudagraph_dispatcher.get_capture_descs())
+        for _, descs in plan:
+            for desc in descs:
+                if desc.graph_variant != 0 or desc.attention_context_bucket:
+                    raise ValueError(
+                        f"{KNOB}=1 does not support context-specialized CUDA "
+                        f"graphs ({desc}); unset {KNOB} or the graph buckets"
+                    )
+        model = runner.get_model()
+        count = 0
+        try:
+            for slot in range(1, self.num_slots):
+                model.v41_bind_slot(slot, new_sequence=True)
+                for mode, descs in plan:
+                    for desc in descs:
+                        slot_desc = replace(desc, graph_variant=slot_variant(slot))
+                        runner._warmup_and_capture(
+                            slot_desc,
+                            cudagraph_runtime_mode=mode,
+                            batch_descriptor_override=slot_desc,
+                        )
+                        count += 1
+                    torch.accelerator.synchronize()
+                self.captured_variants.append(slot_variant(slot))
+        finally:
+            model.v41_bind_slot(0, new_sequence=True)
+        if get_tp_group().rank_in_group == 0:
+            logger.info(
+                "%s: captured %d CUDA graph(s) for slot(s) 1..%d (variants %s).",
+                KNOB,
+                count,
+                self.num_slots - 1,
+                self.captured_variants,
+            )
