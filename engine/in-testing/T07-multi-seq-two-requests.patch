+@pytest.fixture(autouse=True)
+def two_devices(monkeypatch):
+    # Scheduler bookkeeping is CPU-only; do not require two physical GPUs.
+    monkeypatch.setattr("vllm.config.parallel.current_platform.device_count", lambda: 2)
