+    engine.run()
+
+    ids = _scheduled_ids(engine.steps)
+    assert all(len(step) <= 1 for step in ids)
+    # Admission takes the first two steps (one request each), then the two
+    # requests alternate with no empty step until the first one finishes.
+    assert ids[:2] == [["0"], ["1"]]
+    steady = ids[2 : 2 + 2 * 8]
+    assert steady == [["0"], ["1"]] * 8
+    for step in engine.steps:
