+def test_three_requests_take_turns(v41):
+    scheduler = create_scheduler(pipeline_parallel_size=2, max_num_seqs=3)
+    requests = create_requests(num_requests=3, num_tokens=20, max_tokens=12)
+    for request in requests:
+        scheduler.add_request(request)
+    engine = Engine(scheduler)
+    engine.run()
+
+    ids = [step[0] for step in _scheduled_ids(engine.steps) if step]
+    # A waiting request gets every other turn while one can be admitted.
+    assert ids[:4] == ["0", "1", "0", "2"]
+    # Least recently scheduled first: every window of three is a permutation.
+    steady = ids[4:30]
+    for i in range(len(steady) - 2):
+        assert sorted(steady[i : i + 3]) == ["0", "1", "2"]
+    # With three runnable requests and two stages there is no empty step.
+    first_finish = min(
+        i for i, step in enumerate(engine.steps) if step.finished_req_ids
+    )
+    assert all(s.num_scheduled_tokens for s in engine.steps[:first_finish])
+    assert sorted(
+        set(s for step in engine.steps for s in (step.v41_slots or {}).values())
+    ) == [
+        0,
+        1,
+        2,
+    ]
+    assert all(r.num_output_tokens == 12 for r in requests)
