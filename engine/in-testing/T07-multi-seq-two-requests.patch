+def test_spec_decode_drafts_and_new_tokens(v41):
+    """Drafts travel with each step's output; the first stage gets the bonus
+    token only, and the accepted count moves num_computed_tokens."""
+    scheduler = create_scheduler(
+        pipeline_parallel_size=2, max_num_seqs=2, num_speculative_tokens=3
+    )
+    request_a, request_b = create_requests(num_requests=2, num_tokens=20, max_tokens=40)
+    scheduler.add_request(request_a)
+    scheduler.add_request(request_b)
+    pattern = [0, 3, 1, 2, 3, 0, 2]
+    engine = Engine(
+        scheduler,
+        num_drafts=3,
+        accept=lambda step, req_id, drafts: min(len(drafts), pattern[step % 7]),
+    )
+    engine.run()
+    decode_steps = [s for s in engine.steps if s.scheduled_cached_reqs.req_ids]
+    assert decode_steps
+    for step in decode_steps:
+        (req_id,) = step.num_scheduled_tokens
+        drafts = step.scheduled_spec_decode_tokens.get(req_id, [])
+        assert len(drafts) == 3
+        assert step.num_scheduled_tokens[req_id] == 1 + len(drafts)
+        (sent,) = step.scheduled_cached_reqs.new_token_ids
+        assert len(sent) == 1
+        assert not step.scheduled_cached_reqs.all_token_ids
+    assert request_a.num_output_tokens >= 40
+    assert request_b.num_output_tokens >= 40
