+# -- graphs and drafts -------------------------------------------------------
+def _helper(num_slots=3, last=True, spec=True, monkeypatch=None):
+    if monkeypatch is not None:
+        monkeypatch.setattr(multi_runner, "get_pp_group", lambda: _pp(last))
+    runner = SimpleNamespace(
+        scheduler_config=SimpleNamespace(max_num_seqs=num_slots),
+        dynamic_draft_vocab_prefill_topk=0,
