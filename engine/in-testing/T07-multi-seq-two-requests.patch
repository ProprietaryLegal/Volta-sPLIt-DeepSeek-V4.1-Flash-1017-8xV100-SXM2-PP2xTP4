+def test_prepend_uses_parked_drafts():
+    helper = multi_runner.V41MultiSeqRunner.__new__(multi_runner.V41MultiSeqRunner)
+    helper.parks = {"r": multi_runner.ParkedRow(np.arange(11), [7, 8, 9])}
+    req_state = SimpleNamespace(num_tokens=11)
+    assert helper.is_parked("r") and not helper.is_parked("s")
+    # 2 of 3 parked drafts accepted: computed 11 -> 13, the bonus token at 13.
+    assert helper.prepend_parked_drafts("r", req_state, 13, [42]) == [7, 8, 42]
+    assert helper.prepend_parked_drafts("r", req_state, 11, [42]) == [42]
+    # More accepted than parked: fail closed (the default path only warns).
+    with pytest.raises(RuntimeError, match="3 parked"):
+        helper.prepend_parked_drafts("r", req_state, 15, [42])
+
