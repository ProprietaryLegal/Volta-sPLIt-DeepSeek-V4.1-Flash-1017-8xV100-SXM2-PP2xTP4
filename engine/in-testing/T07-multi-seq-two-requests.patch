+def test_slot_descriptor(monkeypatch):
+    helper, _ = _helper(monkeypatch=monkeypatch)
+    desc = BatchDescriptor(num_tokens=6, num_reqs=1, uniform=False)
+    helper.slot = None
+    assert helper.slot_descriptor(CUDAGraphMode.FULL, desc) is desc
+    helper.slot = 0
+    assert helper.slot_descriptor(CUDAGraphMode.FULL, desc) is desc
+    helper.slot = 2
+    assert helper.slot_descriptor(CUDAGraphMode.NONE, desc) is desc
+    slot_desc = helper.slot_descriptor(CUDAGraphMode.FULL, desc)
+    assert slot_desc == dataclasses.replace(desc, graph_variant=-1002)
