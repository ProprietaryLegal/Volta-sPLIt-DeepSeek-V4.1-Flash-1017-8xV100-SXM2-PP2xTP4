index e401a9054..ca9db5467 100644
--- a/vllm/v1/core/kv_cache_manager.py
+++ b/vllm/v1/core/kv_cache_manager.py
@@ -9,6 +9,7 @@ from typing import Literal, overload
 import vllm.envs as envs
