+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build the V4.1 v41idx CUDA extension (SM70) into ./build/v41idx.so.
+
+VLLM_V41_INDEX_TILED loads it from VLLM_V41_INDEX_TILED_LIB, defaulting to
+benchmarks/deepseek_v41/v41idx/build/v41idx.so beside VLLM_V41K_LIB's v41k
+directory. V41IDX_BUILD_DIR overrides the build directory. The nvcc flags are
+v41k's (no fast-math: the kernel must round exactly like v41k's reference).
+"""
+
+import os
+
+from torch.utils import cpp_extension as ce
+
+here = os.path.dirname(os.path.abspath(__file__))
+build = os.environ.get("V41IDX_BUILD_DIR") or os.path.join(here, "build")
+os.makedirs(build, exist_ok=True)
+ce.load(
+    name="v41idx",
+    sources=[os.path.join(here, "v41idx.cu")],
+    extra_cuda_cflags=[
+        "-O3",
+        "-gencode",
+        "arch=compute_70,code=sm_70",
+        "--expt-relaxed-constexpr",
+        "-std=c++20",
+        "-U__CUDA_NO_HALF_OPERATORS__",
+        "-U__CUDA_NO_HALF_CONVERSIONS__",
+        "-U__CUDA_NO_HALF2_OPERATORS__",
+        "-U__CUDA_NO_BFLOAT16_CONVERSIONS__",
+    ],
+    extra_cflags=["-O3", "-std=c++20"],
+    is_python_module=False,
+    build_directory=build,
+    verbose=False,
+)
+print("built", os.path.join(build, "v41idx.so"))
diff --git a/benchmarks/deepseek_v41/v41idx/check_v41idx.py b/benchmarks/deepseek_v41/v41idx/check_v41idx.py
new file mode 100644
index 000000000..9b823d355
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/check_v41idx.py
@@ -0,0 +1,321 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check of v41idx.index_scores_tiled (owner window only, server down).
+
+Every case runs three kernels on the same inputs and NaN-poisoned outputs:
+  v41k   torch.ops.v41k.index_scores_decode from the DEPLOYED v41k.so (--v41k)
+  ref    torch.ops.v41idx.index_scores_ref (the embedded verbatim copy)
+  tiled  torch.ops.v41idx.index_scores_tiled (the new kernel)
+and requires tiled == v41k and ref == v41k BITWISE over the whole output row
+(written columns and the poison past the live end), plus a minimum number of
+written / finite values so the comparison is not of poison alone.
+
+Matrix: heads 8 (tokens 1..8) and 4 (tokens 1..16); capacities 1, 63, 64, 65,
+1000, 4097, 65536, 131072; live ends 0, 1, 31, 32, 63, 64, 65, 1000, 37500,
+75000 and the capacity (each <= capacity); ratio 1, 4, 8 (positions[-1] at
+every offset inside the ratio group); realistic keys (scale exponents near
+the observed range) and full-range keys (every scale byte, NaN/Inf scales);
+normal and extreme q / weights (+-65504, Inf, NaN); a plain output and a
+bank-like one (rows of a wider [16, width] buffer, as bank.partial[:tokens]).
+Then CUDA graphs: one capture replayed with changed positions (live ends
+5 .. capacity) against eager v41k, and, in a fresh process, a capture whose
+first-ever tiled call is inside the capture (T 6 and T 8). Then timing in
+graphs (TIME lines, us per call, tiled vs deployed v41k).
+
+  --quick      reduced matrix (TP4 runs); --sanitize: small grid for
+  compute-sanitizer (one capacity past 2 CTAs x SMs so the persistent loop
+  turns), no graphs, no timing; --no-time; --json PATH. Exit 0 only when every check
+  passes ("ALL OK"); any mismatch or exception -> "FAILED", exit 1.
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+
+import torch
+
+POISON_BASE = 0x7E00
+
+
+def load(lib, v41k):
+    torch.ops.load_library(v41k)
+    torch.ops.load_library(lib)
+    assert hasattr(torch.ops.v41k, "index_scores_decode"), v41k
+    assert int(torch.ops.v41idx.version()) == 1, lib
+
+
+def poison(rows, width, dev):
+    p = (torch.arange(rows * width, device=dev, dtype=torch.int32) & 0x1FF) | POISON_BASE
+    return p.to(torch.int16).view(torch.float16).reshape(rows, width)
+
+
+def make_keys(cap, mode, gen, dev):
+    k = torch.randint(0, 256, (cap, 68), generator=gen, dtype=torch.uint8, device="cpu")
+    if mode == "real":
+        # biased E8M0 exponents around the observed index-key range (2^-12 .. 2^4)
+        k[:, 64:] = torch.randint(115, 132, (cap, 4), generator=gen, dtype=torch.uint8)
+    else:
+        k[:, 64:] = torch.randint(0, 256, (cap, 4), generator=gen, dtype=torch.uint8)
+        if cap >= 4:
+            k[0, 64:] = 255  # NaN/Inf scale
+            k[1, 64:] = 0    # zero scale
+            k[2, 64:] = 254
+            k[3, 64:] = 1
+    return k.to(dev)
+
+
+def make_qw(rows, mode, gen, dev):
+    q = torch.randn(rows, 128, generator=gen, dtype=torch.float32)
+    w = torch.randn(rows, generator=gen, dtype=torch.float32) * 0.5
+    if mode == "extreme":
+        q[0, 0] = 65504.0
+        q[0, 1] = -65504.0
+        q[0, 5] = float("inf")
+        w[0] = 65504.0
+        if rows > 1:
+            q[1, 7] = float("nan")
+            w[1] = float("-inf")
+        if rows > 2:
+            q[2, :] = 1000.0
+            w[2] = -0.0
+        if rows > 3:
+            w[3] = float("nan")
+    return q.half().to(dev).contiguous(), w.half().to(dev).contiguous()
+
+
+def positions_for(tokens, end, ratio, off):
+    """tokens consecutive positions whose last one gives (p + 1) // ratio == end."""
+    if end == 0:
+        last = ratio - 2 - off  # needs ratio >= 2
+    else:
+        last = end * ratio - 1 + off
+    return torch.arange(last - tokens + 1, last + 1, dtype=torch.int64).clamp_min(0)
+
+
+class Stats:
+    def __init__(self):
+        self.cases = 0
+        self.bad = []
+        self.written = 0
+        self.finite = 0
+
+    def ok(self):
+        return not self.bad
+
+
+def run_case(st, H, T, keys, q, w, pos, ratio, bank, tag):
+    dev = keys.device
+    cap = keys.shape[0]
+    width = cap + 40 if bank else cap
+    outs = {}
+    for name in ("v41k", "ref", "tiled"):
+        if bank:
+            buf = poison(16, width, dev)
+            o = buf[:T]
+        else:
+            o = poison(T, width, dev)
+        args = (o, q, w, keys, pos, H, ratio)
+        if name == "v41k":
+            torch.ops.v41k.index_scores_decode(*args)
+        elif name == "ref":
+            torch.ops.v41idx.index_scores_ref(*args)
+        else:
+            torch.ops.v41idx.index_scores_tiled(*args)
+        outs[name] = o
+    a = outs["v41k"].view(torch.int16)
+    st.cases += 1
+    for name in ("ref", "tiled"):
+        b = outs[name].view(torch.int16)
+        if not torch.equal(a, b):
+            n = int((a != b).sum().item())
+            st.bad.append(f"{tag} {name}!=v41k ({n} values)")
+    pz = poison(T, width, dev).view(torch.int16)
+    written = a != pz
+    st.written += int(written.sum().item())
+    st.finite += int((written & torch.isfinite(outs["v41k"])).sum().item())
+
+
+def matrix(st, dev, quick, sanitize, seed=1103):
+    gen = torch.Generator().manual_seed(seed)
+    if sanitize:
+        # 12000 keys = 188 blocks > 2 CTAs x 80 SMs: the persistent loop runs twice
+        caps, hts = [65, 12000], [(8, 1), (8, 6), (8, 8), (4, 16)]
+    elif quick:
+        caps = [64, 65, 4097, 131072]
+        hts = [(8, t) for t in (1, 2, 6, 8)] + [(4, t) for t in (1, 6, 16)]
+    else:
+        caps = [1, 63, 64, 65, 1000, 4097, 65536, 131072]
+        hts = [(8, t) for t in range(1, 9)] + [(4, t) for t in range(1, 17)]
+    ends_all = [0, 1, 31, 32, 63, 64, 65, 1000, 37500, 75000]
+    ratios = [1, 4] if sanitize else [1, 4, 8]
+    for cap in caps:
+        for kmode in ("real", "full"):
+            keys = make_keys(cap, kmode, gen, dev)
+            ends = sorted({e for e in ends_all if e <= cap} | {cap})
+            if sanitize or quick:
+                ends = sorted({e for e in (0, 1, 63, 65, cap // 2, cap) if e <= cap})
+            for H, T in hts:
+                for qmode in ("normal",) if sanitize else ("normal", "extreme"):
+                    q, w = make_qw(T * H, qmode, gen, dev)
+                    for ratio in ratios:
+                        for end in ends:
+                            if end == 0 and ratio < 2:
+                                continue
+                            offs = {0, ratio - 1} if end else {0}
+                            for off in sorted(offs):
+                                if end == 0 and off > ratio - 2:
+                                    continue
+                                pos = positions_for(T, end, ratio, off).to(dev)
+                                for bank in (True,) if sanitize else (False, True):
+                                    tag = (f"H{H} T{T} cap{cap} {kmode}/{qmode} r{ratio} "
+                                           f"end{end}+{off} {'bank' if bank else 'plain'}")
+                                    run_case(st, H, T, keys, q, w, pos, ratio, bank, tag)
+    torch.cuda.synchronize()
+
+
+def graph_replay(st, dev):
+    """One capture, replayed with changed positions; compared with eager v41k."""
+    gen = torch.Generator().manual_seed(7)
+    H, T, cap = 8, 6, 131072
+    keys = make_keys(cap, "real", gen, dev)
+    q, w = make_qw(T * H, "normal", gen, dev)
+    pos = positions_for(T, 1, 4, 0).to(dev)
+    out = poison(T, cap, dev)
+    torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)  # warm (eager)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)
+    for end in (5, 64, 65, 1000, 37500, 75000, 131071, 131072):
+        for off in (0, 3):
+            pos.copy_(positions_for(T, end, 4, off).to(dev))
+            out.copy_(poison(T, cap, dev))
+            g.replay()
+            ref = poison(T, cap, dev)
+            torch.ops.v41k.index_scores_decode(ref, q, w, keys, pos, H, 4)
+            torch.cuda.synchronize()
+            st.cases += 1
+            if not torch.equal(out.view(torch.int16), ref.view(torch.int16)):
+                st.bad.append(f"graph replay end{end}+{off}: tiled!=v41k")
+
+
+FIRST_IN_CAPTURE = r"""
+import sys, torch
+sys.path.insert(0, {here!r})
+import check_v41idx as c
+c.load({lib!r}, {v41k!r})
+dev = torch.device("cuda:0")
+torch.cuda.init()
+gen = torch.Generator().manual_seed(11)
+H, T, cap = 8, {T}, 65536
+keys = c.make_keys(cap, "real", gen, dev)
+q, w = c.make_qw(T * H, "normal", gen, dev)
+pos = c.positions_for(T, 30000, 4, 1).to(dev)
+out = c.poison(T, cap, dev)
+torch.cuda.synchronize()
+g = torch.cuda.CUDAGraph()
+with torch.cuda.graph(g):
+    torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)
+g.replay()
+ref = c.poison(T, cap, dev)
+torch.ops.v41k.index_scores_decode(ref, q, w, keys, pos, H, 4)
+torch.cuda.synchronize()
+print("FIRSTCAP", "OK" if torch.equal(out.view(torch.int16), ref.view(torch.int16)) else "MISMATCH")
+"""
+
+
+def first_call_in_capture(st, lib, v41k):
+    here = os.path.dirname(os.path.abspath(__file__))
+    for T in (6, 8):
+        r = subprocess.run(
+            [sys.executable, "-I", "-c",
+             FIRST_IN_CAPTURE.format(here=here, lib=lib, v41k=v41k, T=T)],
+            capture_output=True, text=True,
+        )
+        st.cases += 1
+        if r.returncode != 0 or "FIRSTCAP OK" not in r.stdout:
+            st.bad.append(f"first call inside capture T{T}: rc={r.returncode} "
+                          f"{(r.stdout + r.stderr)[-300:]}")
+
+
+def timing(dev, lines):
+    gen = torch.Generator().manual_seed(3)
+    H, T = 8, 6
+    for cap in (65536, 131072):
+        keys = make_keys(cap, "real", gen, dev)
+        q, w = make_qw(T * H, "normal", gen, dev)
+        for end in (1000, 10000, 37500, 75000, 131072):
+            if end > cap:
+                continue
+            pos = positions_for(T, end, 4, 0).to(dev)
+            res = {}
+            for name in ("v41k", "tiled"):
+                out = poison(T, cap, dev)
+                op = (torch.ops.v41k.index_scores_decode if name == "v41k"
+                      else torch.ops.v41idx.index_scores_tiled)
+                op(out, q, w, keys, pos, H, 4)
+                torch.cuda.synchronize()
+                g = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(g):
+                    for _ in range(20):
+                        op(out, q, w, keys, pos, H, 4)
+                for _ in range(5):
+                    g.replay()
+                s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                s.record()
+                for _ in range(50):
+                    g.replay()
+                e.record()
+                torch.cuda.synchronize()
+                res[name] = s.elapsed_time(e) * 1000.0 / (50 * 20)
+            line = (f"TIME H{H} T{T} cap{cap} keys{end}: v41k {res['v41k']:.1f} us "
+                    f"tiled {res['tiled']:.1f} us ({res['v41k'] / res['tiled']:.2f}x)")
+            print(line, flush=True)
+            lines.append(line)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", required=True, help="v41idx.so under test")
+    ap.add_argument("--v41k", required=True, help="the DEPLOYED v41k.so (VLLM_V41K_LIB)")
+    ap.add_argument("--quick", action="store_true")
+    ap.add_argument("--sanitize", action="store_true")
+    ap.add_argument("--no-time", action="store_true")
+    ap.add_argument("--json")
+    a = ap.parse_args()
+    t0 = time.time()
+    load(a.lib, a.v41k)
+    dev = torch.device("cuda:0")
+    print(f"DEVICE {torch.cuda.get_device_name(dev)} SMs "
+          f"{torch.cuda.get_device_properties(dev).multi_processor_count} "
+          f"grid(131072)={int(torch.ops.v41idx.grid_for(131072, 0))}", flush=True)
+    st = Stats()
+    matrix(st, dev, a.quick, a.sanitize)
+    print(f"MATRIX {st.cases} cases, {st.written} values written by v41k "
+          f"({st.finite} finite), {len(st.bad)} mismatched cases", flush=True)
+    min_written = 2000 if a.sanitize else 100000
+    if st.written < min_written or st.finite < min_written // 2:
+        st.bad.append(f"coverage too low: written {st.written} finite {st.finite}")
+    if not a.sanitize:
+        graph_replay(st, dev)
+        first_call_in_capture(st, a.lib, a.v41k)
+        print(f"GRAPHS done, {len(st.bad)} mismatched cases so far", flush=True)
+    lines = []
+    if not (a.no_time or a.sanitize):
+        timing(dev, lines)
+    for b in st.bad[:20]:
+        print("FAIL", b)
+    ok = st.ok()
+    print(("ALL OK" if ok else "FAILED") + f" ({st.cases} cases, {time.time() - t0:.0f} s)")
+    if a.json:
+        with open(a.json, "w") as f:
+            json.dump({"ok": ok, "cases": st.cases, "written": st.written,
+                       "finite": st.finite, "bad": st.bad[:200], "time": lines}, f, indent=1)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/benchmarks/deepseek_v41/v41idx/test_v41idx_cpu.py b/benchmarks/deepseek_v41/v41idx/test_v41idx_cpu.py
new file mode 100644
index 000000000..cdea908b8
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/test_v41idx_cpu.py
@@ -0,0 +1,305 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU checks of VLLM_V41_INDEX_TILED (no GPU): run with CUDA_VISIBLE_DEVICES=.
+
+  1. knob-off identity: attention_ops.py with the VLLM_V41_INDEX_TILED edit
+     undone (the getenv import, the _INDEX_TILED assignment, the module-level
+     "if _INDEX_TILED: import index_tiled", and the call-site
+     "if _INDEX_TILED: ... elif" unwrapped to its else branch) is AST-identical
+     to the base file (--base), and _INDEX_TILED is False for "", "0", unset.
+  2. index_tiled.py: knob parsing, library path, fail-fast load (OSError for a
+     missing .so), ValueError for heads outside {4, 8} / more than 64 rows,
+     RuntimeError from the op's own argument checks (--lib: a v41idx.so, a
+     CPU build is enough).
+  3. host bit-exactness (--host-test): v41idx_host_test.cu (the kernel bodies
+     compiled for the host, run with the persistent-CTA schedule on
+     NaN-poisoned shared memory, against a transliteration of the deployed
+     kernel and an independent OCP E2M1 / E8M0 decoder), and the same test
+     built with the summation order reversed must report mismatches.
+Prints one line per check and "ALL OK" / "FAILED"; exit 0 only on ALL OK.
+"""
+
+import argparse
+import ast
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
+OPS = os.path.join(ROOT, "vllm", "models", "deepseek_v41", "attention_ops.py")
+WRAP = os.path.join(ROOT, "vllm", "models", "deepseek_v41", "index_tiled.py")
+results = []
+
+
+def report(name, ok, detail=""):
+    results.append(bool(ok))
+    print(f"{'PASS' if ok else 'FAIL'} {name}{': ' + detail if detail else ''}")
+
+
+# ---------------------------------------------------------------- 1. knob off
+def _is_name(node, name):
+    return isinstance(node, ast.Name) and node.id == name
+
+
+class _Undo(ast.NodeTransformer):
+    """Undo the VLLM_V41_INDEX_TILED edit; record what was removed."""
+
+    def __init__(self):
+        self.removed = []
+
+    def _kind(self, node):
+        if (
+            isinstance(node, ast.ImportFrom)
+            and node.module == "os"
+            and [(a.name, a.asname) for a in node.names]
+            == [("getenv", "_v41idx_getenv")]
+        ):
+            return "import getenv"
+        if isinstance(node, ast.Assign) and any(
+            _is_name(t, "_INDEX_TILED") for t in node.targets
+        ):
+            return "assign"
+        if isinstance(node, ast.If) and _is_name(node.test, "_INDEX_TILED"):
+            return "if-unwrap" if node.orelse else "if"
+        return None
+
+    def generic_visit(self, node):
+        for field, value in ast.iter_fields(node):
+            if isinstance(value, list):
+                kept = []
+                for item in value:
+                    kind = self._kind(item) if isinstance(item, ast.stmt) else None
+                    if kind:
+                        self.removed.append((kind, item))
+                        if kind == "if-unwrap":
+                            kept.extend(self.visit(s) for s in item.orelse)
+                        continue
+                    kept.append(self.visit(item) if isinstance(item, ast.AST) else item)
+                setattr(node, field, kept)
+            elif isinstance(value, ast.AST):
+                setattr(node, field, self.visit(value))
+        return node
+
+
+def check_knob_off(ops_path, base_path):
+    if not base_path:
+        report("knob-off AST identity", False, "--base not given")
+        return
+    base = ast.parse(open(base_path).read())
+    new_src = open(ops_path).read()
+    new = ast.parse(new_src)
+    undo = _Undo()
+    undo.visit(new)
+    same = ast.dump(base) == ast.dump(new)
+    kinds = sorted(k for k, _ in undo.removed)
+    report(
+        "knob-off AST identity (attention_ops.py with the INDEX_TILED edit undone "
+        "== base)",
+        same and kinds == ["assign", "if", "if-unwrap", "import getenv"],
+        f"removed {kinds}",
+    )
+    assign = [n for k, n in undo.removed if k == "assign"]
+    env_ok = (
+        len(assign) == 1
+        and ast.unparse(assign[0].value)
+        == "_v41idx_getenv('VLLM_V41_INDEX_TILED', '0') not in ('', '0')"
+    )
+    # index_tiled is imported and used only inside the removed statements, and
+    # the unwrapped branch keeps only the else part (the deployed code).
+    refs = new_src.count("index_tiled")
+    removed_refs = sum(
+        ast.unparse(n).count("index_tiled") - sum(
+            ast.unparse(s).count("index_tiled") for s in n.orelse
+        )
+        for k, n in undo.removed
+        if isinstance(n, ast.If)
+    )
+    report(
+        "knob-off reachability (_INDEX_TILED = getenv(...) not in ('', '0'); "
+        "index_tiled only behind it)",
+        env_ok and refs == removed_refs and refs >= 2,
+        f"index_tiled refs {refs}, inside the _INDEX_TILED branches {removed_refs}",
+    )
+    expr = "__import__('os').getenv('VLLM_V41_INDEX_TILED', '0') not in ('', '0')"
+    got = {}
+    for knob in (None, "", "0", "1"):
+        env = dict(os.environ)
+        env.pop("VLLM_V41_INDEX_TILED", None)
+        if knob is not None:
+            env["VLLM_V41_INDEX_TILED"] = knob
+        out = subprocess.run(
+            [sys.executable, "-I", "-c", f"print({expr})"],
+            env=env, capture_output=True, text=True, check=True,
+        ).stdout.strip()
+        got[knob] = out
+    report(
+        "knob values (unset, '', '0' -> off; '1' -> on)",
+        got == {None: "False", "": "False", "0": "False", "1": "True"},
+        str(got),
+    )
+
+
+# ----------------------------------------------------------- 2. index_tiled.py
+WRAP_SNIPPET = r"""
+import importlib.util, json, os, sys
+out = {{}}
+try:
+    spec = importlib.util.spec_from_file_location("index_tiled_under_test", {wrap!r})
