+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// v41idx: VLLM_V41_INDEX_TILED decode index scorer for DeepSeek-V4.1 on SM70
+// (lane hbm-spend1103). Bitwise replacement of v41k::index_scores_decode.
+//
+// Contract (the same as v41k::index_scores_decode, which stays the reference):
+//   q   fp16 [tokens * heads, 128]  (token-major rows), w fp16 [tokens * heads]
+//   keys uint8 [capacity, 68]: 64 B E2M1 nibbles (even element low) + 4 biased
+//        power-of-two scale exponents, one per 32 elements
+//   positions int64 [>= tokens]; end = (positions[tokens - 1] + 1) / ratio
+//   out fp16, row stride out.size(1): out[t, n] for n < end only =
+//     fp16( sum_h fp16( relu( fp16( q[t,h] . k[n] ) ) * w[t,h] ) )
+//   with q . k accumulated as ONE fmaf chain over d = 0..127 in order, from
+//   0.f, the key values rounded to fp16 first, and the head sum in h order.
+//   Columns n >= end are never written.
+//
+// Why it is faster: the reference launches capacity / 32 CTAs (4096 at the
+// stage-2 capacity of 131072 rows) and each thread computes one (key, token)
+// pair with two shared-memory loads per FMA; at short context almost all CTAs
+// only read positions and exit (25.6 / 48.9 us per call MEASURED at 0 keys),
+// and at 300K keys it runs ~1.2 TFLOP/s (497 / 1061 us per call). Here:
+//   - a persistent grid (<= 2 CTAs per SM) loops over 64-key blocks of the
+//     live prefix only;
+//   - q (FP32) and w are staged once per CTA; each 64-key block is decoded
+//     once into shared memory as fp16 (exactly the reference's rounded key);
+//   - each thread owns one token x H heads x 4 keys (4 * H accumulators) and
+//     reads operands with 128-bit (q) / 64-bit (k) shared loads.
+// Every (row, key) dot product is still the same fmaf chain in the same order
+// on the same operand values, and the epilogue is the reference's, so the
+// result is bitwise identical (proved on CPU with the host-compiled bodies
+// below, and on GPU against the deployed v41k.so in check_v41idx.py).
+//
+// The stage/tile bodies are __host__ __device__ so that v41idx_host_test.cu
+// runs the exact kernel code on the CPU (no GPU) with the CTA schedule.
+
+#include <cstdint>
+#include <cstring>
+#include <cmath>
+#include <cuda_fp16.h>
+
+#ifndef V41IDX_HOST_TEST
+  #include <mutex>
+  #include <torch/all.h>
+  #include <ATen/cuda/CUDAContext.h>
+  #include <c10/cuda/CUDAGuard.h>
+  #include <c10/cuda/CUDAException.h>
+#endif
+
+namespace v41idx {
+
+constexpr int KB = 64;      // keys per block
+constexpr int KL = 16;      // key lanes per token (threads per token)
+constexpr int KJ = KB / KL; // keys per thread (4): kl, kl + 16, kl + 32, kl + 48
+constexpr int QS = 132;     // q row stride in floats (528 B: 16-B aligned)
+constexpr int KS = 132;     // key row stride in halves (264 B: 8-B aligned; 16
+                            // consecutive rows start on banks 0, 2, .., 30)
+constexpr int KEY_BYTES = 68;
+constexpr int MAX_ROWS = 64;
+constexpr int MAX_THREADS = 256;
+
+__host__ __device__ constexpr int smem_bytes(int rows) {
+  return rows * QS * 4 + ((rows + 3) & ~3) * 4 + KB * KS * 2;
+}
+
+__host__ __device__ inline float bits_float(uint32_t u) {
+#ifdef __CUDA_ARCH__
+  return __uint_as_float(u);
+#else
+  float f;
+  memcpy(&f, &u, 4);
+  return f;
+#endif
+}
+
+// The reference's v41k_e2m1, operation for operation.
+__host__ __device__ inline float e2m1(int code) {
+  const int m = code & 7;
+  const float mag = m < 2 ? 0.5f * m
+                          : bits_float(uint32_t(((m >> 1) + 126) << 23) |
+                                       uint32_t((m & 1) << 22));
+  return (code & 8) ? -mag : mag;
+}
+
+// q rows -> FP32 shared rows (exactly __half2float of the input), w -> ws.
+__host__ __device__ inline void stage_q(int tid, int nt, const __half* q,
+                                        const __half* w, int rows, float* qs,
+                                        float* ws) {
+  for (int i = tid; i < rows * 128; i += nt) {
+    const int r = i / 128, d = i % 128;
+    qs[r * QS + d] = __half2float(q[r * 128 + d]);
+  }
+  for (int r = tid; r < rows; r += nt) ws[r] = __half2float(w[r]);
+}
+
+// Decode keys [n0, n0 + KB) into ks (fp16), zeros past end (never read for
+// output). One item = one 4-byte word = 8 elements of one key row.
+__host__ __device__ inline void stage_keys(int tid, int nt,
+                                           const uint8_t* keys, int64_t n0,
+                                           int64_t end, __half* ks) {
+  for (int i = tid; i < KB * 16; i += nt) {
+    const int k = i / 16, wd = i % 16;
+    const int64_t n = n0 + k;
+    __half h[8];
+    if (n < end) {
+      const uint8_t* row = keys + n * KEY_BYTES;
+      uint32_t word;
+#ifdef __CUDA_ARCH__
+      word = *reinterpret_cast<const uint32_t*>(row + 4 * wd);
+#else
+      memcpy(&word, row + 4 * wd, 4);
+#endif
+      // byte b = 4 wd + c; its scale is row[64 + (2 b) / 32] = row[64 + wd / 4]
+      const float scale = bits_float(uint32_t(row[64 + wd / 4]) << 23);
+#pragma unroll
+      for (int c = 0; c < 4; ++c) {
+        const int byte = int((word >> (8 * c)) & 255u);
+        const float lo = e2m1(byte & 15) * scale;
+        const float hi = e2m1((byte >> 4) & 15) * scale;
+        h[2 * c] = __float2half_rn(lo);
+        h[2 * c + 1] = __float2half_rn(hi);
+      }
+    } else {
+#pragma unroll
+      for (int c = 0; c < 8; ++c) h[c] = __float2half_rn(0.f);
+    }
+    __half* dst = ks + k * KS + 8 * wd;
+#ifdef __CUDA_ARCH__
+    uint2 a, b;
+    memcpy(&a, h, 8);
+    memcpy(&b, h + 4, 8);
+    reinterpret_cast<uint2*>(dst)[0] = a;
+    reinterpret_cast<uint2*>(dst)[1] = b;
+#else
+    memcpy(dst, h, 16);
+#endif
+  }
+}
+
+// One thread: token t, key lane kl (keys kl + 16 j), all H heads of t.
+template <int H>
+__host__ __device__ inline void tile(int t, int kl, const float* qs,
+                                     const __half* ks, const float* ws,
+                                     int64_t n0, int64_t end, __half* out,
+                                     int64_t n_out) {
+  float acc[H][KJ];
+#pragma unroll
+  for (int h = 0; h < H; ++h)
+#pragma unroll
+    for (int j = 0; j < KJ; ++j) acc[h][j] = 0.f;
+#ifdef V41IDX_MUTANT_ORDER
+  // CPU-test mutant only: reversed d order (must be caught as a mismatch).
+  for (int d = 124; d >= 0; d -= 4) {
+#else
+  for (int d = 0; d < 128; d += 4) {
+#endif
+    float kv[KJ][4];
+#pragma unroll
+    for (int j = 0; j < KJ; ++j) {
+      const __half* kp = ks + (kl + KL * j) * KS + d;
+      __half2 a, b;
+#ifdef __CUDA_ARCH__
+      const uint2 raw = *reinterpret_cast<const uint2*>(kp);
+      memcpy(&a, &raw.x, 4);
+      memcpy(&b, &raw.y, 4);
+#else
+      memcpy(&a, kp, 4);
+      memcpy(&b, kp + 2, 4);
+#endif
+      kv[j][0] = __low2float(a);
+      kv[j][1] = __high2float(a);
+      kv[j][2] = __low2float(b);
+      kv[j][3] = __high2float(b);
+    }
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      const float* qp = qs + (t * H + h) * QS + d;
+      float qv[4];
+#ifdef __CUDA_ARCH__
+      const float4 q4 = *reinterpret_cast<const float4*>(qp);
+      qv[0] = q4.x;
+      qv[1] = q4.y;
+      qv[2] = q4.z;
+      qv[3] = q4.w;
+#else
+      memcpy(qv, qp, 16);
+#endif
+#ifdef V41IDX_MUTANT_ORDER
+#pragma unroll
+      for (int c = 3; c >= 0; --c)
+#else
+#pragma unroll
+      for (int c = 0; c < 4; ++c)
+#endif
+#pragma unroll
+        for (int j = 0; j < KJ; ++j)
+          acc[h][j] = fmaf(qv[c], kv[j][c], acc[h][j]);
+    }
+  }
+#pragma unroll
+  for (int j = 0; j < KJ; ++j) {
+    const int64_t n = n0 + kl + KL * j;
+    if (n >= end) continue;
+    float total = 0.f;
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      float s = __half2float(__float2half_rn(acc[h][j]));
+      s = s > 0.f ? s : 0.f;
+      total += __half2float(__float2half_rn(s * ws[t * H + h]));
+    }
+    out[int64_t(t) * n_out + n] = __float2half_rn(total);
+  }
+}
+
+// Shared-memory carve-up for `rows` rows.
+struct Smem {
+  float* qs;
+  float* ws;
+  __half* ks;
+};
+__host__ __device__ inline Smem carve(unsigned char* base, int rows) {
+  Smem s;
+  s.qs = reinterpret_cast<float*>(base);
+  s.ws = s.qs + rows * QS;
+  s.ks = reinterpret_cast<__half*>(s.ws + ((rows + 3) & ~3));
+  return s;
+}
+
+#ifndef V41IDX_HOST_TEST
+template <int H>
+__global__ void __launch_bounds__(MAX_THREADS)
+    index_scores_tiled(const __half* __restrict__ q,
+                       const __half* __restrict__ w,
+                       const uint8_t* __restrict__ keys,
+                       const int64_t* __restrict__ positions,
+                       __half* __restrict__ out, int tokens, int64_t n_out,
+                       int ratio) {
+  extern __shared__ __align__(16) unsigned char smem[];
+  const int64_t end = (positions[tokens - 1] + 1) / ratio;
+  int64_t n0 = int64_t(blockIdx.x) * KB;
+  if (n0 >= end) return;
+  const int rows = tokens * H;
+  const Smem s = carve(smem, rows);
+  const int tid = threadIdx.x, nt = blockDim.x;
+  stage_q(tid, nt, q, w, rows, s.qs, s.ws);
+  const int t = tid / KL, kl = tid % KL;
+  for (; n0 < end; n0 += int64_t(gridDim.x) * KB) {
+    stage_keys(tid, nt, keys, n0, end, s.ks);
+    __syncthreads();
+    if (t < tokens) tile<H>(t, kl, s.qs, s.ks, s.ws, n0, end, out, n_out);
+    __syncthreads();
+  }
+}
+#endif
+
+}  // namespace v41idx
+
+#ifndef V41IDX_HOST_TEST
+  #include "v41idx_ref.cuh"
+
+namespace {
+
+int sm_count(int device) {
+  static std::mutex mu;
+  static int counts[64] = {0};
+  std::lock_guard<std::mutex> lock(mu);
+  TORCH_CHECK(device >= 0 && device < 64, "v41idx: device index out of range");
+  if (counts[device] == 0) {
+    int c = 0;
+    C10_CUDA_CHECK(cudaDeviceGetAttribute(&c, cudaDevAttrMultiProcessorCount,
+                                          device));
+    counts[device] = c;
+  }
+  return counts[device];
+}
+
+template <int H>
+void allow_smem(int device) {
+  static std::mutex mu;
+  static bool done[64] = {false};
+  std::lock_guard<std::mutex> lock(mu);
+  if (!done[device]) {
+    C10_CUDA_CHECK(cudaFuncSetAttribute(
+        v41idx::index_scores_tiled<H>,
+        cudaFuncAttributeMaxDynamicSharedMemorySize,
+        v41idx::smem_bytes(v41idx::MAX_ROWS)));
+    done[device] = true;
+  }
+}
+
+void check_args(const torch::Tensor& out, const torch::Tensor& q,
+                const torch::Tensor& w, const torch::Tensor& keys,
+                const torch::Tensor& positions, int64_t heads, int64_t ratio,
+                bool tiled) {
+  const int64_t tokens = out.dim() == 2 ? out.size(0) : -1;
+  TORCH_CHECK(out.is_cuda() && q.device() == out.device() &&
+                  w.device() == out.device() &&
+                  keys.device() == out.device() &&
+                  positions.device() == out.device(),
+              "v41idx: all tensors must be on one CUDA device");
+  TORCH_CHECK(out.dim() == 2 && out.scalar_type() == torch::kHalf &&
+                  out.stride(1) == 1 && out.stride(0) == out.size(1),
+              "v41idx: out must be fp16 [tokens, n_out] with row stride n_out");
+  if (tiled)
+    TORCH_CHECK(heads == 4 || heads == 8,
+                "v41idx: tiled scorer supports 4 or 8 index heads per rank, got ",
+                heads);
+  TORCH_CHECK(heads >= 1 && tokens >= 1 && tokens * heads <= 64,
+              "v41idx: need 1 <= tokens * heads <= 64");
+  TORCH_CHECK(q.scalar_type() == torch::kHalf && q.is_contiguous() &&
+                  q.dim() == 2 && q.size(0) == tokens * heads &&
+                  q.size(1) == 128,
+              "v41idx: q must be contiguous fp16 [tokens * heads, 128]");
+  TORCH_CHECK(w.scalar_type() == torch::kHalf && w.is_contiguous() &&
+                  w.numel() == tokens * heads,
+              "v41idx: w must be contiguous fp16 [tokens * heads]");
+  TORCH_CHECK(keys.scalar_type() == torch::kUInt8 && keys.is_contiguous() &&
+                  keys.dim() == 2 && keys.size(1) == 68 && keys.size(0) > 0,
+              "v41idx: keys must be contiguous uint8 [capacity > 0, 68]");
+  TORCH_CHECK(positions.scalar_type() == torch::kInt64 &&
+                  positions.is_contiguous() && positions.numel() >= tokens,
+              "v41idx: positions must be contiguous int64 with >= tokens entries");
+  TORCH_CHECK(ratio >= 1, "v41idx: ratio must be >= 1");
+}
+
+void index_scores_tiled(torch::Tensor out, torch::Tensor q, torch::Tensor w,
+                        torch::Tensor keys, torch::Tensor positions,
+                        int64_t heads, int64_t ratio) {
+  check_args(out, q, w, keys, positions, heads, ratio, true);
+  const at::cuda::OptionalCUDAGuard guard(out.device());
+  const int device = out.get_device();
+  const int tokens = int(out.size(0));
+  const int rows = tokens * int(heads);
+  const int threads = ((tokens * v41idx::KL + 31) / 32) * 32;
+  const int smem = v41idx::smem_bytes(rows);
+  const int64_t blocks = (keys.size(0) + v41idx::KB - 1) / v41idx::KB;
+  const int grid = int(std::min<int64_t>(blocks, 2 * int64_t(sm_count(device))));
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const auto* qp = reinterpret_cast<const __half*>(q.data_ptr());
+  const auto* wp = reinterpret_cast<const __half*>(w.data_ptr());
+  auto* op = reinterpret_cast<__half*>(out.data_ptr());
+  if (heads == 8) {
+    allow_smem<8>(device);
+    v41idx::index_scores_tiled<8><<<grid, threads, smem, stream>>>(
+        qp, wp, keys.data_ptr<uint8_t>(), positions.data_ptr<int64_t>(), op,
+        tokens, out.size(1), int(ratio));
+  } else {
+    allow_smem<4>(device);
+    v41idx::index_scores_tiled<4><<<grid, threads, smem, stream>>>(
+        qp, wp, keys.data_ptr<uint8_t>(), positions.data_ptr<int64_t>(), op,
+        tokens, out.size(1), int(ratio));
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// The deployed reference kernel (verbatim copy) with the deployed launch
+// configuration; for check_v41idx.py only (the deployed v41k.so op is the
+// primary reference there).
+void index_scores_ref(torch::Tensor out, torch::Tensor q, torch::Tensor w,
+                      torch::Tensor keys, torch::Tensor positions,
+                      int64_t heads, int64_t ratio) {
+  check_args(out, q, w, keys, positions, heads, ratio, false);
+  const at::cuda::OptionalCUDAGuard guard(out.device());
+  const int tokens = out.size(0);
+  auto stream = at::cuda::getCurrentCUDAStream();
+  constexpr int KB = 32;
+  const int blocks = (keys.size(0) + KB - 1) / KB;
+  v41idx_ref::index_scores_decode<KB><<<blocks, 256, 0, stream>>>(
+      reinterpret_cast<const half*>(q.data_ptr()),
+      reinterpret_cast<const half*>(w.data_ptr()), keys.data_ptr<uint8_t>(),
+      positions.data_ptr<int64_t>(), reinterpret_cast<half*>(out.data_ptr()),
+      tokens, int(heads), out.size(1), int(ratio));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+int64_t version() { return 1; }
+
+int64_t grid_for(int64_t capacity, int64_t device) {
+  const int64_t blocks = (capacity + v41idx::KB - 1) / v41idx::KB;
+  return std::min<int64_t>(blocks, 2 * int64_t(sm_count(int(device))));
+}
+
+}  // namespace
+
+TORCH_LIBRARY(v41idx, m) {
+  m.def(
+      "index_scores_tiled(Tensor(a!) out, Tensor q, Tensor w, Tensor keys, "
+      "Tensor positions, int heads, int ratio) -> ()",
+      &index_scores_tiled);
+  m.def(
+      "index_scores_ref(Tensor(a!) out, Tensor q, Tensor w, Tensor keys, "
+      "Tensor positions, int heads, int ratio) -> ()",
+      &index_scores_ref);
+  m.def("version() -> int", &version);
+  m.def("grid_for(int capacity, int device) -> int", &grid_for);
+}
+#endif
diff --git a/benchmarks/deepseek_v41/v41idx/v41idx_host_test.cu b/benchmarks/deepseek_v41/v41idx/v41idx_host_test.cu
new file mode 100644
index 000000000..fbaa99271
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/v41idx_host_test.cu
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// v41idx_host_test.cu: CPU-only proof that the VLLM_V41_INDEX_TILED kernel
+// bodies (stage_q / stage_keys / tile from v41idx.cu, compiled for the HOST,
+// run with the kernel's own persistent-CTA schedule) give bitwise the same
+// output as the deployed v41k::index_scores_decode.
+//
+// Expected values do not come from v41idx.cu:
+//   1. key decode: every (nibble byte, scale byte) pair against the OCP MX
+//      E2M1 table {0, .5, 1, 1.5, 2, 3, 4, 6} (sign bit 8) and the IEEE meaning
+//      of the scale byte as an FP32 exponent field (0 -> 0, 255 -> inf);
+//   2. scores: ref_scores(), a line-by-line transliteration of the deployed
+//      kernel's loops (v41k.cu index_scores_decode: decode into float ks, one
+//      fmaf chain per (row, key), relu/weight/head-sum epilogue), with its own
+//      decode from item 1.
+// Build and run (no GPU, no kernel launch):
+//   nvcc -std=c++17 -O2 -DV41IDX_HOST_TEST v41idx_host_test.cu -o host_test && ./host_test
+//   nvcc ... -DV41IDX_MUTANT_ORDER ... && ./host_test --expect-mismatch   (mutant must be caught)
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <vector>
+#include <string>
+
+#include "v41idx.cu"
+
+using v41idx::KB;
+using v41idx::KEY_BYTES;
+
+static uint64_t rng_state = 0x9E3779B97F4A7C15ull;
+static uint64_t rnd() {
+  uint64_t x = rng_state;
+  x ^= x << 13;
+  x ^= x >> 7;
+  x ^= x << 17;
+  return rng_state = x;
+}
+static float uni() { return float(rnd() >> 40) / float(1ull << 24); }  // [0, 1)
+static float gauss() {
+  float u = uni() + 1e-7f, v = uni();
+  return std::sqrt(-2.f * std::log(u)) * std::cos(6.2831853f * v);
+}
+static uint16_t hbits(__half h) {
+  uint16_t u;
+  memcpy(&u, &h, 2);
+  return u;
+}
+static __half hfrom(uint16_t u) {
+  __half h;
+  memcpy(&h, &u, 2);
+  return h;
+}
+
+// --- independent spec decode -------------------------------------------
+static float spec_e2m1(int code) {
+  static const float mag[8] = {0.f, 0.5f, 1.f, 1.5f, 2.f, 3.f, 4.f, 6.f};
+  const float m = mag[code & 7];
+  return (code & 8) ? -m : m;  // code 8 -> -0.0f
+}
+static float spec_scale(int e) {
+  if (e == 0) return 0.f;          // exponent field 0, mantissa 0
+  if (e == 255) return INFINITY;   // exponent field all ones, mantissa 0
+  return std::ldexp(1.f, e - 127);
+}
+
+// --- transliteration of the deployed kernel (v41k.cu, G4b decode indexer) --
+static void ref_scores(const std::vector<__half>& q, const std::vector<__half>& w,
+                       const std::vector<uint8_t>& keys, int64_t cap,
+                       const std::vector<int64_t>& positions, std::vector<__half>& out,
+                       int tokens, int heads, int64_t n_out, int ratio) {
+  const int64_t end = (positions[tokens - 1] + 1) / ratio;
+  const int RB = 32;
+  const int64_t blocks = (cap + RB - 1) / RB;
+  for (int64_t blk = 0; blk < blocks; ++blk) {
+    const int64_t n0 = blk * RB;
+    if (n0 >= end) continue;
+    for (int k = 0; k < RB; ++k) {
+      const int64_t n = n0 + k;
+      if (n >= end) continue;
+      float ks[128];
+      for (int b = 0; b < 64; ++b) {
+        const uint8_t* row = keys.data() + n * 68;
+        const int byte = row[b];
+        const float scale = spec_scale(row[64 + (2 * b) / 32]);
+        const float lo = spec_e2m1(byte & 15) * scale;
+        const float hi = spec_e2m1((byte >> 4) & 15) * scale;
+        ks[2 * b] = __half2float(__float2half_rn(lo));
+        ks[2 * b + 1] = __half2float(__float2half_rn(hi));
+      }
+      for (int tok = 0; tok < tokens; ++tok) {
+        float total = 0.f;
+        for (int h = 0; h < heads; ++h) {
+          const int r = tok * heads + h;
+          float dot = 0.f;
+          for (int d = 0; d < 128; ++d)
+            dot = std::fma(__half2float(q[r * 128 + d]), ks[d], dot);
+          float s = __half2float(__float2half_rn(dot));
+          s = s > 0.f ? s : 0.f;
+          total += __half2float(__float2half_rn(s * __half2float(w[r])));
+        }
+        out[tok * n_out + n] = __float2half_rn(total);
+      }
+    }
+  }
+}
+
+// --- the kernel bodies, run with the kernel's schedule ---------------------
+template <int H>
+static void tiled_host(const std::vector<__half>& q, const std::vector<__half>& w,
+                       const std::vector<uint8_t>& keys, int64_t cap,
+                       const std::vector<int64_t>& positions, std::vector<__half>& out,
+                       int tokens, int64_t n_out, int ratio, int grid_cap) {
+  const int64_t end = (positions[tokens - 1] + 1) / ratio;
+  const int rows = tokens * H;
+  const int nt = ((tokens * v41idx::KL + 31) / 32) * 32;
+  const int64_t blocks = (cap + KB - 1) / KB;
+  const int64_t grid = blocks < grid_cap ? blocks : grid_cap;
+  std::vector<float> buf((v41idx::smem_bytes(rows) + 15) / 4 + 4);
+  unsigned char* base = reinterpret_cast<unsigned char*>(buf.data());
+  for (int64_t cta = 0; cta < grid; ++cta) {
+    int64_t n0 = cta * KB;
+    if (n0 >= end) continue;
+    // fresh, poisoned shared memory per CTA
+    for (auto& f : buf) f = NAN;
+    const v41idx::Smem s = v41idx::carve(base, rows);
+    for (int tid = 0; tid < nt; ++tid)
+      v41idx::stage_q(tid, nt, q.data(), w.data(), rows, s.qs, s.ws);
+    for (; n0 < end; n0 += grid * KB) {
+      for (int tid = 0; tid < nt; ++tid)
+        v41idx::stage_keys(tid, nt, keys.data(), n0, end, s.ks);
+      for (int tid = 0; tid < nt; ++tid) {
+        const int t = tid / v41idx::KL, kl = tid % v41idx::KL;
+        if (t < tokens)
+          v41idx::tile<H>(t, kl, s.qs, s.ks, s.ws, n0, end, out.data(), n_out);
+      }
+    }
+  }
+}
+
+static long decode_test() {
+  long bad = 0;
+  std::vector<uint8_t> row(68 * KB, 0);
+  std::vector<__half> ks(KB * v41idx::KS);
+  // row k: nibble byte (k + 64 * rep) in every one of its 64 bytes, scale byte e
+  for (int e = 0; e < 256; ++e) {
+    for (int rep = 0; rep < 4; ++rep) {
+      for (int k = 0; k < KB; ++k) {
+        for (int b = 0; b < 64; ++b) row[k * 68 + b] = uint8_t(k + 64 * rep);
+        for (int g = 0; g < 4; ++g) row[k * 68 + 64 + g] = uint8_t(e);
+      }
+      for (int tid = 0; tid < 96; ++tid)
+        v41idx::stage_keys(tid, 96, row.data(), 0, KB, ks.data());
+      for (int k = 0; k < KB; ++k) {
+        const int byte = k + 64 * rep;
+        const __half elo = __float2half_rn(spec_e2m1(byte & 15) * spec_scale(e));
+        const __half ehi = __float2half_rn(spec_e2m1((byte >> 4) & 15) * spec_scale(e));
+        for (int b = 0; b < 64; ++b) {
+          if (hbits(ks[k * v41idx::KS + 2 * b]) != hbits(elo)) ++bad;
+          if (hbits(ks[k * v41idx::KS + 2 * b + 1]) != hbits(ehi)) ++bad;
+        }
+      }
+    }
+  }
+  // mixed scales per 32-element group (byte b uses scale 64 + b / 16)
+  for (int k = 0; k < KB; ++k)
+    for (int i = 0; i < 68; ++i) row[k * 68 + i] = uint8_t(rnd());
+  for (int tid = 0; tid < 96; ++tid) v41idx::stage_keys(tid, 96, row.data(), 0, KB, ks.data());
+  for (int k = 0; k < KB; ++k)
+    for (int b = 0; b < 64; ++b) {
+      const int byte = row[k * 68 + b], e = row[k * 68 + 64 + b / 16];
+      if (hbits(ks[k * v41idx::KS + 2 * b]) != hbits(__float2half_rn(spec_e2m1(byte & 15) * spec_scale(e)))) ++bad;
+      if (hbits(ks[k * v41idx::KS + 2 * b + 1]) != hbits(__float2half_rn(spec_e2m1(byte >> 4) * spec_scale(e)))) ++bad;
+    }
+  return bad;
+}
+
+int main(int argc, char** argv) {
+  const bool expect_mismatch = argc > 1 && std::string(argv[1]) == "--expect-mismatch";
+  long cases = 0, mismatch_cases = 0, mismatched = 0, compared = 0, nonfinite = 0, written = 0, written_finite = 0;
+  long decode_bad = decode_test();
+  std::printf("DECODE exhaustive 256 bytes x 256 scale bytes + mixed groups: %ld mismatches\n", decode_bad);
+  const int caps[] = {1, 63, 64, 65, 300};
+  const int grids[] = {1, 3, 160};
+  for (int heads : {8, 4}) {
+    for (int tokens = 1; tokens * heads <= 64; ++tokens) {
+      for (int cap : caps) {
+        for (int ratio : {1, 4}) {
+          for (int mode = 0; mode < 2; ++mode) {
+            const int64_t full = int64_t(cap) * ratio;  // positions[T-1] + 1 -> end = cap
+            const int64_t ends_pos[] = {0, 1, int64_t(ratio), full / 2, full - 1, full};
+            for (int64_t p1 : ends_pos) {
+              for (int grid : grids) {
+                const int rows = tokens * heads;
+                std::vector<__half> q(rows * 128), w(rows);
+                for (auto& v : q) {
+                  float f = gauss();
+                  if (mode == 1) {  // extremes: large, overflowing dots, some inf / nan
+                    const float r = uni();
+                    f = r < 0.02f ? (r < 0.01f ? INFINITY : NAN) : f * 30000.f;
+                  }
+                  v = __float2half_rn(f);
+                }
+                for (auto& v : w) v = __float2half_rn(mode == 1 ? gauss() * 300.f : gauss() * 0.1f);
+                std::vector<uint8_t> keys(size_t(cap) * 68);
+                for (int64_t n = 0; n < cap; ++n) {
+                  for (int b = 0; b < 64; ++b) keys[n * 68 + b] = uint8_t(rnd());
+                  for (int g = 0; g < 4; ++g)
+                    keys[n * 68 + 64 + g] = mode == 1 ? uint8_t(rnd()) : uint8_t(118 + rnd() % 14);
+                }
+                std::vector<int64_t> positions(tokens);
+                for (int t = 0; t < tokens; ++t) positions[t] = p1 - 1 - (tokens - 1 - t);
+                const int64_t n_out = cap + 7;
+                std::vector<__half> a(tokens * n_out), b(tokens * n_out);
+                for (size_t i = 0; i < a.size(); ++i) a[i] = b[i] = hfrom(uint16_t(0x7E00 | (i & 0x1FF)));
+                ref_scores(q, w, keys, cap, positions, a, tokens, heads, n_out, ratio);
+                if (heads == 8)
+                  tiled_host<8>(q, w, keys, cap, positions, b, tokens, n_out, ratio, grid);
+                else
+                  tiled_host<4>(q, w, keys, cap, positions, b, tokens, n_out, ratio, grid);
+                long m = 0;
+                for (size_t i = 0; i < a.size(); ++i) {
+                  if (hbits(a[i]) != hbits(b[i])) ++m;
+                  if (!std::isfinite(__half2float(a[i]))) ++nonfinite;
+                  if (hbits(a[i]) != uint16_t(0x7E00 | (i & 0x1FF))) {
+                    ++written;
+                    if (std::isfinite(__half2float(a[i]))) ++written_finite;
+                  }
+                }
+                compared += long(a.size());
+                mismatched += m;
+                ++cases;
+                if (m) {
+                  ++mismatch_cases;
+                  if (!expect_mismatch && mismatch_cases <= 5)
+                    std::printf("MISMATCH heads %d tokens %d cap %d ratio %d mode %d p1 %lld grid %d: %ld\n",
+                                heads, tokens, cap, ratio, mode, (long long)p1, grid, m);
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  std::printf("SCORES %ld cases, %ld values compared (%ld non-finite incl. poison; %ld written by the reference, %ld of them finite), %ld mismatched values in %ld cases\n",
+              cases, compared, nonfinite, written, written_finite, mismatched, mismatch_cases);
+  if (!expect_mismatch && (written < 100000 || written_finite < 50000)) {
+    std::printf("FAILED: too few written values for a meaningful comparison\n");
+    return 1;
+  }
+  if (expect_mismatch) {
+    const bool killed = mismatched > 0;
+    std::printf("%s\n", killed ? "MUTANT KILLED" : "MUTANT SURVIVED");
+    return killed ? 0 : 1;
+  }
+  const bool ok = decode_bad == 0 && mismatched == 0;
+  std::printf("%s\n", ok ? "ALL OK" : "FAILED");
+  return ok ? 0 : 1;
+}
diff --git a/benchmarks/deepseek_v41/v41idx/v41idx_ref.cuh b/benchmarks/deepseek_v41/v41idx/v41idx_ref.cuh
new file mode 100644
index 000000000..f14fc986f
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/v41idx_ref.cuh
@@ -0,0 +1,74 @@
+// v41idx_ref.cuh: VERBATIM copy of the deployed v41k.cu decode indexer (v41k-diet1103/v41k.cu lines 1874-1942,
+// identical in v41k, v41k-gu1103 and v41k-diet1103). Kit BASECHECK re-extracts the deployed text and compares.
+// Wrapped in namespace v41idx_ref; used only by the check op index_scores_ref. Do not edit.
+namespace v41idx_ref {
+// ---- G4b decode indexer: scores over packed FP4 index keys ----------------
+// Packed key row (68 B): 64 B E2M1 nibbles (even element in the low nibble)
+// then 4 power-of-two scale exponents (biased) for groups of 32. Rows q/w are
+// (token, head) pairs padded to 64. Output fp16 out[t, n] =
+//   sum_h fp16(fp16(relu(fp16(q[t,h] . k[n]))) * w[t,h]), for n < live end.
+__device__ __forceinline__ float v41k_e2m1(int code) {
+  const int m = code & 7;
+  const float mag = m < 2 ? 0.5f * m
+                          : __uint_as_float(uint32_t(((m >> 1) + 126) << 23) |
+                                            uint32_t((m & 1) << 22));
+  return (code & 8) ? -mag : mag;
+}
+
+template <int KB>
+__global__ void __launch_bounds__(256)
+    index_scores_decode(const half* __restrict__ q, const half* __restrict__ w,
+                        const uint8_t* __restrict__ keys,
+                        const int64_t* __restrict__ positions,
+                        half* __restrict__ out, int tokens, int heads,
+                        int64_t n_out, int ratio) {
+  __shared__ half qs[64][136];
+  __shared__ float ks[KB][129];
+  __shared__ float ws[64];
+  const int t = threadIdx.x;
+  const int64_t end = (positions[tokens - 1] + 1) / ratio;
+  const int64_t n0 = int64_t(blockIdx.x) * KB;
+  if (n0 >= end) return;
+  const int rows = tokens * heads;
+  for (int i = t; i < 64 * 128; i += 256) {
+    const int r = i / 128, d = i % 128;
+    qs[r][d] = r < rows ? q[r * 128 + d] : __float2half(0.f);
+  }
+  if (t < 64) ws[t] = t < rows ? __half2float(w[t]) : 0.f;
+  for (int i = t; i < KB * 64; i += 256) {
+    const int k = i / 64, b = i % 64;
+    const int64_t n = n0 + k;
+    float lo = 0.f, hi = 0.f;
+    if (n < end) {
+      const uint8_t* row = keys + n * 68;
+      const int byte = row[b];
+      const float scale =
+          __uint_as_float(uint32_t(row[64 + (2 * b) / 32]) << 23);
+      lo = v41k_e2m1(byte & 15) * scale;
+      hi = v41k_e2m1((byte >> 4) & 15) * scale;
+    }
+    // Round like the FP16 cache values (exact for these products).
+    ks[k][2 * b] = __half2float(__float2half_rn(lo));
+    ks[k][2 * b + 1] = __half2float(__float2half_rn(hi));
+  }
+  __syncthreads();
+  // Each thread: one key column (k), a stripe of (token) outputs.
+  for (int item = t; item < KB * tokens; item += 256) {
+    const int k = item % KB, tok = item / KB;
+    const int64_t n = n0 + k;
+    if (n >= end) continue;
+    float total = 0.f;
+    for (int h = 0; h < heads; ++h) {
+      const int r = tok * heads + h;
+      float dot = 0.f;
+#pragma unroll 16
+      for (int d = 0; d < 128; ++d)
+        dot = fmaf(__half2float(qs[r][d]), ks[k][d], dot);
+      float s = __half2float(__float2half_rn(dot));
+      s = s > 0.f ? s : 0.f;
+      total += __half2float(__float2half_rn(s * ws[r]));
+    }
+    out[int64_t(tok) * n_out + n] = __float2half_rn(total);
+  }
+}
+}  // namespace v41idx_ref
