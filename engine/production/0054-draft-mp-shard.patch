+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Build the V4.1 v41draft CUDA extension (SM70) into ./build/v41draft.so.
+
+VLLM_V41_DRAFT_GEMV2 loads it from VLLM_V41_DRAFT_GEMV_LIB, defaulting to
+benchmarks/deepseek_v41/v41draft/build/v41draft.so beside VLLM_V41K_LIB's v41k
+directory. V41DRAFT_BUILD_DIR overrides the build directory.
+"""
+
+import os
+
+from torch.utils import cpp_extension as ce
+
+here = os.path.dirname(os.path.abspath(__file__))
+build = os.environ.get("V41DRAFT_BUILD_DIR") or os.path.join(here, "build")
+os.makedirs(build, exist_ok=True)
+ce.load(
+    name="v41draft",
+    sources=[os.path.join(here, "v41draft.cu")],
+    extra_cuda_cflags=[
+        "-O3",
+        "-gencode",
+        "arch=compute_70,code=sm_70",
+        "--expt-relaxed-constexpr",
+        "-std=c++20",
+        "-U__CUDA_NO_HALF_OPERATORS__",
+        "-U__CUDA_NO_HALF_CONVERSIONS__",
+        "-U__CUDA_NO_HALF2_OPERATORS__",
+        "-U__CUDA_NO_BFLOAT16_CONVERSIONS__",
+    ],
+    extra_cflags=["-O3", "-std=c++20"],
+    is_python_module=False,
+    build_directory=build,
+    verbose=False,
+)
+print("built", os.path.join(build, "v41draft.so"))
diff --git a/benchmarks/deepseek_v41/v41draft/check_v41draft.py b/benchmarks/deepseek_v41/v41draft/check_v41draft.py
new file mode 100644
index 000000000..e8064d55c
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41draft/check_v41draft.py
@@ -0,0 +1,440 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check for lane drafter1103 (VLLM_V41_DRAFT_GEMV2, VLLM_V41_DRAFT_MP_SHARD). Owner window only, server down.
+
+  python -I check_v41draft.py --lib NEW.so --v41k DEPLOYED_v41k.so --src STAGE [--quick] [--no-time] [--json out]
+  python -I check_v41draft.py --lib NEW.so --v41k ... --src STAGE --sanitize        (small grid for compute-sanitizer)
+  python -I check_v41draft.py --lib NEW.so --v41k ... --src STAGE --tp4             (4 visible GPUs, real vLLM TP group)
+
+The reference is the DEPLOYED v41k fp8_gemv (+ fp8_reduce), i.e. today's draft numerics. Every comparison is bitwise
+(int16 view of the fp16 outputs). Steps:
+  ops       v41draft.fp8_gemv2 == v41k.fp8_gemv for every production draft shape and edge shapes, M 1..8, both layouts,
+            the production split and forced splits 1/2/3/odd, with and without bias; outputs and partials poisoned
+            with NaN first; split-K counters back to zero after every call
+  oracle    v41k.fp8_gemv == the numpy CPU oracle (fp8_ref.py) on small shapes (the contract the kernel is held to)
+  mutant    a wrong split (production + 1) must change some output bits, so the comparison is sensitive
+  linear    the staged fp8_linear.py with VLLM_V41_DRAFT_GEMV2=1 (registered counters, row-slice weights) == the
+            installed fp8_block32_linear (knob off), through the module the engine calls
+  shard     4 row shards with the full call's split, concatenated == the replicated call (v41k and v41draft)
+  graph     CUDA-graph capture + 50 replays of fp8_gemv2 (split-K path) == eager; counters zero after
+  trap      a stale counter traps (subprocess; illegal state is loud, never a wrong answer)
+  time      graph-replayed us/call, old vs new (layout 0/1), weights rotated through > 64 MB so nothing sits in L2;
+            per-round sums over the 33 draft GEMV call sites (sizing/drafter_sites.txt)
+  --tp4     one process per GPU, vLLM init_distributed_environment + TP group of 4, the staged dspark
+            _draft_mp_shard (real tensor_model_parallel_all_gather) == the replicated fp8_block32_linear on every rank
+"""
+
+import argparse
+import importlib.util
+import json
+import os
+import statistics
+import subprocess
+import sys
+import time
+import types
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--lib", required=True, help="the v41draft.so under test")
+ap.add_argument("--v41k", default=os.environ.get("VLLM_V41K_LIB"), help="deployed v41k.so (reference)")
+ap.add_argument("--src", default=os.path.abspath(os.path.join(HERE, "..", "..", "..")), help="staged tree root")
+ap.add_argument("--quick", action="store_true")
+ap.add_argument("--sanitize", action="store_true")
+ap.add_argument("--no-time", action="store_true")
+ap.add_argument("--tp4", action="store_true")
+ap.add_argument("--trap-child", action="store_true", help=argparse.SUPPRESS)
+ap.add_argument("--tp4-child", type=int, default=-1, help=argparse.SUPPRESS)
+ap.add_argument("--tp4-port", type=int, default=0, help=argparse.SUPPRESS)
+ap.add_argument("--json")
+args = ap.parse_args()
+if not args.v41k or not os.path.exists(args.v41k):
+    raise SystemExit(f"check_v41draft: reference v41k.so not found ({args.v41k!r}); pass --v41k or VLLM_V41K_LIB")
+os.environ["VLLM_V41K_LIB"] = args.v41k
+
+import numpy as np  # noqa: E402
+import torch  # noqa: E402
+
+torch.ops.load_library(args.v41k)
+torch.ops.load_library(args.lib)
+K41, KD = torch.ops.v41k, torch.ops.v41draft
+if KD.version() != 1:
+    raise SystemExit(f"v41draft version {KD.version()} != 1")
+dev = "cuda"
+results = {"device": torch.cuda.get_device_name(), "capability": list(torch.cuda.get_device_capability()),
+           "lib": args.lib, "v41k": args.v41k, "checks": []}
+fails = []
+
+
+def record(name, ok, **info):
+    results["checks"].append(dict(name=name, ok=bool(ok), **info))
+    if not ok:
+        fails.append(name)
+    print(("PASS " if ok else "FAIL ") + name + (" " + json.dumps(info) if info else ""), flush=True)
+
+
+def gemv_split(n, k):
+    ctas = (n + 31) // 32
+    return max(1, min(k // 512 if k >= 512 else 1, (240 + ctas - 1) // ctas))
+
+
+def make(m, n, k, seed, bias=False):
+    g = torch.Generator(device="cpu").manual_seed(seed)
+    x = (torch.randn(m, k, generator=g) * 0.5).half()
+    w = torch.randint(0, 256, (n, k), generator=g, dtype=torch.uint8)
+    w[(w & 0x7F) == 0x7F] ^= 1  # E4M3 NaN codes do not occur in checkpoints
+    s = torch.randint(112, 124, ((n + 31) // 32, k // 32), generator=g, dtype=torch.uint8)
+    b = (torch.randn(n, generator=g) * 0.1).half() if bias else None
+    return x.to(dev), w.to(dev), s.to(dev), (b.to(dev) if b is not None else None)
+
+
+def old(x, w, s, split, bias=None):
+    m, n = x.shape[0], w.shape[0]
+    out = torch.full((m, n), float("nan"), dtype=torch.half, device=dev)
+    part = torch.full((split * m * n if (split > 1 or bias is not None) else 1,), float("nan"), device=dev)
+    K41.fp8_gemv(out, x, w, s, part, split, bias)
+    return out
+
+
+def new(x, w, s, split, bias=None, layout=0, counters=None):
+    m, n = x.shape[0], w.shape[0]
+    out = torch.full((m, n), float("nan"), dtype=torch.half, device=dev)
+    part = torch.full((split * m * n if (split > 1 or bias is not None) else 1,), float("nan"), device=dev)
+    c = torch.zeros((n + 15) // 16, dtype=torch.int32, device=dev) if counters is None else counters
+    KD.fp8_gemv2(out, x, w, s, part, split, bias, c, layout)
+    return out, c
+
+
+def beq(a, b):
+    return torch.equal(a.view(torch.int16), b.view(torch.int16))
+
+
+# production draft GEMV sites (sizing/drafter_sites.txt, 50 traced rounds): name, N, K, M, calls per round
+SITES = [("main_proj", 5120, 15360, 6, 1), ("ctx_wkv", 512, 5120, 6, 3), ("wq_a", 1280, 5120, 5, 3),
+         ("wq_b", 8192, 1280, 5, 3), ("wkv", 512, 5120, 5, 3), ("wo_a", 1024, 4096, 5, 6),
+         ("wo_b", 5120, 2048, 5, 3), ("shared_gate_up", 576, 5120, 5, 6), ("shared_down", 5120, 576, 5, 3)]
+EDGE = [(32, 32), (40, 64), (100, 544), (16, 512), (48, 1056), (1280, 15360), (33, 4096)]
+
+# ----------------------------------------------------------------------------------------------- trap child
+if args.trap_child:
+    x, w, s, _ = make(4, 512, 5120, 3)
+    split = gemv_split(512, 5120)
+    c = torch.full((32,), split, dtype=torch.int32, device=dev)  # stale: already at gridDim.y
+    out, _ = new(x, w, s, split, counters=c)
+    torch.cuda.synchronize()
+    print("TRAP-CHILD: no trap", flush=True)
+    sys.exit(0)
+
+# ----------------------------------------------------------------------------------------------- sanitize grid
+if args.sanitize:
+    n_runs, bad = 0, 0
+    for (n, k) in [(100, 544), (512, 5120), (40, 64)]:
+        for m in (1, 5, 8):
+            for split in sorted({1, 3, gemv_split(n, k)}):
+                if split > max(1, k // 16):
+                    continue
+                for bias in (False, True):
+                    x, w, s, b = make(m, n, k, 11 + m, bias)
+                    ref = old(x, w, s, split, b)
+                    for layout in ((0, 1) if m <= 6 else (0,)):
+                        got, c = new(x, w, s, split, b, layout)
+                        n_runs += 1
+                        bad += int(not beq(got, ref)) + int(bool(c.any()))
+    torch.cuda.synchronize()
+    print(f"SANITIZE runs {n_runs} mismatches {bad}")
+    sys.exit(1 if bad else 0)
+
+
+# ----------------------------------------------------------------------------------------------- module loading
+def load_file(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def staged_modules(gemv2):
+    """Installed (deployed, knob off) fp8_linear + the staged draft_gemv / fp8_linear / dspark with the knobs set."""
+    for key in ("VLLM_V41_DRAFT_GEMV2", "VLLM_V41_DRAFT_MP_SHARD"):
+        os.environ.pop(key, None)
+    import vllm.models.deepseek_v41.fp8_linear as ref_lin
+
+    if getattr(ref_lin, "_DRAFT_GEMV2", False):
+        raise SystemExit("installed fp8_linear has the GEMV2 knob on; the reference must be knob-off")
+    os.environ["VLLM_V41_DRAFT_GEMV2"] = "1" if gemv2 else "0"
+    os.environ["VLLM_V41_DRAFT_MP_SHARD"] = "1"
+    os.environ["VLLM_V41_DRAFT_GEMV_LIB"] = args.lib
+    pkg = os.path.join(args.src, "vllm", "models", "deepseek_v41")
+    dg = load_file("vllm.models.deepseek_v41.draft_gemv", os.path.join(pkg, "draft_gemv.py"))
+    setattr(sys.modules["vllm.models.deepseek_v41"], "draft_gemv", dg)
+    new_lin = load_file("vllm.models.deepseek_v41.v41draft_check_fp8_linear", os.path.join(pkg, "fp8_linear.py"))
+    assert new_lin._DRAFT_GEMV2 == gemv2 and dg.GEMV2 == gemv2 and dg.MP_SHARD
+    return ref_lin, dg, new_lin, pkg
+
+
+def fp8(w, s):
+    return w.view(torch.float8_e4m3fn), s.view(torch.float8_e8m0fnu)
+
+
+# ----------------------------------------------------------------------------------------------- TP4 child / parent
+if args.tp4_child >= 0:
+    rank = args.tp4_child
+    torch.cuda.set_device(rank)
+    from vllm.config import VllmConfig, set_current_vllm_config
+    from vllm.distributed import ensure_model_parallel_initialized, init_distributed_environment
+    from vllm.distributed.parallel_state import get_tensor_model_parallel_rank
+
+    with set_current_vllm_config(VllmConfig()):
+        init_distributed_environment(world_size=4, rank=rank, local_rank=rank,
+                                     distributed_init_method=f"tcp://127.0.0.1:{args.tp4_port}")
+        ensure_model_parallel_initialized(4, 1)
+        assert get_tensor_model_parallel_rank() == rank
+        ok_all = True
+        for gemv2 in (False, True):
+            if gemv2:
+                for key in list(sys.modules):
+                    if key.endswith("draft_gemv") or key.endswith("v41draft_check_fp8_linear") or "dspark_stage" in key:
+                        del sys.modules[key]
+            ref_lin, dg, new_lin, pkg = staged_modules(gemv2)
+            dsp = load_file("vllm.models.deepseek_v41.dspark_stage", os.path.join(pkg, "dspark.py"))
+            assert dsp._DRAFT_MP_SHARD
+            for m in (1, 5, 6, 8):
+                x, w, s, _ = make(m, 5120, 15360, 1000 + m)  # same seed on every rank: replicated weight
+                wf, sf = fp8(w, s)
+                if gemv2:
+                    dg.register_counters(wf)
+                main_proj = types.SimpleNamespace(weight=wf, weight_scale_inv=sf, bias=None)
+                assert dsp._draft_mp_scope(x)
+                got = dsp._draft_mp_shard(main_proj, x)
+                want = ref_lin.fp8_block32_linear(x, wf, sf)
+                torch.cuda.synchronize()
+                ok = beq(got, want) and got.is_contiguous() and got.shape == want.shape
+                ok_all &= ok
+                print(f"TP4 rank {rank} gemv2 {int(gemv2)} M{m}: {'bitwise' if ok else 'DIFFERS'}", flush=True)
+                if gemv2:
+                    dg._STATE.update({"starts": [], "ranges": []})
+    sys.exit(0 if ok_all else 1)
+
+if args.tp4:
+    import socket
+
+    with socket.socket() as so:
+        so.bind(("127.0.0.1", 0))
+        port = so.getsockname()[1]
+    if torch.cuda.device_count() != 4:
+        raise SystemExit(f"--tp4 needs exactly 4 visible GPUs, found {torch.cuda.device_count()}")
+    base = [sys.executable, "-I", os.path.abspath(__file__), "--lib", args.lib, "--v41k", args.v41k, "--src", args.src,
+            "--tp4-port", str(port)]
+    procs = [subprocess.Popen(base + ["--tp4-child", str(r)]) for r in range(4)]
+    rcs = [p.wait(timeout=1200) for p in procs]
+    record("tp4: dspark _draft_mp_shard (vLLM TP group, real all-gather) == replicated, every rank", rcs == [0] * 4,
+           rcs=rcs)
+    print("ALL OK" if not fails else "FAILED: " + ", ".join(fails))
+    sys.exit(0 if not fails else 1)
+
+# ----------------------------------------------------------------------------------------------- ops
+t0 = time.time()
+shapes = [(n, k) for _, n, k, _, _ in SITES] + EDGE
+ms = (1, 5, 6, 8) if args.quick else tuple(range(1, 9))
+n_cmp, bad, bad_counters, worst = 0, [], 0, None
+for (n, k) in shapes:
+    prod = gemv_split(n, k)
+    splits = sorted({prod, 1, 2, 3, 7} if not args.quick else {prod, 1, 3})
+    splits = [sp for sp in splits if sp <= max(1, k // 16)]
+    for m in ms:
+        for bias in (False, True):
+            x, w, s, b = make(m, n, k, n * 7 + k + m, bias)
+            for sp in splits:
+                ref = old(x, w, s, sp, b)
+                for layout in ((0, 1) if m <= 6 else (0,)):
+                    got, c = new(x, w, s, sp, b, layout)
+                    n_cmp += 1
+                    if not beq(got, ref):
+                        bad.append(f"N{n} K{k} M{m} split{sp} bias{int(bias)} layout{layout}")
+                    bad_counters += int(bool(c.any()))
+                    if bool(torch.isnan(got).any()):
+                        bad.append(f"NaN N{n} K{k} M{m} split{sp}")
+torch.cuda.synchronize()
+record("ops: fp8_gemv2 == v41k fp8_gemv bitwise (production + edge shapes, M, splits, bias, layouts)", not bad,
+       comparisons=n_cmp, mismatches=len(bad), first=bad[:5], seconds=round(time.time() - t0, 1))
+record("ops: split-K counters are zero after every call", bad_counters == 0, nonzero=bad_counters)
+
+# oracle
+sys.path.insert(0, HERE)
+import fp8_ref  # noqa: E402
+
+o_bad = []
+for (m, n, k, sp, bias) in [(1, 32, 512, 1, False), (5, 64, 1024, 2, True), (6, 40, 544, 3, False),
+                            (8, 96, 1536, 1, True), (3, 33, 2048, 4, False)]:
+    x, w, s, b = make(m, n, k, 77 + m, bias)
+    want = fp8_ref.ref_gemv(x.cpu().numpy(), w.cpu().numpy(), s.cpu().numpy(), sp,
+                            None if b is None else b.cpu().numpy())
+    got = old(x, w, s, sp, b).cpu().numpy()
+    if not np.array_equal(got.view(np.uint16), want.view(np.uint16)):
+        o_bad.append(f"M{m} N{n} K{k} split{sp}")
+record("oracle: v41k fp8_gemv == numpy oracle (fp8_ref.py) bitwise", not o_bad, mismatches=o_bad)
+
+# mutant
+x, w, s, _ = make(6, 5120, 15360, 5)
+sp = gemv_split(5120, 15360)
+record("mutant: split+1 changes output bits (comparison is sensitive)",
+       not beq(new(x, w, s, sp + 1)[0], old(x, w, s, sp)), split=sp)
+
+# linear (the module the engine calls)
+ref_lin, dg, new_lin, pkg = staged_modules(True)
+l_bad, l_n = [], 0
+for name, n, k, m0, _ in SITES:
+    # One site at a time: the previous site's weight is freed and the caching allocator may hand its
+    # address to this one, so clear the registry first (the TP4 child does the same per case).
+    dg._STATE.update({"starts": [], "ranges": []})
+    x, w, s, _ = make(6, n, k, 31 + n)
+    wf, sf = fp8(w, s)
+    dg.register_counters(wf)
+    for m in ms:
+        xm = x[:m].contiguous()
+        for bias in (None, (torch.randn(n, device=dev) * 0.1).half()):
+            l_n += 1
+            if not beq(new_lin.fp8_block32_linear(xm, wf, sf, bias), ref_lin.fp8_block32_linear(xm, wf, sf, bias)):
+                l_bad.append(f"{name} M{m} bias{int(bias is not None)}")
+    if n % 64 == 0:  # a 32-row aligned slice (grouped wo_a / shard style) finds its parent's counters
+        half_rows = n // 2
+        ws, ss = wf[half_rows:], sf[half_rows // 32:]
+        l_n += 1
+        if not beq(new_lin.fp8_block32_linear(x, ws, ss), ref_lin.fp8_block32_linear(x, ws, ss)):
+            l_bad.append(f"{name} slice")
+torch.cuda.synchronize()
+record("linear: staged fp8_block32_linear (GEMV2=1) == installed (knob off), bitwise", not l_bad, calls=l_n,
+       mismatches=l_bad)
+try:
+    new_lin.fp8_block32_linear(*(lambda t: (t[0], *fp8(t[1], t[2])))(make(5, 64, 512, 9)))
+    record("linear: an unregistered weight raises (no silent path)", False)
+except RuntimeError as e:
+    record("linear: an unregistered weight raises (no silent path)", "no counters registered" in str(e))
+
+# shard (single GPU simulation of MP_SHARD)
+sh_bad = []
+for m in (1, 5, 6, 8):
+    x, w, s, _ = make(m, 5120, 15360, 500 + m)
+    sp = gemv_split(5120, 15360)
+    full = old(x, w, s, sp)
+    rows = 5120 // 4
+    for impl in ("v41k", "v41draft"):
+        parts = []
+        for r in range(4):
+            wr, sr = w[r * rows:(r + 1) * rows], s[r * rows // 32:(r + 1) * rows // 32]
+            parts.append(old(x, wr, sr, sp) if impl == "v41k" else new(x, wr, sr, sp)[0])
+        if not beq(torch.cat(parts, dim=1), full):
+            sh_bad.append(f"{impl} M{m}")
+record("shard: 4 row shards (full split) concatenated == replicated main_proj, bitwise", not sh_bad,
+       mismatches=sh_bad)
+
+# graph replay
+x, w, s, b = make(5, 1280, 5120, 41, True)
+sp = gemv_split(1280, 5120)
+c = torch.zeros(80, dtype=torch.int32, device=dev)
+gout = torch.empty(5, 1280, dtype=torch.half, device=dev)
+part = torch.empty(sp * 5 * 1280, device=dev)
+st = torch.cuda.Stream()
+st.wait_stream(torch.cuda.current_stream())
+with torch.cuda.stream(st):
+    KD.fp8_gemv2(gout, x, w, s, part, sp, b, c, 0)
+torch.cuda.current_stream().wait_stream(st)
+g = torch.cuda.CUDAGraph()
+with torch.cuda.graph(g):
+    KD.fp8_gemv2(gout, x, w, s, part, sp, b, c, 0)
+g_ok = True
+for i in range(50):
+    gout.fill_(float("nan"))
+    if i == 25:
+        x.copy_((torch.randn_like(x.float()) * 0.5).half())
+    g.replay()
+    torch.cuda.synchronize()
+    g_ok &= beq(gout, old(x, w, s, sp, b))
+record("graph: 50 replays (input changed mid-way) == eager v41k, counters zero", g_ok and not bool(c.any()))
+
+# trap
+tp = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "--lib", args.lib, "--v41k", args.v41k,
+                     "--trap-child"], capture_output=True, text=True, timeout=300)
+record("trap: a stale split-K counter traps (process fails loudly)",
+       tp.returncode != 0 and "no trap" not in tp.stdout, rc=tp.returncode,
+       tail=(tp.stderr.strip().splitlines() or [""])[-1][:160])
+
+
+# ----------------------------------------------------------------------------------------------- timing
+def graphed_us(fns, reps=20, rounds=5, iters=20):
+    """fns: list of callables, cycled (weights rotate so the measured traffic comes from HBM)."""
+    s2 = torch.cuda.Stream()
+    s2.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s2):
+        for f in fns:
+            f()
+    torch.cuda.current_stream().wait_stream(s2)
+    gr = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(gr):
+        for i in range(reps):
+            fns[i % len(fns)]()
+    for _ in range(3):
+        gr.replay()
+    out = []
+    for _ in range(rounds):
+        a, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        for _ in range(iters):
+            gr.replay()
+        e.record()
+        e.synchronize()
+        out.append(a.elapsed_time(e) * 1000.0 / (iters * reps))
+    return round(statistics.median(out), 2)
+
+
+def timed(n, k, m, split, rows=None):
+    copies = max(2, min(20, (64 << 20) // (n * k) + 1))
+    sets = [make(m, n, k, 900 + i) for i in range(copies)]
+    if rows is not None:
+        sets = [(x, w[:rows].contiguous(), s[:rows // 32].contiguous(), b) for x, w, s, b in sets]
+    nn = sets[0][1].shape[0]
+    outs = torch.empty(m, nn, dtype=torch.half, device=dev)
+    part = torch.empty(split * m * nn, device=dev)
+    cs = [torch.zeros((nn + 15) // 16, dtype=torch.int32, device=dev) for _ in sets]
+    row = {"old": graphed_us([lambda t=t: K41.fp8_gemv(outs, t[0], t[1], t[2], part, split, None) for t in sets])}
+    for layout in ((0, 1) if m <= 6 else (0,)):
+        row[f"new_l{layout}"] = graphed_us(
+            [lambda t=t, c=c, L=layout: KD.fp8_gemv2(outs, t[0], t[1], t[2], part, split, None, c, L)
+             for t, c in zip(sets, cs)])
+    return row
+
+
+if not args.no_time:
+    timing, tot = {}, {"old": 0.0, "new_l0": 0.0, "new_l1": 0.0, "new_best": 0.0}
+    for name, n, k, m, calls in SITES:
+        row = timed(n, k, m, gemv_split(n, k))
+        timing[name] = dict(row, M=m, calls=calls)
+        best = min(v for kk, v in row.items() if kk.startswith("new"))
+        for key in ("old", "new_l0", "new_l1"):
+            tot[key] += calls * row.get(key, row["new_l0"])
+        tot["new_best"] += calls * best
+        print("TIME", name, f"M{m}", f"x{calls}", json.dumps(row), flush=True)
+    sh = timed(5120, 15360, 6, gemv_split(5120, 15360), rows=1280)
+    timing["main_proj_shard_1280"] = sh
+    print("TIME main_proj_shard_1280 M6 x1", json.dumps(sh), flush=True)
+    mp = timing["main_proj"]
+    tot_mp_old = tot["old"] - mp["old"] + sh["old"]
+    tot_mp_new = tot["new_best"] - min(mp["new_l0"], mp["new_l1"]) + min(sh["new_l0"], sh["new_l1"])
+    summary = {"round_old_us": round(tot["old"], 1), "round_gemv2_l0_us": round(tot["new_l0"], 1),
+               "round_gemv2_l1_us": round(tot["new_l1"], 1), "round_gemv2_best_us": round(tot["new_best"], 1),
+               "round_mp_shard_only_us": round(tot_mp_old, 1), "round_both_best_us": round(tot_mp_new, 1),
+               "note": "isolated graphed kernels; excludes the fp8_reduce launch gaps and the all-gather (~15 us)"}
+    results["timing_us"], results["timing_round"] = timing, summary
+    print("TIME round", json.dumps(summary), flush=True)
+    record("timing collected (informational)", True)
+
+results["ok"] = not fails
+results["fails"] = fails
+results["finished"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+if args.json:
+    with open(args.json, "w") as f:
+        json.dump(results, f, indent=1)
+print("ALL OK" if not fails else "FAILED: " + ", ".join(fails))
+sys.exit(0 if not fails else 1)
diff --git a/benchmarks/deepseek_v41/v41draft/fp8_ref.py b/benchmarks/deepseek_v41/v41draft/fp8_ref.py
