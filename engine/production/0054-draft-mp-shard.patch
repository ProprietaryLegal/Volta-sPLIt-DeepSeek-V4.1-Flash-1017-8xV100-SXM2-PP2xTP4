+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// v41draft: the DSpark draft's FP8 (E4M3, UE8M0 32x32 block scales) small-M GEMV for SM70, BITWISE equal to
+// #1277's v41k fp8_gemv_kernel<M> + fp8_reduce (VLLM_V41_DRAFT_GEMV2, lane drafter1103).
+//
+// Arithmetic contract (copied from v41k fp8_gemv_kernel, unchanged): for output (m, n) and split s
+// (kbeg = s * ksplit, kend = min(K, kbeg + ksplit), ksplit = round_up(ceil(K / split), 16)), "lane" l = 0..31 walks
+// the 16-code chunks k0 = kbeg + 16 l + 512 j < kend in ascending j:
+//     dot = 0; for i in 0..15: dot = fmaf(e4m3_as_fp16(w[n, k0 + i]), float(x[m, k0 + i]), dot)
+//     acc_l = fmaf(dot, scale(n, k0 / 32), acc_l)                      (acc_l starts at 0)
+// then the 32 lane values are summed by the xor butterfly 16, 8, 4, 2, 1 (lane 0's value is the partial).
+// split == 1 and no bias: out = half_rn(partial). Otherwise out = half_rn(((0 + p_0) + p_1) + ... + float(bias)).
+// e4m3_as_fp16(b) is the fp16 with bits ((b & 0x7f) << 7) | ((b & 0x80) << 8) (= E4M3 x 2^-8, exact, subnormals
+// included); the 2^8 is folded into the scale: e + 8 < 255 ? 2^(e + 8 - 127) : 2^(e - 127) * 256.
+//
+// What is different (scheduling only; every FP operation and its operand order is the same):
+//   * rows of x are split over two warp groups (M = 5 -> 3 + 2, M = 6 -> 3 + 3, M = 4 -> 2 + 2, M = 7/8 -> 4 + 3/4),
+//     so a warp holds at most 3 (4) rows of x in registers: <= 128 registers for M <= 6 (old: 162 at M 6), two
+//     256-thread CTAs per SM instead of one for M 6. The two groups read the same weight rows (L1 hits) and run the
+//     same code (the second group of M 5/7 computes one zero row of x that it never stores);
+//   * E4M3 -> fp16 for two codes at once (byte_perm + two shifts + one lop3 per pair), the same 16-bit patterns;
+//   * the next chunk's weight words and scales are loaded before the current chunk is computed;
+//   * split-K partials are summed by the last CTA of each row block (threadfence + atomic counter, fixed split order,
+//     __ldcg reads), so there is no second fp8_reduce launch. The counter is reset by that CTA; a counter that is not
+//     below the split count on entry is an illegal state and traps (no silent wrong sums).
+// CTA: 256 threads, 8 warps x 4 rows; 32 rows per CTA with one warp group (M <= 3), 16 rows with two. Grid
+// (ceil(N / rows), split). Workspace: partials [split, M, N] fp32 (caller-owned, no init) and counters int32
+// [>= ceil(N / 16)] that start at zero and are left at zero (allocate once per weight; never shared by two
+// concurrently running launches). No allocation, no host sync: CUDA-graph capturable.
+//
+// Compile check without torch:
+//   nvcc -DV41DRAFT_NO_TORCH -std=c++17 -O3 -gencode=arch=compute_70,code=sm_70 -Xptxas=-v -cubin -o x.cubin v41draft.cu
+#include <cuda_fp16.h>
+#include <cstdint>
+
+#ifndef V41DRAFT_NO_TORCH
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <torch/all.h>
+#include <torch/library.h>
+#endif
+
+namespace v41draft {
+
+constexpr int kThreads = 256;
+constexpr int64_t kVersion = 1;  // bumped on any change of the kernel or its contract
+
+struct Params {
+  half* out;              // [M, N]
+  float* partials;        // [split, M, N] (unused when direct)
+  int* counters;          // [ceil(N / rows)] (unused when direct)
+  const half* x;          // [M, K]
+  const uint8_t* w;       // [N, K] E4M3 codes
+  const uint8_t* scales;  // [ceil(N / 32), K / 32] UE8M0 exponents
+  const half* bias;       // [N] or nullptr
+  int M, N, K, ksplit, split, direct;
+};
+
+// Two E4M3 codes (bytes 0 and 1 of p32 = b0 | b1 << 16) -> the two fp16 patterns of the contract, as floats.
+__device__ __forceinline__ float2 e4m3_pair(uint32_t word, bool high) {
+  const uint32_t p = __byte_perm(word, 0u, high ? 0x4342u : 0x4140u);
+  const uint32_t bits = ((p & 0x007f007fu) << 7) | ((p & 0x00800080u) << 8);
+  __half2_raw raw;
+  raw.x = static_cast<unsigned short>(bits & 0xffffu);
+  raw.y = static_cast<unsigned short>(bits >> 16);
+  return __half22float2(__half2(raw));
+}
+
+__device__ __forceinline__ float ue8m0_scale(int e) {
+  return e + 8 < 255 ? __int_as_float((e + 8) << 23) : __int_as_float(e << 23) * 256.f;
+}
+
+// One warp: rows n0 .. n0 + 3 (those below N), x rows mbase .. mbase + mcount - 1 (mcount <= MS), split s. Both warp
+// groups run this one instance (one hot loop in the instruction cache); a group with mcount < MS computes on zero
+// rows of x that it never stores.
+template <int MS>
+__device__ __forceinline__ void warp_rows(const Params& p, int n0, int mbase, int mcount, int s, int lane) {
+  const int K = p.K, N = p.N;
+  const int nvalid = min(4, N - n0);  // may be <= 0: the warp then only joins the CTA barriers
+  const int sgroups = K / 32;
+  const int kbeg = s * p.ksplit, k_end = min(K, kbeg + p.ksplit);
+  float acc[4][MS];
+#pragma unroll
+  for (int r = 0; r < 4; ++r)
+#pragma unroll
+    for (int m = 0; m < MS; ++m) acc[r][m] = 0.f;
+  uint4 q[4];
+  int e[4];
+  int k0 = kbeg + lane * 16;
+  if (k0 < k_end) {
+#pragma unroll
+    for (int r = 0; r < 4; ++r) {
+      if (r < nvalid) {
+        q[r] = __ldg(reinterpret_cast<const uint4*>(p.w + int64_t(n0 + r) * K + k0));
+        e[r] = __ldg(p.scales + ((n0 + r) / 32) * sgroups + k0 / 32);
+      } else {
+        q[r] = make_uint4(0u, 0u, 0u, 0u);
+        e[r] = 0;
+      }
+    }
+  }
+  while (k0 < k_end) {
+    const int kn = k0 + 512;
+    uint4 qn[4];
+    int en[4];
+    if (kn < k_end) {
+#pragma unroll
+      for (int r = 0; r < 4; ++r) {
+        if (r < nvalid) {
+          qn[r] = __ldg(reinterpret_cast<const uint4*>(p.w + int64_t(n0 + r) * K + kn));
+          en[r] = __ldg(p.scales + ((n0 + r) / 32) * sgroups + kn / 32);
+        } else {
+          qn[r] = make_uint4(0u, 0u, 0u, 0u);
+          en[r] = 0;
+        }
+      }
+    }
+    float xv[MS][16];
+#pragma unroll
+    for (int m = 0; m < MS; ++m) {
+      uint4 a = make_uint4(0u, 0u, 0u, 0u), b = a;
+      if (m < mcount) {
+        const half* xr = p.x + int64_t(mbase + m) * K + k0;
+        a = __ldg(reinterpret_cast<const uint4*>(xr));
+        b = __ldg(reinterpret_cast<const uint4*>(xr + 8));
+      }
+      const half2* ha = reinterpret_cast<const half2*>(&a);
+      const half2* hb = reinterpret_cast<const half2*>(&b);
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const float2 fa = __half22float2(ha[i]), fb = __half22float2(hb[i]);
+        xv[m][2 * i] = fa.x;
+        xv[m][2 * i + 1] = fa.y;
+        xv[m][8 + 2 * i] = fb.x;
+        xv[m][8 + 2 * i + 1] = fb.y;
+      }
+    }
+#pragma unroll
+    for (int r = 0; r < 4; ++r) {
+      if (r < nvalid) {
+        const float scale = ue8m0_scale(e[r]);
+        const uint32_t words[4] = {q[r].x, q[r].y, q[r].z, q[r].w};
+        float v[16];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const float2 lo = e4m3_pair(words[j], false), hi = e4m3_pair(words[j], true);
+          v[4 * j] = lo.x;
+          v[4 * j + 1] = lo.y;
+          v[4 * j + 2] = hi.x;
+          v[4 * j + 3] = hi.y;
+        }
+        float dot[MS];
+#pragma unroll
+        for (int m = 0; m < MS; ++m) dot[m] = 0.f;
+#pragma unroll
+        for (int i = 0; i < 16; ++i)
+#pragma unroll
+          for (int m = 0; m < MS; ++m) dot[m] = fmaf(v[i], xv[m][i], dot[m]);
+#pragma unroll
+        for (int m = 0; m < MS; ++m) acc[r][m] = fmaf(dot[m], scale, acc[r][m]);
+      }
+    }
+    k0 = kn;
+#pragma unroll
+    for (int r = 0; r < 4; ++r) {
+      q[r] = qn[r];
+      e[r] = en[r];
+    }
+  }
+#pragma unroll
+  for (int r = 0; r < 4; ++r)
+#pragma unroll
+    for (int m = 0; m < MS; ++m) {
+      float v = acc[r][m];
+#pragma unroll
+      for (int o = 16; o; o >>= 1) v += __shfl_xor_sync(0xffffffffU, v, o);
+      acc[r][m] = v;
+    }
+  if (lane == 0) {
+#pragma unroll
+    for (int r = 0; r < 4; ++r) {
+      if (r < nvalid) {
+        const int n = n0 + r;
+#pragma unroll
+        for (int m = 0; m < MS; ++m) {
+          if (m >= mcount) continue;
+          if (p.direct)
+            p.out[int64_t(mbase + m) * N + n] = __float2half_rn(acc[r][m]);
+          else
+            p.partials[(int64_t(s) * p.M + mbase + m) * N + n] = acc[r][m];
+        }
+      }
+    }
+  }
+}
+
+// Two CTAs per SM (<= 128 registers) while a warp holds <= 3 rows of x; M 7/8 (4 rows) keep one CTA and no spills.
+template <int M0, int M1>
+__global__ void __launch_bounds__(kThreads, M0 <= 3 ? 2 : 1) fp8_gemv2_kernel(const Params p) {
+  constexpr int kGroups = M1 > 0 ? 2 : 1;
+  constexpr int kWarpsPerGroup = 8 / kGroups;
+  constexpr int kRows = kWarpsPerGroup * 4;
+  const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+  const int group = warp / kWarpsPerGroup;
+  const int n0 = blockIdx.x * kRows + (warp % kWarpsPerGroup) * 4;
+  const int s = blockIdx.y;
+  static_assert(M1 <= M0, "the first warp group holds the most rows of x");
+  warp_rows<M0>(p, n0, group * M0, group == 0 ? M0 : M1, s, lane);
+  if (p.direct) return;
+  __shared__ int s_last;
+  __threadfence();
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    const int prev = atomicAdd(p.counters + blockIdx.x, 1);
+    if (prev < 0 || prev >= static_cast<int>(gridDim.y)) __trap();  // stale counter: illegal state
+    s_last = prev == static_cast<int>(gridDim.y) - 1;
+  }
+  __syncthreads();
+  if (!s_last) return;
+  __threadfence();
+  const int nbase = blockIdx.x * kRows;
+  const int rows = min(kRows, p.N - nbase);
+  for (int i = threadIdx.x; i < rows * p.M; i += kThreads) {
+    const int m = i / rows, n = nbase + i % rows;
+    float v = 0.f;
+    for (int ss = 0; ss < p.split; ++ss) v += __ldcg(p.partials + (int64_t(ss) * p.M + m) * p.N + n);
+    if (p.bias) v += __half2float(p.bias[n]);
+    p.out[int64_t(m) * p.N + n] = __float2half_rn(v);
+  }
+  if (threadIdx.x == 0) atomicExch(p.counters + blockIdx.x, 0);
+}
+
+// Layouts (same arithmetic, scheduling only): 0 = two warp groups for M >= 4 (16 rows per CTA); 1 = one warp group
+// holding all M rows of x (32 rows per CTA, the original kernel's geometry; M <= 6). M <= 3 is one group in both.
+inline int rows_per_cta(int M, int layout) { return (M <= 3 || layout == 1) ? 32 : 16; }
+
+inline int ksplit_of(int K, int split) {
+  int ksplit = (K + split - 1) / split;  // v41k_fp8_gemv's formula
+  return (ksplit + 15) / 16 * 16;
+}
+
+inline void launch(const Params& p, int layout, cudaStream_t stream) {
+  const int rows = rows_per_cta(p.M, layout);
+  const dim3 grid((p.N + rows - 1) / rows, p.split);
+#define V41DRAFT_L(A, B) fp8_gemv2_kernel<A, B><<<grid, kThreads, 0, stream>>>(p)
+  if (layout == 1 && p.M >= 4) {
+    switch (p.M) {
+      case 4: V41DRAFT_L(4, 0); break;
+      case 5: V41DRAFT_L(5, 0); break;
+      default: V41DRAFT_L(6, 0); break;
+    }
+    return;
+  }
+  switch (p.M) {
+    case 1: V41DRAFT_L(1, 0); break;
+    case 2: V41DRAFT_L(2, 0); break;
+    case 3: V41DRAFT_L(3, 0); break;
+    case 4: V41DRAFT_L(2, 2); break;
+    case 5: V41DRAFT_L(3, 2); break;
+    case 6: V41DRAFT_L(3, 3); break;
+    case 7: V41DRAFT_L(4, 3); break;
+    default: V41DRAFT_L(4, 4); break;
+  }
+#undef V41DRAFT_L
+}
+
+#ifdef V41DRAFT_NO_TORCH
+__global__ void version_kernel(int64_t* out) { *out = kVersion; }
+// compile-check instantiations
+template __global__ void fp8_gemv2_kernel<1, 0>(const Params);
+template __global__ void fp8_gemv2_kernel<2, 0>(const Params);
+template __global__ void fp8_gemv2_kernel<3, 0>(const Params);
+template __global__ void fp8_gemv2_kernel<2, 2>(const Params);
+template __global__ void fp8_gemv2_kernel<3, 2>(const Params);
+template __global__ void fp8_gemv2_kernel<3, 3>(const Params);
+template __global__ void fp8_gemv2_kernel<4, 3>(const Params);
+template __global__ void fp8_gemv2_kernel<4, 4>(const Params);
+template __global__ void fp8_gemv2_kernel<4, 0>(const Params);
+template __global__ void fp8_gemv2_kernel<5, 0>(const Params);
+template __global__ void fp8_gemv2_kernel<6, 0>(const Params);
+#else
+// out [M, N] fp16; x [M, K] fp16; w [N, K] uint8 (E4M3 bits); scales [ceil(N/32), K/32] uint8 (UE8M0);
+// partials fp32 >= split*M*N elements unless direct; counters int32 >= ceil(N / 16) unless direct.
+// direct = split == 1 and no bias (v41k_fp8_gemv's rule). layout: see rows_per_cta (1 needs M <= 6).
+void fp8_gemv2(at::Tensor out, const at::Tensor& x, const at::Tensor& w, const at::Tensor& scales,
+               at::Tensor partials, int64_t split, const c10::optional<at::Tensor>& bias, at::Tensor counters,
+               int64_t layout) {
+  const at::cuda::OptionalCUDAGuard guard(x.device());
+  TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kHalf && x.dim() == 2 && x.is_contiguous(),
+              "v41draft.fp8_gemv2: x must be contiguous CUDA fp16 [M, K]");
+  const int64_t M = x.size(0), K = x.size(1), N = w.size(0);
+  TORCH_CHECK(M >= 1 && M <= 8, "v41draft.fp8_gemv2: M must be 1..8, got ", M);
+  TORCH_CHECK(K % 32 == 0 && K > 0, "v41draft.fp8_gemv2: K must be a positive multiple of 32");
+  TORCH_CHECK(split >= 1 && split <= 65535, "v41draft.fp8_gemv2: split must be 1..65535");
+  TORCH_CHECK(layout == 0 || (layout == 1 && M <= 6), "v41draft.fp8_gemv2: layout must be 0, or 1 with M <= 6");
+  TORCH_CHECK(w.scalar_type() == at::kByte && w.dim() == 2 && w.size(1) == K && w.is_contiguous() &&
+                  w.device() == x.device() && N >= 1,
+              "v41draft.fp8_gemv2: w must be contiguous uint8 [N, K] on x's device");
+  TORCH_CHECK(scales.scalar_type() == at::kByte && scales.dim() == 2 && scales.size(0) == (N + 31) / 32 &&
+                  scales.size(1) == K / 32 && scales.is_contiguous() && scales.device() == x.device(),
+              "v41draft.fp8_gemv2: scales must be contiguous uint8 [ceil(N/32), K/32]");
+  TORCH_CHECK(out.scalar_type() == at::kHalf && out.dim() == 2 && out.size(0) == M && out.size(1) == N &&
+                  out.is_contiguous() && out.device() == x.device(),
+              "v41draft.fp8_gemv2: out must be contiguous fp16 [M, N]");
+  TORCH_CHECK(reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0 &&
+                  reinterpret_cast<uintptr_t>(w.data_ptr()) % 16 == 0,
+              "v41draft.fp8_gemv2: x and w must be 16-byte aligned");
+  const bool direct = split == 1 && !bias.has_value();
+  Params p{};
+  p.out = reinterpret_cast<half*>(out.data_ptr());
+  p.x = reinterpret_cast<const half*>(x.data_ptr());
+  p.w = w.data_ptr<uint8_t>();
+  p.scales = scales.data_ptr<uint8_t>();
+  p.bias = nullptr;
+  p.M = static_cast<int>(M);
+  p.N = static_cast<int>(N);
+  p.K = static_cast<int>(K);
+  p.split = static_cast<int>(split);
+  p.ksplit = ksplit_of(p.K, p.split);
+  p.direct = direct ? 1 : 0;
+  if (!direct) {
+    TORCH_CHECK(partials.scalar_type() == at::kFloat && partials.is_contiguous() &&
+                    partials.numel() >= split * M * N && partials.device() == x.device(),
+                "v41draft.fp8_gemv2: partials must be contiguous fp32 with >= split*M*N elements");
+    TORCH_CHECK(counters.scalar_type() == at::kInt && counters.is_contiguous() && counters.dim() == 1 &&
+                    counters.numel() >= (N + 15) / 16 && counters.device() == x.device(),
+                "v41draft.fp8_gemv2: counters must be contiguous int32 [>= ceil(N/16)] on x's device");
+    p.partials = partials.data_ptr<float>();
+    p.counters = counters.data_ptr<int>();
+    if (bias.has_value()) {
+      TORCH_CHECK(bias->scalar_type() == at::kHalf && bias->numel() == N && bias->is_contiguous() &&
+                      bias->device() == x.device(),
+                  "v41draft.fp8_gemv2: bias must be contiguous fp16 [N]");
+      p.bias = reinterpret_cast<const half*>(bias->data_ptr());
+    }
+  }
+  launch(p, static_cast<int>(layout), at::cuda::getCurrentCUDAStream());
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+int64_t rows_per_cta_op(int64_t M, int64_t layout) {
+  return rows_per_cta(static_cast<int>(M), static_cast<int>(layout));
+}
+int64_t version_op() { return kVersion; }
+#endif
+
+}  // namespace v41draft
+
+#ifndef V41DRAFT_NO_TORCH
+TORCH_LIBRARY(v41draft, m) {
+  m.def(
+      "fp8_gemv2(Tensor(a!) out, Tensor x, Tensor w, Tensor scales, Tensor(b!) partials, int split, "
+      "Tensor? bias, Tensor(c!) counters, int layout) -> ()");
+  m.def("rows_per_cta(int M, int layout) -> int", &v41draft::rows_per_cta_op);
+  m.def("version() -> int", &v41draft::version_op);
+}
+
+TORCH_LIBRARY_IMPL(v41draft, CUDA, m) { m.impl("fp8_gemv2", &v41draft::fp8_gemv2); }
+#endif
