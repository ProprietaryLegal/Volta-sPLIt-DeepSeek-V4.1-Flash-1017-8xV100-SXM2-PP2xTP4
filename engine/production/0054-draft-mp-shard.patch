@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""DSpark draft FP8 GEMV levers (lane drafter1103). Both are BITWISE.
+
+VLLM_V41_DRAFT_GEMV2=1
+    Every call that fp8_block32_linear sends to v41k's fp8_gemv (1 <= M <= 8
+    with VLLM_V41_FP8_GEMV=1) runs v41draft's fp8_gemv2 instead: the same
+    per-output FP32 operations in the same order (see v41draft.cu), with the
+    rows of x split over two warp groups, a cheaper E4M3 decode, a prefetched
+    next chunk and the split-K sum done in-kernel by the last CTA (no
+    fp8_reduce launch). Needs v41draft.so and per-weight counters, which
+    V41Fp8LinearMethod registers at load time.
+VLLM_V41_DRAFT_GEMV2_LAYOUT=0|1
+    0 (default): two warp groups for M >= 4; 1: one group (the original
+    kernel's geometry; M <= 6, M 7..8 use 0). Scheduling only; the output
+    bits are the same.
+VLLM_V41_DRAFT_MP_SHARD=1
+    The draft's main_proj (a ReplicatedLinear: every TP rank reads the full
+    5120 x 15360 FP8 weight, 78.6 MB, every round) computes only this rank's
+    N / TP output columns with the split of the full call, then all-gathers
+    them. An output element depends only on its x row, its weight row, K and
+    the split, so the gathered result is bitwise the replicated one. Scope:
+    the GEMV path (1 <= M <= 8, VLLM_V41_FP8_GEMV=1); larger M (prefill) keeps
+    the replicated call by design.
+
+The knobs are read with os.getenv here so envs.py (patched by other kits)
+stays untouched. Library: VLLM_V41_DRAFT_GEMV_LIB, else
+benchmarks/deepseek_v41/v41draft/build/v41draft.so beside VLLM_V41K_LIB's
+v41k directory.
+"""
+
+import bisect
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def _flag(name):
+    value = os.getenv(name, "0") or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1, got {value!r}")
+    return value == "1"
+
+
+GEMV2 = _flag("VLLM_V41_DRAFT_GEMV2")
+MP_SHARD = _flag("VLLM_V41_DRAFT_MP_SHARD")
+LAYOUT = int(os.getenv("VLLM_V41_DRAFT_GEMV2_LAYOUT", "0") or "0")
+if LAYOUT not in (0, 1):
+    raise ValueError("VLLM_V41_DRAFT_GEMV2_LAYOUT must be 0 or 1")
+LIB_VERSION = 1
+MAX_M = 8
+
+_STATE: dict = {"loaded": False, "starts": [], "ranges": [], "logged": set()}
+
+
+def gemv_split(n, k):
+    """Split-K count of fp8_block32_linear's GEMV path for an n x k weight."""
+    ctas = (n + 31) // 32
+    return max(1, min(k // 512 if k >= 512 else 1, (240 + ctas - 1) // ctas))
+
+
+def library_path():
+    explicit = os.getenv("VLLM_V41_DRAFT_GEMV_LIB")
+    if explicit:
+        return explicit
+    v41k = os.getenv("VLLM_V41K_LIB")
+    if v41k:
+        root = os.path.dirname(os.path.dirname(os.path.dirname(v41k)))
+    else:
+        root = os.path.join(
+            os.path.dirname(os.path.abspath(__file__)),
+            "..",
+            "..",
+            "..",
+            "benchmarks",
+            "deepseek_v41",
+        )
+    return os.path.join(root, "v41draft", "build", "v41draft.so")
+
+
+def ready():
+    """Load v41draft.so once. With GEMV2 on, a missing library is an error."""
+    if not _STATE["loaded"]:
+        path = library_path()
+        torch.ops.load_library(path)  # raises OSError when the .so is missing
+        version = torch.ops.v41draft.version()
+        if version != LIB_VERSION:
+            raise RuntimeError(
+                f"VLLM_V41_DRAFT_GEMV2: {path} is version {version}, "
+                f"this module needs {LIB_VERSION}"
+            )
+        _STATE["loaded"] = True
+        logger.info(
+            "V4.1 draft GEMV2: v41draft fp8_gemv2 active (%s, layout %d)",
+            path,
+            LAYOUT,
+        )
+    return True
+
+
+def register_counters(weight):
+    """Allocate the split-K counters of one FP8 weight (load time, zeros).
+
+    Slices of the weight (grouped wo_a, the main_proj shard) use the counters
+    of the weight they lie in; a weight's launches are stream-ordered, never
+    concurrent, and each launch leaves its counters at zero.
+    """
+    start = weight.data_ptr()
+    end = start + weight.numel() * weight.element_size()
+    i = bisect.bisect_right(_STATE["starts"], start)
+    if (i and _STATE["ranges"][i - 1][1] > start) or (
+        i < len(_STATE["starts"]) and _STATE["starts"][i] < end
+    ):
+        raise RuntimeError("V4.1 draft GEMV2: overlapping FP8 weight registrations")
+    counters = torch.zeros(
+        (weight.shape[0] + 15) // 16, dtype=torch.int32, device=weight.device
+    )
+    _STATE["starts"].insert(i, start)
+    _STATE["ranges"].insert(i, (start, end, counters))
+
+
+def counters_for(weight):
+    start = weight.data_ptr()
+    end = start + weight.numel() * weight.element_size()
+    i = bisect.bisect_right(_STATE["starts"], start) - 1
+    if i < 0 or not _STATE["ranges"][i][0] <= start < end <= _STATE["ranges"][i][1]:
+        raise RuntimeError(
+            "V4.1 draft GEMV2: no counters registered for this FP8 weight "
+            "(V41Fp8LinearMethod.process_weights_after_loading registers them)"
+        )
+    counters = _STATE["ranges"][i][2]
+    if counters.numel() < (weight.shape[0] + 15) // 16:
+        raise RuntimeError("V4.1 draft GEMV2: counters smaller than the weight")
+    return counters
+
+
+def gemv(x, weight, scales, split, bias=None):
+    """fp8_block32_linear's GEMV path with an explicit split.
+
+    weight [N, K] float8_e4m3fn and scales [ceil(N/32), K/32] float8_e8m0fnu
+    may be row slices (32-row aligned) of a registered weight. Returns
+    [M, N] fp16, bitwise v41k fp8_gemv(..., split, bias).
+    """
+    m, n = x.shape[0], weight.shape[0]
+    if not 1 <= m <= MAX_M:
+        raise ValueError(f"V4.1 draft GEMV: M must be 1..{MAX_M}, got {m}")
+    result = torch.empty(m, n, dtype=x.dtype, device=x.device)
+    partials = torch.empty(
+        split * m * n if (split > 1 or bias is not None) else 1,
+        device=x.device,
+        dtype=torch.float32,
+    )
+    if GEMV2:
+        ready()
+        torch.ops.v41draft.fp8_gemv2(
+            result,
+            x,
+            weight.view(torch.uint8),
+            scales.view(torch.uint8),
+            partials,
+            split,
+            bias,
+            counters_for(weight),
+            LAYOUT if m <= 6 else 0,  # layout 1 exists for M <= 6 only
+        )
+    else:
+        torch.ops.v41k.fp8_gemv(
+            result,
+            x,
+            weight.view(torch.uint8),
+            scales.view(torch.uint8),
+            partials,
+            split,
+            bias,
+        )
+    return result
+
+
+def sharded_projection(x, weight, scales, rank, world, gather):
+    """Rows [rank * N / world, (rank + 1) * N / world) with the full call's
+    split, then ``gather`` (dim -1). Bitwise the replicated GEMV."""
+    n, k = weight.shape
+    if n % (32 * world):
+        raise ValueError(f"V4.1 draft MP_SHARD: N={n} is not a multiple of 32*{world}")
+    if x.dtype != torch.float16 or x.ndim != 2 or not x.is_contiguous():
+        raise ValueError("V4.1 draft MP_SHARD needs contiguous FP16 [M, K] input")
+    if x.shape[1] != k or k % 32:
+        raise ValueError("V4.1 draft MP_SHARD: input width does not match the weight")
+    if scales.shape != (n // 32, k // 32):
+        raise ValueError("V4.1 draft MP_SHARD needs [N/32, K/32] UE8M0 scales")
+    if weight.dtype != torch.float8_e4m3fn or scales.dtype != torch.float8_e8m0fnu:
+        raise ValueError("V4.1 draft MP_SHARD needs an FP8 E4M3 weight, UE8M0 scales")
+    if not (weight.is_contiguous() and scales.is_contiguous()):
+        raise ValueError("V4.1 draft MP_SHARD needs contiguous weight and scales")
+    rows = n // world
+    split = gemv_split(n, k)
+    part = gemv(
+        x,
+        weight[rank * rows : (rank + 1) * rows],
+        scales[rank * rows // 32 : (rank + 1) * rows // 32],
+        split,
+    )
+    key = ("mp", rank, world, n, k)
+    if key not in _STATE["logged"]:
+        _STATE["logged"].add(key)
+        logger.info(
+            "V4.1 DSpark main_proj: TP-sharded GEMV (rank %d/%d, rows %d..%d, "
+            "split %d, gemv2 %s)",
+            rank,
+            world,
+            rank * rows,
+            (rank + 1) * rows,
+            split,
+            GEMV2,
+        )
+    return gather(part, -1)
