index 000000000..77790c0fd
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41draft/fp8_ref.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU oracle for the DSpark draft FP8 GEMV (numpy only, no torch, no GPU).
+
+ref_gemv(x, w, scales, split, bias) computes, in exactly the order of
+#1277's v41k fp8_gemv_kernel<M> + fp8_reduce (v41k.cu, "FP8 (e4m3, UE8M0
+32x32 block scales) small-M GEMV for the DSpark draft"):
+  * lane l of split s walks the 16-code chunks k0 = kbeg + 16 l + 512 j;
+  * dot = fmaf chain over the chunk (E4M3 -> fp16 bit placement -> fp32);
+  * acc_l = fmaf(dot, scale, acc_l); the xor butterfly 16, 8, 4, 2, 1;
+  * direct (split 1, no bias): fp16(partial); else fp16(0 + p_0 + ... + bias).
+fmaf is emulated exactly: the product of two float32 is exact in float64,
+TwoSum recovers the error of the float64 sum, and the one case where float64
+rounding can change the float32 result (the sum lands exactly on a float32
+midpoint) is resolved by the error's sign.
+"""
+
+import numpy as np
+
+F32 = np.float32
+
+
+def e4m3_fp16_bits(codes):
+    """The fp16 bit pattern the kernels give an E4M3 code: E4M3 x 2^-8."""
+    b = codes.astype(np.uint32)
+    return (((b & 0x7F) << 7) | ((b & 0x80) << 8)).astype(np.uint16)
+
+
+def e4m3_decode(codes):
+    return e4m3_fp16_bits(codes).view(np.float16).astype(F32)
+
+
+def ue8m0_scale(e):
+    e = e.astype(np.uint32)
+    hi = (e + 8) < 255
+    a = ((e + 8) << 23).astype(np.uint32).view(F32)
+    with np.errstate(over="ignore"):
+        b = (e << 23).astype(np.uint32).view(F32) * F32(256.0)
+    return np.where(hi, a, b).astype(F32)
+
+
+def fmaf(a, b, c):
+    """Exact float32 fused multiply-add, elementwise (round to nearest even)."""
+    a64, b64, c64 = (np.asarray(v, F32).astype(np.float64) for v in (a, b, c))
+    p = a64 * b64  # exact: 24 + 24 significant bits
+    s = p + c64
+    bb = s - p
+    t = (p - (s - bb)) + (c64 - bb)  # s + t == p + c exactly (TwoSum)
+    with np.errstate(over="ignore", invalid="ignore"):
+        r = s.astype(F32)
+        up = np.nextafter(r, F32(np.inf))
+        down = np.nextafter(r, F32(-np.inf))
+        mid_up = (r.astype(np.float64) + up.astype(np.float64)) * 0.5
+        mid_dn = (r.astype(np.float64) + down.astype(np.float64)) * 0.5
+        r = np.where((s == mid_up) & (t > 0), up, r)
+        r = np.where((s == mid_dn) & (t < 0), down, r)
+    return r.astype(F32)
+
+
+def ksplit_of(k, split):
+    ksplit = (k + split - 1) // split
+    return (ksplit + 15) // 16 * 16
+
+
+def gemv_split(n, k):
+    """fp8_block32_linear's split for its GEMV path (see fp8_linear.py)."""
+    ctas = (n + 31) // 32
+    return max(1, min(k // 512 if k >= 512 else 1, (240 + ctas - 1) // ctas))
+
+
+def ref_partials(x, w, scales, split):
+    """[split, M, N] float32 partials (lane 0 of the butterfly)."""
+    x = np.asarray(x, np.float16).astype(F32)
+    m, k = x.shape
+    n = w.shape[0]
+    wv = e4m3_decode(np.asarray(w, np.uint8))  # [N, K]
+    sc = ue8m0_scale(np.asarray(scales, np.uint8))  # [N/32, K/32]
+    ks = ksplit_of(k, split)
+    out = np.zeros((split, m, n), F32)
+    for s in range(split):
+        kbeg, kend = s * ks, min(k, s * ks + ks)
+        acc = np.zeros((32, m, n), F32)
+        for lane in range(32):
+            k0 = kbeg + lane * 16
+            while k0 < kend:
+                dot = np.zeros((m, n), F32)
+                for i in range(16):
+                    dot = fmaf(wv[None, :, k0 + i], x[:, None, k0 + i], dot)
+                scale = sc[np.arange(n) // 32, k0 // 32][None, :]
+                acc[lane] = fmaf(dot, scale, acc[lane])
+                k0 += 512
+        idx = np.arange(32)
+        for o in (16, 8, 4, 2, 1):
+            acc = (acc + acc[idx ^ o]).astype(F32)
+        out[s] = acc[0]
+    return out
+
+
+def ref_gemv(x, w, scales, split, bias=None):
+    parts = ref_partials(x, w, scales, split)
+    if split == 1 and bias is None:
+        return parts[0].astype(np.float16)
+    v = np.zeros(parts.shape[1:], F32)
+    for s in range(split):
+        v = (v + parts[s]).astype(F32)
+    if bias is not None:
+        v = (v + np.asarray(bias, np.float16).astype(F32)[None, :]).astype(F32)
+    return v.astype(np.float16)
diff --git a/benchmarks/deepseek_v41/v41draft/test_v41draft_cpu.py b/benchmarks/deepseek_v41/v41draft/test_v41draft_cpu.py
new file mode 100644
index 000000000..932538f91
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41draft/test_v41draft_cpu.py
@@ -0,0 +1,380 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for lane drafter1103 (VLLM_V41_DRAFT_GEMV2 / VLLM_V41_DRAFT_MP_SHARD). No GPU, no compile.
+
+  python -I test_v41draft_cpu.py --repo <worktree> [--base-rev 7e9a15686]
+  python -I test_v41draft_cpu.py --knob-off-only --file NEW=BASE [--file NEW=BASE ...]
+
+Checks (each prints OK/FAIL; exit 0 only if all pass):
+  knob-off   fp8_linear.py and dspark.py with every VLLM_V41_DRAFT_* statement removed are AST-identical to the base
+  decode     the kernel's two-codes-at-once E4M3 decode gives the same fp16 bits as the per-code formula (all 65536
+             pairs) and those bits are the OCP E4M3 value x 2^-8 (all 254 finite codes; independent float math)
+  fmaf       the oracle's exact float32 fma equals exact rational arithmetic (fractions) on random and tie cases
+  split      draft_gemv.gemv_split equals the split statements of base fp8_block32_linear for every N, K in a grid
+  ksplit     v41draft.cu's ksplit formula is v41k.cu's (text)
+  oracle     ref_gemv against an independent float64 dot product (tolerance check of the oracle itself)
+  shard      4 row shards computed with the full call's split and concatenated == the replicated call, bitwise,
+             through draft_gemv.sharded_projection (gemv replaced by the oracle); and with each shard's own split
+             (the mutant) they differ, so the check is sensitive
+  counters   draft_gemv.register_counters / counters_for: slices of a weight find its counters, overlaps and
+             unregistered weights raise
+"""
+
+import argparse
+import ast
+import fractions
+import importlib.util
+import os
+import random
+import re
+import subprocess
+import sys
+import types
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import fp8_ref  # noqa: E402
+
+RESULTS = []
+
+
+def report(name, ok, detail=""):
+    RESULTS.append(ok)
+    print(f"{'OK  ' if ok else 'FAIL'} {name}{': ' + detail if detail else ''}", flush=True)
+
+
+# ---------------------------------------------------------------- knob-off identity
+def _names(node):
+    return {n.id for n in ast.walk(node) if isinstance(n, ast.Name)}
+
+
+def _strip(tree):
+    """Remove the drafter1103 additions: module names _DRAFT_*, functions _draft_*, `if <uses _DRAFT_*>:` blocks
+    without else, and `import os` at module level of fp8_linear.py (the base imports no os there)."""
+
+    class T(ast.NodeTransformer):
+        def generic_visit(self, node):
+            for field, value in ast.iter_fields(node):
+                if isinstance(value, list) and value and isinstance(value[0], ast.stmt):
+                    keep = []
+                    for st in value:
+                        if isinstance(st, ast.If) and any(x.startswith("_DRAFT_") for x in _names(st.test)):
+                            if st.orelse:
+                                raise ValueError("knob-off strip: an `if _DRAFT_*` with else is not allowed")
+                            continue
+                        if isinstance(st, ast.Assign) and all(
+                            isinstance(t, ast.Name) and t.id.startswith("_DRAFT_") for t in st.targets
+                        ):
+                            continue
+                        if isinstance(st, ast.FunctionDef) and st.name.startswith("_draft_"):
+                            continue
+                        keep.append(st)
+                    setattr(node, field, keep)
+            return super().generic_visit(node)
+
+    return T().visit(tree)
+
+
+def knob_off_sensitivity(base_src, name):
+    """The strip must not hide a real change: a mutant outside the knob code has to fail the comparison."""
+    mutant = base_src.replace("import torch\n", "import torch\nimport math\n", 1)
+    knobbed = mutant.replace("import torch\n", "import torch\n_DRAFT_X = 1\n", 1)
+    a = ast.dump(_strip(ast.parse(knobbed)), include_attributes=False)
+    report(f"knob-off checker catches a non-knob change in {name}", mutant != base_src and a != ast.dump(
+        ast.parse(base_src), include_attributes=False))
+
+
+def knob_off(new_src, base_src, name):
+    new = ast.parse(new_src)
+    base = ast.parse(base_src)
+    base_imports_os = any(
+        isinstance(s, ast.Import) and any(a.name == "os" for a in s.names) for s in base.body
+    )
+    if not base_imports_os:
+        new.body = [s for s in new.body if not (isinstance(s, ast.Import) and [a.name for a in s.names] == ["os"])]
+    stripped = _strip(new)
+    a, b = ast.dump(stripped, include_attributes=False), ast.dump(base, include_attributes=False)
+    report(f"knob-off {name}", a == b, "AST identical after removing VLLM_V41_DRAFT_* code" if a == b else "DIFFERS")
+    # the knob names must actually be read from the environment in the new file
+    if "_DRAFT_" in new_src:
+        ok = bool(re.search(r'VLLM_V41_DRAFT_(GEMV2|MP_SHARD)"', new_src))
+        report(f"knob-read {name}", ok)
+
+
+# ---------------------------------------------------------------- decode
+def byte_perm(x, y, sel):
+    """CUDA __byte_perm (default mode) on Python ints."""
+    src = [(x >> (8 * i)) & 0xFF for i in range(4)] + [(y >> (8 * i)) & 0xFF for i in range(4)]
+    return sum(src[(sel >> (4 * i)) & 0x7] << (8 * i) for i in range(4))
+
+
+def check_decode():
+    bad = 0
+    for word in range(0, 1 << 16):
+        for high in (False, True):
+            w32 = word if not high else word << 16
+            p = byte_perm(w32, 0, 0x4342 if high else 0x4140)
+            bits = ((p & 0x007F007F) << 7) | ((p & 0x00800080) << 8)
+            lo, hi = bits & 0xFFFF, bits >> 16
+            b0 = (w32 >> (16 if high else 0)) & 0xFF
+            b1 = (w32 >> (24 if high else 8)) & 0xFF
+            want = [int(fp8_ref.e4m3_fp16_bits(np.array([b], np.uint8))[0]) for b in (b0, b1)]
+            bad += (lo != want[0]) + (hi != want[1])
+    report("decode pair == per-code bits (65536 x 2 cases)", bad == 0, f"{bad} mismatches")
+    # OCP E4M3: s eeee mmm, bias 7, subnormal e=0: m/8 * 2^-6; 0x7f/0xff NaN
+    bad = 0
+    for b in range(256):
+        if b & 0x7F == 0x7F:
+            continue
+        s = -1.0 if b & 0x80 else 1.0
+        e, m = (b >> 3) & 0xF, b & 7
+        val = s * (m / 8.0) * 2.0**-6 if e == 0 else s * (1 + m / 8.0) * 2.0 ** (e - 7)
+        got = float(fp8_ref.e4m3_decode(np.array([b], np.uint8))[0])
+        bad += got != val * 2.0**-8 or (val == 0 and np.signbit(got) != (s < 0))
+    report("decode bits == OCP E4M3 value x 2^-8 (254 finite codes, signed zeros)", bad == 0, f"{bad} mismatches")
+
+
+# ---------------------------------------------------------------- fmaf
+def exact_fma(a, b, c):
+    a, b, c = (float(np.float32(v)) for v in (a, b, c))
+    r = fractions.Fraction(a) * fractions.Fraction(b) + fractions.Fraction(c)
+    # round the rational to float32, nearest even: bracket with float32 neighbours
+    f = np.float32(float(r))  # float(r) rounds to nearest double; fix up below
+    for _ in range(3):
+        lo, hi = (np.nextafter(f, np.float32(-np.inf)), f) if fractions.Fraction(float(f)) > r else (f, np.nextafter(f, np.float32(np.inf)))
+        dlo, dhi = r - fractions.Fraction(float(lo)), fractions.Fraction(float(hi)) - r
+        if dlo < dhi:
+            f = lo
+        elif dhi < dlo:
+            f = hi
+        else:
+            f = lo if (int(np.float32(lo).view(np.uint32)) & 1) == 0 else hi
+    return np.float32(f)
+
+
+def check_fmaf():
+    rng = random.Random(1103)
+    cases = []
+    for _ in range(4000):
+        cases.append(tuple(np.float32(rng.uniform(-4, 4) * 2.0 ** rng.randint(-30, 30)) for _ in range(3)))
+    # near-ties: a*b + c lands on/near float32 midpoints
+    for _ in range(4000):
+        a = np.float32(1 + rng.randint(0, 1 << 12) / (1 << 12))
+        b = np.float32(1 + rng.randint(0, 1 << 12) / (1 << 12))
+        c = np.float32(-float(np.float32(float(a) * float(b))) + rng.choice([0, 1, -1]) * 2.0**-24)
+        cases.append((a, b, c))
+    for _ in range(2000):  # products with exactly representable ties against large c
+        a = np.float32(2.0 ** rng.randint(-10, 10))
+        b = np.float32(1 + rng.randint(0, 255) / 256)
+        c = np.float32(rng.choice([1, -1]) * 2.0 ** rng.randint(10, 30))
+        cases.append((a, b, c))
+    a, b, c = (np.array(v, np.float32) for v in zip(*cases))
+    got = fp8_ref.fmaf(a, b, c)
+    bad = sum(int(got[i].view(np.uint32)) != int(exact_fma(*cases[i]).view(np.uint32)) for i in range(len(cases)))
+    report(f"fmaf oracle == exact rational ({len(cases)} cases incl. ties)", bad == 0, f"{bad} mismatches")
+
+
+# ---------------------------------------------------------------- split / ksplit
+def check_split(base_fp8_src):
+    tree = ast.parse(base_fp8_src)
+    fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "fp8_block32_linear")
+    stmts = []
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Assign):
+            tgt = [t.id for t in node.targets if isinstance(t, ast.Name)]
+            if tgt in (["ctas"], ["split"]) and "torch" not in ast.unparse(node):
+                stmts.append(node)
+    src = "\n".join(ast.unparse(s) for s in stmts[:2])
+    ok = src.startswith("ctas = ") and "split = max(1" in src
+    report("split statements found in base fp8_block32_linear", ok, src.replace("\n", "; "))
+    if not ok:
+        return
+    sys.path.insert(0, os.path.dirname(DRAFT_GEMV_PATH))
+    dg = load_draft_gemv()
+    bad = 0
+    for n in list(range(32, 9000, 32)) + [576, 1280, 5120, 8192, 15360]:
+        for k in [32, 64, 480, 512, 544, 576, 1024, 1280, 2048, 4096, 5120, 15360]:
+            env = {"n": n, "k": k}
+            exec(src, {"max": max, "min": min}, env)
+            bad += env["split"] != dg.gemv_split(n, k) or env["split"] != fp8_ref.gemv_split(n, k)
+    report("gemv_split == base fp8_block32_linear split (N x K grid)", bad == 0, f"{bad} mismatches")
+
+
+def check_ksplit(v41k_cu, v41draft_cu):
+    old = re.search(r"int ksplit = \(K \+ split - 1\) / split;\s*ksplit = \(ksplit \+ 15\) / 16 \* 16;", v41k_cu)
+    new = re.search(
+        r"int ksplit = \(K \+ split - 1\) / split;[^\n]*\n\s*return \(ksplit \+ 15\) / 16 \* 16;", v41draft_cu
+    )
+    report("ksplit formula: v41draft.cu == v41k.cu", bool(old and new))
+
+
+# ---------------------------------------------------------------- oracle / shard
+def rand_case(rng, m, n, k, nan_codes=False):
+    x = (rng.standard_normal((m, k)) * rng.choice([0.01, 1, 8])).astype(np.float16)
+    w = rng.integers(0, 256, (n, k), dtype=np.uint8)
+    if not nan_codes:
+        w[(w & 0x7F) == 0x7F] ^= 1
+    scales = rng.integers(112, 124, ((n + 31) // 32, k // 32), dtype=np.uint8)
+    return x, w, scales
+
+
+def check_oracle():
+    rng = np.random.default_rng(1103)
+    worst = 0.0
+    for m, n, k, split in [(1, 32, 512, 1), (5, 64, 1024, 2), (6, 96, 1280, 3), (3, 32, 2048, 4)]:
+        x, w, s = rand_case(rng, m, n, k)
+        got = fp8_ref.ref_gemv(x, w, s, split).astype(np.float64)
+        wv = fp8_ref.e4m3_decode(w).astype(np.float64) * np.repeat(
+            np.repeat(fp8_ref.ue8m0_scale(s).astype(np.float64), 32, 0)[:n], 32, 1
+        )
+        want = x.astype(np.float64) @ wv.T
+        err = np.max(np.abs(got - want) / (np.abs(want) + 1e-3 * np.max(np.abs(want))))
+        worst = max(worst, float(err))
+    report("oracle vs float64 dot (sanity, not bitwise)", worst < 2e-3, f"max rel err {worst:.2e}")
+
+
+def load_draft_gemv():
+    """Import draft_gemv.py without vllm: stub vllm.logger."""
+    if "draft_gemv_under_test" in sys.modules:
+        return sys.modules["draft_gemv_under_test"]
+    import logging
+
+    vllm = types.ModuleType("vllm")
+    vlog = types.ModuleType("vllm.logger")
+    vlog.init_logger = logging.getLogger
+    sys.modules.setdefault("vllm", vllm)
+    sys.modules["vllm.logger"] = vlog
+    spec = importlib.util.spec_from_file_location("draft_gemv_under_test", DRAFT_GEMV_PATH)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["draft_gemv_under_test"] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def check_shard():
+    import torch
+
+    dg = load_draft_gemv()
+    rng = np.random.default_rng(7)
+    world = 4
+    calls = []
+
+    def oracle_gemv(x, weight, scales, split, bias=None):
+        calls.append((tuple(weight.shape), split))
+        return torch.from_numpy(
+            fp8_ref.ref_gemv(x.numpy(), weight.view(torch.uint8).numpy(), scales.view(torch.uint8).numpy(), split,
+                             None if bias is None else bias.numpy())
+        )
+
+    def gather(part, dim):
+        return gathered.setdefault("parts", []).append(part) or part
+
+    orig = dg.gemv
+    dg.gemv = oracle_gemv
+    try:
+        bad = 0
+        for m, n, k in [(6, 512, 1536), (1, 256, 1024), (5, 384, 2048)]:
+            x, w, s = rand_case(rng, m, n, k)
+            full = fp8_ref.ref_gemv(x, w, s, fp8_ref.gemv_split(n, k))
+            parts = []
+            for rank in range(world):
+                gathered = {}
+                dg.sharded_projection(
+                    torch.from_numpy(x), torch.from_numpy(w).view(torch.float8_e4m3fn),
+                    torch.from_numpy(s).view(torch.float8_e8m0fnu), rank, world, gather
+                )
+                parts.append(gathered["parts"][0].numpy())
+            cat = np.concatenate(parts, axis=1)
+            bad += int(not np.array_equal(cat.view(np.uint16), full.view(np.uint16)))
+            # mutant: each shard with its own (local-N) split
+            local = np.concatenate(
+                [
+                    fp8_ref.ref_gemv(x, w[r * n // world : (r + 1) * n // world],
+                                     s[r * n // world // 32 : (r + 1) * n // world // 32],
+                                     fp8_ref.gemv_split(n // world, k))
+                    for r in range(world)
+                ],
+                axis=1,
+            )
+            same_split = fp8_ref.gemv_split(n // world, k) == fp8_ref.gemv_split(n, k)
+            if not same_split and np.array_equal(local.view(np.uint16), full.view(np.uint16)):
+                bad += 1
+                print(f"  mutant not caught at M{m} N{n} K{k}")
+        splits = sorted(set(c[1] for c in calls))
+        report("shard: concat of 4 shards (full split) == replicated, bitwise; local-split mutant differs", bad == 0,
+               f"{bad} failures; splits used {splits}")
+        # the projection must refuse misaligned N
+        try:
+            dg.sharded_projection(torch.zeros(1, 64, dtype=torch.float16),
+                                  torch.zeros(96, 64, dtype=torch.uint8).view(torch.float8_e4m3fn),
+                                  torch.zeros(3, 2, dtype=torch.uint8).view(torch.float8_e8m0fnu), 0, 4, gather)
+            report("shard: N not a multiple of 32*TP raises", False)
+        except ValueError:
+            report("shard: N not a multiple of 32*TP raises", True)
+    finally:
+        dg.gemv = orig
+
+
+def check_counters():
+    import torch
+
+    dg = load_draft_gemv()
+    dg._STATE.update({"starts": [], "ranges": []})
+    a = torch.zeros(5120, 1024, dtype=torch.uint8)
+    b = torch.zeros(512, 1024, dtype=torch.uint8)
+    dg.register_counters(a)
+    dg.register_counters(b)
+    ok = dg.counters_for(a).numel() == 320 and dg.counters_for(b).numel() == 32
+    ok &= dg.counters_for(a[1280:2560]) is dg.counters_for(a)
+    ok &= int(dg.counters_for(a).abs().sum()) == 0
+    raised = 0
+    for fn in (lambda: dg.counters_for(torch.zeros(32, 1024, dtype=torch.uint8)),
+               lambda: dg.register_counters(a[32:64])):
+        try:
+            fn()
+        except RuntimeError:
+            raised += 1
+    report("counters: slices find their weight's counters; unregistered and overlapping raise", ok and raised == 2)
+
+
+def main():
+    global DRAFT_GEMV_PATH
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo", default=os.path.abspath(os.path.join(HERE, "..", "..", "..")))
+    ap.add_argument("--base-rev", default="7e9a15686")
+    ap.add_argument("--knob-off-only", action="store_true")
+    ap.add_argument("--file", action="append", default=[], help="NEW=BASE pairs for --knob-off-only")
+    ap.add_argument("--quick", action="store_true", help="skip the exhaustive decode and slow oracle checks")
+    a = ap.parse_args()
+    DRAFT_GEMV_PATH = os.path.join(a.repo, "vllm/models/deepseek_v41/draft_gemv.py")
+    if a.knob_off_only:
+        for pair in a.file:
+            new, base = pair.split("=", 1)
+            knob_off(open(new).read(), open(base).read(), os.path.basename(new))
+    else:
+        rel = "vllm/models/deepseek_v41"
+
+        def base(path):
+            return subprocess.run(["git", "-C", a.repo, "show", f"{a.base_rev}:{path}"], check=True,
+                                  capture_output=True, text=True).stdout
+
+        for f in ("fp8_linear.py", "dspark.py"):
+            knob_off(open(os.path.join(a.repo, rel, f)).read(), base(f"{rel}/{f}"), f)
+            knob_off_sensitivity(base(f"{rel}/{f}"), f)
+        if not a.quick:
+            check_decode()
+        check_fmaf()
+        check_split(base(f"{rel}/fp8_linear.py"))
+        check_ksplit(base("benchmarks/deepseek_v41/v41k/v41k.cu"),
+                     open(os.path.join(HERE, "v41draft.cu")).read())
+        check_oracle()
+        check_shard()
+        check_counters()
+    print("ALL OK" if all(RESULTS) else f"FAILED {RESULTS.count(False)} of {len(RESULTS)}")
+    return 0 if all(RESULTS) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
