+template <class To, class Ti, class B>
+inline __device__ To quant(Ti x, B n_bits) {
+  auto y = round<To>(x);
+  if constexpr (n_bits <
+                sizeof(To) * 8) {  // saturate operation for sub-byte type
+    return min(y, To((1 << n_bits) - 1));
+  } else {
+    return y;
+  }
+}
