+template<typename T>
+struct plus {
+    __device__ T operator()(T a, T b)
+    {
+        return a + b;
+    }
+};
+
+template<typename T>
+struct minus {
+    __device__ T operator()(T a, T b)
+    {
+        return a - b;
+    }
