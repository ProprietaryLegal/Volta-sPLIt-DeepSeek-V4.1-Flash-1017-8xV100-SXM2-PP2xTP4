@@ -0,0 +1,30 @@
+"""Build v41prefmoe.so, the SM70 prefill IQ GEMM library of VLLM_V41_PREFILL_IQ_GEMM (Volta sPLIt, D51).
+
+Same source (csrc/prefill_iq.cu and the packaged OpenMMLab TurboMind / 1Cat SM70 headers under csrc/upstream) and the
+same compiler flags as our production build; only our internal build-window guards were removed. The library is
+loaded from next to vllm/model_executor/layers/quantization/gguf_prefill_iq.py, so the result is copied there.
+
+  cd benchmarks/deepseek_v41/v41prefmoe && TORCH_CUDA_ARCH_LIST=7.0 python build.py
+"""
+from pathlib import Path
+import os
+import shutil
+
+from torch.utils.cpp_extension import load
+
+root = Path(__file__).resolve().parent
+if os.environ.get("TORCH_CUDA_ARCH_LIST") != "7.0":
+    raise RuntimeError("set TORCH_CUDA_ARCH_LIST=7.0: this library is built for SM70 only")
+build = root / "build"
+build.mkdir(exist_ok=True)
+load(name="v41prefmoe", sources=[str(root / "csrc/prefill_iq.cu")],
+     build_directory=str(build),
+     extra_include_paths=[str(root / "csrc/upstream"), str(root / "csrc/upstream/sm70_turbomind/lmdeploy")],
+     extra_cflags=["-O3", "-std=c++20", "-fvisibility=hidden"],
+     extra_cuda_cflags=["-O3", "-std=c++20", "-UNDEBUG", "--expt-relaxed-constexpr", "-Xptxas=-v",
+                        "--compiler-options=-fvisibility=hidden", "-U__CUDA_NO_HALF_OPERATORS__",
+                        "-U__CUDA_NO_HALF_CONVERSIONS__", "-U__CUDA_NO_HALF2_OPERATORS__"],
+     with_cuda=True, is_python_module=False, verbose=True)
+dest = root.parents[2] / "vllm/model_executor/layers/quantization/v41prefmoe.so"
+shutil.copyfile(build / "v41prefmoe.so", dest)
+print(f"v41prefmoe.so -> {dest}")
diff --git a/benchmarks/deepseek_v41/v41prefmoe/csrc/prefill_iq.cu b/benchmarks/deepseek_v41/v41prefmoe/csrc/prefill_iq.cu
