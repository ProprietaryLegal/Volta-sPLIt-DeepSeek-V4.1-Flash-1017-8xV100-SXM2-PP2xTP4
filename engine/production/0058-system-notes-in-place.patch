+def _system_in_place_switch() -> bool:
+    """VLLM_V41_SYSTEM_IN_PLACE: where a system-role message that arrives after
+    the first user or assistant message goes.
+
+    0 (default, also unset): it is moved into the system block at the front of
+    the prompt, as before. Every token after the front then shifts, and a chat
+    that adds such a message reads its whole prompt again.
+    1: it stays where the client sent it (the DeepSeek-V4.1 encoding renders a
+    mid-conversation system message natively). The front of the prompt does not
+    change, so the cached prefix still matches.
+    Anything else refuses at import (the server does not start).
+    """
+    value = os.getenv("VLLM_V41_SYSTEM_IN_PLACE", "0") or "0"
+    if value not in ("0", "1"):
+        raise ValueError(f"VLLM_V41_SYSTEM_IN_PLACE must be 0 or 1, got {value!r}")
+    return value == "1"
+
+
+_SYSTEM_IN_PLACE = _system_in_place_switch()
+if _SYSTEM_IN_PLACE:
+    logger.info(
+        "VLLM_V41_SYSTEM_IN_PLACE=1 active: mid-chat system messages keep their place"
+    )
+
+
+def _system_text(content) -> str:
+    """Text of a system-role message, without Claude Code's per-request
+    attribution header (it defeats prefix caching)."""
+    if isinstance(content, str):
+        return content
+    return "".join(
+        block.text
+        for block in content
+        if block.type == "text"
+        and block.text
+        and not block.text.startswith("x-anthropic-billing-header")
+    )
+
+
 def wrap_data_with_event(data: str, event: str):
