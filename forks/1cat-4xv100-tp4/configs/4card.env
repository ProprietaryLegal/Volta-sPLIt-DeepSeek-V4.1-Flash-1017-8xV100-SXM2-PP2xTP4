# 4card.env: environment of the DS-V4.1-Flash 4-card fork (one 4x V100-SXM2-32GB NVLink board, TP4, PP=1).
# Sourced by start.sh, verify.sh and smoke-4card.sh. Edit the MACHINE block for your host; leave the LEVER block
# alone unless you are running an A/B. Model files never go in the repository: the paths below are placeholders.
# Every "${X:-...}" line keeps a value already exported in the caller's shell, so `X=... ./start.sh` overrides it.

# ---------------------------------------------------------------- MACHINE (edit) ------------------------------------
# Install root written by install.sh: $FORK_HOME/src (patched 1Cat-vLLM), $FORK_HOME/.venv, $FORK_HOME/run.
FORK_HOME=${FORK_HOME:-$HOME/ds41-4card}
# Model files (the same downloads #1277 uses; see README "Model files"). __SET_ME__ makes start.sh refuse to boot.
DS41_GGUF=${DS41_GGUF:-__SET_ME__/gguf/DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00001-of-00004.gguf}
DS41_BASE=${DS41_BASE:-__SET_ME__/base}
DS41_ENGRAM=${DS41_ENGRAM:-__SET_ME__/gguf/DeepSeek-V4.1-Flash-Engram-IQ4_NL.gguf}
DS41_DSPARK=${DS41_DSPARK:-__SET_ME__/dspark-v41}
# The four GPUs of ONE NVLink board, as PCI_BUS_ID indices (custom all-reduce maps CUDA_VISIBLE_DEVICES with int(),
# so UUIDs fail there). the 8-GPU host's Board B is 0,1,4,5.
DS41_GPUS=${DS41_GPUS:-__SET_ME__}
DS41_HOST=${DS41_HOST:-127.0.0.1}
DS41_PORT=${DS41_PORT:-18044}
DS41_SERVED_NAME=${DS41_SERVED_NAME:-deepseek-v4.1-flash}
# Cold experts: share of each layer's routed experts kept in host RAM (#1277's measured 4-card value is 0.33; the
# 40 layers do not fit on four 32 GB cards with every expert resident, see README "Memory").
DS41_OFFLOAD=${DS41_OFFLOAD:-0.33}
# Toolchain for install.sh (#1277 built with CUDA 12.8 and gcc-14).
CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.8}
CC=${CC:-gcc-14}
CXX=${CXX:-g++-14}

# ---------------------------------------------------------------- RUNTIME (fixed) -----------------------------------
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export VLLM_WORKER_MULTIPROC_METHOD=spawn OMP_NUM_THREADS=1 VLLM_NO_USAGE_STATS=1
# The engine's v41k CUDA extension, built on THIS machine by install.sh (v41k/build_v41k.sh). Without it TP4 falls back
# to the TP1-only expert kernels and dies at graph capture.
export VLLM_V41K_LIB=${VLLM_V41K_LIB:-$FORK_HOME/src/benchmarks/deepseek_v41/v41k/build/v41k.so}

# ---------------------------------------------------------------- LEVERS (adopted, on) ------------------------------
# #1277's own serving envs (upstream run_serve3.sh): G3 down rows, same-session prefix reuse, 512K packed FP4 KV.
export VLLM_V41_DOWN_ROWS=1 VLLM_V41_SESSION_PREFIX=1 VLLM_V41_PACKED_KV=1 VLLM_V41_INDEX_TILE_MB=32
# Levers adopted on the 8-GPU host's 8-GPU PP2xTP4 build (README "Levers"); all PP-generic, traced on at PP=1.
export VLLM_V41_INDEX_REDUCE=1           # TOK1103: indexer top-k reduce over the custom all-reduce IPC bank
export VLLM_V41_DMV_X=1                  # dense M<=6 matvec family (dmv13_x) in v41k
export VLLM_V41_COUPLED_DRAFTS=1         # coupled (Gumbel-shared) DSpark drafts for T>0
export VLLM_V41_COUPLED_DRAFT_TEMP=1.0
export VLLM_V41_MARKOV_SHARD=1           # greedy Markov draft head sharded over the TP ranks (self-checked at load)
export VLLM_V41_COUPLED_SHARD=1          # coupled draft head sharded over the TP ranks
export VLLM_V41_COUPLED_LOCAL=1          # coupled verify on rank-local vocabulary shards
export VLLM_V41_PLAN_FUSE=1              # expert plan built inside the q8 quantize launch
export VLLM_V41_EXPERT_FAST=1            # routed experts on v41k gate_up_fast + down_rows_fast
export VLLM_V41_FUSE_ATTN_PREP=1         # query RoPE + kv_norm/RoPE/FP8 QDQ in one launch per layer
export VLLM_V41_FUSE_ATTN_POST=1         # window ring insert + inverse RoPE + output FP8 QDQ in one launch
export VLLM_V41_HOT_REFILL=1 VLLM_V41_RING_REACH=124   # 1Cat #1341 hot-ring refill on a same-session prefix hit
# PP_KEEP_BATCH keeps the persistent batch across EMPTY PIPELINE STEPS, which only exist at PP>=2. At PP=1 the engine
# rejects it with "VLLM_V41_PP_KEEP_BATCH=1 ignored ... pipeline_parallel_size is 1" and runs the default path.
export VLLM_V41_PP_KEEP_BATCH=0
# Synchronous scheduling (serve-4card.yaml no-async-scheduling) is the configuration every adopted lever was measured
# in. Upstream #1277 ran async at PP=1 (UPSTREAM ~4 ms/round less host time); the async arm is PENDING (README).
unset VLLM_V41_ASYNC

# ---------------------------------------------------------------- PENDING (off; add when it wins) -------------------
# Each line is a hook: uncomment ONLY after the lever wins its own A/B on this board (README "Pending levers").
# export VLLM_V41_ASYNC=1                 # + async-scheduling: true in the yaml (start.sh ASYNC=1 does both)
# export VLLM_V41_MIX_STREAM=1            # D33 (and VLLM_V41_MIX_STREAM_GROUPS)
# export VLLM_V41_EXPERT_DIET=3           # D34: adopted value 3 on the 8-GPU build (needs the diet1103 v41k.so)
# export VLLM_V41_PREFILL_SKIP_ROWS=1     # D35
# export VLLM_USE_V2_MODEL_RUNNER=1       # D32 MRV2 runner
# export VLLM_V41_KV_HOT_POSITIONS=524288 # D31 C3 hot ring (about +330 MiB/GPU ESTIMATED; mind the 500K-prefill floor)
# VLLM_V41_MULTI_SEQ                      # PP2-only by design (interleaves sequences across pipeline stages)
