index 000000000..d9d012f87
--- /dev/null
+++ b/vllm/models/deepseek_v41/expert_topp.py
@@ -0,0 +1,213 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Decode routed-expert top-p prune. LOSSY, off by default.
+
+A port of TensorFold's TF_DSV41_EXPERT_TOPP rule (router_gemv.cu
+`prune_row`, as carried by 0rand/deepseek-v41-tensorfold-spark @ a903cb5).
+TensorFold production: TOPP 0.85, MIN_K 3, MIN_W 0, RENORM kept, decode and
+verify rows only. Author's figure: about +5 % decode.
+
+Per row, on the K routed weights w_0..w_{K-1} (slot = pick order):
+
+  total = sum of w in slot order (fp32, sequential)
+  f_i   = w_i / total
+  rank  = position by f descending, ties by the lower slot
+  excl  = exclusive prefix sum of f in rank order (sequential)
+  keep  = (excl < TOPP and f >= MIN_W) or rank < MIN_K
+  ks    = sum of the kept w in slot order
+  w_i'  = kept: w_i (orig) or scale * w_i / ks (kept); dropped: 0
+  id_i' = kept: id_i; dropped: -1
+
+A row that keeps every slot comes back bit for bit. Dropped routes carry
+id -1, which the v41k expert-major kernels skip (`moe_plan`: "id < 0: route
+dropped"). Only rows <= MAX_ROWS (the dp4a decode/verify path) are pruned.
+Every op stays on device without a host sync, so the call is graph safe.
+
+Environment (read once at import; a bad value raises):
+  VLLM_V41_PRUNE_TOPP    routed mass kept, (0, 1); 0 = off (default)
+  VLLM_V41_PRUNE_MIN_W   weight-fraction floor, [0, 1]; default 0 (off)
+  VLLM_V41_PRUNE_MIN_K   never fewer kept experts, 1..6; default 3
+  VLLM_V41_PRUNE_RENORM  kept (default) | orig
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+PREFIX = "VLLM_V41_PRUNE_"
+OFF = ("", "0", "off", "false", "no")
+KMAX = 6
+MAX_ROWS = 6
+
+
+@dataclass(frozen=True)
+class Rule:
+    topp: float = 0.0
+    min_w: float = 0.0
+    min_k: int = 3
+    renorm: str = "kept"
+
+    @property
+    def on(self) -> bool:
+        return 0.0 < self.topp < 1.0 or self.min_w > 0.0
+
+
+def _unit(env, name: str, open_top: bool) -> float:
+    raw = env.get(name, "").strip().lower()
+    if raw in OFF:
+        return 0.0
+    try:
+        v = float(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: a number in [0, 1]") from None
+    if not (0.0 <= v < 1.0 if open_top else 0.0 <= v <= 1.0):
+        top = ")" if open_top else "]"
+        raise ValueError(f"{name}={raw!r}: a number in [0, 1{top}")
+    return v
+
+
+def parse(env=None) -> Rule | None:
+    """The rule from the environment, or None when pruning is off."""
+    env = os.environ if env is None else env
+    topp = _unit(env, PREFIX + "TOPP", open_top=True)
+    min_w = _unit(env, PREFIX + "MIN_W", open_top=False)
+    raw_k = env.get(PREFIX + "MIN_K", "").strip()
+    try:
+        min_k = int(raw_k) if raw_k else 3
+    except ValueError:
+        raise ValueError(f"{PREFIX}MIN_K={raw_k!r}: 1..{KMAX}") from None
+    if not 1 <= min_k <= KMAX:
+        raise ValueError(f"{PREFIX}MIN_K={raw_k!r}: 1..{KMAX}")
+    renorm = env.get(PREFIX + "RENORM", "").strip().lower() or "kept"
+    if renorm not in ("kept", "orig"):
+        raise ValueError(f"{PREFIX}RENORM={renorm!r}: kept or orig")
+    rule = Rule(topp, min_w, min_k, renorm)
+    return rule if rule.on else None
+
+
+RULE = parse()
+
+
+def prune(
+    weights: torch.Tensor,
+    ids: torch.Tensor,
+    rule: Rule,
+    scale: float | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """New (weights, ids) for [R, K] router outputs; inputs are not modified.
+
+    `scale` is the kept-renorm target (the routed scaling factor); it
+    defaults to each row's own total.
+    """
+    if weights.shape != ids.shape or weights.dim() != 2:
+        raise ValueError(
+            f"expected matching [R, K] tensors, got {tuple(weights.shape)}"
+            f" / {tuple(ids.shape)}"
+        )
+    R, K = weights.shape
+    if not 1 <= K <= KMAX:
+        raise ValueError(f"top-k {K} outside 1..{KMAX}")
+    if rule.min_k >= K:
+        return weights, ids
+    w = weights.to(torch.float32)
+    total = w[:, 0].clone()
+    for i in range(1, K):
+        total = total + w[:, i]
+    f = w / total[:, None]
+    # Rank: f descending; a stable sort keeps slot order among equals.
+    order = torch.sort(f, dim=1, descending=True, stable=True).indices
+    ranks = torch.arange(K, device=f.device).expand(R, K).contiguous()
+    rank = torch.empty_like(order).scatter_(1, order, ranks)
+    f_sorted = torch.gather(f, 1, order)
+    excl_sorted = torch.zeros_like(f_sorted)
+    acc = torch.zeros(R, dtype=torch.float32, device=f.device)
+    for r in range(K):
+        excl_sorted[:, r] = acc
+        acc = acc + f_sorted[:, r]
+    excl = torch.empty_like(f).scatter_(1, order, excl_sorted)
+    keep = rank < rule.min_k
+    mass = f >= rule.min_w
+    if 0.0 < rule.topp < 1.0:
+        mass = mass & (excl < rule.topp)
+    keep = keep | mass
+    zero = torch.zeros_like(total)
+    ks = torch.where(keep[:, 0], w[:, 0], zero)
+    for i in range(1, K):
+        ks = ks + torch.where(keep[:, i], w[:, i], zero)
+    if rule.renorm == "orig":
+        kept_w = w
+    else:
+        s = total if scale is None else torch.full_like(total, float(scale))
+        kept_w = s[:, None] * (w / ks[:, None])
+    new_w = torch.where(keep, kept_w, torch.zeros_like(w)).to(weights.dtype)
+    new_ids = torch.where(keep, ids, torch.full_like(ids, -1))
+    all_kept = keep.all(dim=1, keepdim=True)
+    return (
+        torch.where(all_kept, weights, new_w),
+        torch.where(all_kept, ids, new_ids),
+    )
+
+
+def check_path(experts, em_ready=None, resident_type=None) -> None:
+    """Raise unless every consumer of this layer's routes skips id -1.
+
+    Verified consumers: the V4.1 dp4a decode op on the expert-major TP4 row
+    path (`moe_plan` skips id < 0) and a resident expert cache, whose
+    resolve only validates. The cold-expert SharedExpertRank resolve, the
+    fp16 fallback, expert maps, EPLB, routing capture and expert tracing
+    index with the id and are refused.
+    """
+    if em_ready is None:
+        from vllm.model_executor.layers.quantization.gguf_v41_moe import (
+            _expert_major_ready as em_ready,
+        )
+    if resident_type is None:
+        from vllm.model_executor.layers.quantization.gguf_shared_runtime import (
+            ResidentExpertRank as resident_type,
+        )
+    qm = getattr(experts, "quant_method", None)
+    router = getattr(experts, "router", None)
+    cache = getattr(qm, "expert_cache", None)
+    w2 = getattr(experts, "gguf_w2", None)
+    problems = []
+    if not getattr(qm, "is_v41", False):
+        problems.append("experts are not the native V4.1 GGUF method")
+    if not getattr(qm, "dp4a_admitted", False):
+        problems.append("the dp4a decode path is not admitted")
+    if getattr(qm, "expert_trace_tokens", 0):
+        problems.append("expert tracing is on")
+    if getattr(experts, "expert_map", None) is not None:
+        problems.append("an expert map is set")
+    if getattr(router, "eplb_state", None) is not None:
+        problems.append("EPLB is on")
+    if getattr(router, "capture_fn", None) is not None:
+        problems.append("routed-expert capture is on")
+    if cache is not None and not isinstance(
+        getattr(cache, "runtime", None), resident_type
+    ):
+        problems.append("the expert cache is not fully resident")
+    if not em_ready():
+        problems.append("the v41k expert-major kernels are not loaded")
+    if w2 is None or w2.dim() < 2 or w2.shape[1] != 1280:
+        problems.append("the TP4 row-split down path is not active")
+    if problems:
+        raise RuntimeError(
+            "VLLM_V41_PRUNE_* is set but dropped routes are not safe here: "
+            + "; ".join(problems)
+            + ". Unset VLLM_V41_PRUNE_TOPP / VLLM_V41_PRUNE_MIN_W."
+        )
+
+
+def route_hook(module, weights: torch.Tensor, ids: torch.Tensor, scale: float):
+    """Prune a target MoE layer's decode routes when a rule is on."""
+    if RULE is None or not getattr(module, "prune_routes", False):
+        return weights, ids
+    if not getattr(module, "_prune_checked", False):
+        check_path(module.experts)
+        module._prune_checked = True
+    if weights.shape[0] > MAX_ROWS:
+        return weights, ids
+    return prune(weights, ids, RULE, scale)
