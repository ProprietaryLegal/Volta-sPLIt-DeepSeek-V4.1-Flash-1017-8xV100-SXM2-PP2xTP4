-"""Fused V4.1 router epilogue: sqrt(softplus) scores, biased top-k, renormalize."""
+"""Fused V4.1 router epilogue: sqrt(softplus) scores, biased top-k, renormalize.
+
+With PRUNE, the lossy decode expert top-p rule of
+vllm/models/deepseek_v41/expert_topp.py runs on the K weights in registers
+(no extra launch): dropped slots get weight 0 and id -1. It is bit-equal to
+expert_topp.prune(unpruned weights, ids, rule, SCALE).
+"""
 
 import torch
 
 from vllm.triton_utils import tl, triton
 
 
+@triton.jit
+def _pick(x, k, j):
+    """Lane j of an 8-lane vector as a scalar (exact: one non-zero term)."""
+    return tl.sum(tl.where(k == j, x, 0.0), 0)
+
+
+@triton.jit
+def _prune(
+    w,
+    chosen,
+    k,
+    K: tl.constexpr,
+    SCALE: tl.constexpr,
+    TOPP: tl.constexpr,
+    MIN_W: tl.constexpr,
+    MIN_K: tl.constexpr,
+    ORIG: tl.constexpr,
+):
+    live = k < K
+    w = tl.where(live, w, 0.0)
+    total = _pick(w, k, 0)
+    for j in tl.static_range(1, K):
+        total = total + _pick(w, k, j)
+    f = w / total
+    # rank: f descending, ties to the lower slot.
+    rank = tl.zeros((8,), tl.int32)
+    for j in tl.static_range(K):
+        fj = _pick(f, k, j)
+        ahead = (fj > f) | ((fj == f) & (j < k))
+        rank += ahead.to(tl.int32)
+    # Exclusive prefix of f in rank order, accumulated sequentially.
+    excl = tl.zeros((8,), tl.float32)
+    acc = _pick(f, k, -1)
+    for r in tl.static_range(K):
+        at = live & (rank == r)
+        excl = tl.where(at, acc, excl)
+        acc = acc + tl.sum(tl.where(at, f, 0.0), 0)
+    mass = f >= MIN_W
+    if TOPP > 0.0:
+        mass = mass & (excl < TOPP)
+    keep = live & ((rank < MIN_K) | mass)
+    ks = tl.sum(tl.where((k == 0) & keep, w, 0.0), 0)
+    for i in tl.static_range(1, K):
+        ks = ks + tl.sum(tl.where((k == i) & keep, w, 0.0), 0)
+    kept = w if ORIG else SCALE * (w / ks)
+    all_kept = tl.sum((live & ~keep).to(tl.int32), 0) == 0
+    out = tl.where(all_kept, w, tl.where(keep, kept, 0.0))
+    ids = tl.where(all_kept | keep, chosen, -1)
+    return out, ids
+
+
