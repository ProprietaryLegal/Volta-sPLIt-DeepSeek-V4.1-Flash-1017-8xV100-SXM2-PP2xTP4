diff --git a/tests/models/test_deepseek_v41_router_prune.py b/tests/models/test_deepseek_v41_router_prune.py
new file mode 100644
index 000000000..fbfd48aea
--- /dev/null
+++ b/tests/models/test_deepseek_v41_router_prune.py
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""V4.1 fused router with the in-kernel expert top-p prune (CPU, interpreter).
+
+``route_topk(..., prune=rule)`` must equal ``expert_topp.prune`` applied to
+the unpruned ``route_topk`` output bit for bit, and ``prune=None`` must keep
+the router's original output. The Triton kernel runs in the interpreter
+(TRITON_INTERPRET=1); ``vllm.triton_utils`` is stubbed with triton itself.
+
+    python tests/models/test_deepseek_v41_router_prune.py   # or pytest
+"""
+
+import os
+
+os.environ["TRITON_INTERPRET"] = "1"  # before triton is imported
+
+import importlib.util  # noqa: E402
+import sys  # noqa: E402
+import types  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+import triton  # noqa: E402
+import triton.language as tl  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def _load(name, path, stub=False):
+    if stub and "vllm.triton_utils" not in sys.modules:
+        mod = types.ModuleType("vllm.triton_utils")
+        mod.tl, mod.triton = tl, triton
+        sys.modules.setdefault("vllm", types.ModuleType("vllm"))
+        sys.modules["vllm.triton_utils"] = mod
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+ROUTER = _load(
+    "v41_router_under_test",
+    ROOT / "vllm/model_executor/kernels/mhc/deepseek_v41_router.py",
+    stub=True,
+)
+ET = _load(
+    "v41_expert_topp_router_test", ROOT / "vllm/models/deepseek_v41/expert_topp.py"
+)
+Rule = ET.Rule
+
+
+def _inputs(rows, seed):
+    g = torch.Generator().manual_seed(seed)
+    logits = torch.randn(rows, 384, generator=g) * 2.0
+    bias = torch.randn(384, generator=g) * 0.1
+    return logits, bias
+
+
+def _torch_router(logits, bias, k=6, scale=1.5):
+    scores = torch.nn.functional.softplus(logits).sqrt()
+    ids = (scores + bias).topk(k, dim=-1).indices
+    p = scores.gather(1, ids)
+    return p / (p.sum(-1, keepdim=True) + 1e-20) * scale, ids
+
+
+def test_unpruned_router_matches_torch():
+    logits, bias = _inputs(6, 0)
+    w, ids = ROUTER.route_topk(logits, bias, 6, 1.5)
+    tw, tids = _torch_router(logits, bias)
+    assert torch.equal(ids, tids)
+    torch.testing.assert_close(w, tw, rtol=1e-5, atol=1e-6)
+
+
+RULES = [
+    Rule(0.85, 0.0, 3, "kept"),
+    Rule(0.7, 0.0, 1, "kept"),
+    Rule(0.5, 0.0, 2, "orig"),
+    Rule(0.0, 0.12, 2, "kept"),
+    Rule(0.9, 0.05, 3, "orig"),
+]
+
+
+@pytest.mark.parametrize("rule", RULES, ids=str)
+@pytest.mark.parametrize("seed", [0, 1])
+def test_in_kernel_prune_is_bit_equal_to_torch_rule(rule, seed):
+    logits, bias = _inputs(6, seed)
+    w, ids = ROUTER.route_topk(logits, bias, 6, 1.5)
+    pw, pids = ROUTER.route_topk(logits, bias, 6, 1.5, prune=rule)
+    ew, eids = ET.prune(w, ids, rule, 1.5)
+    assert torch.equal(pids, eids)
+    assert torch.equal(pw, ew), (pw, ew)
+
+
+def test_production_rule_drops_routes_in_kernel():
+    logits, bias = _inputs(6, 9)
+    rule = Rule(0.85, 0.0, 3, "kept")
+    hits = 0
+    for seed in range(4):
+        logits, bias = _inputs(6, seed + 20)
+        pw, pids = ROUTER.route_topk(logits, bias, 6, 1.5, prune=rule)
+        assert ((pids >= 0).sum(1) >= 3).all()
+        assert torch.equal(pw[pids < 0], torch.zeros_like(pw[pids < 0]))
+        hits += int((pids < 0).sum())
+    assert hits > 0
+
+
+def test_min_k_at_or_above_k_is_a_no_op():
+    logits, bias = _inputs(4, 3)
+    w, ids = ROUTER.route_topk(logits, bias, 6, 1.5)
+    pw, pids = ROUTER.route_topk(logits, bias, 6, 1.5, prune=Rule(0.5, 0.0, 6))
+    assert torch.equal(w, pw) and torch.equal(ids, pids)
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main([__file__, "-q"]))
