@@ -48,6 +49,33 @@ def _row_projection(
     tl.store(out + row * N + col, dot)
 
 
+@triton.jit
+def _gate_cols(
+    x,
+    weight,
+    out,
+    M: tl.constexpr,
+    K: tl.constexpr,
+    N: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    # One program per output column for all M (<= 8) rows. Every row runs the
+    # exact _row_projection body (same 1024-wide chunks, chunk order, loads,
+    # reduction and warps), so its FP32 result does not depend on M or on
+    # which kernel ran; the weight row is read once instead of M times.
+    col = tl.program_id(0)
+    index = tl.arange(0, BLOCK)
+    rows = tl.arange(0, 8)
+    acc = tl.zeros((8,), tl.float32)
+    for first in tl.static_range(triton.cdiv(K, BLOCK)):
+        k = first * BLOCK + index
+        for row in tl.static_range(M):
+            a = tl.load(x + row * K + k, k < K, 0).to(tl.float32)
+            b = tl.load(weight + col * K + k, k < K, 0).to(tl.float32)
+            acc = tl.where(rows == row, acc + tl.sum(a * b, 0), acc)
+    tl.store(out + rows * N + col, acc, rows < M)
+
