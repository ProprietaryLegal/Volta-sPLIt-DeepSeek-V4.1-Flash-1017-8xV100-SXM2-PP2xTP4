index 000000000..3a72b5f2e
--- /dev/null
+++ b/tests/models/test_deepseek_v41_router_floor.py
@@ -0,0 +1,181 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""V4.1 router floor kernels against today's kernels (CPU, Triton interpreter).
+
+``_route_fast`` (int32 ids, one packed int64 max per pick) must give
+``_route``'s routes and weights bit for bit, ties included, with and without
+the expert prune; ``_gate_cols`` (one program per gate column, all rows) must
+give ``_row_projection``'s FP32 logits bit for bit for M = 1..6.
+
+Scope: the interpreter runs ``tl.sum`` as a numpy reduction, so these tests
+prove the kernels' logic (indexing, packing, tie order, masking, chunk order
+and accumulation), not the GPU's in-warp reduction trees. The GPU check is
+benchmarks/deepseek_v41/router_floor_check.py.
+
+    python tests/models/test_deepseek_v41_router_floor.py   # or pytest
+"""
+
+import os
+
+os.environ["TRITON_INTERPRET"] = "1"  # before triton is imported
+
+import ast  # noqa: E402
+import importlib.util  # noqa: E402
+import sys  # noqa: E402
+import types  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+import triton  # noqa: E402
+import triton.language as tl  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def _stubs():
+    sys.modules.setdefault("vllm", types.ModuleType("vllm"))
+    if "vllm.triton_utils" not in sys.modules:
+        tu = types.ModuleType("vllm.triton_utils")
+        tu.tl, tu.triton = tl, triton
+        sys.modules["vllm.triton_utils"] = tu
+    if "vllm.envs" not in sys.modules:
+        envs = types.ModuleType("vllm.envs")
+        envs.VLLM_V41_COL_PROJ = "0"
+        envs.VLLM_V41_COL_B = "2"
+        envs.VLLM_V41_COL_BLOCK = "256"
+        envs.VLLM_V41_COL_W = "4"
+        envs.VLLM_V41_GATE_COLS = "0"
+        sys.modules["vllm.envs"] = envs
+        sys.modules["vllm"].envs = envs
+
+
+def _load(name, rel):
+    _stubs()
+    spec = importlib.util.spec_from_file_location(name, ROOT / rel)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+ROUTER = _load(
+    "v41_router_floor_router", "vllm/model_executor/kernels/mhc/deepseek_v41_router.py"
+)
+MHC = _load("v41_router_floor_mhc", "vllm/model_executor/kernels/mhc/deepseek_v41.py")
+ET = _load("v41_router_floor_topp", "vllm/models/deepseek_v41/expert_topp.py")
+
+
+def _logits(rows, seed, ties=False):
+    g = torch.Generator().manual_seed(seed)
+    logits = torch.randn(rows, 384, generator=g) * 2.0
+    bias = torch.randn(384, generator=g) * 0.1
+    if ties:
+        # Exact key ties: equal logits on experts with equal bias, placed so
+        # that tied experts land inside the top 6.
+        bias[10:20] = 0.05
+        for r in range(rows):
+            logits[r, 10:20] = logits[r].max() + 1.0
+            logits[r, 13] = logits[r, 11]
+    return logits, bias
+
+
+@pytest.mark.parametrize("rows", [1, 2, 3, 4, 5, 6])
+@pytest.mark.parametrize("ties", [False, True])
+def test_fast_route_matches_route(rows, ties):
+    for seed in range(3):
+        logits, bias = _logits(rows, seed + 10 * rows, ties)
+        w, ids = ROUTER.route_topk(logits, bias, 6, 1.5, fast=False)
+        fw, fids = ROUTER.route_topk(logits, bias, 6, 1.5, fast=True)
+        assert ids.dtype == torch.int64 and fids.dtype == torch.int32
+        assert torch.equal(fids.long(), ids)
+        assert torch.equal(fw, w)
+
+
+def test_ties_pick_the_lowest_expert_first():
+    logits, bias = _logits(2, 1, ties=True)
+    _, fids = ROUTER.route_topk(logits, bias, 6, 1.5, fast=True)
+    for r in range(2):
+        assert fids[r].tolist() == list(range(10, 16))
+
+
+@pytest.mark.parametrize(
+    "rule", [ET.Rule(0.85, 0.0, 3, "kept"), ET.Rule(0.5, 0.05, 1, "orig")], ids=str
+)
+def test_fast_route_with_prune_matches_route(rule):
+    logits, bias = _logits(6, 4)
+    w, ids = ROUTER.route_topk(logits, bias, 6, 1.5, prune=rule, fast=False)
+    fw, fids = ROUTER.route_topk(logits, bias, 6, 1.5, prune=rule, fast=True)
+    assert torch.equal(fids.long(), ids) and torch.equal(fw, w)
+    assert int((fids < 0).sum()) > 0
+
+
+def _row(x, weight):
+    out = torch.empty(x.shape[0], weight.shape[0], dtype=torch.float32)
+    MHC._row_projection[(x.shape[0], weight.shape[0])](
+        x,
+        weight,
+        out,
+        K=x.shape[1],
+        N=weight.shape[0],
+        NORMALIZE=False,
+        EPS=1e-20,
+        BLOCK=1024,
+    )
+    return out
+
+
+def _cols(x, weight):
+    out = torch.full((x.shape[0], weight.shape[0]), float("nan"))
+    MHC._gate_cols[(weight.shape[0],)](
+        x, weight, out, M=x.shape[0], K=x.shape[1], N=weight.shape[0], BLOCK=1024
+    )
+    return out
+
+
+@pytest.mark.parametrize("rows", [1, 2, 3, 4, 5, 6])
+def test_gate_cols_matches_row_projection(rows):
+    g = torch.Generator().manual_seed(rows)
+    x = torch.randn(rows, 5120, generator=g).half()
+    weight = (torch.randn(96, 5120, generator=g) * 0.02).bfloat16()
+    assert torch.equal(_cols(x, weight), _row(x, weight))
+
+
+def test_gate_cols_masks_a_partial_last_chunk_and_fp32_inputs():
+    g = torch.Generator().manual_seed(7)
+    x = torch.randn(4, 1500, generator=g)
+    weight = (torch.randn(24, 1500, generator=g) * 0.02).bfloat16()
+    assert torch.equal(_cols(x, weight), _row(x, weight))
+
+
+def test_gate_cols_rows_do_not_depend_on_m():
+    g = torch.Generator().manual_seed(9)
+    x = torch.randn(6, 5120, generator=g).half()
+    weight = (torch.randn(48, 5120, generator=g) * 0.02).bfloat16()
+    full = _cols(x, weight)
+    for m in range(1, 6):
+        assert torch.equal(_cols(x[:m].contiguous(), weight), full[:m])
+
+
+def test_dispatch_and_knobs():
+    src = (ROOT / "vllm/model_executor/kernels/mhc/deepseek_v41.py").read_text()
+    assert '_GATE_COLS = envs.VLLM_V41_GATE_COLS == "1"' in src
+    assert "if _GATE_COLS and not normalized and x.shape[0] > 0:" in src
+    router = (
+        ROOT / "vllm/model_executor/kernels/mhc/deepseek_v41_router.py"
+    ).read_text()
+    assert '_FAST = os.getenv("VLLM_V41_ROUTE_FAST", "0") == "1"' in router
+    envs = (ROOT / "vllm/envs.py").read_text()
+    for name, d in (
+        ("VLLM_V41_GATE_COLS", "0"),
+        ("VLLM_V41_ROUTE_FAST", "0"),
+        ("VLLM_V41_ROUTE_WARPS", "1"),
+    ):
+        assert f'    {name}: str = "{d}"\n' in envs
+        assert f'lambda: os.getenv("{name}", "{d}")' in envs
+    check = ROOT / "benchmarks/deepseek_v41/router_floor_check.py"
+    ast.parse(check.read_text())
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main([__file__, "-q"]))
