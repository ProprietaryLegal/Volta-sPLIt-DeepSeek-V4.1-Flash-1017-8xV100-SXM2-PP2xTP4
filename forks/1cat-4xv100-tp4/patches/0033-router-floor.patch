diff --git a/vllm/model_executor/kernels/mhc/deepseek_v41_router.py b/vllm/model_executor/kernels/mhc/deepseek_v41_router.py
index 12e8c5e98..a1764d1b2 100644
--- a/vllm/model_executor/kernels/mhc/deepseek_v41_router.py
+++ b/vllm/model_executor/kernels/mhc/deepseek_v41_router.py
@@ -8,10 +8,17 @@ vllm/models/deepseek_v41/expert_topp.py runs on the K weights in registers
 expert_topp.prune(unpruned weights, ids, rule, SCALE).
 """
 
+import os
+
 import torch
 
 from vllm.triton_utils import tl, triton
 
+# Router floor (default off): int32 ids (no int64 -> int32 cast launch), one
+# packed max per pick, ROUTE_WARPS warps. Routes and weights stay bit-equal.
+_FAST = os.getenv("VLLM_V41_ROUTE_FAST", "0") == "1"
+_FAST_WARPS = int(os.getenv("VLLM_V41_ROUTE_WARPS", "1"))
+
 
 @triton.jit
 def _pick(x, k, j):
@@ -106,15 +113,75 @@ def _route(
     tl.store(ids + t * K + k, chosen.to(tl.int64), k < K)
 
 
-def route_topk(logits, bias, top_k=6, scale=1.5, prune=None):
-    """`prune`: an expert_topp.Rule applied to every row, or None."""
+@triton.jit
+def _route_fast(
+    logits,
+    bias,
+    probs,
+    ids,
+    E: tl.constexpr,
+    K: tl.constexpr,
+    SCALE: tl.constexpr,
+    BLOCK: tl.constexpr,
+    PRUNE: tl.constexpr = False,
+    TOPP: tl.constexpr = 0.0,
+    MIN_W: tl.constexpr = 0.0,
+    MIN_K: tl.constexpr = 3,
+    ORIG: tl.constexpr = False,
