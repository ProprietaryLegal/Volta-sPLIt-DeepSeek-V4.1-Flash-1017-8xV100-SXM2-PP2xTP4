new file mode 100644
index 000000000..333e5dfc1
--- /dev/null
+++ b/benchmarks/deepseek_v41/router_floor_check.py
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check for the V4.1 router floor kernels (one GPU, synthetic inputs).
+
+1. Bit equality, M = 1..6: ``_gate_cols`` vs ``_row_projection`` (FP32 gate
+   logits from FP16 activations and a BF16 384 x 5120 gate) and
+   ``_route_fast`` (each warp count) vs ``_route`` (ids and weight bits),
+   on random rows and on rows with exact key ties.
+2. Time per launch inside a CUDA graph (``--reps`` launches per replay).
+
+Synthetic data only. Exit status 1 if any comparison differs.
+
+    python benchmarks/deepseek_v41/router_floor_check.py --trials 500
+"""
+
+import argparse
+import json
+import sys
+
+import torch
+
+from vllm.model_executor.kernels.mhc import deepseek_v41 as mhc
+from vllm.model_executor.kernels.mhc import deepseek_v41_router as router
+
+E, K_DIM, TOP_K, SCALE = 384, 5120, 6, 1.5
+
+
+def _route_ref(logits, bias):
+    probs = torch.empty(logits.shape[0], TOP_K, device=logits.device)
+    ids = torch.empty(logits.shape[0], TOP_K, dtype=torch.int64, device=logits.device)
+    router._route[(logits.shape[0],)](
+        logits, bias, probs, ids, E=E, K=TOP_K, SCALE=SCALE, BLOCK=512, num_warps=4
+    )
+    return probs, ids
+
+
+def _route_new(logits, bias, warps):
+    probs = torch.empty(logits.shape[0], TOP_K, device=logits.device)
+    ids = torch.empty(logits.shape[0], TOP_K, dtype=torch.int32, device=logits.device)
+    router._route_fast[(logits.shape[0],)](
+        logits, bias, probs, ids, E=E, K=TOP_K, SCALE=SCALE, BLOCK=512, num_warps=warps
+    )
+    return probs, ids
+
+
+def _proj_ref(x, weight):
+    out = torch.empty(x.shape[0], E, device=x.device)
+    mhc._row_projection[(x.shape[0], E)](
+        x,
+        weight,
+        out,
+        K=K_DIM,
+        N=E,
+        NORMALIZE=False,
+        EPS=1e-20,
+        BLOCK=1024,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+def _proj_new(x, weight):
+    out = torch.empty(x.shape[0], E, device=x.device)
+    mhc._gate_cols[(E,)](
+        x,
+        weight,
+        out,
+        M=x.shape[0],
+        K=K_DIM,
+        N=E,
+        BLOCK=1024,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+def _bits(t):
+    return t.contiguous().view(torch.int32)
+
+
+def _graph_us(fn, reps):
+    fn()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for _ in range(reps):
+            fn()
+    graph.replay()
+    torch.cuda.synchronize()
+    start, end = torch.cuda.Event(True), torch.cuda.Event(True)
+    best = float("inf")
+    for _ in range(5):
+        start.record()
+        graph.replay()
+        end.record()
+        torch.cuda.synchronize()
+        best = min(best, start.elapsed_time(end) * 1000.0 / reps)
+    return best
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--trials", type=int, default=500)
+    ap.add_argument("--reps", type=int, default=200)
+    ap.add_argument("--warps", default="1,2,4")
+    ap.add_argument("--seed", type=int, default=0)
+    args = ap.parse_args()
+    warps = [int(w) for w in args.warps.split(",")]
+    dev = torch.device("cuda")
+    g = torch.Generator(device=dev).manual_seed(args.seed)
+    weight = (torch.randn(E, K_DIM, device=dev, generator=g) * 0.02).bfloat16()
+    bias = torch.randn(E, device=dev, generator=g) * 0.1
+    report = {"mismatch": {}, "us": {}}
+    bad = 0
+    for m in range(1, 7):
+        route = {w: 0 for w in warps}
+        proj = 0
+        for trial in range(args.trials):
+            x = torch.randn(m, K_DIM, device=dev, generator=g).half()
+            ref = _proj_ref(x, weight)
+            proj += int(not torch.equal(_bits(_proj_new(x, weight)), _bits(ref)))
+            logits = ref.clone()
+            if trial % 4 == 3:  # exact key ties inside the top 6
+                tie_bias = bias.clone()
+                tie_bias[10:20] = 0.05
+                logits[:, 10:20] = logits.amax(1, keepdim=True) + 1.0
+            else:
+                tie_bias = bias
+            rw, ri = _route_ref(logits, tie_bias)
+            for w in warps:
+                nw, ni = _route_new(logits, tie_bias, w)
+                same = torch.equal(ni.long(), ri) and torch.equal(_bits(nw), _bits(rw))
+                route[w] += int(not same)
+        report["mismatch"][f"M{m}"] = {
+            "gate_cols": proj,
+            **{f"route_fast_w{w}": route[w] for w in warps},
+        }
+        bad += proj + sum(route.values())
+        x = torch.randn(m, K_DIM, device=dev, generator=g).half()
+        logits = _proj_ref(x, weight)
+        us = {
+            "row_projection": _graph_us(lambda: _proj_ref(x, weight), args.reps),
+            "gate_cols": _graph_us(lambda: _proj_new(x, weight), args.reps),
+            "route": _graph_us(lambda: _route_ref(logits, bias), args.reps),
+            "route_plus_int32_cast": _graph_us(
+                lambda: _route_ref(logits, bias)[1].to(torch.int32), args.reps
+            ),
+        }
+        for w in warps:
+            us[f"route_fast_w{w}"] = _graph_us(
+                lambda w=w: _route_new(logits, bias, w), args.reps
+            )
+        report["us"][f"M{m}"] = {k: round(v, 2) for k, v in us.items()}
+    report["trials_per_m"] = args.trials
+    report["ok"] = bad == 0
+    print(json.dumps(report, indent=1))
+    return 0 if bad == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/models/test_deepseek_v41_router_floor.py b/tests/models/test_deepseek_v41_router_floor.py
