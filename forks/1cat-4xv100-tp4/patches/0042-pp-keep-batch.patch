+    assert fn(on, "r", req_state, 0, 13, [42], {}) == [7, 8, 42]
+    assert fn(on, "r", req_state, None, 13, [42], {"r": list(range(100, 114))}) == [
+        111,
+        112,
+        42,
+    ]
+    with pytest.raises(RuntimeError, match=KNOB):
+        fn(on, "r", req_state, None, 13, [42], {})
+    with pytest.raises(RuntimeError, match=KNOB):
+        fn(on, "r", req_state, 0, 15, [42], {})
