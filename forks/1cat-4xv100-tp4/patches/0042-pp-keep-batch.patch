diff --git a/vllm/v1/core/sched/pp_keep_batch.py b/vllm/v1/core/sched/pp_keep_batch.py
new file mode 100644
index 000000000..1c3be47e5
--- /dev/null
+++ b/vllm/v1/core/sched/pp_keep_batch.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_V41_PP_KEEP_BATCH: keep a running request across empty pipeline steps.
+
+With pipeline parallelism the engine keeps ``pipeline_parallel_size`` batches
+in flight (``EngineCore.step_with_batch_queue``). With one request and
+synchronous scheduling the request is still in flight on every other engine
+step, so that step schedules nothing. On such an empty step the V1 runner drops
+the request from its persistent batch (it was not scheduled) and the scheduler
+forgets that the request ran in the previous step. The next step then copies
+and serializes the request's whole token history
+(``CachedRequestData.all_token_ids``) to every worker, and every runner
+rebuilds the request's persistent-batch row from its prompt and output lists.
+All of that is O(context) host work on the critical path of each decode round.
+
+With the knob on, a fully empty step (no request scheduled at all) changes
+neither side:
+
+- the scheduler keeps its previous-step record for the requests that are
+  still running, so it does not resend their history;
+- the runner keeps its persistent-batch rows (except a request preempted in
+  that step), so their token ids, block table and previous drafts stay in
+  place for the next step.
+
+Both sides take the decision from the same config through
+:func:`pp_keep_batch_decision`, so they agree. This is the V1-runner
+counterpart of 1Cat-vLLM PR #1263, which removed the resend for the V2 runner
+only.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import vllm.envs as envs
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+KNOB = "VLLM_V41_PP_KEEP_BATCH"
+
+
+def pp_keep_batch_requested() -> bool:
+    """Whether the knob is set to 1. Any value other than unset, 0 or 1 is an
+    error, so a typo cannot leave the operator believing the path ran."""
+    value = (envs.VLLM_V41_PP_KEEP_BATCH or "0").strip()
+    if value not in ("0", "1"):
+        raise ValueError(f"{KNOB} must be 0 or 1, got {value!r}")
+    return value == "1"
+
+
+def pp_keep_batch_decision(vllm_config: VllmConfig) -> tuple[bool, str]:
+    """Return ``(enabled, reason)``.
+
+    ``enabled`` is False when the knob is off (``reason`` is then empty) or
+    when the configuration is outside the covered shape (``reason`` names
+    why; the caller logs it and runs the default path). The result depends
+    only on the environment and the config, so the engine-core scheduler and
+    every worker's runner compute the same answer.
+    """
+    if not pp_keep_batch_requested():
+        return False, ""
+
+    parallel_config = vllm_config.parallel_config
+    scheduler_config = vllm_config.scheduler_config
+    model_config = vllm_config.model_config
+    speculative_config = vllm_config.speculative_config
+
+    pp_size = parallel_config.pipeline_parallel_size
+    if pp_size <= 1:
+        return False, (
+            "pipeline_parallel_size is 1, so there are no empty pipeline steps"
+        )
+    if vllm_config.use_v2_model_runner:
+        return False, (
+            "the V2 model runner keeps request state on the GPU and already "
+            "skips the history resend (1Cat-vLLM #1263)"
+        )
+    if scheduler_config.async_scheduling:
+        return False, (
+            "async scheduling is on; its PP path sends no new_token_ids and "
+            "rebuilds requests from all_token_ids, which this knob does not cover"
+        )
+    if parallel_config.distributed_executor_backend == "external_launcher":
+        return False, "the external_launcher backend is not covered"
+    if vllm_config.kv_transfer_config is not None:
+        return False, (
+            "a KV connector is configured; its empty steps run "
+            "kv_connector_no_forward, which this knob does not cover"
+        )
+    if vllm_config.ec_transfer_config is not None:
+        return False, "an encoder-cache connector is configured"
+    if model_config is not None:
+        if model_config.runner_type == "pooling":
+            return False, "pooling models are not covered"
+        if model_config.is_hybrid:
+            return False, (
+                "hybrid (Mamba/linear-attention) models read per-row accepted "
+                "counts that a re-added row resets; not covered"
+            )
+    if speculative_config is not None:
+        if speculative_config.use_ngram_gpu():
+            return False, (
+                "ngram_gpu drafting updates its GPU token tensors incrementally "
+                "from re-added rows; not covered"
+            )
+        if speculative_config.use_dflash_ddtree():
+            # A non-last stage rebuilds the accepted drafts as a prefix of the
+            # previous step's scheduled drafts once the history is not sent;
+            # tree verification accepts a path, not a prefix.
+            return False, (
+                "dflash_ddtree verification accepts a tree path, not a prefix "
+                "of the scheduled drafts; not covered"
+            )
+    return True, (
+        f"PP={pp_size}, V1 model runner, synchronous scheduling: a fully empty "
+        "pipeline step keeps the persistent batch and the previous-step record"
+    )
