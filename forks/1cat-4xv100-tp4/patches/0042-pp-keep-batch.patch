+    off = SimpleNamespace(
+        pp_keep_batch=False, input_batch=SimpleNamespace(spec_token_ids=[[7, 8, 9]])
+    )
+    # Knob off: unchanged default (warn once, return the sent tokens).
+    assert fn(off, "r", req_state, None, 13, [42], {}) == [42]
