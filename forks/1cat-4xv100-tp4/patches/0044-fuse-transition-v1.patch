new file mode 100644
index 000000000..98f069fc7
--- /dev/null
+++ b/tests/models/test_deepseek_v41_small_fuse.py
@@ -0,0 +1,243 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""V4.1 small-kernel fusions against today's kernels (CPU, Triton interpreter).
+
+* VLLM_V41_FUSE_TRANSITION: ``_transition_fused3`` (one launch, last-arrival
+  finish) must give ``_transition_parts3`` + ``_transition_finish3``'s residual,
+  FP16 collapse and mixes bit for bit, for 1..8 tokens, MIX on/off and every
+  fn-row grouping, and must leave its counters at zero.
+
+Scope: the interpreter runs programs one after another and ``tl.sum`` as a
+numpy reduction, so these tests prove the kernels' logic (ticket counting,
+who finishes, re-arming, chunk order, residual write-after-read), not the
+GPU's reduction trees or memory ordering. Reduction layouts are compared on
+sm_70 TTGIR in test_deepseek_v41_small_fuse_sm70.py; the GPU check is
+benchmarks/deepseek_v41/small_fuse_check.py.
+
+    python tests/models/test_deepseek_v41_small_fuse.py   # or pytest
+"""
+
+import os
+
+os.environ["TRITON_INTERPRET"] = "1"  # before triton is imported
+
+import importlib.util  # noqa: E402
+import logging  # noqa: E402
+import sys  # noqa: E402
+import types  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+import pytest  # noqa: E402
+import torch  # noqa: E402
+import triton  # noqa: E402
+import triton.language as tl  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[2]
+
+_ENV = {
+    "VLLM_V41_HC_WINDOW": "2048",
+    "VLLM_V41_HC_COLS": "32",
+    "VLLM_V41_HC_PW": "4",
+    "VLLM_V41_HC_FW": "4",
+    "VLLM_V41_HC_V3": "1",
+    "VLLM_V41_HC_V3_GROUPS": "8",
+}
+
+
+class _Envs(types.ModuleType):
+    def __getattr__(self, name):
+        if name.startswith("VLLM_"):
+            return _ENV.get(name, "0")
+        raise AttributeError(name)
+
+
+def _stubs():
+    sys.modules.setdefault("vllm", types.ModuleType("vllm"))
+    if "vllm.triton_utils" not in sys.modules:
+        tu = types.ModuleType("vllm.triton_utils")
+        tu.tl, tu.triton = tl, triton
+        sys.modules["vllm.triton_utils"] = tu
+    if "vllm.logger" not in sys.modules:
+        lg = types.ModuleType("vllm.logger")
+        lg.init_logger = logging.getLogger
+        sys.modules["vllm.logger"] = lg
+    if "vllm.envs" not in sys.modules:
+        envs = _Envs("vllm.envs")
+        sys.modules["vllm.envs"] = envs
+        sys.modules["vllm"].envs = envs
+
+
+def _load(name, rel):
+    _stubs()
+    spec = importlib.util.spec_from_file_location(name, ROOT / rel)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+FUSED = _load(
+    "v41_small_fuse_mhc", "vllm/model_executor/kernels/mhc/deepseek_v41_fused.py"
+)
+
+
+class _PoisonTorch(types.ModuleType):
+    """``torch`` for the module under test: fresh buffers start as NaN / -1."""
+
+    def __getattr__(self, name):
+        return getattr(torch, name)
+
+    @staticmethod
+    def _poison(t):
+        return t.fill_(float("nan") if t.is_floating_point() else -1)
+
+    def empty(self, *args, **kwargs):
+        return self._poison(torch.empty(*args, **kwargs))
+
+    def empty_like(self, x, **kwargs):
+        return self._poison(torch.empty_like(x, **kwargs))
+
+
+@pytest.fixture(autouse=True)
+def _poisoned(monkeypatch):
+    monkeypatch.setattr(FUSED, "torch", _PoisonTorch("torch"))
+    yield
+
+
+def _bits(x):
+    x = x.contiguous()
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _same(a, b):
+    return a.dtype == b.dtype and a.shape == b.shape and torch.equal(_bits(a), _bits(b))
+
+
+def _transition_inputs(tokens, seed, mix):
+    g = torch.Generator().manual_seed(seed)
+    h = FUSED.H
+    comb = torch.rand(tokens, 4, 4, generator=g) + 0.05
+    inputs = dict(
+        residual=torch.randn(tokens, 4, h, generator=g),
+        y=torch.randn(tokens, h, generator=g).half(),
+        post=torch.rand(tokens, 4, generator=g) * 2.0,
+        comb=comb / comb.sum(-1, keepdim=True),
+        collapse_pre=torch.rand(tokens, 4, generator=g) + 1e-6,
+        norm_weight=torch.randn(h, generator=g),
+        fn=None,
+        scale=None,
+        base=None,
+    )
+    if mix:
+        inputs["fn"] = torch.randn(24, 4 * h, generator=g) * 0.02
+        inputs["scale"] = torch.rand(3, generator=g) + 0.5
+        inputs["base"] = torch.randn(24, generator=g) * 0.1
+    return inputs
+
+
+def _call(fn, inputs):
+    residual = inputs["residual"].clone()
+    out, mixes = fn(
+        residual,
+        inputs["y"],
+        inputs["post"],
+        inputs["comb"],
+        inputs["collapse_pre"],
+        inputs["norm_weight"],
+        inputs["fn"],
+        inputs["scale"],
+        inputs["base"],
+        1e-20,
+        1e-6,
+        20,
+    )
+    return residual, out, mixes
+
+
+def _assert_transition_equal(old, new):
+    assert _same(old[0], new[0]), "residual"
+    assert _same(old[1], new[1]), "collapse"
+    assert not torch.isnan(new[1]).any()
+    if old[2] is None:
+        assert new[2] is None
+        return
+    for name, a, b in zip(("pre", "post", "comb"), old[2], new[2]):
+        assert _same(a, b), name
+        assert not torch.isnan(b).any(), name
+
+
+def _counters_zero():
+    for counters in FUSED._FT_COUNTERS.values():
+        assert int(counters.abs().sum()) == 0
+
+
+@pytest.mark.parametrize(
+    "tokens,mix,groups",
+    [(t, True, 8) for t in range(1, 9)]
+    + [(t, False, 1) for t in (1, 2, 5, 6, 8)]
+    + [(t, True, g) for t in (1, 6) for g in (1, 2, 3, 4)],
+)
+def test_transition_fused_bitwise(monkeypatch, tokens, mix, groups):
+    monkeypatch.setattr(FUSED, "_V3_GROUPS", groups)
+    inputs = _transition_inputs(tokens, 100 + tokens * 7 + groups, mix)
+    old = _call(FUSED._hc_transition3, inputs)
+    new = _call(FUSED._hc_transition_fused, inputs)
+    _assert_transition_equal(old, new)
+    _counters_zero()
+
+
+def test_transition_fused_rearms(monkeypatch):
+    # Same counters, back-to-back launches with different shapes and inputs.
+    monkeypatch.setattr(FUSED, "_V3_GROUPS", 8)
+    for tokens, mix, seed in ((6, True, 1), (3, False, 2), (6, True, 3), (1, True, 4)):
+        inputs = _transition_inputs(tokens, seed, mix)
+        old = _call(FUSED._hc_transition3, inputs)
+        new = _call(FUSED._hc_transition_fused, inputs)
+        _assert_transition_equal(old, new)
+        _counters_zero()
+
+
+def test_transition_dispatch(monkeypatch):
+    # Knob on: hc_transition takes the fused path for 1..8 tokens only.
+    calls = []
+    real = FUSED._hc_transition_fused
+
+    def spy(*args):
+        calls.append(args[0].shape[0])
+        return real(*args)
+
+    monkeypatch.setattr(FUSED, "_hc_transition_fused", spy)
+    inputs = _transition_inputs(2, 9, True)
+    monkeypatch.setattr(FUSED, "_FUSE_TRANSITION", False)
+    residual_old = inputs["residual"].clone()
+    old = FUSED.hc_transition(
+        residual_old,
+        inputs["y"],
+        inputs["post"],
+        inputs["comb"],
+        inputs["collapse_pre"],
+        inputs["norm_weight"],
+        inputs["fn"],
+        inputs["scale"],
+        inputs["base"],
+    )
+    assert calls == []
+    monkeypatch.setattr(FUSED, "_FUSE_TRANSITION", True)
+    residual_new = inputs["residual"].clone()
+    new = FUSED.hc_transition(
+        residual_new,
+        inputs["y"],
+        inputs["post"],
+        inputs["comb"],
+        inputs["collapse_pre"],
+        inputs["norm_weight"],
+        inputs["fn"],
+        inputs["scale"],
+        inputs["base"],
+    )
+    assert calls == [2]
+    _assert_transition_equal((residual_old, *old), (residual_new, *new))
+
+
+if __name__ == "__main__":
+    sys.exit(pytest.main([__file__, "-q"]))
