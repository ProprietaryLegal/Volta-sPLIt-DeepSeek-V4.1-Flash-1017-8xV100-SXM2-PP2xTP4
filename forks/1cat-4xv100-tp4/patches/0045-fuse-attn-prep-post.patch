index 000000000..8e9ba2bec
--- /dev/null
+++ b/benchmarks/deepseek_v41/small_fuse_check.py
@@ -0,0 +1,554 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check for the V4.1 small-kernel fusions (one GPU, synthetic inputs).
+
+    VLLM_V41_FUSE_TRANSITION  _transition_parts3 + _transition_finish3
+                              -> _transition_fused3 (last-arrival finish)
+    VLLM_V41_FUSE_ATTN_PREP   _rotate(q), _short_rms(kv), _rotate(kv), _qdq
+                              -> _attn_prep
+    VLLM_V41_FUSE_ATTN_POST   _ring_insert, _rotate(inverse), _qdq
+                              -> _attn_post
+
+1. Bit equality, old vs new, every output into fresh NaN-poisoned buffers:
+   transition for M = 1..8, with mixes (the attention and FFN boundaries)
+   and without (a stage's final norm), fn-row groups = VLLM_V41_HC_V3_GROUPS
+   (8 unless set) and 1/2/4; PREP for M = 1..6 on the window and compressed
+   RoPE tables; POST for M = 1..8 with and without a window ring. Positions
+   inside the 16K table, at its end, beyond it (cos/sin on the fly) and 0;
+   zero rows, sub-floor QDQ groups and near-FP16-max values; invalid ring
+   tokens. The fused transition's counters must be zero after every call.
+2. CUDA graphs: each fused op captured at several M, replayed with new
+   inputs and interleaved across M (shared counters), against graphs of the
+   old kernels.
+3. Time per call inside a CUDA graph (--reps calls per replay, median of
+   --trials), old vs new, for M = --time-tokens; the per-layer and per-round
+   estimate uses 2 transitions + 1 PREP + 1 POST per layer, --layers layers.
+   Transition register caps (maxnreg None/40/32) are timed too.
+
+Loads the kernel modules from this script's tree (no vllm install or build
+needed). Exit status 1 on any difference.
+
+    CUDA_VISIBLE_DEVICES=0 python benchmarks/deepseek_v41/small_fuse_check.py \\
+        --json /tmp/small_fuse.json
+"""
+
+import argparse
+import contextlib
+import importlib.util
+import json
+import statistics
+import sys
+import types
+from pathlib import Path
+
+import torch
+
+_HERE = Path(__file__).resolve().parent
+_spec = importlib.util.spec_from_file_location(
+    "small_fuse_sm70_check", _HERE / "small_fuse_sm70_check.py"
+)
+_loader = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_loader)
+
+FUSED, ATTN, ROPE, NORM, OPS = _loader.load_modules()
+H = FUSED.H
+HEADS, GROUPS = 16, 2  # per TP rank
+TABLE_LENGTH = 16384
+DEV = "cuda"
+
+
+class _PoisonTorch(types.ModuleType):
+    def __getattr__(self, name):
+        return getattr(torch, name)
+
+    @staticmethod
+    def _poison(t):
+        return t.fill_(float("nan") if t.is_floating_point() else -1)
+
+    def empty(self, *args, **kwargs):
+        return self._poison(torch.empty(*args, **kwargs))
+
+    def empty_like(self, x, **kwargs):
+        return self._poison(torch.empty_like(x, **kwargs))
+
+
+_MODULES = (FUSED, ATTN, ROPE, NORM, OPS)
+
+
+@contextlib.contextmanager
+def poisoned():
+    saved = [m.torch for m in _MODULES]
+    for m in _MODULES:
+        m.torch = _PoisonTorch("torch")
+    try:
+        yield
+    finally:
+        for m, t in zip(_MODULES, saved):
+            m.torch = t
+
+
+def _bits(x):
+    x = x.contiguous()
+    return x.view({4: torch.int32, 2: torch.int16, 1: torch.int8}[x.element_size()])
+
+
+def compare(failures, name, old, new):
+    """Bitwise; records a failure (with a short diagnosis) on any difference."""
+    ok = (
+        old.shape == new.shape
+        and old.dtype == new.dtype
+        and torch.equal(_bits(old), _bits(new))
+    )
+    if ok and old.is_floating_point() and torch.isnan(new).any():
+        ok = False  # finite inputs: a NaN is a buffer the new kernel never wrote
+    if not ok:
+        info = {"check": name, "shape": list(new.shape)}
+        if old.shape == new.shape and old.is_floating_point():
+            differ = _bits(old) != _bits(new)
+            info["differ"] = int(differ.sum())
+            info["nan_new"] = int(torch.isnan(new).sum())
+            d = (old.float() - new.float()).abs()
+            info["max_abs"] = float(d[torch.isfinite(d)].max()) if differ.any() else 0
+        failures.append(info)
+    return ok
+
+
+# ---------------------------------------------------------------- inputs --
+
+
+def _gen(seed):
+    return torch.Generator(device=DEV).manual_seed(seed)
+
+
+def _doubly_stochastic(x):
+    # Sinkhorn-like comb: repeated expansion stays bounded (timing graphs).
+    for _ in range(8):
+        x = x / x.sum(-1, keepdim=True)
+        x = x / x.sum(-2, keepdim=True)
+    return x
+
+
+def transition_inputs(tokens, mix, seed):
+    g = _gen(seed)
+    r = dict(
+        residual=torch.randn(tokens, 4, H, device=DEV, generator=g) * 0.7,
+        y=(torch.randn(tokens, H, device=DEV, generator=g) * 0.5).half(),
+        post=2.0 * torch.sigmoid(torch.randn(tokens, 4, device=DEV, generator=g)),
+        comb=_doubly_stochastic(
+            torch.softmax(torch.randn(tokens, 4, 4, device=DEV, generator=g), -1)
+        ),
+        collapse_pre=torch.sigmoid(torch.randn(tokens, 4, device=DEV, generator=g))
+        + 1e-6,
+        norm_weight=1.0 + 0.1 * torch.randn(H, device=DEV, generator=g),
+        fn=None,
+        scale=None,
+        base=None,
+    )
+    if tokens > 1:
+        r["y"][1] = 0  # a token whose sublayer output is zero
+    if tokens > 2:
+        r["residual"][2, :, :256] *= 1e-4  # one tiny chunk
+    if mix:
+        r["fn"] = torch.randn(24, 4 * H, device=DEV, generator=g) * 0.02
+        r["scale"] = 0.5 + torch.rand(3, device=DEV, generator=g)
+        r["base"] = 0.5 * torch.randn(24, device=DEV, generator=g)
+    return r
+
+
+def _transition(path, x, residual=None):
+    residual = x["residual"].clone() if residual is None else residual
+    out, mixes = path(
+        residual,
+        x["y"],
+        x["post"],
+        x["comb"],
+        x["collapse_pre"],
+        x["norm_weight"],
+        x["fn"],
+        x["scale"],
+        x["base"],
+        1e-20,
+        1e-6,
+        20,
+    )
+    return residual, out, mixes
+
+
+def compare_transition(failures, tag, old, new):
+    ok = compare(failures, tag + " residual", old[0], new[0])
+    ok &= compare(failures, tag + " collapse", old[1], new[1])
+    if old[2] is not None:
+        for name, a, b in zip(("pre", "post", "comb"), old[2], new[2]):
+            ok &= compare(failures, f"{tag} {name}", a, b)
+    for counters in FUSED._FT_COUNTERS.values():
+        if int(counters.abs().sum()):
+            failures.append({"check": tag + " counters not re-armed"})
+            counters.zero_()
+            ok = False
+    return ok
+
+
+def rows(tokens, width, seed, scale=1.0):
+    g = _gen(seed)
+    x = torch.randn(tokens, width, device=DEV, generator=g) * scale
+    x[0, 128:256] *= 1e-5  # one QDQ group under the amax floor
+    if tokens > 1:
+        x[1] = 0  # all-zero row: RMS eps and the QDQ floor
+    if tokens > 2:
+        x[2, ::5] *= 2000.0  # near the FP16 top
+    return x.clamp(-65000, 65000).half()
+
+
+def position_sets(tokens):
+    # Consecutive decode positions; table end and beyond (on-the-fly
+    # cos/sin); zero and mixed.
+    picks = [0, TABLE_LENGTH - 1, TABLE_LENGTH, TABLE_LENGTH + 4093, 7, 5000]
+    yield "decode", torch.arange(tokens, device=DEV) + 4000
+    yield (
+        "edges",
+        torch.tensor([picks[i % len(picks)] for i in range(tokens)], device=DEV),
+    )
+    yield "beyond", torch.arange(tokens, device=DEV) + TABLE_LENGTH - 2
+
+
+TABLES = {}
+
+
+def table(compressed):
+    if compressed not in TABLES:
+        TABLES[compressed] = ROPE.rope_table(
+            TABLE_LENGTH, compressed=compressed, device=DEV
+        )
+    return TABLES[compressed]
+
+
+def prep_old(q, kv, w, positions, tab):
+    query = ROPE.apply_rope(q, positions, tab)
+    window = ROPE.attention_qdq(
+        ROPE.apply_rope(NORM.short_rms_norm(kv, w, 1e-20), positions, tab)
+    )
+    return query, window
+
+
+def prep_new(q, kv, w, positions, tab):
+    result = ATTN.attn_prep(q, kv, w, 1e-20, positions, tab)
+    if result is None:
+        raise RuntimeError("attn_prep declined a decode-shaped call")
+    return result
+
+
+def post_old(output, positions, tab, ring, values, valid):
+    if ring is not None:
+        OPS.insert_window_ring(ring, values, positions, valid)
+    output = ROPE.apply_rope(output, positions, tab, inverse=True)
+    return ROPE.attention_qdq(output.reshape(output.shape[0], GROUPS, 4096))
+
+
+def post_new(output, positions, tab, ring, values, valid):
+    result = ATTN.attn_post(output, positions, tab, GROUPS, ring, values, valid)
+    if result is None:
+        raise RuntimeError("attn_post declined a decode-shaped call")
+    return result
+
+
+def post_inputs(tokens, ring, seed):
+    output = rows(tokens, HEADS * 512, seed).view(tokens, HEADS, 512)
+    if not ring:
+        return output, None, None, None
+    g = _gen(seed + 1)
+    values = rows(tokens, 512, seed + 2)
+    valid = torch.ones(tokens, dtype=torch.bool, device=DEV)
+    if tokens >= 3:
+        valid[tokens // 2] = False  # a padded token: not written
+    ring_buf = torch.randn(OPS.WINDOW_RING, 512, device=DEV, generator=g).half()
+    return output, ring_buf, values, valid
+
+
+# ------------------------------------------------------------ bit checks --
+
+
+def check_transition(failures, report, groups_list):
+    n = 0
+    for groups in groups_list:
+        FUSED._V3_GROUPS = groups
+        for mix in (True, False):
+            if not mix and groups != groups_list[0]:
+                continue  # groups only apply with mixes
+            for tokens in range(1, 9):
+                for seed in range(2):
+                    x = transition_inputs(tokens, mix, 1000 * tokens + seed)
+                    with poisoned():
+                        old = _transition(FUSED._hc_transition3, x)
+                        new = _transition(FUSED._hc_transition_fused, x)
+                    tag = f"transition M={tokens} mix={mix} groups={groups}"
+                    compare_transition(failures, tag, old, new)
+                    n += 1
+    report["transition_cases"] = n
+
+
+def check_prep(failures, report):
+    n = 0
+    for tokens in range(1, 7):
+        for compressed in (False, True):
+            tab = table(compressed)
+            for pname, positions in position_sets(tokens):
+                seed = 100 * tokens + 10 * compressed + len(pname)
+                q = rows(tokens, HEADS * 512, seed).view(tokens, HEADS, 512)
+                kv = rows(tokens, 512, seed + 1, scale=0.4)
+                w = 1.0 + 0.2 * torch.randn(512, device=DEV, generator=_gen(seed))
+                with poisoned():
+                    old = prep_old(q, kv, w, positions, tab)
+                    new = prep_new(q, kv, w, positions, tab)
+                tag = f"prep M={tokens} compressed={compressed} {pname}"
+                compare(failures, tag + " query", old[0], new[0])
+                compare(failures, tag + " window", old[1], new[1])
+                n += 1
+    report["prep_cases"] = n
+
+
+def check_post(failures, report):
+    n = 0
+    tab = table(False)
+    for tokens in range(1, 9):
+        for ring in (False, True):
+            for pname, positions in position_sets(tokens):
+                if ring and pname == "edges":
+                    continue  # repeated ring slots race in the old kernel too
+                seed = 300 * tokens + 10 * ring + len(pname)
+                output, ring_buf, values, valid = post_inputs(tokens, ring, seed)
+                ring_old = ring_buf.clone() if ring else None
+                with poisoned():
+                    old = post_old(output, positions, tab, ring_old, values, valid)
+                    new = post_new(output, positions, tab, ring_buf, values, valid)
+                tag = f"post M={tokens} ring={ring} {pname}"
+                compare(failures, tag + " output", old, new)
+                if ring:
+                    compare(failures, tag + " ring", ring_old, ring_buf)
+                n += 1
+    report["post_cases"] = n
+
+
+# ----------------------------------------------------------- CUDA graphs --
+
+
+def _capture(fn):
+    # Poisoned inside the graph too: every replay refills fresh buffers with
+    # NaN before the kernels run, so an unwritten element shows.
+    with poisoned():
+        fn()  # eager warm-up (compiles; allocates the transition counters)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            result = fn()
+    return graph, result
+
+
+def check_graphs(failures, report):
+    n = 0
+    # Transition: graphs at several M share one counter buffer; replay them
+    # interleaved with fresh inputs copied into the static buffers.
+    graphs = {}
+    for tokens in (6, 3, 1, 8):
+        x = transition_inputs(tokens, True, 77 + tokens)
+        res_old, res_new = x["residual"].clone(), x["residual"].clone()
+        g_old, out_old = _capture(
+            lambda x=x, r=res_old: _transition(FUSED._hc_transition3, x, r)[1:]
+        )
+        g_new, out_new = _capture(
+            lambda x=x, r=res_new: _transition(FUSED._hc_transition_fused, x, r)[1:]
+        )
+        graphs[tokens] = (x, res_old, res_new, g_old, out_old, g_new, out_new)
+    for step, tokens in enumerate((6, 3, 6, 1, 8, 3, 6)):
+        x, res_old, res_new, g_old, out_old, g_new, out_new = graphs[tokens]
+        fresh = transition_inputs(tokens, True, 5000 + step)
+        for key in ("y", "post", "comb", "collapse_pre"):
+            x[key].copy_(fresh[key])
+        res_old.copy_(fresh["residual"])
+        res_new.copy_(fresh["residual"])
+        g_old.replay()
+        g_new.replay()
+        torch.cuda.synchronize()
+        tag = f"graph transition step={step} M={tokens}"
+        compare_transition(
+            failures,
+            tag,
+            (res_old, out_old[0], out_old[1]),
+            (res_new, out_new[0], out_new[1]),
+        )
+        n += 1
+    # PREP / POST: replays with new inputs.
+    tab = table(True)
+    for tokens in (6, 2):
+        positions = torch.arange(tokens, device=DEV) + 9000
+        q = rows(tokens, HEADS * 512, 1).view(tokens, HEADS, 512)
+        kv = rows(tokens, 512, 2, scale=0.4)
+        w = 1.0 + 0.2 * torch.randn(512, device=DEV, generator=_gen(3))
+        g_old, o_old = _capture(lambda: prep_old(q, kv, w, positions, tab))
+        g_new, o_new = _capture(lambda: prep_new(q, kv, w, positions, tab))
+        for step in range(3):
+            q.copy_(rows(tokens, HEADS * 512, 40 + step).view(tokens, HEADS, 512))
+            kv.copy_(rows(tokens, 512, 50 + step, scale=0.4))
+            positions.add_(1)
+            g_old.replay()
+            g_new.replay()
+            torch.cuda.synchronize()
+            tag = f"graph prep step={step} M={tokens}"
+            compare(failures, tag + " query", o_old[0], o_new[0])
+            compare(failures, tag + " window", o_old[1], o_new[1])
+            n += 1
+    for tokens in (8, 6):
+        positions = torch.arange(tokens, device=DEV) + 9000
+        output, ring_new, values, valid = post_inputs(tokens, True, 7)
+        ring_old = ring_new.clone()
+        g_old, o_old = _capture(
+            lambda: post_old(output, positions, table(False), ring_old, values, valid)
+        )
+        g_new, o_new = _capture(
+            lambda: post_new(output, positions, table(False), ring_new, values, valid)
+        )
+        for step in range(3):
+            fresh = post_inputs(tokens, True, 60 + step)
+            output.copy_(fresh[0])
+            values.copy_(fresh[2])
+            ring_old.copy_(fresh[1])
+            ring_new.copy_(fresh[1])
+            positions.add_(tokens)
+            g_old.replay()
+            g_new.replay()
+            torch.cuda.synchronize()
+            tag = f"graph post step={step} M={tokens}"
+            compare(failures, tag + " output", o_old, o_new)
+            compare(failures, tag + " ring", ring_old, ring_new)
+            n += 1
+    report["graph_cases"] = n
+
+
+# ---------------------------------------------------------------- timing --
+
+
+def graph_us(fn, reps, trials):
+    fn()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for _ in range(reps):
+            fn()
+    graph.replay()
+    torch.cuda.synchronize()
+    times = []
+    for _ in range(trials):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(10):
+            graph.replay()
+        end.record()
+        end.synchronize()
+        times.append(start.elapsed_time(end) * 1000.0 / (10 * reps))
+    del graph
+    return statistics.median(times)
+
+
+def timing(report, tokens_list, reps, trials, layers, groups):
+    FUSED._V3_GROUPS = groups
+    out = {}
+    for tokens in tokens_list:
+        row = {}
+        x = transition_inputs(tokens, True, 31)
+        res = x["residual"].clone()
+        row["transition_old"] = graph_us(
+            lambda: _transition(FUSED._hc_transition3, x, res), reps, trials
+        )
+        cap = FUSED._FT_MAXNREG
+        for maxnreg in (cap, None, 40, 32):
+            key = f"transition_new_maxnreg{maxnreg}"
+            if key in row:
+                continue
+            FUSED._FT_MAXNREG = maxnreg
+            row[key] = graph_us(
+                lambda: _transition(FUSED._hc_transition_fused, x, res), reps, trials
+            )
+        FUSED._FT_MAXNREG = cap
+        row["transition_new"] = row[f"transition_new_maxnreg{cap}"]
+        tab = table(False)
+        positions = torch.arange(tokens, device=DEV) + 4000
+        q = rows(tokens, HEADS * 512, 5).view(tokens, HEADS, 512)
+        kv = rows(tokens, 512, 6, scale=0.4)
+        w = torch.ones(512, device=DEV)
+        if tokens <= 6:
+            row["prep_old"] = graph_us(
+                lambda: prep_old(q, kv, w, positions, tab), reps, trials
+            )
+            row["prep_new"] = graph_us(
+                lambda: prep_new(q, kv, w, positions, tab), reps, trials
+            )
+        output, ring, values, valid = post_inputs(tokens, True, 8)
+        row["post_old"] = graph_us(
+            lambda: post_old(output, positions, tab, ring, values, valid), reps, trials
+        )
+        row["post_new"] = graph_us(
+            lambda: post_new(output, positions, tab, ring, values, valid), reps, trials
+        )
+        saving = 2 * (row["transition_old"] - row["transition_new"]) + (
+            row["post_old"] - row["post_new"]
+        )
+        if "prep_old" in row:
+            saving += row["prep_old"] - row["prep_new"]
+        row["layer_saving_us"] = saving
+        row["round_saving_ms"] = saving * layers / 1000.0
+        out[f"M={tokens}"] = {k: round(v, 2) for k, v in row.items()}
+    report["timing_us"] = out
+    report["timing_note"] = (
+        f"median of {trials} x 10 replays of a {reps}-call graph; per layer = 2 "
+        f"transitions (mixes on) + PREP + POST (ring on); round = {layers} layers"
+    )
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--device", type=int, default=0)
+    ap.add_argument("--time-tokens", default="1,2,3,4,5,6")
+    ap.add_argument("--reps", type=int, default=40)
+    ap.add_argument("--trials", type=int, default=7)
+    ap.add_argument("--layers", type=int, default=40)
+    ap.add_argument("--skip-timing", action="store_true")
+    ap.add_argument("--json", default=None)
+    args = ap.parse_args()
+    torch.cuda.set_device(args.device)
+    prod_groups = FUSED._V3_GROUPS
+    groups_list = [prod_groups] + [g for g in (1, 2, 4) if g != prod_groups]
+    report = {
+        "device": torch.cuda.get_device_name(),
+        "capability": list(torch.cuda.get_device_capability()),
+        "torch": torch.__version__,
+        "triton": _loader.triton.__version__,
+        "hc_v3_groups": prod_groups,
+        "transition_maxnreg": FUSED._FT_MAXNREG,
+    }
+    failures = []
+    check_transition(failures, report, groups_list)
+    FUSED._V3_GROUPS = prod_groups
+    check_prep(failures, report)
+    check_post(failures, report)
+    check_graphs(failures, report)
+    report["mismatches"] = len(failures)
+    report["failures"] = failures[:40]
+    if not args.skip_timing:
+        timing(
+            report,
+            [int(t) for t in args.time_tokens.split(",")],
+            args.reps,
+            args.trials,
+            args.layers,
+            prod_groups,
+        )
+    report["ok"] = not failures
+    text = json.dumps(report, indent=1)
+    print(text)
+    if args.json:
+        Path(args.json).write_text(text)
+    return 0 if not failures else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
