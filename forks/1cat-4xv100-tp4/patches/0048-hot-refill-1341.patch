new file mode 100644
index 000000000..ccb6f105a
--- /dev/null
+++ b/tests/models/sim_deepseek_v41_hot_refill.py
@@ -0,0 +1,47 @@
+"""CPU simulation of V41PackedKV.refill_hot (1Cat #1341 port): extracts the method from kv_store.py by AST."""
+import ast, sys, types, torch
+src = open(sys.argv[1]).read()
+fn = next(n for n in ast.walk(ast.parse(src)) if isinstance(n, ast.FunctionDef) and n.name == "refill_hot")
+ns = {}; exec(compile(ast.Module([fn], []), "refill_hot", "exec"), ns); refill = ns["refill_hot"]
+C = 3
+def run(sources, hot_positions, prompt, answer, drafts=4, cached=None):
+    st = types.SimpleNamespace(sources=sources, hot_rows={s: max(1, hot_positions // r) for s, r in sources.items()})
+    total = prompt + answer + drafts + 1024
+    st.host = {s: torch.zeros(total // r + 1, C, dtype=torch.int32) for s, r in sources.items()}
+    st.hot = {s: torch.zeros(st.hot_rows[s], C, dtype=torch.int32) for s in sources}
+    def write(s, row, tag):
+        v = torch.tensor([row, tag, 7], dtype=torch.int32)
+        st.hot[s][row % st.hot_rows[s]] = v; st.host[s][row] = v
+    # previous request: prompt + answer + rejected drafts, tag 1 (host also written; rank 0 writes every row)
+    for s, r in sources.items():
+        for row in range((prompt + answer + drafts) // r): write(s, row, 1)
+    cached = prompt if cached is None else cached
+    # the old request's rows past the hit differ in content from what the new request will write: mark them stale
+    for s, r in sources.items():
+        for row in range(cached // r, (prompt + answer + drafts) // r):
+            st.hot[s][row % st.hot_rows[s]][1] = 99
+    n = refill(st, cached)
+    bad = 0
+    for s, r in sources.items():
+        hi = cached // r - 1; rows = st.hot_rows[s]
+        for c in range(max(0, hi - rows + 1), hi + 1):
+            if not torch.equal(st.hot[s][c % rows], st.host[s][c]): bad += 1
+    return n, bad
+srcs = {2: 4, 8: 128, 14: 4, 20: 4}
+fails = 0
+for prompt, answer, hp in [(40000, 64, 32768), (39560, 64, 32768), (250000, 64, 32768), (500000, 64, 32768),
+                           (37000, 1, 32768), (100, 64, 64), (2000, 300, 1024)]:
+    n, bad = run(srcs, hp, prompt, answer)
+    print(f"prompt {prompt} answer {answer} hot_positions {hp}: copied {n} rows, mismatched slots {bad}")
+    fails += bad != 0
+# guard: ring cannot wrap yet -> nothing copied, and nothing needed
+n, bad = run({2: 4}, 32768, 20000, 64)
+print(f"below ring (20000 tokens): copied {n}, mismatched {bad}"); fails += (n != 0) + (bad != 0)
+# without the refill the wrapped case must show stale slots (proves the check can fail)
+st_bad = None
+def norefill(st, cached): return 0
+ns["refill_hot"] = norefill
+saved = refill; refill = norefill
+_, bad = run(srcs, 32768, 40000, 64); refill = saved
+print(f"control without refill at 40000: mismatched {bad} (must be > 0)"); fails += bad == 0
+print("FAIL" if fails else "PASS"); sys.exit(1 if fails else 0)
